<UserControl x:Class="TerminalHost.Views.Popups.GitBranchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             d:DataContext="{d:DesignInstance viewModels:GitBranchViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Key Branches Section -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8"
                IsVisible="{Binding HasKeyBranches}">
            <StackPanel>
                <!-- Current branch header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Current:"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CurrentBranch.ShortName}"
                               Foreground="{StaticResource SyntaxGreenBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Key branch comparisons -->
                <ItemsControl ItemsSource="{Binding KeyBranchStatuses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="domain:KeyBranchStatus">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- "vs" label -->
                                <TextBlock Grid.Column="0"
                                           Text="vs"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>

                                <!-- Key branch name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Branch.ShortName}"
                                           Foreground="{StaticResource SyntaxCyanBrush}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                <!-- Status display -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding StatusDisplay}"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeTiny}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="↓ Pull"
                                            ToolTip.Tip="Fast-forward current branch to this (pull changes from this branch)"
                                            Classes="TerminalSwitchButton"
                                            Command="{Binding $parent[ItemsControl].((viewModels:GitBranchViewModel)DataContext).FastForwardToKeyBranchCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanFastForward}"
                                            Padding="10,4"
                                            FontSize="{StaticResource FontSizeTiny}"
                                            Margin="0,0,4,0"/>
                                    <Button Content="↑ Push"
                                            ToolTip.Tip="Fast-forward this branch to current (push changes to this branch)"
                                            Classes="TerminalSwitchButton"
                                            Command="{Binding $parent[ItemsControl].((viewModels:GitBranchViewModel)DataContext).FastForwardKeyBranchToCurrentCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding CanFastForwardKeyToCurrent}"
                                            Foreground="{StaticResource SyntaxGreenBrush}"
                                            Padding="10,4"
                                            FontSize="{StaticResource FontSizeTiny}"
                                            Margin="0,0,4,0"/>
                                    <Button Content="Reset"
                                            ToolTip.Tip="Reset current branch to this (destructive)"
                                            Classes="TerminalSwitchButton"
                                            Command="{Binding $parent[ItemsControl].((viewModels:GitBranchViewModel)DataContext).ResetToKeyBranchCommand}"
                                            CommandParameter="{Binding}"
                                            Foreground="{StaticResource AccentOrangeBrush}"
                                            Padding="10,4"
                                            FontSize="{StaticResource FontSizeTiny}"
                                            Margin="0,0,4,0"/>
                                    <Button Content="Compare"
                                            ToolTip.Tip="Compare with current branch"
                                            Classes="TerminalSwitchButton"
                                            Command="{Binding $parent[ItemsControl].((viewModels:GitBranchViewModel)DataContext).CompareWithKeyBranchCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="10,4"
                                            FontSize="{StaticResource FontSizeTiny}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Search Box -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8">
            <TextBox x:Name="GitBranchSearchBox"
                     Text="{Binding SearchText}"
                     Watermark="Search branches..."
                     Background="{StaticResource BackgroundMediumBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderSubtleBrush}"
                     BorderThickness="1"
                     Padding="8,6"
                     FontSize="{StaticResource FontSizeCode}"/>
        </Border>

        <!-- Branch List -->
        <ListBox x:Name="GitBranchList"
                 Grid.Row="2"
                 ItemsSource="{Binding Branches}"
                 SelectedItem="{Binding SelectedBranch}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="domain:GitBranch">
                    <Grid Margin="8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Current branch indicator -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Icon}"
                                   Foreground="{Binding StatusColor}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Branch name -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   Foreground="{Binding StatusColor}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Issue number (for branches like issues/#123) -->
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding IssueNumber}"
                                   Foreground="{StaticResource SyntaxBlueBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   IsVisible="{Binding IssueNumber, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Status: ahead/behind, local only, gone -->
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="{Binding StatusDisplay}"
                                   Foreground="{Binding StatusBadgeColor, Converter={StaticResource HexToBrushConverter}}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   ToolTip.Tip="{Binding TrackingBranch}"
                                   IsVisible="{Binding StatusDisplay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Last commit info (second row) -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                   Text="{Binding LastCommitDisplay}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"
                                   IsVisible="{Binding LastCommitDisplay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                </Style>
            </ListBox.Styles>
        </ListBox>

        <!-- Empty state -->
        <TextBlock x:Name="GitBranchEmptyState"
                   Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="{StaticResource FontSizeSmall}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Padding="20"
                   IsVisible="{Binding Branches.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

        <!-- Footer with action buttons -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Fetch"
                            Classes="TerminalSwitchButton"
                            Command="{Binding FetchAllCommand}"
                            ToolTip.Tip="Fetch all remotes (F)"
                            Margin="0,0,4,0"/>
                    <Button Content="Pull"
                            Classes="TerminalSwitchButton"
                            Command="{Binding PullCommand}"
                            ToolTip.Tip="Pull current branch (P)"
                            Margin="0,0,4,0"/>
                    <Button Content="Compare"
                            Classes="TerminalSwitchButton"
                            Command="{Binding CompareWithSelectedBranchCommand}"
                            ToolTip.Tip="Compare with current branch (C)"
                            Margin="0,0,4,0"/>
                    <Button Content="Delete"
                            Classes="TerminalSwitchButton"
                            Command="{Binding DeleteBranchCommand}"
                            ToolTip.Tip="Delete selected branch (Del)"
                            Margin="0,0,4,0"/>
                    <Button Content="Checkout"
                            Classes="TerminalSwitchButton"
                            Command="{Binding CheckoutBranchCommand}"
                            ToolTip.Tip="Switch to selected branch (Enter)"/>
                </StackPanel>
                <Button Content="+ New Branch"
                        Classes="TerminalSwitchButton"
                        Command="{Binding CreateBranchCommand}"
                        ToolTip.Tip="Create new branch from current HEAD"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
