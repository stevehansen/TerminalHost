<UserControl x:Class="TerminalHost.Views.Popups.MergeConflictView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             d:DataContext="{d:DesignInstance vm:MergeConflictViewModel}"
             mc:Ignorable="d">

    <controls:DraggablePopup
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        PopupWidth="{Binding Width, Mode=TwoWay}"
        PopupHeight="{Binding Height, Mode=TwoWay}"
        HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
        VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}"
        Title="{Binding Title}"
        CloseCommand="{Binding CloseCommand}">

        <controls:DraggablePopup.HeaderRightContent>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ConflictFiles.Count, StringFormat='{}{0} conflicted files'}"
                           Foreground="{StaticResource TextDimmedBrush}"
                           FontSize="{StaticResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Button Content="Refresh"
                        Classes="TerminalSwitchButton"
                        Command="{Binding RefreshConflictFilesCommand}"
                        ToolTip.Tip="Refresh conflict file list"
                        Margin="0,0,8,0"/>
            </StackPanel>
        </controls:DraggablePopup.HeaderRightContent>

        <controls:DraggablePopup.PopupContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="150"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Conflict file list -->
                    <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                                <TextBlock Foreground="{StaticResource TextDimmedBrush}" FontSize="{StaticResource FontSizeTiny}">
                                    <Run Text="{Binding ConflictFiles.Count, Mode=OneWay}"/>
                                    <Run Text=" conflicted files"/>
                                </TextBlock>
                            </Border>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ConflictFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="domain:GitFileStatus">
                                            <Border Background="Transparent"
                                                    Padding="4,3"
                                                    Cursor="Hand"
                                                    PointerPressed="OnConflictFilePressed">
                                                <Border.Styles>
                                                    <Style Selector="Border:pointerover">
                                                        <Setter Property="Background" Value="#333333"/>
                                                    </Style>
                                                </Border.Styles>
                                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                                    <TextBlock Text="U" Foreground="#FF6B6B" FontWeight="Bold"
                                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Width="16"/>
                                                    <TextBlock Text="{Binding FileName}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeSmall}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty state -->
                            <TextBlock Grid.Row="1"
                                       Text="No merge conflicts"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding !ConflictFiles.Count}"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

                    <!-- Merge conflict viewer -->
                    <Border Grid.Column="2" Background="{StaticResource BackgroundDarkestBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Top header: Ours vs Theirs -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="OURS (HEAD)" Foreground="#4EC9B0" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text=" | " Foreground="{StaticResource TextDimmedBrush}" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="THEIRS (incoming)" Foreground="#569CD6" FontWeight="SemiBold" FontSize="11"/>
                                </Grid>
                            </Border>

                            <!-- Ours vs Theirs side-by-side -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ours panel -->
                                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding OursContent, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="#4EC9B0"
                                             FontFamily="{StaticResource FontFamilyMonospace}"
                                             FontSize="12"
                                             BorderThickness="0"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="True"/>
                                </ScrollViewer>

                                <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

                                <!-- Theirs panel -->
                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <TextBox Text="{Binding TheirsContent, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="#569CD6"
                                             FontFamily="{StaticResource FontFamilyMonospace}"
                                             FontSize="12"
                                             BorderThickness="0"
                                             TextWrapping="NoWrap"
                                             AcceptsReturn="True"/>
                                </ScrollViewer>
                            </Grid>

                            <!-- Action bar -->
                            <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <TextBlock Text="RESULT" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="AI Suggestion — review before saving"
                                                   Foreground="#C586C0" FontSize="11" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsAiSuggestion}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Command="{Binding AiSuggestCommand}"
                                                Classes="TerminalSwitchButton"
                                                Foreground="#C586C0"
                                                Margin="0,0,8,0"
                                                Content="{Binding IsAiLoading, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Thinking...|AI Suggest'}"/>
                                        <Button Content="Accept Ours"
                                                Classes="TerminalSwitchButton"
                                                Command="{Binding AcceptOursCommand}"
                                                Foreground="#4EC9B0"
                                                Margin="0,0,4,0"/>
                                        <Button Content="Accept Theirs"
                                                Classes="TerminalSwitchButton"
                                                Command="{Binding AcceptTheirsCommand}"
                                                Foreground="#569CD6"
                                                Margin="0,0,4,0"/>
                                        <Button Content="Accept Both"
                                                Classes="TerminalSwitchButton"
                                                Command="{Binding AcceptBothCommand}"
                                                Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&lt; Prev"
                                                Classes="TerminalSwitchButton"
                                                Command="{Binding NavigatePrevHunkCommand}"
                                                IsEnabled="{Binding CanNavigatePrev}"
                                                Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding HunkCountText}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <Button Content="Next &gt;"
                                                Classes="TerminalSwitchButton"
                                                Command="{Binding NavigateNextHunkCommand}"
                                                IsEnabled="{Binding CanNavigateNext}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Result panel (editable) -->
                            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding ResultContent, Mode=TwoWay}"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         FontSize="12"
                                         BorderThickness="0"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer with actions -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" Padding="12,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Save &amp; Mark Resolved"
                                    Classes="TerminalSwitchButton"
                                    Command="{Binding SaveAndMarkResolvedCommand}"
                                    Foreground="#4EC9B0"
                                    Margin="0,0,8,0"/>
                            <Button Content="Continue Merge"
                                    Classes="TerminalSwitchButton"
                                    Command="{Binding ContinueMergeCommand}"
                                    Foreground="{StaticResource AccentBlueBrush}"
                                    Margin="0,0,8,0"/>
                            <Button Content="Abort Merge"
                                    Classes="TerminalSwitchButton"
                                    Command="{Binding AbortMergeCommand}"
                                    Foreground="#F14C4C"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Info}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </controls:DraggablePopup.PopupContent>
    </controls:DraggablePopup>
</UserControl>
