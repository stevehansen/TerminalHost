<UserControl x:Class="TerminalHost.Views.Popups.TestResultsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             d:DataContext="{d:DesignInstance viewModels:TestResultsViewModel}"
             mc:Ignorable="d">

    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource SyntaxGreenBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0"
            MinWidth="600"
            MaxWidth="800"
            MaxHeight="600"
            Width="{Binding Width, Mode=TwoWay}"
            Height="{Binding Height, Mode=TwoWay}"
            BoxShadow="0 5 20 0 #80000000"
            IsVisible="{Binding IsOpen}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="x"
                            Classes="TabCloseButton"
                            Command="{Binding CloseCommand}"
                            FontSize="{StaticResource FontSizeLarge}"
                            Padding="8,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="T" FontSize="{StaticResource FontSizeNormal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeCode}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" (F6)"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Summary Bar -->
            <Border Grid.Row="1" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8">
                <DockPanel>
                    <!-- Action buttons on right -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Stop"
                                Classes="TerminalSwitchButton"
                                Command="{Binding CancelTestsCommand}"
                                IsVisible="{Binding IsRunning}"
                                Margin="0,0,4,0"/>
                        <Button Content="Rerun"
                                Classes="TerminalSwitchButton"
                                Command="{Binding RerunTestsCommand}"
                                ToolTip.Tip="Re-run all tests"
                                Margin="0,0,4,0"/>
                        <Button Content="Run Failed"
                                Classes="TerminalSwitchButton"
                                Command="{Binding RunFailedTestsCommand}"
                                ToolTip.Tip="Re-run only failed tests"
                                Margin="0,0,4,0"/>
                        <Button Classes="TerminalSwitchButton"
                                Command="{Binding AnalyzeFailuresCommand}"
                                ToolTip.Tip="Analyze failures with AI"
                                Content="{Binding IsAnalyzingFailures, Converter={StaticResource BoolToStringConverter}, ConverterParameter='...|Analyze'}"/>
                    </StackPanel>

                    <!-- Summary counts -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Passed -->
                        <Border Background="{StaticResource SyntaxGreenBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="P " Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PassedCount}" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Failed -->
                        <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <Border.Styles>
                                <Style Selector="Border">
                                    <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                </Style>
                                <Style Selector="Border[IsVisible=true]">
                                    <Setter Property="Background" Value="{StaticResource SyntaxRedBrush}"/>
                                </Style>
                            </Border.Styles>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="X " Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="{Binding FailedCount}" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Skipped -->
                        <Border Background="{StaticResource SyntaxYellowBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                IsVisible="{Binding SkippedCount}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="O " Foreground="Black" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SkippedCount}" Foreground="Black" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Duration -->
                        <TextBlock Text="{Binding TotalDuration}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   IsVisible="{Binding TotalDuration}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Test Results List -->
            <ListBox x:Name="TestResultsList"
                     Grid.Row="2"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:TestResult">
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status icon -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding StatusIcon}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       FontWeight="Bold">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextDimmedBrush}"/>
                                    </Style>
                                    <Style Selector="TextBlock[Tag=Passed]">
                                        <Setter Property="Foreground" Value="{StaticResource SyntaxGreenBrush}"/>
                                    </Style>
                                    <Style Selector="TextBlock[Tag=Failed]">
                                        <Setter Property="Foreground" Value="{StaticResource SyntaxRedBrush}"/>
                                    </Style>
                                    <Style Selector="TextBlock[Tag=Skipped]">
                                        <Setter Property="Foreground" Value="{StaticResource SyntaxYellowBrush}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>

                            <!-- Test name -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding FullName}"/>

                            <!-- Duration -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DurationDisplay}"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <!-- Loading/Running indicator -->
            <Border Grid.Row="2"
                    Background="{StaticResource BackgroundDarkBrush}"
                    IsVisible="{Binding IsRunning}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Running tests..."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Error Details Panel (for selected failed test) -->
            <Border Grid.Row="3"
                    Background="{StaticResource BackgroundDarkestBrush}"
                    Padding="12,8"
                    IsVisible="{Binding SelectedResult.ErrorMessage}"
                    MaxHeight="150">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedResult.ErrorMessage}"
                                   Foreground="{StaticResource SyntaxRedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontFamily="Consolas,Menlo,Monaco,Courier New,monospace"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedResult.StackTrace}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontFamily="Consolas,Menlo,Monaco,Courier New,monospace"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   IsVisible="{Binding SelectedResult.StackTrace}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- AI Diagnosis callout -->
            <Border Grid.Row="4" Classes="AiCallout"
                    IsVisible="{Binding HasSelectedDiagnosis}"
                    Margin="0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="AI Diagnosis" Foreground="#10B981"
                                   FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedAiDiagnosis}" TextWrapping="Wrap" Foreground="#D4D4D4" FontSize="{StaticResource FontSizeSmall}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x1F4CB;" Classes="InlineAction"
                            Command="{Binding CopySelectedAiDiagnosisCommand}"
                            ToolTip.Tip="Copy to clipboard"
                            VerticalAlignment="Top" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="5" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="0,0,6,6">
                <DockPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>