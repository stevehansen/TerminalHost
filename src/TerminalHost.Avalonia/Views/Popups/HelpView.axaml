<UserControl x:Class="TerminalHost.Views.Popups.HelpView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="500">
    <Border Background="{DynamicResource BackgroundDarkBrush}"
        BorderBrush="{DynamicResource AccentPrimaryBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Margin="10"
        MinWidth="700"
        MaxWidth="900"
        MaxHeight="850"
        BoxShadow="0 5 20 0 #80000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="8,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                        Content="├ù"
                        Classes="TabCloseButton"
                        Command="{Binding CloseHelpCommand}"
                        FontSize="{DynamicResource FontSizeHeader}"
                        Padding="8,2">
                        <AutomationProperties.Name>Close Help</AutomationProperties.Name>
                    </Button>
                    <TextBlock Text="TerminalHost Help"
                           Foreground="{DynamicResource TextBrightBrush}"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel Margin="10">
                    <!-- Keyboard Shortcuts Section -->
                    <TextBlock Text="Keyboard Shortcuts" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Tab Navigation -->
                    <TextBlock Text="Tab Navigation" Foreground="{DynamicResource SyntaxLightBlueBrush}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Tab" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Next tab" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+Tab" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Previous tab" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Γîÿ 1-9" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Jump to tab 1-9" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ΓîÿΓçº T" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Open tab switcher (search tabs)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Γîÿ W" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Close current tab" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Middle-click tab" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Close tab" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    </Grid>

                    <!-- Terminal -->
                    <TextBlock Text="Terminal" Foreground="{DynamicResource SyntaxLightBlueBrush}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Γîÿ `" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Switch between Custom/Shell terminal" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Links button" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Click to view detected URLs and file paths" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    </Grid>

                    <!-- File Operations -->
                    <TextBlock Text="File Operations" Foreground="{DynamicResource SyntaxLightBlueBrush}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Γîÿ N" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Open new project (folder picker)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Γîÿ E" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Open current folder in Finder" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Γîÿ O" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Open file preview dialog" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ΓîÿΓçº E" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Open file editor" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="ΓîÿΓçº F" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Toggle file explorer panel" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    </Grid>

                    <!-- Application -->
                    <TextBlock Text="Application" Foreground="{DynamicResource SyntaxLightBlueBrush}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Γîÿ ," Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Open settings editor" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Γîÿ P" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Open settings (Profiles)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ΓîÿΓçº P" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Open command palette" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ΓîÿΓçº N" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Open scratch pad (notes)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Γîÿ T" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Open task panel" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="ΓîÿΓçº I" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="Open Timeline Mode" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="ΓîÿΓçº Q" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="Quick add task" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="ΓîÿΓçº M" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="Quick add note" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Γîÿ G" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="Open git changes panel" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Γîÿ B" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="Open git branch switcher" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="ΓîÿΓçº S" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="Open git stash panel" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="ΓîÿΓçº G" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="11" Grid.Column="1" Text="Open git reflog" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="F1" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="Show this help window" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="13" Grid.Column="0" Text="ΓîÿΓçº O" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="13" Grid.Column="1" Text="Repository quick access" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="14" Grid.Column="0" Text="ΓîÿΓçº H" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="14" Grid.Column="1" Text="Open commit history" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="15" Grid.Column="0" Text="ΓîÿΓçº R" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="15" Grid.Column="1" Text="PR Review Mode" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="16" Grid.Column="0" Text="F6" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="16" Grid.Column="1" Text="Run tests" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="17" Grid.Column="0" Text="Γîÿ M" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="17" Grid.Column="1" Text="Markdown preview" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="18" Grid.Column="0" Text="ΓîÿΓçº L" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="18" Grid.Column="1" Text="Toggle sidebar layout" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    </Grid>

                    <!-- Quick Commands Section -->
                    <TextBlock Text="Default Quick Commands" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ΓîÿΓçº C" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Send 'commit' to Claude Code" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="ΓîÿΓçº D" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Run 'git pull --rebase' in Shell" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ΓîÿΓçº U" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Run 'git push' in Shell" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                    </Grid>

                    <!-- Tips Section -->
                    <TextBlock Text="Tips" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="ΓÇó " Foreground="{DynamicResource SyntaxBlueBrush}"/><Run Text="Drag tabs to reorder them"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="ΓÇó " Foreground="{DynamicResource SyntaxBlueBrush}"/><Run Text="Use the splitter between terminals to adjust the split ratio (saved per directory)"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="ΓÇó " Foreground="{DynamicResource SyntaxBlueBrush}"/><Run Text="File preview supports syntax highlighting for: JSON, C#, JavaScript/TypeScript, Python, XML, Markdown, CSV/TSV"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="ΓÇó " Foreground="{DynamicResource SyntaxBlueBrush}"/><Run Text="Configure custom link patterns in Settings to make ticket IDs clickable"/>
                    </TextBlock>

                    <!-- Command Line Section -->
                    <TextBlock Text="Command Line Usage" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <Border Background="{DynamicResource BackgroundDarkestBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock FontFamily="{DynamicResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                            <Run Text="host" Foreground="{DynamicResource SyntaxCyanBrush}"/>
                            <Run Text="                  # Open/focus app"/>
                            </TextBlock>
                            <TextBlock FontFamily="{DynamicResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                            <Run Text="host ." Foreground="{DynamicResource SyntaxCyanBrush}"/>
                            <Run Text="                # Open project from current directory"/>
                            </TextBlock>
                            <TextBlock FontFamily="{DynamicResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                            <Run Text="host /Users/me/MyProject" Foreground="{DynamicResource SyntaxCyanBrush}"/>
                            <Run Text="   # Open specific project"/>
                            </TextBlock>
                            <TextBlock FontFamily="{DynamicResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                            <Run Text="host -w /Users/me/Path" Foreground="{DynamicResource SyntaxCyanBrush}"/>
                            <Run Text="     # Using named argument"/>
                            </TextBlock>
                            <TextBlock FontFamily="{DynamicResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                            <Run Text="host -multi" Foreground="{DynamicResource SyntaxCyanBrush}"/>
                            <Run Text="         # Allow multiple instances"/>
                            </TextBlock>
                            <TextBlock FontFamily="{DynamicResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                            <Run Text="host -data path" Foreground="{DynamicResource SyntaxCyanBrush}"/>
                            <Run Text="     # Override config path"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Paths Section -->
                    <TextBlock Text="Important Paths" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Config file:" Foreground="{DynamicResource SyntaxLightBlueBrush}" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="~/Library/Application Support/TerminalHost/config.json" Foreground="{DynamicResource SyntaxOrangeBrush}" FontFamily="{DynamicResource FontFamilyMonospace}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundMediumBrush}" Padding="16,10" CornerRadius="0,0,8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                           Foreground="{DynamicResource TextDimmedBrush}"
                           FontSize="{DynamicResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Text="Press Escape or F1 to close"/>
                    <TextBlock Foreground="{DynamicResource TextDimmedBrush}"
                           FontSize="{DynamicResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Text="TerminalHost v1.0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>