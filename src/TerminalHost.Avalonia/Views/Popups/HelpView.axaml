<UserControl x:Class="TerminalHost.Views.Popups.HelpView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="700" d:DesignHeight="500">
    <Border Background="{DynamicResource BackgroundDarkBrush}"
        BorderBrush="{DynamicResource AccentPrimaryBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Margin="10"
        MinWidth="700"
        MaxWidth="900"
        MaxHeight="850"
        BoxShadow="0 5 20 0 #80000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="8,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                        Content="x"
                        Classes="TabCloseButton"
                        Command="{Binding CloseHelpCommand}"
                        FontSize="{DynamicResource FontSizeHeader}"
                        Padding="8,2">
                        <AutomationProperties.Name>Close Help</AutomationProperties.Name>
                    </Button>
                    <TextBlock Text="TerminalHost Help"
                           Foreground="{DynamicResource TextBrightBrush}"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel Margin="10">
                    <!-- Keyboard Shortcuts Section -->
                    <TextBlock Text="Keyboard Shortcuts" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Shortcut Sections (data-driven) -->
                    <ItemsControl ItemsSource="{Binding HelpShortcutSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SyntaxLightBlueBrush}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Shortcut}" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quick Commands Section (data-driven) -->
                    <ItemsControl ItemsSource="{Binding HelpQuickCommandSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,16">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Shortcut}" Foreground="{DynamicResource SyntaxOrangeBrush}" Margin="0,2"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tips Section -->
                    <TextBlock Text="Tips" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="* " Foreground="{DynamicResource SyntaxBlueBrush}"/><Run Text="Drag tabs to reorder them"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="* " Foreground="{DynamicResource SyntaxBlueBrush}"/><Run Text="Use the splitter between terminals to adjust the split ratio (saved per directory)"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="* " Foreground="{DynamicResource SyntaxBlueBrush}"/><Run Text="File preview supports syntax highlighting for: JSON, C#, JavaScript/TypeScript, Python, XML, Markdown, CSV/TSV"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <Run Text="* " Foreground="{DynamicResource SyntaxBlueBrush}"/><Run Text="Configure custom link patterns in Settings to make ticket IDs clickable"/>
                    </TextBlock>

                    <!-- Command Line Section -->
                    <TextBlock Text="Command Line Usage" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <Border Background="{DynamicResource BackgroundDarkestBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding HelpCommandLineExamples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{DynamicResource FontFamilyMonospace}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2">
                                        <Run Text="{Binding Command}" Foreground="{DynamicResource SyntaxCyanBrush}"/>
                                        <Run Text="   # "/>
                                        <Run Text="{Binding Description}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Paths Section -->
                    <TextBlock Text="Important Paths" Foreground="{DynamicResource SyntaxCyanBrush}" FontSize="{DynamicResource FontSizeNormal}" FontWeight="SemiBold" Margin="0,8,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Config file:" Foreground="{DynamicResource SyntaxLightBlueBrush}" Margin="0,2"/>
                        <TextBlock Grid.Column="1" Text="{Binding HelpConfigPath}" Foreground="{DynamicResource SyntaxOrangeBrush}" FontFamily="{DynamicResource FontFamilyMonospace}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundMediumBrush}" Padding="16,10" CornerRadius="0,0,8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                           Foreground="{DynamicResource TextDimmedBrush}"
                           FontSize="{DynamicResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Text="Press Escape or F1 to close"/>
                    <TextBlock Foreground="{DynamicResource TextDimmedBrush}"
                           FontSize="{DynamicResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Text="TerminalHost v1.0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
