<UserControl x:Class="TerminalHost.Views.Popups.FileHistoryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             d:DataContext="{d:DesignInstance viewModels:FileHistoryViewModel}"
             mc:Ignorable="d"
             IsVisible="{Binding IsOpen}">

    <!-- Overlay panel centered in parent -->
    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{StaticResource BackgroundDarkBrush}"
                BorderBrush="{StaticResource SyntaxCyanBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                Width="1000"
                Height="700"
                BoxShadow="0 5 20 0 #80000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="x"
                                Classes="TabCloseButton"
                                Command="{Binding CloseCommand}"
                                FontSize="{StaticResource FontSizeLarge}"
                                Padding="8,2"/>
                        <Button DockPanel.Dock="Right"
                                Content="Refresh"
                                Classes="TerminalSwitchButton"
                                Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Refresh history"
                                Margin="0,0,8,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" FontSize="{StaticResource FontSizeNormal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="File History - "
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FileName}"
                                       Foreground="{StaticResource SyntaxCyanBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content: Split view with commits and diff -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Commits list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="CommitsList"
                                 Grid.Row="0"
                                 ItemsSource="{Binding Commits}"
                                 SelectedItem="{Binding SelectedCommit, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="domain:GitCommit">
                                    <Grid Margin="12,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Short hash -->
                                        <Border Grid.Row="0" Grid.Column="0"
                                                Background="{StaticResource SyntaxCyanBrush}"
                                                CornerRadius="3"
                                                Padding="4,2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortHash}"
                                                       Foreground="{StaticResource BackgroundDarkBrush}"
                                                       FontSize="{StaticResource FontSizeTiny}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontWeight="Bold"/>
                                        </Border>

                                        <!-- Subject -->
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Subject}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <!-- Relative date -->
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding RelativeDate}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>

                                        <!-- Author -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding AuthorName}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Margin="0,2,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>

                        <!-- Load more button -->
                        <Button Grid.Row="1"
                                Content="Load More"
                                Classes="TerminalSwitchButton"
                                Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding HasMoreCommits}"
                                HorizontalAlignment="Stretch"
                                Margin="8,4"/>
                    </Grid>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BorderSubtleBrush}"/>

                    <!-- Diff viewer -->
                    <Border Grid.Column="2" Background="{StaticResource BackgroundDarkestBrush}">
                        <Grid>
                            <!-- Diff content -->
                            <controls:DiffViewer DiffText="{Binding FileDiff}"
                                                 IsVisible="{Binding SelectedCommit, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                            <!-- No selection message -->
                            <TextBlock Text="Select a commit to view changes"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedCommit, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copy Hash"
                                    Classes="TerminalSwitchButton"
                                    Command="{Binding CopyHashCommand}"
                                    ToolTip.Tip="Copy commit hash to clipboard"
                                    Margin="0,0,4,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Commits.Count, StringFormat='{}{0} commits'}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>