<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             xmlns:core="clr-namespace:TerminalHost.Core.Interfaces;assembly=TerminalHost.Core"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="TerminalHost.Views.Panels.DebugLogPanelView"
             x:DataType="vm:DebugLogViewModel">

  <controls:DraggablePopup
      IsOpen="{Binding IsOpen, Mode=TwoWay}"
      PopupWidth="{Binding Width, Mode=TwoWay}"
      PopupHeight="{Binding Height, Mode=TwoWay}"
      HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
      VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}"
      Title="🐛 Debug Log"
      CloseCommand="{Binding CloseCommand}">

    <controls:DraggablePopup.HeaderRightContent>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Content="Clear" Command="{Binding ClearLogCommand}" Classes="TerminalSwitchButton"/>
        <Button Content="↻ Refresh" Command="{Binding RefreshCommand}" Classes="TerminalSwitchButton"/>
      </StackPanel>
    </controls:DraggablePopup.HeaderRightContent>

    <controls:DraggablePopup.PopupContent>
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- Filter row -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding FilterText, Mode=TwoWay}"
                     Watermark="Filter..."
                     Width="220"
                     FontFamily="{StaticResource FontFamilyMonospace}"/>
            <CheckBox Content="Info" IsChecked="{Binding ShowInfo}"
                      Foreground="#94A3B8" VerticalAlignment="Center"/>
            <CheckBox Content="Warn" IsChecked="{Binding ShowWarnings}"
                      Foreground="#E5C07B" VerticalAlignment="Center"/>
            <CheckBox Content="Error" IsChecked="{Binding ShowErrors}"
                      Foreground="#E06C75" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Entries -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Entries}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="core:DebugLogEntry">
              <TextBlock FontFamily="{StaticResource FontFamilyMonospace}"
                         FontSize="12"
                         Padding="8,2"
                         TextWrapping="NoWrap"
                         Foreground="#94A3B8">
                <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}', Mode=OneTime}" Foreground="#64748B"/>
                <Run Text=" [" Foreground="#64748B"/><Run Text="{Binding Source, Mode=OneTime}" Foreground="#61AFEF"/><Run Text="] " Foreground="#64748B"/>
                <Run Text="{Binding Message, Mode=OneTime}"/>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
          <TextBlock Foreground="#64748B" FontSize="11">
            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
            <Run Text=" entries"/>
          </TextBlock>
        </Border>
      </Grid>
    </controls:DraggablePopup.PopupContent>
  </controls:DraggablePopup>
</UserControl>
