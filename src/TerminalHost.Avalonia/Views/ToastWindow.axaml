<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TerminalHost.Views"
        x:Class="TerminalHost.Views.ToastWindow"
        Title="Toasts"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CanResize="False"
        Width="420"
        Height="400">
    <!-- Toast container positioned at bottom-right -->
    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,16">
        <views:ToastContainerView x:Name="ToastContainer"/>
    </Grid>
</Window>