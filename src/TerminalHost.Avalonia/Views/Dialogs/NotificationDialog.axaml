<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TerminalHost.Views.Dialogs.NotificationDialog"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="350"
        MaxWidth="500">
    <Border Background="{DynamicResource BackgroundDarkBrush}"
            BorderBrush="{DynamicResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6"
            BoxShadow="0 5 20 0 #80000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="6,6,0,0"
                    PointerPressed="Header_PointerPressed"
                    Cursor="SizeAll">
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource TextBrightBrush}"
                           FontSize="{StaticResource FontSizeNormal}"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource FontFamilyStandard}"/>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <TextBlock x:Name="IconText"
                           Grid.Column="0"
                           FontSize="32"
                           VerticalAlignment="Top"
                           Margin="0,0,16,0"/>

                <!-- Message -->
                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeCode}"
                           FontFamily="{StaticResource FontFamilyStandard}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           MaxWidth="380"/>
            </Grid>

            <!-- Footer with Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Yes Button -->
                    <Button x:Name="YesButton"
                            Content="Yes"
                            Click="YesButton_Click"
                            IsVisible="False"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{DynamicResource AccentPrimaryBrush}"
                            Foreground="{DynamicResource TextBrightBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            CornerRadius="4">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                    <!-- No Button -->
                    <Button x:Name="NoButton"
                            Content="No"
                            Click="NoButton_Click"
                            IsVisible="False"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{DynamicResource BackgroundLightBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            CornerRadius="4">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BackgroundActiveBrush}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BackgroundActiveBrush}"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                    <!-- OK Button -->
                    <Button x:Name="OKButton"
                            Content="OK"
                            Click="OKButton_Click"
                            IsVisible="False"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{DynamicResource AccentPrimaryBrush}"
                            Foreground="{DynamicResource TextBrightBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            CornerRadius="4">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Style>
                        </Button.Styles>
                    </Button>

                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="CancelButton_Click"
                            IsVisible="False"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{DynamicResource BackgroundLightBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand"
                            CornerRadius="4">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BackgroundActiveBrush}"/>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource BackgroundActiveBrush}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>