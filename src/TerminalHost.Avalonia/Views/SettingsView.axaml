<UserControl x:Class="TerminalHost.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="using:System"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:conv="using:TerminalHost.Converters"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Domain"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundDarkestBrush}">
    <UserControl.Styles>
        <!-- Note: WPF Style.Triggers have been removed. -->
        <!-- In Avalonia, use separate Style elements with Selector="ControlType.ClassName:pseudoclass" -->
        <!-- Example: <Style Selector="Button:pointerover"> for hover effects -->
        <!-- Settings Toolbar Button Style -->
        <Style Selector="Button.SettingsToolbarButton">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.SettingsToolbarButton:pointerover">
            <Setter Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        </Style>

        <!-- Mode Toggle Button Style (RadioButton look) -->
        <Style Selector="RadioButton.ModeToggleButton">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="RadioButton.ModeToggleButton:checked">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
        </Style>
        <Style Selector="RadioButton.ModeToggleButton:pointerover:not(:checked)">
            <Setter Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
        </Style>

        <!-- Sidebar Item Button Style -->
        <Style Selector="RadioButton.SidebarItemButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="RadioButton.SidebarItemButton:checked">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        </Style>
        <Style Selector="RadioButton.SidebarItemButton:pointerover:not(:checked)">
            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Form TextBox Style -->
        <Style Selector="TextBox.FormTextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCode}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Form CheckBox Style -->
        <Style Selector="CheckBox.FormCheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Section Header Style -->
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Section Description Style -->
        <Style Selector="TextBlock.SectionDescription">
            <Setter Property="Foreground" Value="{StaticResource TextDimmedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>

        <!-- Field Label Style -->
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Help Text Style -->
        <Style Selector="TextBlock.HelpText">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
        </Style>

        <!-- Hyperlink Button Style -->
        <Style Selector="Button.HyperlinkButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.HyperlinkButton:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style Selector="ComboBox.DarkComboBox">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCode}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding ItemTemplate}"
                                                Margin="{TemplateBinding Padding}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                IsHitTestVisible="False"/>
                                <Path Grid.Column="1"
                                      Data="M0,0 L4,4 L8,0"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       IsLightDismissEnabled="True">
                                    <Border Background="{StaticResource BackgroundMediumBrush}"
                                            BorderBrush="{StaticResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            MinWidth="{Binding $parent[ComboBox].Bounds.Width}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer Margin="4,6">
                                            <ItemsPresenter x:Name="PART_ItemsPresenter"
                                                            ItemsPanel="{TemplateBinding ItemsPanel}"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="ComboBox.DarkComboBox:pointerover /template/ Border#RootBorder">
            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style Selector="ComboBoxItem.DarkComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="ComboBoxItem.DarkComboBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem.DarkComboBoxItem:pointerover:not(:selected)">
            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Bool to Visibility Converter -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- View Mode to Visibility Converters -->
        <conv:ViewModeToVisibilityConverter x:Key="RichModeVisibility" TargetMode="Rich"/>
        <conv:ViewModeToVisibilityConverter x:Key="RawModeVisibility" TargetMode="Raw"/>

        <!-- View Mode Converter -->
        <conv:ViewModeConverter x:Key="ViewModeConverter"/>

        <!-- Section Converter -->
        <conv:SectionConverter x:Key="SectionConverter"/>

        <!-- Section to Visibility Converter -->
        <conv:SectionToVisibilityConverter x:Key="SectionVisibility"/>

        <!-- Layout Mode Converter -->
        <conv:LayoutModeConverter x:Key="LayoutModeConverter"/>

        <!-- Null to Visibility Converter -->
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
            <DockPanel>
                <!-- Mode Toggle (Left) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton Content="Rich"
                                 GroupName="ViewMode"
                                 Classes="ModeToggleButton"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeConverter}, ConverterParameter=Rich}"
                                 Name="RichModeButton"
                                 Margin="0,0,2,0"/>
                    <RadioButton Content="Raw"
                                 GroupName="ViewMode"
                                 Classes="ModeToggleButton"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeConverter}, ConverterParameter=Raw}"
                                 Name="RawModeButton"
                                 Margin="0,0,12,0"/>

                    <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,2,12,2"/>

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Name="SaveButton"
                            Classes="SettingsToolbarButton"
                            Margin="0,0,4,0"/>
                    <Button Content="Reload"
                            Command="{Binding ReloadCommand}"
                            Classes="SettingsToolbarButton"
                            Margin="0,0,4,0"/>
                </StackPanel>

                <TextBlock Text="config.json"
                           Foreground="{StaticResource TextDimmedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeSmall}"/>
            </DockPanel>
        </Border>

        <!-- Rich Mode Content -->
        <Grid Grid.Row="1" IsVisible="{Binding ViewMode, Converter={StaticResource RichModeVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                <StackPanel Margin="0,8,0,0">
                    <RadioButton Content="General"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=General}"/>
                    <RadioButton Content="Terminals"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=Terminals}"/>
                    <RadioButton Content="AI Assistants"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=AiAssistants}"/>
                    <RadioButton Content="Profiles"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=Profiles}"/>
                    <RadioButton Content="Quick Commands"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=QuickCommands}"/>
                    <RadioButton Content="Link Patterns"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=LinkPatterns}"/>
                    <RadioButton Content="Project Types"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=ProjectTypes}"/>
                    <RadioButton Content="Claude Commands"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=ClaudeCommands}"/>
                    <RadioButton Content="Directory Settings"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=DirectorySettings}"/>
                    <RadioButton Content="API &amp; Webhooks"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=ApiWebhooks}"/>
                    <RadioButton Content="Status Overlay"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=StatusOverlay}"/>
                    <RadioButton Content="Channels"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=Channels}"/>
                    <RadioButton Content="Containers"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=Containers}"/>
                    <RadioButton Content="Memory"
                                 GroupName="SettingsSection"
                                 Classes="SidebarItemButton"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=Memory}"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- General Settings Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=General}">
                        <TextBlock Text="General Settings" Classes="SectionHeader"/>
                        <TextBlock Text="Application behavior and appearance settings." Classes="SectionDescription"/>

                        <CheckBox Content="Confirm before closing window"
                                  IsChecked="{Binding ConfirmOnClose}"
                                  Classes="FormCheckBox"
                                  ToolTip.Tip="When enabled, shows a confirmation dialog before closing the application."/>
                        <TextBlock Text="Shows a confirmation dialog when closing the application with active terminals."
                                   Classes="HelpText"/>

                        <CheckBox Content="Show icon in system tray"
                                  IsChecked="{Binding ShowInSystemTray}"
                                  Classes="FormCheckBox"
                                  ToolTip.Tip="Minimizes to system tray instead of taskbar."/>
                        <TextBlock Text="When enabled, the application minimizes to the system tray instead of the taskbar."
                                   Classes="HelpText"/>

                        <TextBlock Text="WORKSPACE SORT MODE"
                                   Classes="FieldLabel"
                                   Margin="0,12,0,4"/>
                        <ComboBox SelectedIndex="{Binding WorkspaceSortModeIndex}"
                                  Width="260"
                                  HorizontalAlignment="Left"
                                  Background="{DynamicResource BackgroundLightBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  ToolTip.Tip="How workspaces are sorted in the sidebar.">
                            <ComboBox.Items>
                                <system:String>Manual (drag to reorder)</system:String>
                                <system:String>By Usage (recent activity)</system:String>
                                <system:String>Alphabetical (A-Z)</system:String>
                            </ComboBox.Items>
                        </ComboBox>
                        <TextBlock Text="Manual: drag workspaces to reorder. Usage: sorted by focus time + activity from last 7 days. Alphabetical: sorted A-Z by name."
                                   Classes="HelpText"/>

                        <TextBlock Text="GIT TRACKING MODE"
                                   Classes="FieldLabel"
                                   Margin="0,12,0,4"/>
                        <ComboBox SelectedIndex="{Binding GitTrackingModeIndex}"
                                  Width="260"
                                  HorizontalAlignment="Left"
                                  Background="{DynamicResource BackgroundLightBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  ToolTip.Tip="Controls background git status tracking for workspaces.">
                            <ComboBox.Items>
                                <system:String>All workspaces (fetch + status)</system:String>
                                <system:String>Current workspace only</system:String>
                                <system:String>Disabled (manual refresh only)</system:String>
                            </ComboBox.Items>
                        </ComboBox>
                        <TextBlock Text="All: periodically fetches and refreshes git status for every workspace. Current only: only tracks the selected tab. Disabled: no background git activity."
                                   Classes="HelpText"/>

                        <CheckBox Content="Touch-friendly mode"
                                  IsChecked="{Binding TouchMode}"
                                  Classes="FormCheckBox"
                                  ToolTip.Tip="Enable larger touch targets for mobile remote desktop usage."/>
                        <TextBlock Text="When enabled, UI elements have larger touch targets and more padding for easier use on touch devices or remote desktop from mobile."
                                   Classes="HelpText"/>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16,0,16"/>

                        <!-- Git Auto-fetch -->
                        <TextBlock Text="GIT AUTO-FETCH"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <CheckBox Content="Automatically fetch from git remotes"
                                  IsChecked="{Binding GitAutoFetch}"
                                  Classes="FormCheckBox"
                                  ToolTip.Tip="Periodically fetches from all git remotes to keep behind counts up to date."/>
                        <TextBlock Text="When enabled, automatically fetches from git remotes in the background to keep behind/ahead counts current."
                                   Classes="HelpText"/>

                        <Grid ColumnDefinitions="Auto,100,*" Margin="0,8,0,0"
                              IsEnabled="{Binding GitAutoFetch}">
                            <TextBlock Grid.Column="0"
                                       Text="Fetch interval (seconds):"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <NumericUpDown Grid.Column="1"
                                           Value="{Binding GitAutoFetchIntervalSeconds}"
                                           Minimum="30"
                                           Maximum="600"
                                           Increment="10"
                                           FormatString="0"
                                           ToolTip.Tip="Interval between automatic fetches (30-600 seconds)"/>
                        </Grid>
                        <TextBlock Text="How often to fetch from remotes (minimum 30 seconds, maximum 10 minutes)."
                                   Classes="HelpText"/>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16,0,16"/>

                        <!-- Custom Paths -->
                        <TextBlock Text="CUSTOM PATH ENTRIES"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Additional directories to add to the terminal PATH environment variable. Useful for tools like .NET SDK, Python, etc."
                                   Classes="SectionDescription"
                                   Margin="0,0,0,12"/>

                        <!-- Path toolbar -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Browse..."
                                    Classes="SettingsToolbarButton"
                                    Margin="0,0,4,0"
                                    Click="BrowseCustomPath_Click"/>
                            <Button Content="+ Add"
                                    Classes="SettingsToolbarButton"
                                    Command="{Binding AddCustomPathCommand}"
                                    Margin="0,0,4,0"/>
                            <Button Content="- Remove"
                                    Classes="SettingsToolbarButton"
                                    Command="{Binding RemoveCustomPathCommand}"
                                    IsEnabled="{Binding SelectedCustomPath, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </StackPanel>

                        <!-- Path list -->
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="0"
                                Height="120">
                            <ListBox ItemsSource="{Binding CustomPaths}"
                                     SelectedItem="{Binding SelectedCustomPath}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontSize="{StaticResource FontSizeCode}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Padding="8,4"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- New path input -->
                        <TextBox Text="{Binding NewCustomPath}"
                                 Classes="FormTextBox"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 Watermark="Enter path (e.g., /usr/local/share/dotnet)"
                                 Margin="0,8,0,0"/>
                        <TextBlock Text="Paths are added in order, with earlier entries taking priority. Changes take effect for new terminals."
                                   Classes="HelpText"/>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16,0,16"/>

                        <!-- Sound Notifications -->
                        <TextBlock Text="SOUND NOTIFICATIONS"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <CheckBox Content="Enable sound notifications"
                                  IsChecked="{Binding SoundsEnabled}"
                                  Classes="FormCheckBox"
                                  ToolTip.Tip="Play sounds for toast notifications."/>
                        <TextBlock Text="Play audio notifications for success, error, and warning messages."
                                   Classes="HelpText"/>

                        <CheckBox Content="Only when app is unfocused"
                                  IsChecked="{Binding SoundsOnlyWhenUnfocused}"
                                  Classes="FormCheckBox"
                                  IsEnabled="{Binding SoundsEnabled}"
                                  ToolTip.Tip="Only play sounds when you're not looking at the app."/>
                        <TextBlock Text="Sounds will only play when the TerminalHost window is not focused, so you get notified while working in other apps."
                                   Classes="HelpText"/>

                        <Grid Margin="0,8,0,0" IsEnabled="{Binding SoundsEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*" MaxWidth="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Success:" Grid.Row="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding SoundOptions}"
                                      SelectedItem="{Binding SuccessSound}"
                                      Classes="DarkComboBox"
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="Error:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding SoundOptions}"
                                      SelectedItem="{Binding ErrorSound}"
                                      Classes="DarkComboBox"
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="Warning:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding SoundOptions}"
                                      SelectedItem="{Binding WarningSound}"
                                      Classes="DarkComboBox"
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="Info:" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="3" Grid.Column="1"
                                      ItemsSource="{Binding SoundOptions}"
                                      SelectedItem="{Binding InfoSound}"
                                      Classes="DarkComboBox"
                                      Margin="0,0,0,8"/>

                            <TextBlock Text="Input Waiting:" Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Row="4" Grid.Column="1"
                                      ItemsSource="{Binding SoundOptions}"
                                      SelectedItem="{Binding InputWaitingSound}"
                                      Classes="DarkComboBox"/>
                        </Grid>
                        <TextBlock Text="Sound names map to platform sounds: macOS uses system sounds (Glass, Tink, Funk, Basso, Purr), Linux uses freedesktop theme sounds. You can also enter a path to a sound file."
                                   Classes="HelpText"/>

                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16,0,16"/>

                        <!-- Voice Command Settings -->
                        <TextBlock Text="VOICE COMMANDS"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <CheckBox Content="Enable voice commands"
                                  IsChecked="{Binding VoiceEnabled}"
                                  Classes="FormCheckBox"
                                  ToolTip.Tip="Enable hands-free control of TerminalHost using voice commands (F4)."/>
                        <TextBlock Text="Press F4 to start/stop listening. Speak command names (e.g. 'git changes', 'settings') or say 'send to claude: ...' to type text into the AI terminal."
                                   Classes="HelpText"/>

                        <CheckBox Content="Show transcript overlay"
                                  IsChecked="{Binding VoiceShowTranscript}"
                                  Classes="FormCheckBox"
                                  IsEnabled="{Binding VoiceEnabled}"
                                  ToolTip.Tip="Show a floating bar with recognized speech text and matched command."/>
                        <TextBlock Text="Displays a floating bar at the top showing what was heard, matched command preview, and countdown before execution."
                                   Classes="HelpText"/>

                        <CheckBox Content="Feedback sounds"
                                  IsChecked="{Binding VoiceFeedbackSounds}"
                                  Classes="FormCheckBox"
                                  IsEnabled="{Binding VoiceEnabled}"
                                  ToolTip.Tip="Play audio feedback when listening starts/stops and commands execute."/>
                        <TextBlock Text="Audible feedback when voice listening starts, stops, or a command is recognized."
                                   Classes="HelpText"/>

                        <TextBlock Text="WHISPER MODEL" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <ComboBox SelectedIndex="{Binding VoiceWhisperModelSizeIndex}"
                                  IsEnabled="{Binding VoiceEnabled}"
                                  Classes="DarkComboBox">
                            <ComboBoxItem Content="Tiny (~75 MB) — fastest, lower accuracy"/>
                            <ComboBoxItem Content="Base (~142 MB) — good for simple commands"/>
                            <ComboBoxItem Content="Small (~466 MB) — excellent accuracy (recommended)"/>
                            <ComboBoxItem Content="Medium (~1.5 GB) — high accuracy, slower on CPU"/>
                            <ComboBoxItem Content="Large V3 (~3 GB) — highest accuracy, requires significant RAM"/>
                        </ComboBox>
                        <TextBlock Text="Larger models are more accurate but use more memory and take longer to process. The Small model is recommended for most users. Model is downloaded on first use."
                                   Classes="HelpText"/>

                        <TextBlock Text="LANGUAGE" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <ComboBox SelectedIndex="{Binding VoiceWhisperLanguageIndex}"
                                  IsEnabled="{Binding VoiceEnabled}"
                                  Classes="DarkComboBox">
                            <ComboBoxItem Content="Auto-detect"/>
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Dutch"/>
                            <ComboBoxItem Content="German"/>
                            <ComboBoxItem Content="French"/>
                            <ComboBoxItem Content="Spanish"/>
                            <ComboBoxItem Content="Italian"/>
                            <ComboBoxItem Content="Portuguese"/>
                            <ComboBoxItem Content="Japanese"/>
                            <ComboBoxItem Content="Chinese"/>
                            <ComboBoxItem Content="Korean"/>
                            <ComboBoxItem Content="Russian"/>
                        </ComboBox>
                        <TextBlock Text="Set a specific language for better accuracy, or use Auto-detect for mixed-language use. Auto-detect works well with the Small model and above."
                                   Classes="HelpText"/>

                        <TextBlock Text="CONFIDENCE THRESHOLD" Classes="FieldLabel" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding VoiceEnabled}">
                            <Slider Width="200"
                                    Minimum="0.3" Maximum="1.0"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding VoiceConfidenceThreshold}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding VoiceConfidenceThreshold, StringFormat={}{0:P0}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Minimum confidence required to match a command. Lower values match more loosely; higher values require closer matches. Commands below threshold show alternatives instead."
                                   Classes="HelpText"/>

                    </StackPanel>

                    <!-- Terminal Settings Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Terminals}">
                        <TextBlock Text="Terminal Settings" Classes="SectionHeader"/>
                        <TextBlock Text="Configure the custom terminal and shell terminal commands." Classes="SectionDescription"/>

                        <!-- Custom Terminal -->
                        <TextBlock Text="CUSTOM TERMINAL"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Command" Classes="FieldLabel"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CustomCommand}"
                                     Classes="FormTextBox"
                                     FontFamily="{StaticResource FontFamilyMonospace}"/>
                            <Button Grid.Column="1" Content="Browse..."
                                    Classes="SettingsToolbarButton"
                                    Margin="8,0,0,0"
                                    Click="BrowseCustomCommand_Click"/>
                        </Grid>
                        <TextBlock Text="Path to the custom terminal executable. Environment variables like %USERPROFILE% are supported."
                                   Classes="HelpText"/>

                        <TextBlock Text="Display Name" Classes="FieldLabel"/>
                        <TextBox Text="{Binding CustomCommandName}"
                                 Classes="FormTextBox"
                                 Width="300"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Text="The name shown in tabs and UI elements."
                                   Classes="HelpText"/>

                        <TextBlock Text="Icon" Classes="FieldLabel"/>
                        <TextBox Text="{Binding CustomCommandIcon}"
                                 Classes="FormTextBox"
                                 Width="60"
                                 HorizontalAlignment="Left"
                                 FontSize="{StaticResource FontSizeLarge}"/>
                        <TextBlock Text="Single emoji character displayed in the tab."
                                   Classes="HelpText"/>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,24"/>

                        <!-- Shell Terminal -->
                        <TextBlock Text="SHELL TERMINAL"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Command" Classes="FieldLabel"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ShellCommand}"
                                     Classes="FormTextBox"
                                     FontFamily="{StaticResource FontFamilyMonospace}"/>
                            <Button Grid.Column="1" Content="Browse..."
                                    Classes="SettingsToolbarButton"
                                    Margin="8,0,0,0"
                                    Click="BrowseShellCommand_Click"/>
                        </Grid>
                        <TextBlock Text="Path to the shell executable (e.g., pwsh.exe, cmd.exe)."
                                   Classes="HelpText"/>

                        <TextBlock Text="Display Name" Classes="FieldLabel"/>
                        <TextBox Text="{Binding ShellCommandName}"
                                 Classes="FormTextBox"
                                 Width="300"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Text="The name shown in tabs and UI elements."
                                   Classes="HelpText"/>

                        <TextBlock Text="Icon" Classes="FieldLabel"/>
                        <TextBox Text="{Binding ShellCommandIcon}"
                                 Classes="FormTextBox"
                                 Width="60"
                                 HorizontalAlignment="Left"
                                 FontSize="{StaticResource FontSizeLarge}"/>
                        <TextBlock Text="Single emoji character displayed in the tab."
                                   Classes="HelpText"/>
                    </StackPanel>

                    <!-- AI Assistants Section -->
                    <Grid Margin="24"
                          IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=AiAssistants}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="AI Assistants" Classes="SectionHeader"/>
                        <TextBlock Grid.Row="1" Text="Configure AI CLI assistants. Enabled assistants appear in the toolbar dropdown for per-project selection." Classes="SectionDescription"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: AI Assistant List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddAiAssistantCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    ToolTip.Tip="Add a new AI assistant"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="Reset"
                                                    Command="{Binding ResetAiAssistantsCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    ToolTip.Tip="Reset to default AI assistants"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- AI Assistant List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding AiAssistants}"
                                             SelectedItem="{Binding SelectedAiAssistant}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}"
                                                               Classes="iconText"
                                                               Margin="0,0,4,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                                        <TextBlock Text="{Binding Command}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Border Background="{StaticResource StatusSuccessBrush}"
                                                                CornerRadius="2"
                                                                Padding="4,1"
                                                                Margin="4,0,0,0"
                                                                IsVisible="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="Default"
                                                                       Foreground="{StaticResource TextBrightBrush}"
                                                                       FontSize="{StaticResource FontSizeTiny}"/>
                                                        </Border>
                                                        <Border Background="{StaticResource AccentPrimaryBrush}"
                                                                CornerRadius="2"
                                                                Padding="4,1"
                                                                Margin="4,0,0,0"
                                                                IsVisible="{Binding Enabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="Enabled"
                                                                       Foreground="{StaticResource TextBrightBrush}"
                                                                       FontSize="{StaticResource FontSizeTiny}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Form -->
                            <Border Grid.Column="2" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Edit AI Assistant"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                    <StackPanel IsVisible="{Binding SelectedAiAssistant, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="Name" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditAiName}"
                                                 Classes="FormTextBox"/>

                                        <TextBlock Text="Command" Classes="FieldLabel" Margin="0,12,0,0"/>
                                        <TextBox Text="{Binding EditAiCommand}"
                                                 Classes="FormTextBox"/>
                                        <TextBlock Text="The command to run (supports environment variables like %USERPROFILE%)"
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Icon" Classes="FieldLabel" Margin="0,12,0,0"/>
                                        <TextBox Text="{Binding EditAiIcon}"
                                                 Classes="FormTextBox"
                                                 Width="80"
                                                 HorizontalAlignment="Left"/>
                                        <TextBlock Text="Short text or emoji shown in the UI"
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Detection Command" Classes="FieldLabel" Margin="0,12,0,0"/>
                                        <TextBox Text="{Binding EditAiDetectionCommand}"
                                                 Classes="FormTextBox"/>
                                        <TextBlock Text="Command to check if this assistant is installed (e.g., 'claude --version')"
                                                   Classes="HelpText"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <CheckBox Content="Enabled"
                                                      IsChecked="{Binding EditAiEnabled}"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      VerticalContentAlignment="Center"/>
                                            <CheckBox Content="Default"
                                                      IsChecked="{Binding EditAiIsDefault}"
                                                      Foreground="{StaticResource TextPrimaryBrush}"
                                                      VerticalContentAlignment="Center"
                                                      Margin="16,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyAiAssistantCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Padding="16,6"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteAiAssistantCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Padding="16,6"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Select an AI assistant to edit"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontStyle="Italic"
                                               IsVisible="{Binding SelectedAiAssistant, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Profiles Section -->
                    <Grid Margin="24"
                          IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Profiles}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Profiles" Classes="SectionHeader"/>
                        <TextBlock Grid.Row="1" Text="Terminal profiles that can be launched from the + menu. Profiles with auto-start enabled will launch automatically when the application starts." Classes="SectionDescription"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Profile List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddProfileCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    ToolTip.Tip="Add a new profile"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveProfileUpCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="28"
                                                    ToolTip.Tip="Move up"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveProfileDownCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="28"
                                                    ToolTip.Tip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Profile List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Profiles}"
                                             SelectedItem="{Binding SelectedProfile}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                               Classes="iconText"/>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                                        <TextBlock Text="{Binding Command}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Background="{StaticResource StatusSuccessBrush}"
                                                            CornerRadius="2"
                                                            Padding="4,1"
                                                            Margin="4,0,0,0"
                                                            IsVisible="{Binding AutoStart, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Auto"
                                                                   Foreground="{StaticResource TextBrightBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Panel -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="16"
                                    IsVisible="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Edit Profile"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="Name" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditProfileName}"
                                                 Classes="FormTextBox"/>
                                        <TextBlock Text="Display name for the profile."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Command" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditProfileCommand}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="The command to execute (e.g., pwsh.exe, cmd.exe)."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Icon" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditProfileIcon}"
                                                 Classes="FormTextBox"
                                                 Width="60"
                                                 HorizontalAlignment="Left"
                                                 FontSize="{StaticResource FontSizeLarge}"/>
                                        <TextBlock Text="Single emoji character shown in menus."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Keyboard Shortcut" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditProfileShortcut}"
                                                 Classes="FormTextBox"
                                                 Width="200"
                                                 HorizontalAlignment="Left"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="e.g., Ctrl+Shift+P"
                                                   Classes="HelpText"/>
                                        <TextBlock Text="{Binding ProfileShortcutWarning}"
                                                   IsVisible="{Binding ProfileShortcutWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="#FFA500"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>

                                        <CheckBox Content="Auto-start on application launch"
                                                  IsChecked="{Binding EditProfileAutoStart}"
                                                  Classes="FormCheckBox"/>
                                        <TextBlock Text="Automatically launch this profile when the app starts."
                                                   Classes="HelpText"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyProfileCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="80"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteProfileCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- No Selection State -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    IsVisible="{Binding SelectedProfile, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="Select a profile to edit"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Quick Commands Section -->
                    <Grid Margin="24"
                          IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=QuickCommands}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Quick Commands" Classes="SectionHeader"/>
                        <TextBlock Grid.Row="1" Text="Keyboard shortcuts to send commands to terminals." Classes="SectionDescription"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Command List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddQuickCommandCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    ToolTip.Tip="Add a new quick command"/>
                                            <Button Content="Reset"
                                                    Command="{Binding ResetQuickCommandsCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    ToolTip.Tip="Reset to default quick commands"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveQuickCommandUpCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="28"
                                                    ToolTip.Tip="Move up"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveQuickCommandDownCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="28"
                                                    ToolTip.Tip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Command List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding QuickCommands}"
                                             SelectedItem="{Binding SelectedQuickCommand}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                               Classes="iconText"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,0,0"/>
                                                    <Border Grid.Column="2"
                                                            Background="{StaticResource BackgroundLightBrush}"
                                                            CornerRadius="2"
                                                            Padding="4,1"
                                                            Margin="4,0,0,0"
                                                            IsVisible="{Binding Shortcut, Converter={StaticResource NullToCollapsedConverter}}">
                                                        <TextBlock Text="{Binding Shortcut}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Panel -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="16"
                                    IsVisible="{Binding SelectedQuickCommand, Converter={StaticResource NullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Edit Command"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="Label" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditQcLabel}"
                                                 Classes="FormTextBox"/>
                                        <TextBlock Text="Display name for the command button."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Icon" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditQcIcon}"
                                                 Classes="FormTextBox"
                                                 Width="60"
                                                 HorizontalAlignment="Left"
                                                 FontSize="{StaticResource FontSizeLarge}"/>
                                        <TextBlock Text="Single emoji or character shown on the button."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Command Text" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditQcText}"
                                                 Classes="FormTextBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="60"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="The text sent to the terminal when executed."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Target Terminal" Classes="FieldLabel"/>
                                        <ComboBox SelectedIndex="{Binding EditQcTargetIndex}"
                                                  Width="200"
                                                  HorizontalAlignment="Left"
                                                  Background="{DynamicResource BackgroundLightBrush}"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <ComboBox.Items>
                                                <system:String>Custom (Claude Code)</system:String>
                                                <system:String>Shell</system:String>
                                            </ComboBox.Items>
                                        </ComboBox>
                                        <TextBlock Text="Which terminal receives the command."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Keyboard Shortcut" Classes="FieldLabel"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto" HorizontalAlignment="Left" Width="340">
                                            <TextBox x:Name="ShortcutTextBox"
                                                     Grid.Column="0"
                                                     Text="{Binding EditQcShortcut}"
                                                     Classes="FormTextBox"
                                                     FontFamily="{StaticResource FontFamilyMonospace}"
                                                     IsReadOnly="{Binding IsCapturingShortcut}"
                                                     Watermark="{Binding IsCapturingShortcut, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Press keys...|Type or click Record'}"
                                                     KeyDown="ShortcutTextBox_KeyDown"/>
                                            <Button Grid.Column="1"
                                                    Content="{Binding IsCapturingShortcut, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Stop|Record'}"
                                                    Command="{Binding ToggleShortcutCaptureCommand}"
                                                    Click="RecordButton_Click"
                                                    Classes="SettingsToolbarButton"
                                                    Width="70"
                                                    Margin="4,0,0,0"
                                                    Background="{Binding IsCapturingShortcut, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#2196F3|#444444'}"/>
                                            <Button Grid.Column="2"
                                                    Content="Clear"
                                                    Command="{Binding ClearShortcutCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="70"
                                                    Margin="4,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="Click 'Record' and press the key combination, or type manually (e.g., Ctrl+Shift+C)"
                                                   Classes="HelpText"/>
                                        <TextBlock Text="{Binding QcShortcutWarning}"
                                                   IsVisible="{Binding QcShortcutWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="#FFA500"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>

                                        <CheckBox Content="Append newline after command"
                                                  IsChecked="{Binding EditQcAppendNewline}"
                                                  Classes="FormCheckBox"/>
                                        <TextBlock Text="Automatically sends Enter after the command text."
                                                   Classes="HelpText"/>

                                        <CheckBox Content="Use user input mode"
                                                  IsChecked="{Binding EditQcUseUserInput}"
                                                  Classes="FormCheckBox"/>
                                        <TextBlock Text="For apps like Claude Code that need key event handling."
                                                   Classes="HelpText"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyQuickCommandCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="80"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteQuickCommandCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- No Selection State -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    IsVisible="{Binding SelectedQuickCommand, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="Select a command to edit"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Link Patterns Section -->
                    <Grid Margin="24"
                          IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=LinkPatterns}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Link Patterns" Classes="SectionHeader"/>
                        <TextBlock Grid.Row="1" Text="Custom patterns to detect and linkify text in terminal output. Use regex capturing groups and URL templates with $1, $2, etc." Classes="SectionDescription"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Pattern List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddLinkPatternCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    ToolTip.Tip="Add a new link pattern"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveLinkPatternUpCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="28"
                                                    ToolTip.Tip="Move up (higher priority)"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveLinkPatternDownCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="28"
                                                    ToolTip.Tip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pattern List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding LinkPatterns}"
                                             SelectedItem="{Binding SelectedLinkPattern}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                                        <TextBlock Text="{Binding Pattern}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding Enabled}"
                                                              VerticalAlignment="Center"
                                                              ToolTip.Tip="Enabled"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Panel -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="16"
                                    IsVisible="{Binding SelectedLinkPattern, Converter={StaticResource NullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Edit Pattern"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="Name" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditLpName}"
                                                 Classes="FormTextBox"/>
                                        <TextBlock Text="Display name for this pattern (e.g., 'JIRA Ticket')."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Regex Pattern" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditLpPattern}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="Regular expression with capturing groups. Example: ([A-Z]+-\d+) for JIRA tickets."
                                                   Classes="HelpText"/>
                                        <TextBlock Text="{Binding RegexTestError}"
                                                   Foreground="{StaticResource StatusErrorBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   IsVisible="{Binding RegexTestIsValid, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Text="URL Template" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditLpUrlTemplate}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="URL with placeholders. Use $0 for full match, $1, $2, etc. for capture groups."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Priority" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditLpPriority}"
                                                 Classes="FormTextBox"
                                                 Width="80"
                                                 HorizontalAlignment="Left"/>
                                        <TextBlock Text="Higher values are matched first (0-100)."
                                                   Classes="HelpText"/>

                                        <CheckBox Content="Enabled"
                                                  IsChecked="{Binding EditLpEnabled}"
                                                  Classes="FormCheckBox"/>
                                        <TextBlock Text="Disable to temporarily turn off this pattern without deleting it."
                                                   Classes="HelpText"/>

                                        <!-- Regex Test Panel -->
                                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                                        <TextBlock Text="TEST PATTERN"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>

                                        <TextBlock Text="Test Input" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding RegexTestInput}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="Enter sample text to test your pattern."
                                                   Classes="HelpText"/>

                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="Match:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Margin="0,0,8,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding RegexTestMatch}"
                                                       Foreground="{StaticResource SyntaxGreenBrush}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontSize="{StaticResource FontSizeSmall}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="URL:"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding RegexTestUrl}"
                                                       Foreground="{StaticResource SyntaxCyanBrush}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       TextWrapping="Wrap"/>
                                        </Grid>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyLinkPatternCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="80"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteLinkPatternCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- No Selection State -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    IsVisible="{Binding SelectedLinkPattern, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="Select a pattern to edit or click + Add to create one"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Project Types Section -->
                    <Grid Margin="24"
                          IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=ProjectTypes}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Project Types" Classes="SectionHeader"/>
                        <TextBlock Grid.Row="1" Text="Auto-detection rules for project run configurations. Define file patterns to detect project types and their default run commands." Classes="SectionDescription"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Project Type List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddProjectTypeCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    ToolTip.Tip="Add a new project type"/>
                                            <Button Content="Reset"
                                                    Command="{Binding ResetProjectTypesCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    ToolTip.Tip="Reset to default project types"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveProjectTypeUpCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="28"
                                                    ToolTip.Tip="Move up"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveProjectTypeDownCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Width="28"
                                                    ToolTip.Tip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Project Type List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding ProjectTypes}"
                                             SelectedItem="{Binding SelectedProjectType}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                                        <TextBlock Text="{Binding DefaultCommand}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Priority}"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="{StaticResource FontSizeTiny}"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,0,0"
                                                               ToolTip.Tip="Priority"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Panel -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="16"
                                    IsVisible="{Binding SelectedProjectType, Converter={StaticResource NullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Edit Project Type"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="ID" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditPtId}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                                 Width="200"
                                                 HorizontalAlignment="Left"/>
                                        <TextBlock Text="Unique identifier (e.g., 'dotnet', 'nodejs', 'custom-react')."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Display Name" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditPtName}"
                                                 Classes="FormTextBox"/>
                                        <TextBlock Text="The name shown in the UI (e.g., '.NET', 'Node.js')."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Detection Files" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditPtDetectFiles}"
                                                 Classes="FormTextBox"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="80"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="File patterns to detect this project type (one per line). Supports wildcards like *.csproj, *.sln, package.json."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Default Run Command" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditPtDefaultCommand}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="Command to run the project (e.g., 'dotnet run', 'npm start')."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Watch Command (optional)" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditPtWatchCommand}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="Command for hot-reload development (e.g., 'dotnet watch run', 'npm run dev')."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="URL Pattern (optional)" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditPtUrlPattern}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="Regex to detect localhost URLs from output. Use capturing group for the URL."
                                                   Classes="HelpText"/>

                                        <TextBlock Text="Priority" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditPtPriority}"
                                                 Classes="FormTextBox"
                                                 Width="80"
                                                 HorizontalAlignment="Left"/>
                                        <TextBlock Text="Higher priority types are checked first (0-100)."
                                                   Classes="HelpText"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyProjectTypeCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="80"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteProjectTypeCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- No Selection State -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    IsVisible="{Binding SelectedProjectType, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="Select a project type to edit or click + Add to create one"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Claude Commands Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=ClaudeCommands}">
                        <TextBlock Text="Claude Commands" Classes="SectionHeader"/>
                        <StackPanel Orientation="Horizontal" Classes="SectionDescription">
                            <TextBlock Text="Keyboard shortcuts for Claude Code slash commands. "/>
                            <Button Content="View documentation →"
                                    Classes="HyperlinkButton"
                                    Tag="https://code.claude.com/docs/en/slash-commands#custom-slash-commands"
                                    Click="Hyperlink_Click"/>
                        </StackPanel>

                        <Border Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="HOW IT WORKS"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                                    <Run Text="Claude Code slash commands are " Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Run Text="auto-detected" Foreground="{StaticResource SyntaxYellowBrush}" FontWeight="SemiBold"/>
                                    <Run Text=" from .md files in:" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </TextBlock>

                                <StackPanel Margin="16,0,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="~/.claude/commands/"
                                                Classes="HyperlinkButton"
                                                Foreground="{StaticResource SyntaxCyanBrush}"
                                                FontFamily="{StaticResource FontFamilyMonospace}"
                                                FontSize="{StaticResource FontSizeCode}"
                                                Click="GlobalCommandsFolder_Click"/>
                                        <TextBlock Text=" (global commands)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content=".claude/commands/"
                                                Classes="HyperlinkButton"
                                                Foreground="{StaticResource SyntaxCyanBrush}"
                                                FontFamily="{StaticResource FontFamilyMonospace}"
                                                FontSize="{StaticResource FontSizeCode}"
                                                Click="ProjectCommandsFolder_Click"/>
                                        <TextBlock Text=" (project commands)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="You can assign keyboard shortcuts to these commands. Detected commands appear in the Command Palette (Ctrl+Shift+P)."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,12"/>

                                <TextBlock Text="ASSIGNING SHORTCUTS"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                                    <Run Text="To assign shortcuts, edit " Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text="settings.claudeCommandShortcuts" Foreground="{StaticResource SyntaxGreenBrush}" FontFamily="{StaticResource FontFamilyMonospace}"/>
                                    <Run Text=" in Raw mode:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>

                                <Border Background="{StaticResource BackgroundMediumBrush}" CornerRadius="3" Padding="12,8">
                                    <TextBlock FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="{StaticResource FontSizeCode}"
                                               Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text='"claudeCommandShortcuts": {' Foreground="{StaticResource SyntaxBlueBrush}"/>
                                        <LineBreak/>
                                        <Run Text='  "review-pr": "Ctrl+Alt+R",' Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <LineBreak/>
                                        <Run Text='  "commit": "Ctrl+Alt+C"' Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <LineBreak/>
                                        <Run Text="}" Foreground="{StaticResource SyntaxBlueBrush}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock TextWrapping="Wrap">
                            <Run Text="💡 Tip:" Foreground="{StaticResource SyntaxYellowBrush}" FontWeight="SemiBold"/>
                            <Run Text=" Create .md files in the commands folders to add your own slash commands. The filename becomes the command name." Foreground="{StaticResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Directory Settings Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=DirectorySettings}">
                        <TextBlock Text="Directory Settings" Classes="SectionHeader"/>
                        <TextBlock Text="Per-project configuration for layout, run configs, and file explorer. These settings are saved automatically when you adjust layouts." Classes="SectionDescription"/>

                        <!-- Directory Selector -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Directory:"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Directories}"
                                      SelectedItem="{Binding SelectedDirectory}"
                                      Background="{DynamicResource BackgroundLightBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      MaxWidth="500"
                                      HorizontalAlignment="Left"/>

                            <Button Grid.Column="2"
                                    Content="Delete"
                                    Command="{Binding DeleteDirectorySettingsCommand}"
                                    Classes="SettingsToolbarButton"
                                    Background="{StaticResource DangerBackgroundBrush}"
                                    Margin="8,0,0,0"
                                    ToolTip.Tip="Remove settings for this directory"/>
                        </Grid>

                        <!-- No Directories Message -->
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="4"
                                Padding="24"
                                IsVisible="{Binding SelectedDirectory, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No project directories with saved settings"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Open a project folder and adjust its layout to create settings."
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Directory Settings Editor -->
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="4"
                                Padding="16"
                                IsVisible="{Binding SelectedDirectory, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel>
                                <!-- Layout Settings -->
                                <TextBlock Text="LAYOUT"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="Terminal Layout" Classes="FieldLabel"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <RadioButton Content="Custom Only"
                                                 GroupName="LayoutMode"
                                                 Classes="ModeToggleButton"
                                                 IsChecked="{Binding EditDsLayoutMode, Converter={StaticResource LayoutModeConverter}, ConverterParameter=CustomFull}"
                                                 Margin="0,0,4,0"/>
                                    <RadioButton Content="Horizontal"
                                                 GroupName="LayoutMode"
                                                 Classes="ModeToggleButton"
                                                 IsChecked="{Binding EditDsLayoutMode, Converter={StaticResource LayoutModeConverter}, ConverterParameter=HorizontalSplit}"
                                                 Margin="0,0,4,0"/>
                                    <RadioButton Content="Vertical"
                                                 GroupName="LayoutMode"
                                                 Classes="ModeToggleButton"
                                                 IsChecked="{Binding EditDsLayoutMode, Converter={StaticResource LayoutModeConverter}, ConverterParameter=VerticalSplit}"/>
                                </StackPanel>
                                <TextBlock Text="How to arrange the Custom and Shell terminals."
                                           Classes="HelpText"/>

                                <TextBlock Text="Split Ratio" Classes="FieldLabel"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="0.2" Maximum="0.8"
                                            Value="{Binding EditDsSplitRatio}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EditDsSplitRatio, StringFormat='{}{0:P0}'}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="How much space the Custom terminal takes (in split mode)."
                                           Classes="HelpText"/>

                                <!-- Run Terminal Settings -->
                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                                <TextBlock Text="RUN TERMINAL"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <CheckBox Content="Show run terminal"
                                          IsChecked="{Binding EditDsShowRunTerminal}"
                                          Classes="FormCheckBox"
                                          Margin="0,0,0,0"/>
                                <TextBlock Text="Show a third terminal for running development servers (F5)."
                                           Classes="HelpText"/>

                                <TextBlock Text="Run Terminal Size" Classes="FieldLabel"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="0.15" Maximum="0.5"
                                            Value="{Binding EditDsRunSplitRatio}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EditDsRunSplitRatio, StringFormat='{}{0:P0}'}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="How much horizontal space the run terminal takes."
                                           Classes="HelpText"/>

                                <!-- File Explorer Settings -->
                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                                <TextBlock Text="FILE EXPLORER"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <CheckBox Content="Show file explorer"
                                          IsChecked="{Binding EditDsShowExplorer}"
                                          Classes="FormCheckBox"
                                          Margin="0,0,0,0"/>
                                <TextBlock Text="Show the file explorer panel on the left (Ctrl+Shift+F)."
                                           Classes="HelpText"/>

                                <TextBlock Text="Explorer Width" Classes="FieldLabel"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="0.1" Maximum="0.4"
                                            Value="{Binding EditDsExplorerRatio}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EditDsExplorerRatio, StringFormat='{}{0:P0}'}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="How much horizontal space the file explorer takes."
                                           Classes="HelpText"/>

                                <!-- Left Panel Settings -->
                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                                <TextBlock Text="LEFT PANEL"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <CheckBox Content="Show left panel"
                                          IsChecked="{Binding EditDsShowLeftPanel}"
                                          Classes="FormCheckBox"
                                          Margin="0,0,0,0"/>
                                <TextBlock Text="Show an additional panel dock on the left side."
                                           Classes="HelpText"/>

                                <TextBlock Text="Left Panel Width" Classes="FieldLabel"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Minimum="0.1" Maximum="0.4"
                                            Value="{Binding EditDsLeftPanelRatio}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding EditDsLeftPanelRatio, StringFormat='{}{0:P0}'}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="How much horizontal space the left panel takes."
                                           Classes="HelpText"/>

                                <!-- AI Assistant -->
                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                                <TextBlock Text="AI ASSISTANT"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <TextBlock Text="AI Assistant" Classes="FieldLabel"/>
                                <ComboBox ItemsSource="{Binding AiAssistants}"
                                          SelectedItem="{Binding EditDsAiAssistant}"
                                          Background="{DynamicResource BackgroundLightBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          MinWidth="150"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,0,4">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayLabel}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Which AI assistant to use for the Custom terminal in this project."
                                           Classes="HelpText"/>

                                <!-- Run Configurations -->
                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                                <TextBlock Text="RUN CONFIGURATIONS"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Custom run configurations for this project. If empty, auto-detection is used."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Run Config List -->
                                    <Border Grid.Column="0" Background="{StaticResource BackgroundMediumBrush}" CornerRadius="3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*" MaxHeight="150"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4">
                                                <Button Content="+"
                                                        Command="{Binding AddRunConfigurationCommand}"
                                                        Classes="SettingsToolbarButton"
                                                        Width="24"
                                                        Padding="0"
                                                        ToolTip.Tip="Add configuration"/>
                                            </StackPanel>

                                            <ListBox Grid.Row="1"
                                                     ItemsSource="{Binding RunConfigurations}"
                                                     SelectedItem="{Binding SelectedRunConfiguration}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="●"
                                                                       Foreground="{StaticResource StatusSuccessBrush}"
                                                                       IsVisible="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                       Margin="0,0,4,0"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Padding" Value="6,4"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Border"
                                                                            Background="{TemplateBinding Background}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                    <Style Selector="ListBoxItem:selected">
                                                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                    </Style>
                                                    <Style Selector="ListBoxItem:pointerover:not(:selected)">
                                                        <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                    </Style>
                                                </ListBox.Styles>
                                            </ListBox>
                                        </Grid>
                                    </Border>

                                    <!-- Run Config Edit Panel -->
                                    <StackPanel Grid.Column="2"
                                                IsVisible="{Binding SelectedRunConfiguration, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="Name" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditRcName}"
                                                 Classes="FormTextBox"/>

                                        <TextBlock Text="Command" Classes="FieldLabel" Margin="0,8,0,0"/>
                                        <TextBox Text="{Binding EditRcCommand}"
                                                 Classes="FormTextBox"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>

                                        <CheckBox Content="Default configuration"
                                                  IsChecked="{Binding EditRcIsDefault}"
                                                  Classes="FormCheckBox"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyRunConfigurationCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="60"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteRunConfigurationCommand}"
                                                    Classes="SettingsToolbarButton"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="60"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Apply Button -->
                                <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,16,0,16"/>

                                <Button Content="Apply Directory Settings"
                                        Command="{Binding ApplyDirectorySettingsCommand}"
                                        Classes="SettingsToolbarButton"
                                        Background="{StaticResource AccentDarkBrush}"
                                        HorizontalAlignment="Left"
                                        Padding="16,8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- API & Webhooks Settings Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=ApiWebhooks}">
                        <TextBlock Text="API &amp; Webhooks" Classes="SectionHeader"/>
                        <TextBlock Text="REST API server, SSE streaming, and MCP collaboration integration." Classes="SectionDescription"/>

                        <!-- API Server -->
                        <CheckBox Content="Enable API Server"
                                  IsChecked="{Binding ApiEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,16,0,4"/>
                        <TextBlock Text="Enables the built-in REST API and SSE streaming server."
                                   Classes="SectionDescription" Margin="0,0,0,12"/>

                        <Grid ColumnDefinitions="Auto,200" Margin="0,0,0,8">
                            <TextBlock Text="PORT" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ApiPort}"
                                     Background="{StaticResource BackgroundLightBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Padding="8,4"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,200" Margin="0,0,0,8">
                            <TextBlock Text="BIND ADDRESS" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ApiBindAddress}"
                                     Background="{StaticResource BackgroundLightBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Padding="8,4"/>
                        </Grid>

                        <!-- API Key (shown when non-loopback) -->
                        <StackPanel Margin="0,0,0,12"
                                    IsVisible="{Binding IsApiKeyRequired, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="API KEY" Classes="FieldLabel"/>
                            <TextBox Text="{Binding ApiKey}"
                                     Background="{StaticResource BackgroundLightBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Padding="8,4"
                                     Width="300" HorizontalAlignment="Left"
                                     PasswordChar="*"/>
                            <TextBlock Text="Required when binding to a non-loopback address. Sent via Authorization: Bearer header."
                                       Foreground="{StaticResource StatusWarningBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <CheckBox Content="Enable SSE (Server-Sent Events)"
                                  IsChecked="{Binding ApiEnableSse}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,8,0,12"/>

                        <!-- CORS Origins -->
                        <Grid ColumnDefinitions="Auto,400" Margin="0,0,0,12">
                            <TextBlock Text="CORS ORIGINS" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ApiCorsOrigins}"
                                     Background="{StaticResource BackgroundLightBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Padding="8,4"/>
                        </Grid>
                        <TextBlock Text="Comma-separated origins. Use * for wildcards (e.g., http://localhost:*)."
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="11"
                                   Margin="0,-8,0,12"/>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- MCP Collab Integration -->
                        <TextBlock Text="MCP Collab Integration" Classes="SectionHeader"/>
                        <TextBlock Text="Register TerminalHost as an MCP server in Claude Code for collaboration tools."
                                   Classes="SectionDescription" Margin="0,0,0,12"/>

                        <StackPanel Margin="0,0,0,8">
                            <!-- Status indicator -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Panel Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="#4CAF50"
                                             IsVisible="{Binding McpCollabInstalled}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="10" Height="10" Fill="#F44336"
                                             IsVisible="{Binding !McpCollabInstalled}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                                <TextBlock Text="{Binding McpCollabStatus}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  Detecting..."
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding McpCollabDetecting}"/>
                            </StackPanel>

                            <!-- MCP URL display -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="MCP URL:" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding McpCollabUrl, Mode=OneWay}" IsReadOnly="True"
                                         Background="{StaticResource BackgroundLightBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderThickness="1"
                                         BorderBrush="{StaticResource BorderSubtleBrush}"
                                         Padding="8,4"
                                         Width="320" VerticalAlignment="Center"/>
                                <Button Content="Copy URL" Command="{Binding CopyMcpCollabUrlCommand}"
                                        Classes="SettingsToolbarButton" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="Install in Claude Code" Command="{Binding InstallMcpCollabCommand}"
                                        Classes="SettingsToolbarButton"/>
                                <Button Content="Uninstall" Command="{Binding UninstallMcpCollabCommand}"
                                        Classes="SettingsToolbarButton" Margin="4,0,0,0"/>
                                <Button Content="Re-detect" Command="{Binding DetectMcpCollabCommand}"
                                        Classes="SettingsToolbarButton" Margin="4,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="Registers globally in Claude Code (user scope) so all projects have access to collaboration tools."
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="11"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Enable Webhooks -->
                        <CheckBox Content="Enable Webhooks"
                                  IsChecked="{Binding ApiEnableWebhooks}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Push events to configured HTTP endpoints with debounce, retry, and HMAC signing."
                                   Classes="SectionDescription" Margin="0,0,0,12"/>

                        <!-- Webhooks List (visible when webhooks enabled) -->
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                IsVisible="{Binding ApiEnableWebhooks, Converter={StaticResource BoolToVisibilityConverter}}">

                            <Grid ColumnDefinitions="200,*">
                                <!-- Webhook list -->
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="+ Add" Command="{Binding AddWebhookCommand}"
                                                Classes="SettingsToolbarButton" Margin="0,0,4,0"/>
                                        <Button Content="- Remove" Command="{Binding RemoveWebhookCommand}"
                                                Classes="SettingsToolbarButton"/>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding ApiWebhooks}"
                                             SelectedItem="{Binding SelectedWebhook}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MaxHeight="200">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Webhook editor -->
                                <StackPanel Grid.Column="1"
                                            IsVisible="{Binding SelectedWebhook, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                    <TextBlock Text="NAME" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding EditWhName}"
                                             Background="{StaticResource BackgroundLightBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Padding="8,4" Margin="0,0,0,8"/>

                                    <TextBlock Text="URL" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding EditWhUrl}"
                                             Background="{StaticResource BackgroundLightBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Padding="8,4" Margin="0,0,0,8"/>

                                    <TextBlock Text="SECRET (FOR HMAC SIGNING)" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding EditWhSecret}"
                                             Background="{StaticResource BackgroundLightBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Padding="8,4" Margin="0,0,0,8"/>

                                    <TextBlock Text="EVENTS FILTER" Classes="FieldLabel"/>
                                    <TextBox Text="{Binding EditWhEvents}"
                                             Background="{StaticResource BackgroundLightBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Padding="8,4" Margin="0,0,0,4"/>
                                    <TextBlock Text="Comma-separated. Examples: *, repo.*, repo.commit, session.*"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="11"
                                               Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="DEBOUNCE (MS)" Classes="FieldLabel"/>
                                            <TextBox Text="{Binding EditWhDebounceMs}"
                                                     Background="{StaticResource BackgroundLightBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderThickness="1"
                                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                                     Padding="8,4" Width="80"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="BATCH WINDOW (MS)" Classes="FieldLabel"/>
                                            <TextBox Text="{Binding EditWhBatchWindowMs}"
                                                     Background="{StaticResource BackgroundLightBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderThickness="1"
                                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                                     Padding="8,4" Width="80"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="MAX RETRIES" Classes="FieldLabel"/>
                                            <TextBox Text="{Binding EditWhMaxRetries}"
                                                     Background="{StaticResource BackgroundLightBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderThickness="1"
                                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                                     Padding="8,4" Width="60"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <CheckBox Content="Enabled"
                                              IsChecked="{Binding EditWhEnabled}"
                                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                    <Button Content="Apply Changes"
                                            Command="{Binding ApplyWebhookCommand}"
                                            Classes="SettingsToolbarButton"
                                            Padding="16,8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Status Overlay Settings Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=StatusOverlay}">
                        <TextBlock Text="Status Overlay" Classes="SectionHeader"/>
                        <TextBlock Text="Floating always-on-top window showing terminal activity state. Toggle with ⌘⇧Y." Classes="SectionDescription"/>

                        <!-- Auto-show on unfocus -->
                        <CheckBox Content="Auto-show when window loses focus"
                                  IsChecked="{Binding OverlayAutoShowOnUnfocus}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,16,0,4"/>
                        <TextBlock Text="Automatically show the overlay when TerminalHost is not focused, and hide when focused."
                                   Classes="HelpText"/>

                        <!-- Default Size -->
                        <TextBlock Text="DEFAULT SIZE" Classes="FieldLabel" Margin="0,16,0,4"/>
                        <ComboBox SelectedIndex="{Binding OverlaySizeIndex}"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Background="{DynamicResource BackgroundLightBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}">
                            <ComboBox.Items>
                                <system:String>Small (icon only)</system:String>
                                <system:String>Medium (icon + text)</system:String>
                            </ComboBox.Items>
                        </ComboBox>
                        <TextBlock Text="Small shows just the status icon. Medium adds a text description."
                                   Classes="HelpText"/>

                        <!-- Opacity -->
                        <TextBlock Text="OPACITY" Classes="FieldLabel" Margin="0,16,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="200"
                                    Minimum="0.3" Maximum="1.0"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding OverlayOpacity}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Background opacity of the overlay window."
                                   Classes="HelpText"/>
                    </StackPanel>

                    <!-- Channels Settings Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Channels}">
                        <TextBlock Text="Claude Code Channels" Classes="SectionHeader" Margin="0,0,0,16"/>
                        <TextBlock Text="Push TerminalHost events (git changes, terminal activity, user messages) into running Claude Code sessions via the MCP channel protocol."
                                   Classes="SectionDescription" Margin="0,0,0,16"/>

                        <!-- Enable Channels -->
                        <StackPanel Margin="0,0,0,12">
                            <CheckBox Content="Enable Channel Integration"
                                      IsChecked="{Binding ChannelEnabled}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="When enabled, Claude Code is launched with the channel server flag and TerminalHost events are forwarded to the session."
                                       Classes="SectionDescription" Margin="20,4,0,0"/>
                        </StackPanel>

                        <!-- Requirements Notice -->
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Requirements" Classes="FieldLabel" Margin="0,0,0,4"/>
                                <TextBlock Text="&#x2022; REST API must be enabled (API &amp; Webhooks section)"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                                <TextBlock Text="&#x2022; SSE streaming must be enabled"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                                <TextBlock Text="&#x2022; Claude Code v2.1.80+ with claude.ai login"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Border>

                        <!-- Channel Server Path -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Channel Server Path (optional)" Classes="FieldLabel"/>
                            <TextBox Text="{Binding ChannelServerPath}"
                                     Classes="FormTextBox" Width="500" HorizontalAlignment="Left"/>
                            <TextBlock Text="Leave empty for auto-detection. Override with absolute path to terminalhost-channel."
                                       Classes="SectionDescription" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Event Filters -->
                        <TextBlock Text="Event Filters" Classes="SectionHeader"/>
                        <TextBlock Text="Which TerminalHost events to forward to Claude Code. Use wildcard patterns."
                                   Classes="SectionDescription" Margin="0,0,0,12"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBox Text="{Binding ChannelEventFilters}"
                                     Classes="FormTextBox" Width="500" HorizontalAlignment="Left"/>
                            <TextBlock Text="Comma-separated. Examples: * (all), repo.* (git events), repo.commit, channel.user_message"
                                       Classes="SectionDescription" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Advanced -->
                        <TextBlock Text="Advanced" Classes="SectionHeader"/>

                        <StackPanel Margin="0,8,0,12">
                            <CheckBox Content="Use development channel flag"
                                      IsChecked="{Binding ChannelUseDevelopmentFlag}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Uses --dangerously-load-development-channels (required during research preview). Uncheck when channels are generally available."
                                       Classes="SectionDescription" Margin="20,4,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <CheckBox Content="Auto-register in .mcp.json"
                                      IsChecked="{Binding ChannelAutoRegisterMcp}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Automatically add the channel server to each project's .mcp.json file."
                                       Classes="SectionDescription" Margin="20,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Containers Settings Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Containers}">
                        <TextBlock Text="Containerized Workspaces" Classes="SectionHeader" Margin="0,0,0,16"/>
                        <TextBlock Text="Run AI assistants inside Docker containers for isolation. Per-project overrides are available via the command palette (Container: Toggle)."
                                   Classes="SectionDescription" Margin="0,0,0,16"/>

                        <!-- Requirements Notice -->
                        <Border Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Requirements" Classes="FieldLabel" Margin="0,0,0,4"/>
                                <TextBlock Text="&#x2022; Docker Desktop must be installed and running"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                                <TextBlock Text="&#x2022; First use builds a workspace image (~10 min, one-time)"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                                <TextBlock Text="&#x2022; Existing tabs must be reloaded after enabling (Tab: Reload in command palette)"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Border>

                        <!-- Enable Containers -->
                        <StackPanel Margin="0,0,0,12">
                            <CheckBox Content="Enable containerized workspaces globally"
                                      IsChecked="{Binding ContainerEnabled}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="When enabled, new project tabs run AI assistants and shells inside Docker containers. Per-project overrides take precedence."
                                       Classes="SectionDescription" Margin="20,4,0,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Docker Path -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Docker Executable" Classes="FieldLabel"/>
                            <TextBox Text="{Binding ContainerDockerPath}"
                                     Classes="FormTextBox" Width="400" HorizontalAlignment="Left"/>
                            <TextBlock Text="Path to the docker CLI. Default: docker (uses PATH)."
                                       Classes="HelpText" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Image Name + Tag -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Image Name" Classes="FieldLabel"/>
                                <TextBox Text="{Binding ContainerImageName}"
                                         Classes="FormTextBox" Width="300"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Image Tag" Classes="FieldLabel"/>
                                <TextBox Text="{Binding ContainerImageTag}"
                                         Classes="FormTextBox" Width="100"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Security & Mounts -->
                        <TextBlock Text="Security &amp; Mounts" Classes="FieldLabel" Margin="0,0,0,8"/>

                        <StackPanel Margin="0,0,0,8">
                            <CheckBox Content="Auto-approve in container (--dangerously-skip-permissions)"
                                      IsChecked="{Binding ContainerAutoApprove}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Skip Claude Code permission prompts inside containers. The container itself acts as the sandbox."
                                       Classes="SectionDescription" Margin="20,4,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <CheckBox Content="Mount SSH keys (readonly)"
                                      IsChecked="{Binding ContainerMountSsh}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Mount ~/.ssh inside the container as readonly for git SSH access."
                                       Classes="SectionDescription" Margin="20,4,0,0"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <CheckBox Content="Mount GitHub CLI auth"
                                      IsChecked="{Binding ContainerMountGhCli}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Share the host's gh CLI authentication with containers. Enables gh commands without re-authenticating."
                                       Classes="SectionDescription" Margin="20,4,0,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Network Mode -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Network Mode" Classes="FieldLabel"/>
                            <TextBox Text="{Binding ContainerNetworkMode}"
                                     Classes="FormTextBox" Width="200" HorizontalAlignment="Left"/>
                            <TextBlock Text="Docker network mode: bridge (default), host, or none."
                                       Classes="HelpText" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Stop on exit -->
                        <StackPanel Margin="0,0,0,12">
                            <CheckBox Content="Stop containers when TerminalHost exits"
                                      IsChecked="{Binding ContainerStopOnExit}"
                                      Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Disable to leave containers running for faster reattach on next launch."
                                       Classes="SectionDescription" Margin="20,4,0,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Reference Volumes -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header + Toolbar -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Reference Volumes (readonly)" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="+ Add" Command="{Binding AddReferenceVolumeCommand}" Classes="SettingsToolbarButton" Margin="0,0,4,0"/>
                                <Button Content="Delete" Command="{Binding DeleteReferenceVolumeCommand}" Classes="SettingsToolbarButton"/>
                            </StackPanel>
                            <TextBlock Grid.Row="0" Text="Shared source code mounted at /refs/{name} inside the container."
                                       Classes="SectionDescription" Margin="0,28,0,0"/>

                            <!-- List -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ContainerReferenceVolumes}"
                                     SelectedItem="{Binding SelectedReferenceVolume}"
                                     Background="{StaticResource BackgroundDarkBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     MaxHeight="150" Margin="0,0,0,8">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding HostPath}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" &#x2192; " Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="/refs/" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Edit Panel -->
                            <StackPanel Grid.Row="2"
                                        IsVisible="{Binding SelectedReferenceVolume, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Host Path" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditRefVolHostPath}"
                                                 Classes="FormTextBox" Width="350"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Name" Classes="FieldLabel"/>
                                        <TextBox Text="{Binding EditRefVolName}"
                                                 Classes="FormTextBox" Width="200"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Content="Apply" Command="{Binding ApplyReferenceVolumeCommand}"
                                        Classes="SettingsToolbarButton" Padding="16,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Docker Image -->
                        <TextBlock Text="Docker Image" Classes="FieldLabel" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Status:" Classes="HelpText" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ContainerImageStatus}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                            <TextBlock Text=" &#x2014; Rebuild recommended" VerticalAlignment="Center"
                                       Foreground="#F0C674" FontSize="12"
                                       IsVisible="{Binding ContainerImageStale}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Edit Dockerfile" Command="{Binding EditDockerfileCommand}"
                                    Classes="SettingsToolbarButton" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Rebuild Image" Command="{Binding RebuildContainerImageCommand}"
                                    Classes="SettingsToolbarButton" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="&#x21bb;" Command="{Binding RefreshImageStatusCommand}" ToolTip.Tip="Refresh status"
                                    Classes="SettingsToolbarButton" Padding="6,6" Margin="0,0,8,0"/>
                        </StackPanel>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                        <!-- Active Containers -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Active Containers" Classes="FieldLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="Refresh" Command="{Binding RefreshContainersCommand}"
                                    Classes="SettingsToolbarButton" Margin="0,0,4,0"/>
                            <Button Content="Recreate" Click="RecreateContainer_Click"
                                    Classes="SettingsToolbarButton" Margin="0,0,4,0"/>
                            <Button Content="Stop" Click="StopContainer_Click"
                                    Classes="SettingsToolbarButton" Margin="0,0,4,0"/>
                            <Button Content="Remove" Click="RemoveContainer_Click"
                                    Classes="SettingsToolbarButton" Margin="0,0,4,0"/>
                            <Button Content="Clean Stopped" Command="{Binding CleanStoppedContainersCommand}"
                                    Classes="SettingsToolbarButton"/>
                        </StackPanel>

                        <ListBox x:Name="ActiveContainersList"
                                 ItemsSource="{Binding ActiveContainers}"
                                 SelectedItem="{Binding SelectedContainer}"
                                 Background="{StaticResource BackgroundDarkBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="1"
                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                 MaxHeight="200" Margin="0,0,0,8">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text=" &#x2014; " Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding State}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding StalenessStatus}"
                                                   Foreground="{StaticResource StatusWarningBrush}"
                                                   IsVisible="{Binding IsStale}"
                                                   Margin="6,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Memory Settings Section -->
                    <StackPanel Margin="24"
                                IsVisible="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Memory}">
                        <TextBlock Text="Agentic Long-Term Memory (Eidet)" Classes="SectionHeader"/>
                        <TextBlock Text="Integration with Eidet — a standalone local-first memory service for AI coding agents. Eidet runs as a system service and provides MCP memory tools directly to AI clients. All memory-specific settings are managed by Eidet (run 'eidet setup' to configure)."
                                   Classes="SectionDescription"/>

                        <CheckBox Content="Enable Eidet Memory"
                                  IsChecked="{Binding MemoryEnabled, Mode=TwoWay}"
                                  Classes="FormCheckBox"
                                  Margin="0,0,0,4"/>

                        <TextBlock Text="{Binding MemoryStatusText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   IsVisible="{Binding MemoryStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <TextBlock Text="EIDET URL" Classes="FieldLabel" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EidetUrl, Mode=TwoWay}"
                                 Classes="FormTextBox"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="Eidet service URL. Default: http://localhost:19380"
                                   Classes="HelpText"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Test Connection"
                                    Command="{Binding TestEidetConnectionCommand}"
                                    Classes="SettingsToolbarButton"
                                    Padding="12,6"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding !IsTestingConnection}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Raw Mode Content (JSON Editor) -->
        <Grid Grid.Row="1" IsVisible="{Binding ViewMode, Converter={StaticResource RawModeVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Raw Mode Toolbar -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Format"
                            Command="{Binding FormatCommand}"
                            Classes="SettingsToolbarButton"/>
                    <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="8,2"/>
                    <Button Content="Reset Quick Commands"
                            Command="{Binding ResetQuickCommandsCommand}"
                            Classes="SettingsToolbarButton"
                            ToolTip.Tip="Reset quick commands to defaults (preserves other settings)"/>
                </StackPanel>
            </Border>

            <!-- JSON Editor -->
            <TextBox x:Name="JsonEditor"
                         Grid.Row="1"
                         Background="{StaticResource BackgroundDarkestBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         FontSize="{StaticResource FontSizeCode}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         Padding="8"
                         TextChanged="JsonEditor_TextChanged"
                         Loaded="JsonEditor_Loaded">
                
            </TextBox>
        </Grid>

        <!-- Error Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource DangerBackgroundBrush}"
                Padding="8,6"
                IsVisible="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource StatusErrorBrush}"
                       FontFamily="{StaticResource FontFamilyMonospace}"
                       FontSize="{StaticResource FontSizeSmall}"/>
        </Border>
    </Grid>
</UserControl>