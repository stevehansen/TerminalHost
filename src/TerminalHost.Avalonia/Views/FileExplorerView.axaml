<UserControl x:Class="TerminalHost.Views.FileExplorerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Domain"
             d:DesignWidth="300" d:DesignHeight="600"
             mc:Ignorable="d">

    <Design.DataContext>
        <viewModels:FileExplorerViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Context Menu -->
        <ContextMenu x:Key="FileContextMenu" Opening="ContextMenu_Opening">
            <MenuItem Header="Open" Command="{Binding OpenInViewerCommand}"
                      InputGesture="Enter">
                <MenuItem.Icon>
                    <TextBlock Text="📄" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Edit" Command="{Binding EditInViewerCommand}"
                      InputGesture="F4">
                <MenuItem.Icon>
                    <TextBlock Text="✏" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open in New Window" Command="{Binding PopOutViewerCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="⧉" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="View History" Command="{Binding ViewHistoryCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="📜" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="View Blame" Command="{Binding ViewBlameCommand}"
                      InputGesture="Cmd+Shift+B">
                <MenuItem.Icon>
                    <TextBlock Text="👤" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Open with Default App" Command="{Binding OpenExternalCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="🚀" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in Finder" Command="{Binding ExploreInExplorerCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="📂" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}"
                      InputGesture="Ctrl+C">
                <MenuItem.Icon>
                    <TextBlock Text="📋" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="CD to Folder" Command="{Binding CdToFolderCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="📋" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Rename" Command="{Binding RenameCommand}"
                      InputGesture="F2">
                <MenuItem.Icon>
                    <TextBlock Text="✏" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete" Command="{Binding DeleteCommand}"
                      InputGesture="Delete">
                <MenuItem.Icon>
                    <TextBlock Text="🗑️" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- TreeView Item Style -->
        <Style Selector="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        </Style>

        <!-- TreeViewItem selected state -->
        <Style Selector="TreeViewItem:selected /template/ Border#PART_SelectedBorder">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        </Style>

        <!-- TreeViewItem hover state -->
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_SelectedBorder">
            <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
        </Style>

        <!-- TreeViewItem inactive selection -->
        <Style Selector="TreeViewItem:selected:not(:focus) /template/ Border#PART_SelectedBorder">
            <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
        </Style>

        <!-- ToggleButton Style for Show Hidden Files -->
        <Style Selector="ToggleButton.HiddenFilesToggle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style Selector="ToggleButton.HiddenFilesToggle:checked">
            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
        </Style>

        <Style Selector="ToggleButton.HiddenFilesToggle:pointerover">
            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource BackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁"
                               Foreground="{StaticResource SyntaxCyanBrush}"
                               FontSize="{StaticResource FontSizeCode}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock Text="Explorer"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right buttons - all use Border with fixed height for consistency -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding HideGitIgnoredFiles}"
                                  ToolTip.Tip="Hide gitignored files"
                                  Classes="TerminalSwitchButton"
                                  Margin="0,0,4,0"
                                  Padding="6,0">
                        <Border Height="20">
                            <TextBlock Text="⊘" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                        </Border>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowHiddenFiles}"
                                  ToolTip.Tip="Show hidden files"
                                  Classes="TerminalSwitchButton"
                                  Margin="0,0,4,0"
                                  Padding="6,0">
                        <Border Height="20">
                            <TextBlock Text="◉" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                        </Border>
                    </ToggleButton>
                    <Button Command="{Binding NewFileCommand}"
                            Classes="TerminalSwitchButton"
                            ToolTip.Tip="New File"
                            Margin="0,0,4,0"
                            Padding="6,0">
                        <Border Height="20">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="{StaticResource FontSizeSmaller}" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Button Command="{Binding NewFolderCommand}"
                            Classes="TerminalSwitchButton"
                            ToolTip.Tip="New Folder"
                            Margin="0,0,4,0"
                            Padding="6,0">
                        <Border Height="20">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="{StaticResource FontSizeSmaller}" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>
                    <Grid>
                        <Button Command="{Binding RefreshCommand}"
                                Classes="TerminalSwitchButton"
                                ToolTip.Tip="Refresh"
                                Padding="6,0">
                            <Border Height="20">
                                <TextBlock Text="↻" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                            </Border>
                        </Button>
                        <!-- Pending changes indicator dot (yellow dot when files changed) -->
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource SyntaxYellowBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-2,-2,0"
                                 IsVisible="{Binding HasPendingChanges}"
                                 ToolTip.Tip="{Binding LastChangedFile, StringFormat='Changed: {0}'}"
                                 IsHitTestVisible="True"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TreeView -->
        <TreeView x:Name="FileTree"
                  Grid.Row="1"
                  ItemsSource="{Binding RootNode.Children}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4"
                  SelectionChanged="FileTree_SelectionChanged"
                  DoubleTapped="FileTree_DoubleTapped"
                  KeyDown="FileTree_KeyDown">
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                    <Grid ContextMenu="{StaticResource FileContextMenu}"
                          Background="{Binding RowBackgroundHex, Converter={StaticResource HexToBrushConverter}}"
                          Margin="-2,0,0,0"
                          ToolTip.Tip="{Binding FullPath}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Loading indicator -->
                            <TextBlock Text="◌"
                                       IsVisible="{Binding IsLoading}"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       Margin="0,0,4,0"/>

                            <!-- File/folder icon -->
                            <TextBlock Text="{Binding Icon}"
                                       IsVisible="{Binding !IsLoading}"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>

                            <!-- File name -->
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Git status badge -->
                            <Border IsVisible="{Binding GitStatus, Converter={StaticResource NullToVisibilityConverter}}"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    Padding="4,0"
                                    Margin="6,0,0,0">
                                <TextBlock Text="{Binding GitStatusIcon}"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding GitStatusColor, Converter={StaticResource StringToColorConverter}}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Loading overlay -->
        <Border Grid.Row="1"
                Background="#80000000"
                IsVisible="{Binding IsLoading}">
            <TextBlock Text="Loading..."
                       Foreground="{StaticResource TextDimmedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeNormal}"/>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="1"
                IsVisible="{Binding RootNode.Children.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                Background="Transparent">
            <TextBlock Text="No files to display"
                       Foreground="{StaticResource TextDimmedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeSmall}"/>
        </Border>
    </Grid>
</UserControl>