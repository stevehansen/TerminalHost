<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Font Families -->
    <FontFamily x:Key="FontFamilyMonospace">Cascadia Code, Consolas, monospace</FontFamily>

    <!-- Font Sizes -->
    <x:Double x:Key="FontSizeMicro">9</x:Double>
    <x:Double x:Key="FontSizeTiny">10</x:Double>
    <x:Double x:Key="FontSizeSmall">11</x:Double>
    <x:Double x:Key="FontSizeCode">12</x:Double>
    <x:Double x:Key="FontSizeNormal">13</x:Double>
    <x:Double x:Key="FontSizeLarge">14</x:Double>
    <x:Double x:Key="FontSizeHeader">16</x:Double>

    <!-- Icon Text Style - Use for single-char/emoji icons in lists -->
    <!-- Monospace font ensures consistent width for all characters -->
    <Style Selector="TextBlock.iconText">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
