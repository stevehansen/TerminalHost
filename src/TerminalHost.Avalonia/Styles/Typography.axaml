<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Font Families -->
    <FontFamily x:Key="FontFamilyMonospace">Cascadia Code, Consolas, monospace</FontFamily>

    <!-- Font Sizes -->
    <x:Double x:Key="FontSizeMicro">9</x:Double>
    <x:Double x:Key="FontSizeTiny">10</x:Double>
    <x:Double x:Key="FontSizeSmall">11</x:Double>
    <x:Double x:Key="FontSizeCode">12</x:Double>
    <x:Double x:Key="FontSizeNormal">13</x:Double>
    <x:Double x:Key="FontSizeLarge">14</x:Double>
    <x:Double x:Key="FontSizeHeader">16</x:Double>
</ResourceDictionary>
