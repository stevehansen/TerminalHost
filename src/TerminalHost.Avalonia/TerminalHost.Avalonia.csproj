<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TerminalHost.Avalonia</RootNamespace>
    <AssemblyName>host</AssemblyName>
    <NoWarn>$(NoWarn);NU1701;AVLN3001</NoWarn>

    <!-- macOS publish settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- macOS ARM64 R2R fixup races on startup during concurrent JIT prep — crashes ~1/5 DMG launches. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Global usings for Core types -->
  <ItemGroup>
    <Using Include="TerminalHost.Core.Domain" />
    <Using Include="TerminalHost.Core.Interfaces" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\TerminalHost.Core\TerminalHost.Core.csproj" />
    <ProjectReference Include="..\TerminalHost.Posix\TerminalHost.Posix.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <ProjectReference Include="..\TerminalHost.macOS\TerminalHost.macOS.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <ProjectReference Include="..\TerminalHost.Linux\TerminalHost.Linux.csproj" />
  </ItemGroup>

  <!-- Resources -->
  <ItemGroup>
    <AvaloniaResource Include="Resources\**\*" Exclude="Resources\**\*.xaml;Resources\**\*.py" />
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <!-- Spark Canvas web assets (shared with WPF, linked from WPF project) -->
  <ItemGroup>
    <Content Include="..\..\src\TerminalHost\TerminalHost\web\spark\**\*" Link="web\spark\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Avalonia-specific files kept (all others use Core via global usings):
    - Domain: TerminalSession, TerminalPair, FileSystemNode, TerminalTheme, SearchMatch, SearchResult, TimelineFileChange, ClaudeCodeSession
    - Services: IFileExplorerService, IFilePreviewService, ISessionManager, ISystemTrayService, ITerminalControlFactory, ITimerService (Avalonia timer)
    - All duplicate Domain types and Service interfaces deleted - using Core.Domain and Core.Interfaces
  -->

  <!-- NuGet Packages -->
  <ItemGroup>
    <!-- Avalonia UI Framework -->
    <PackageReference Include="Avalonia" Version="11.3.15" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.15" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.15" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.15" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.15" Condition="'$(Configuration)' == 'Debug'" />

    <!-- WebView (native WKWebView on macOS, MIT licensed) -->
    <PackageReference Include="WebView.Avalonia.Cross" Version="11.3.1" />
    <PackageReference Include="WebView.Avalonia.Desktop.Cross" Version="11.3.1" />

    <!-- Cross-platform packages -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="Markdig.SyntaxHighlighting" Version="1.1.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />

    <!-- Avalonia-compatible charts -->
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.2" />

    <!-- Avalonia message box dialogs -->
    <PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
  </ItemGroup>

  <!-- Remove PDB files after publish -->
  <Target Name="RemovePdbFiles" AfterTargets="Publish">
    <ItemGroup>
      <PdbFilesToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFilesToDelete)" />
  </Target>

</Project>
