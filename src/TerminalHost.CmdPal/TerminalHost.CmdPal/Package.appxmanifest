<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="TerminalHost.CmdPal"
    Publisher="CN=TerminalHost"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>TerminalHost for Command Palette</DisplayName>
    <PublisherDisplayName>TerminalHost</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="TerminalHost.CmdPal.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="TerminalHost for Command Palette"
        Description="TerminalHost terminal manager integration for PowerToys Command Palette"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- COM server for out-of-process extension hosting -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="TerminalHost.CmdPal.exe"
                          Arguments="-RegisterProcessAsComServer"
                          DisplayName="TerminalHost Extension">
              <com:Class Id="9EB4EA8B-F590-4710-80D4-C8CD1792CED9"
                        DisplayName="TerminalHost Extension" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Register as a Command Palette extension -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension
            Name="com.microsoft.commandpalette"
            Id="TerminalHostCmdPal"
            PublicFolder="Public"
            DisplayName="TerminalHost"
            Description="Workspace switcher, git status, and terminal activity for TerminalHost">
            <uap3:Properties>
              <CmdPalProvider>
                <Activation>
                  <CreateInstance ClassId="9EB4EA8B-F590-4710-80D4-C8CD1792CED9" />
                </Activation>
                <SupportedInterfaces>
                  <Commands />
                </SupportedInterfaces>
              </CmdPalProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
