<UserControl x:Class="TerminalHost.Controls.MergeConflictViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{StaticResource BackgroundDarkestBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top: Ours vs Theirs -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="OURS (HEAD)" Foreground="#4EC9B0" FontWeight="SemiBold" FontSize="11"/>
                <TextBlock Grid.Column="1" Text=" | " Foreground="{StaticResource TextDimmedBrush}" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="THEIRS (incoming)" Foreground="#569CD6" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ours panel -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="OursTextBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#4EC9B0"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         FontSize="12"
                         BorderThickness="0"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"/>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

            <!-- Theirs panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="TheirsTextBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="#569CD6"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         FontSize="12"
                         BorderThickness="0"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="RESULT" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="AiSuggestionLabel"
                               Text="AI Suggestion — review before saving"
                               Foreground="#C586C0" FontSize="11" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AiSuggestButton" Content="✨ AI Suggest"
                            Style="{StaticResource TerminalSwitchButton}"
                            Foreground="#C586C0"
                            Margin="0,0,8,0"/>
                    <Button x:Name="AcceptOursButton" Content="Accept Ours"
                            Style="{StaticResource TerminalSwitchButton}"
                            Foreground="#4EC9B0"
                            Margin="0,0,4,0"/>
                    <Button x:Name="AcceptTheirsButton" Content="Accept Theirs"
                            Style="{StaticResource TerminalSwitchButton}"
                            Foreground="#569CD6"
                            Margin="0,0,4,0"/>
                    <Button x:Name="AcceptBothButton" Content="Accept Both"
                            Style="{StaticResource TerminalSwitchButton}"
                            Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PrevHunkButton" Content="&lt; Prev"
                            Style="{StaticResource TerminalSwitchButton}"
                            Margin="0,0,4,0"/>
                    <TextBlock x:Name="HunkCountText"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <Button x:Name="NextHunkButton" Content="Next &gt;"
                            Style="{StaticResource TerminalSwitchButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Result panel -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBox x:Name="ResultTextBox"
                     Background="Transparent"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontFamily="{StaticResource FontFamilyMonospace}"
                     FontSize="12"
                     BorderThickness="0"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"/>
        </ScrollViewer>
    </Grid>
</UserControl>
