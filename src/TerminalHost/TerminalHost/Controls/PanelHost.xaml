<UserControl x:Class="TerminalHost.Controls.PanelHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:TerminalHost.Core.Interfaces;assembly=TerminalHost.Core"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             xmlns:views="clr-namespace:TerminalHost.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="300"
             d:Background="#1E1E1E">

    <UserControl.Resources>
        <!-- Local DataTemplates for all panel types -->
        <DataTemplate DataType="{x:Type vm:FileExplorerPanelViewModel}">
            <views:FileExplorerView DataContext="{Binding ExplorerViewModel}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MarkdownPreviewViewModel}">
            <views:MarkdownPreviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GitFilesViewModel}">
            <views:GitFilesContentView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScratchPadViewModel}">
            <views:ScratchPadContentView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Panel Tab Strip -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Control buttons for active panel -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0">
                    <!-- Custom header commands from active panel -->
                    <ItemsControl ItemsSource="{Binding ActivePanel.HeaderCommands, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Icon}"
                                        ToolTip="{Binding Tooltip}"
                                        Command="{Binding Command}"
                                        Style="{StaticResource TabCloseButton}"
                                        FontSize="12"
                                        Padding="6,2"
                                        Margin="0,0,2,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Separator when custom commands exist -->
                    <Border Width="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            Margin="2,4,4,4"
                            Visibility="{Binding ActivePanel.HeaderCommands, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <!-- Undock button -->
                    <Button x:Name="UndockButton"
                            Content="&#x229E;"
                            ToolTip="Undock to popup"
                            Style="{StaticResource TabCloseButton}"
                            FontSize="12"
                            Padding="6,2"
                            Margin="0,0,2,0"
                            Click="UndockButton_Click"/>
                    <!-- Pop-out button -->
                    <Button x:Name="PopOutButton"
                            Content="&#x29C9;"
                            ToolTip="Pop out to window"
                            Style="{StaticResource TabCloseButton}"
                            FontSize="12"
                            Padding="6,2"
                            Margin="0,0,2,0"
                            Click="PopOutButton_Click"/>
                    <!-- Close button -->
                    <Button x:Name="CloseButton"
                            Content="&#x00D7;"
                            ToolTip="Close panel"
                            Style="{StaticResource TabCloseButton}"
                            FontSize="14"
                            Padding="6,2"
                            Click="CloseButton_Click"/>
                </StackPanel>

                <!-- Tab items -->
                <ItemsControl x:Name="TabStrip"
                              ItemsSource="{Binding Panels, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabBorder"
                                    Padding="8,6"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    MouseLeftButtonDown="PanelTab_MouseLeftButtonDown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PanelIcon}"
                                               FontSize="12"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PanelTitle}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                                            <Binding/>
                                            <Binding Path="ActivePanel" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Active Panel Content - uses implicit DataTemplates from Resources -->
        <ContentControl Grid.Row="1"
                        Content="{Binding ActivePanel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <!-- Empty state when no panels -->
        <TextBlock Grid.Row="1"
                   Text="No panels docked"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActivePanel, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
