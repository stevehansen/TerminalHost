<UserControl x:Class="TerminalHost.Controls.PanelPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             xmlns:interfaces="clr-namespace:TerminalHost.Core.Interfaces;assembly=TerminalHost.Core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=interfaces:IPanelableViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PanelContentTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <controls:DraggablePopup
        x:Name="Popup"
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        Title="{Binding PanelTitle}"
        PopupWidth="{Binding Width, Mode=TwoWay}"
        PopupHeight="{Binding Height, Mode=TwoWay}"
        HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
        VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}"
        CloseCommand="{Binding CloseCommand}">

        <controls:DraggablePopup.HeaderLeftContent>
            <TextBlock Text="{Binding PanelIcon}"
                       FontSize="14"
                       VerticalAlignment="Center"/>
        </controls:DraggablePopup.HeaderLeftContent>

        <controls:DraggablePopup.HeaderRightContent>
            <StackPanel Orientation="Horizontal">
                <!-- Custom header commands from panel -->
                <ItemsControl ItemsSource="{Binding HeaderCommands}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Icon}"
                                    ToolTip="{Binding Tooltip}"
                                    Command="{Binding Command}"
                                    Style="{StaticResource TabCloseButton}"
                                    FontSize="12"
                                    Padding="6,2"
                                    Margin="0,0,4,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Separator when custom commands exist -->
                <Border Width="1"
                        Background="{StaticResource BorderSubtleBrush}"
                        Margin="0,4,4,4"
                        Visibility="{Binding HeaderCommands, Converter={StaticResource NullToCollapsedConverter}}"/>
                <!-- Dock button -->
                <Button Content="&#x25E7;"
                        Style="{StaticResource TabCloseButton}"
                        Click="DockButton_Click"
                        ToolTip="Dock back to panel"
                        FontSize="12"
                        Padding="6,2"
                        Margin="0,0,4,0"/>
                <!-- Pop-out to window button -->
                <Button Content="&#x29C9;"
                        Style="{StaticResource TabCloseButton}"
                        Click="PopOutButton_Click"
                        ToolTip="Pop out to window"
                        FontSize="12"
                        Padding="6,2"
                        Margin="0,0,4,0"/>
            </StackPanel>
        </controls:DraggablePopup.HeaderRightContent>

        <controls:DraggablePopup.PopupContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Content presenter uses DataTemplates from PanelContentTemplates.xaml -->
                <ContentPresenter Grid.Row="0" Content="{Binding}"/>

                <!-- Status bar (only shown when StatusText is not empty) -->
                <Border Grid.Row="1"
                        Background="{StaticResource BackgroundMediumBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="8,4"
                        Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeMicro}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </controls:DraggablePopup.PopupContent>

    </controls:DraggablePopup>
</UserControl>
