<UserControl x:Class="TerminalHost.Controls.DiffViewer"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Unified diff line styles -->
        <SolidColorBrush x:Key="AdditionBrush" Color="#6A9955"/>
        <SolidColorBrush x:Key="DeletionBrush" Color="#F14C4C"/>
        <SolidColorBrush x:Key="HunkHeaderBrush" Color="#569CD6"/>
        <SolidColorBrush x:Key="FileHeaderBrush" Color="#CE9178"/>
        <SolidColorBrush x:Key="MetaBrush" Color="#9CDCFE"/>
        <SolidColorBrush x:Key="IndexBrush" Color="#858585"/>
        <SolidColorBrush x:Key="AdditionBackgroundBrush" Color="#233623"/>
        <SolidColorBrush x:Key="DeletionBackgroundBrush" Color="#3E1E1E"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="RadioButton.DiffModeToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="3">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.DiffModeToggleButton:checked">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="RadioButton.DiffModeToggleButton:pointerover">
            <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
        </Style>
        <Style Selector="RadioButton.DiffModeToggleButton:checked:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Mode toggle bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4"
                MinHeight="28">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="View:"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <RadioButton x:Name="UnifiedModeButton"
                             Content="Unified"
                             Classes="DiffModeToggleButton"
                             IsChecked="True"
                             Margin="0,0,4,0"/>
                <RadioButton x:Name="SideBySideModeButton"
                             Content="Side by Side"
                             Classes="DiffModeToggleButton"/>
            </StackPanel>
        </Border>

        <!-- Unified diff view -->
        <ScrollViewer x:Name="DiffScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="{StaticResource BackgroundDarkestBrush}">
            <ItemsControl x:Name="DiffItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Line number -->
                            <TextBlock Grid.Column="0"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Padding="8,2,8,2"
                                       TextAlignment="Right"
                                       MinWidth="50"
                                       Background="{StaticResource BackgroundDarkBrush}"
                                       Text="{Binding LineNumber}"/>

                            <!-- Content with syntax highlighting -->
                            <TextBlock Grid.Column="1"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       Foreground="{Binding Foreground}"
                                       Background="{Binding Background}"
                                       Padding="4,2"
                                       TextWrapping="NoWrap"
                                       Text="{Binding Content}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Side-by-side diff view -->
        <controls:SideBySideDiffViewer x:Name="SideBySideViewer"
                                        Grid.Row="1"
                                        IsVisible="False"/>

        <!-- Empty state -->
        <TextBlock Grid.Row="1"
                   x:Name="EmptyStateText"
                   Text="No changes to display."
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="{StaticResource FontSizeCode}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="False"/>
    </Grid>
</UserControl>
