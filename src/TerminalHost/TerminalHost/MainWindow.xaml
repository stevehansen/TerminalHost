<Window x:Class="TerminalHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TerminalHost"
        xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
        xmlns:views="clr-namespace:TerminalHost.Views"
        xmlns:popups="clr-namespace:TerminalHost.Views.Popups"
        xmlns:controls="clr-namespace:TerminalHost.Controls"
        xmlns:vm="clr-namespace:TerminalHost.ViewModels"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="Resources/app.ico"
        Height="700"
        Width="1100"
        Background="{StaticResource BackgroundDarkestBrush}"
        WindowStyle="SingleBorderWindow">

    <!-- All styles and converters are now in App.xaml for reuse across views -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarColumnWidth}"/>
            <ColumnDefinition Width="{Binding SidebarSplitterWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Workspace Sidebar (Column 0, spans both rows) - visible in WorkspaceSidebar mode -->
        <views:WorkspaceSidebarView Grid.Column="0" Grid.RowSpan="2"
                                     DataContext="{Binding WorkspaceSidebar}"
                                     Visibility="{Binding DataContext.IsWorkspaceSidebarVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Sidebar Splitter (Column 1) -->
        <GridSplitter Grid.Column="1" Grid.RowSpan="2"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BackgroundDarkBrush}"
                      Visibility="{Binding IsWorkspaceSidebarVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Tab Bar (Column 2, Row 0) - visible in Tabs mode only -->
        <views:TabStrip Grid.Row="0" Grid.Column="2"
                        DataContext="{Binding}"
                        Visibility="{Binding IsTabStripVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Tab Content Area (Column 2, Row 1) -->
        <Grid Grid.Row="1" Grid.Column="2">
            <!-- Show when there's a selected tab -->
            <ContentControl Content="{Binding SelectedTab}"
                            AutomationProperties.AutomationId="MainContentControl"
                            Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVisibilityConverter}}">

            </ContentControl>

            <!-- Empty State - Show a test terminal directly -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                    <TextBlock Text="Test terminal below - " Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeNormal}" VerticalAlignment="Center"/>
                    <Button Content="+ Open Project"
                            AutomationProperties.AutomationId="OpenProjectButton"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding OpenNewProjectCommand}"
                            Padding="16,8"/>
                </StackPanel>

                <!-- Direct XAML terminal test -->
                <term:EasyTerminalControl x:Name="TestTerminal"
                                          Grid.Row="1"
                                          StartupCommandLine="cmd.exe"
                                          Focusable="True"
                                          IsTabStop="True"
                                          Margin="10"
                                          GotFocus="TestTerminal_GotFocus"
                                          MouseDown="TestTerminal_MouseDown"/>
            </Grid>
        </Grid>

        <!-- Tab Dropdown Popup -->
        <Popup x:Name="TabDropdownPopup"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsTabDropdownOpen, Mode=TwoWay}">
            <popups:TabDropdownView x:Name="TabDropdownViewControl" DataContext="{Binding}" />
        </Popup>

        <!-- Tab Switcher Popup (Ctrl+Shift+T) -->
        <Popup x:Name="TabSwitcherPopup"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsTabSwitcherOpen, Mode=TwoWay}">
            <popups:TabSwitcherView x:Name="TabSwitcherViewControl" DataContext="{Binding}" />
        </Popup>

        <!-- Unified File Viewer Popup (Ctrl+O for preview, Ctrl+Shift+E for edit) -->
        <popups:FileViewerPopup x:Name="FileViewerPopupControl" />

        <!-- Help Popup (F1) -->
        <Popup x:Name="HelpPopup"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsHelpOpen, Mode=TwoWay}">
            <popups:HelpView x:Name="HelpViewControl" DataContext="{Binding HelpViewModel}" />
        </Popup>

        <!-- Command Palette Popup (Ctrl+Shift+P) -->
        <Popup x:Name="CommandPalettePopup"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               StaysOpen="False"
               AllowsTransparency="True"
               IsOpen="{Binding IsCommandPaletteOpen, Mode=TwoWay}">
            <popups:CommandPaletteView DataContext="{Binding}" />
        </Popup>

        <!-- Scratch Pad - no popup view here, handled via panel system like Markdown Preview -->

        <!-- Git Files - no popup view here, handled via panel system like Markdown Preview -->

        <!-- Git Branch View (Ctrl+B) -->
        <popups:GitBranchView x:Name="GitBranchViewControl" />

        <!-- Git Stash View (Ctrl+Shift+S) -->
        <popups:GitStashView x:Name="GitStashViewControl" />

        <!-- Git Reflog View (Ctrl+Shift+G) -->
        <popups:ReflogView x:Name="ReflogViewControl" />

        <!-- Manage Worktrees View -->
        <popups:ManageWorktreesView x:Name="ManageWorktreesViewControl" />

        <!-- Detected Links View -->
        <popups:DetectedLinksView x:Name="DetectedLinksViewControl" />

        <!-- Repository Switcher View (Ctrl+Shift+O) -->
        <popups:RepositorySwitcherView x:Name="RepositorySwitcherViewControl" />

        <!-- Test Results View (F6) -->
        <popups:TestResultsView x:Name="TestResultsViewControl" />

        <!-- PR Review View (Ctrl+Shift+R) -->
        <popups:PrReviewView x:Name="PrReviewViewControl" />

        <!-- Branch Comparison View (Ctrl+Alt+B) -->
        <popups:BranchComparisonView x:Name="BranchComparisonViewControl" />

        <!-- Claude Tasks Panel View (Ctrl+Shift+K) -->
        <popups:ClaudeTasksPanelView x:Name="ClaudeTasksPanelViewControl" />

        <!-- Unified Git Panel View (Alt+G) -->
        <popups:UnifiedGitPanelView x:Name="UnifiedGitPanelViewControl" />
    </Grid>
</Window>
