<Window x:Class="TerminalHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TerminalHost"
        xmlns:vm="clr-namespace:TerminalHost.ViewModels"
        xmlns:domain="clr-namespace:TerminalHost.Domain"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        mc:Ignorable="d"
        Title="TerminalHost"
        Height="700"
        Width="1100"
        Background="#1E1E1E"
        FontFamily="Cascadia Code NF, Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Tab Close Button Style -->
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E3E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Terminal Switch Button Style -->
        <Style x:Key="TerminalSwitchButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E3E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveTerminalButton" TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084D8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Converter for active terminal button style -->
        <local:ActiveTerminalStyleConverter x:Key="ActiveTerminalStyleConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Bar -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="4">
            <DockPanel>
                <!-- New Project Button -->
                <Button DockPanel.Dock="Right"
                        Content="+ New Project"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding OpenNewProjectCommand}"
                        Margin="8,0,4,0"/>

                <!-- Tab List -->
                <ListBox x:Name="TabList"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TerminalPairTabViewModel}">
                            <Border x:Name="TabBorder"
                                    Background="#3C3C3C"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4"
                                    Margin="0,0,2,0"
                                    MinWidth="120">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="×"
                                            Style="{StaticResource TabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Foreground="#CCCCCC" VerticalAlignment="Center">
                                        <Run Text="{Binding CurrentIcon, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding TitleWithGit, Mode=OneWay}"/>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Terminal Content Area -->
        <Grid Grid.Row="1">
            <!-- Show when there's a selected tab -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Terminal Switcher Bar -->
                <Border Grid.Row="0" Background="#252525" Padding="8,4">
                    <DockPanel>
                        <!-- Split View Toggle -->
                        <Button DockPanel.Dock="Right"
                                Content="⊞ Split"
                                Style="{StaticResource TerminalSwitchButton}"
                                Command="{Binding SelectedTab.ToggleSplitViewCommand}"/>

                        <!-- Terminal Type Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SelectedTab.CustomIcon, StringFormat='{}{0} Claude Code'}"
                                    Command="{Binding SelectedTab.ShowCustomTerminalCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.ActiveTerminal}" Value="{x:Static domain:ActiveTerminal.Custom}">
                                                <Setter Property="Background" Value="#0078D4"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding SelectedTab.ShellIcon, StringFormat='{}{0} Shell'}"
                                    Command="{Binding SelectedTab.ShowShellTerminalCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTab.ActiveTerminal}" Value="{x:Static domain:ActiveTerminal.Shell}">
                                                <Setter Property="Background" Value="#0078D4"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBlock Foreground="#666666" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Text="{Binding SelectedTab.Pair.WorkingDirectory}"/>

                            <!-- Git Status Display -->
                            <TextBlock Foreground="#4EC9B0" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Text="{Binding SelectedTab.GitStatusDisplay}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Terminal Content Area - Single grid with dynamic column widths -->
                <Grid Grid.Row="1" Background="#1E1E1E" x:Name="TerminalContentGrid">
                    <Grid.ColumnDefinitions>
                        <!-- Custom terminal column -->
                        <ColumnDefinition x:Name="CustomTerminalColumn" Width="6*"/>
                        <!-- Splitter column -->
                        <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                        <!-- Shell terminal column -->
                        <ColumnDefinition x:Name="ShellTerminalColumn" Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Custom Terminal (Left) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Header only visible in split view -->
                        <Border Background="#333333" Padding="4,2"
                                Visibility="{Binding SelectedTab.IsSplitView, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="#AAAAAA" FontSize="10">
                                <Run Text="{Binding SelectedTab.CustomIcon, Mode=OneWay}"/>
                                <Run Text=" Claude Code"/>
                            </TextBlock>
                        </Border>
                        <ContentPresenter Grid.Row="1" Content="{Binding SelectedTab.CustomTerminalContent}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>

                    <!-- Splitter - only interactable in split view -->
                    <GridSplitter Grid.Column="1" Width="4" Background="#333333" HorizontalAlignment="Stretch"
                                  Visibility="{Binding SelectedTab.IsSplitView, Converter={StaticResource BoolToVisibilityConverter}}"
                                  DragCompleted="GridSplitter_DragCompleted"/>

                    <!-- Shell Terminal (Right) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Header only visible in split view -->
                        <Border Background="#333333" Padding="4,2"
                                Visibility="{Binding SelectedTab.IsSplitView, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Foreground="#AAAAAA" FontSize="10">
                                <Run Text="{Binding SelectedTab.ShellIcon, Mode=OneWay}"/>
                                <Run Text=" Shell"/>
                            </TextBlock>
                        </Border>
                        <ContentPresenter Grid.Row="1" Content="{Binding SelectedTab.ShellTerminalContent}"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Empty State - Show a test terminal directly -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                    <TextBlock Text="Test terminal below - " Foreground="#666666" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="+ Open Project"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding OpenNewProjectCommand}"
                            Padding="16,8"/>
                </StackPanel>

                <!-- Direct XAML terminal test -->
                <term:EasyTerminalControl x:Name="TestTerminal"
                                          Grid.Row="1"
                                          StartupCommandLine="cmd.exe"
                                          Focusable="True"
                                          IsTabStop="True"
                                          Margin="10"
                                          GotFocus="TestTerminal_GotFocus"
                                          MouseDown="TestTerminal_MouseDown"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
