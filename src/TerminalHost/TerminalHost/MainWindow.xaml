<Window x:Class="TerminalHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TerminalHost"
        xmlns:domain="clr-namespace:TerminalHost.Domain"
        xmlns:views="clr-namespace:TerminalHost.Views"
        xmlns:popups="clr-namespace:TerminalHost.Views.Popups"
        xmlns:vm="clr-namespace:TerminalHost.ViewModels"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="Resources/app.ico"
        Height="700"
        Width="1100"
        Background="#1E1E1E"
        FontFamily="Cascadia Code NF, Segoe UI"
        WindowStyle="SingleBorderWindow">

    <!-- All styles and converters are now in App.xaml for reuse across views -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Bar -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="4">
            <DockPanel>
                <!-- New Project Button -->
                <Button DockPanel.Dock="Right"
                        Content="+ New Project"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding OpenNewProjectCommand}"
                        Margin="8,0,4,0"/>

                <!-- Settings Button -->
                <Button DockPanel.Dock="Right"
                        Content="Settings"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Settings (Ctrl+,)"
                        Margin="0,0,4,0"/>

                <!-- Profiles Button -->
                <Button DockPanel.Dock="Right"
                        Content="Profiles"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding OpenProfilesCommand}"
                        ToolTip="Manage Profiles (Ctrl+P)"
                        Margin="0,0,4,0"/>

                <!-- Statistics Button -->
                <Button DockPanel.Dock="Right"
                        Content="Statistics"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding OpenStatisticsCommand}"
                        ToolTip="View Usage Statistics"
                        Margin="0,0,4,0"/>

                <!-- Tab Dropdown Button -->
                <Button x:Name="TabDropdownButton"
                        DockPanel.Dock="Right"
                        Content="▼"
                        AutomationProperties.Name="Show all tabs"
                        Style="{StaticResource TerminalSwitchButton}"
                        Click="TabDropdown_Click"
                        ToolTip="All tabs (Ctrl+Shift+T)"
                        Visibility="Collapsed"
                        Margin="0,0,4,0"/>

                <!-- Scroll Right Button -->
                <Button x:Name="ScrollRightButton"
                        DockPanel.Dock="Right"
                        Content="›"
                        AutomationProperties.Name="Scroll tabs right"
                        Style="{StaticResource TerminalSwitchButton}"
                        Click="ScrollRight_Click"
                        ToolTip="Scroll right"
                        Visibility="Collapsed"
                        Padding="6,4"
                        Margin="0,0,2,0"/>

                <!-- Scroll Left Button -->
                <Button x:Name="ScrollLeftButton"
                        DockPanel.Dock="Right"
                        Content="‹"
                        AutomationProperties.Name="Scroll tabs left"
                        Style="{StaticResource TerminalSwitchButton}"
                        Click="ScrollLeft_Click"
                        ToolTip="Scroll left"
                        Visibility="Collapsed"
                        Padding="6,4"
                        Margin="0,0,2,0"/>

                <!-- Tab List -->
                <ListBox x:Name="TabList"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SizeChanged="TabList_SizeChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <!-- Terminal Tab Template -->
                        <DataTemplate DataType="{x:Type vm:TerminalPairTabViewModel}">
                            <Border x:Name="TabBorder"
                                    Background="#3C3C3C"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4"
                                    Margin="0,0,2,0"
                                    MinWidth="120"
                                    AllowDrop="True"
                                    MouseDown="Tab_MouseDown"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tab_PreviewMouseMove"
                                    DragOver="Tab_DragOver"
                                    DragLeave="Tab_DragLeave"
                                    Drop="Tab_Drop">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="×"
                                            AutomationProperties.Name="Close tab"
                                            Style="{StaticResource TabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Activity spinner - rotates when terminal is active (hidden for selected tab) -->
                                    <TextBlock x:Name="ActivitySpinner"
                                               DockPanel.Dock="Right"
                                               Text="◐"
                                               Foreground="#FFD700"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               RenderTransformOrigin="0.5,0.5"
                                               Visibility="Collapsed">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               Text="{Binding TitleWithGit, Mode=OneWay}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                </DataTrigger>
                                <!-- Show and animate spinner when terminal is active AND tab is NOT selected -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAnyTerminalActive}" Value="True"/>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="ActivitySpinner" Property="Visibility" Value="Visible"/>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinnerStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="ActivitySpinner"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinnerStoryboard"/>
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- Settings Tab Template -->
                        <DataTemplate DataType="{x:Type vm:SettingsTabViewModel}">
                            <Border x:Name="TabBorder"
                                    Background="#3C3C3C"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4"
                                    Margin="0,0,2,0"
                                    MinWidth="100"
                                    AllowDrop="True"
                                    MouseDown="Tab_MouseDown"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tab_PreviewMouseMove"
                                    DragOver="Tab_DragOver"
                                    DragLeave="Tab_DragLeave"
                                    Drop="Tab_Drop">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="×"
                                            Style="{StaticResource TabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- Profiles Tab Template -->
                        <DataTemplate DataType="{x:Type vm:ProfilesTabViewModel}">
                            <Border x:Name="TabBorder"
                                    Background="#3C3C3C"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4"
                                    Margin="0,0,2,0"
                                    MinWidth="100"
                                    AllowDrop="True"
                                    MouseDown="Tab_MouseDown"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tab_PreviewMouseMove"
                                    DragOver="Tab_DragOver"
                                    DragLeave="Tab_DragLeave"
                                    Drop="Tab_Drop">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="×"
                                            Style="{StaticResource TabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- Statistics Tab Template -->
                        <DataTemplate DataType="{x:Type vm:StatisticsTabViewModel}">
                            <Border x:Name="TabBorder"
                                    Background="#3C3C3C"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4"
                                    Margin="0,0,2,0"
                                    MinWidth="100"
                                    AllowDrop="True"
                                    MouseDown="Tab_MouseDown"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tab_PreviewMouseMove"
                                    DragOver="Tab_DragOver"
                                    DragLeave="Tab_DragLeave"
                                    Drop="Tab_Drop">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="×"
                                            Style="{StaticResource TabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Tab Content Area -->
        <Grid Grid.Row="1">
            <!-- Show when there's a selected tab -->
            <ContentControl Content="{Binding SelectedTab}"
                            Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Resources>
                    <!-- Terminal Tab Content -->
                    <DataTemplate DataType="{x:Type vm:TerminalPairTabViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Terminal Switcher Bar -->
                            <Border Grid.Row="0" Background="#252525" Padding="8,4">
                                <DockPanel>
                                    <!-- Terminal Type Buttons -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding CustomIcon, StringFormat='{}{0} Claude Code'}"
                                                Command="{Binding ShowCustomTerminalCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTerminal}" Value="{x:Static domain:ActiveTerminal.Custom}">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{Binding ShellIcon, StringFormat='{}{0} Shell'}"
                                                Command="{Binding ShowShellTerminalCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTerminal}" Value="{x:Static domain:ActiveTerminal.Shell}">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <TextBlock Foreground="#666666" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Text="{Binding Pair.WorkingDirectory}"/>

                                        <!-- Git Status Display -->
                                        <TextBlock Foreground="#4EC9B0" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Text="{Binding GitStatusDisplay}"/>

                                        <!-- Quick Commands Separator -->
                                        <Border Width="1" Background="#444444" Margin="16,2,8,2"/>

                                        <!-- Built-in Quick Commands -->
                                        <Button x:Name="DetectedLinksButton"
                                                ToolTip="Detected Links - Click to view"
                                                AutomationProperties.Name="Detected Links"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DataContext.OpenDetectedLinksCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding HasDetectedLinks, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔗" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DetectedLinks.Count}"
                                                           FontSize="10"
                                                           Foreground="#4EC9B0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="📁"
                                                ToolTip="Open in Explorer (Ctrl+E)"
                                                AutomationProperties.Name="Open in Explorer"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="0,0,4,0"/>
                                        <Button Content="📝"
                                                ToolTip="Scratch Pad (Ctrl+Shift+N)"
                                                AutomationProperties.Name="Scratch Pad"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DataContext.OpenScratchPadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="0,0,4,0"/>
                                        <Button Content="📋"
                                                ToolTip="Git Changes (Ctrl+G)"
                                                AutomationProperties.Name="Git Changes"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DataContext.OpenGitChangesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="0,0,4,0"/>
                                        <Button Content="❓"
                                                ToolTip="Help &amp; Shortcuts (F1)"
                                                AutomationProperties.Name="Help"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Margin="0,0,4,0"/>

                                        <!-- Run Controls Separator -->
                                        <Border Width="1" Background="#444444" Margin="4,2,8,2"/>

                                        <!-- Run State Indicator (colored dot) -->
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding RunState, Converter={StaticResource RunStateToColorConverter}}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,4,0"/>

                                        <!-- Run/Stop Button -->
                                        <Button Content="{Binding RunState, Converter={StaticResource RunStateToIconConverter}}"
                                                ToolTip="{Binding RunState, Converter={StaticResource RunStateToTooltipConverter}}"
                                                AutomationProperties.Name="Toggle Project Run"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding ToggleRunCommand}"
                                                Margin="0,0,4,0"/>

                                        <!-- Run Configuration Dropdown (only if multiple configs) -->
                                        <ComboBox ItemsSource="{Binding RunConfigurations}"
                                                  SelectedItem="{Binding ActiveRunConfiguration}"
                                                  MinWidth="80"
                                                  Visibility="{Binding HasMultipleRunConfigs, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Style="{StaticResource DarkComboBox}"
                                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                                  Margin="0,0,4,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" Foreground="#CCCCCC"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Detected Run URL Button -->
                                        <Button ToolTip="{Binding DetectedRunUrl}"
                                                AutomationProperties.Name="Open Detected URL"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Click="OpenDetectedRunUrl_Click"
                                                Visibility="{Binding DetectedRunUrl, Converter={StaticResource NullToCollapsedConverter}}"
                                                Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌐" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding DetectedRunUrl}"
                                                           FontSize="10"
                                                           Foreground="#4EC9B0"
                                                           MaxWidth="150"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Toggle Run Terminal Visibility -->
                                        <ToggleButton IsChecked="{Binding IsRunTerminalVisible}"
                                                      Content="▶"
                                                      ToolTip="Show/Hide Run Terminal"
                                                      AutomationProperties.Name="Toggle Run Terminal Visibility"
                                                      Margin="0,0,8,0">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Background" Value="#2D2D2D"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Padding" Value="8,4"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="3"
                                                                        Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#3E3E3E"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>

                                        <!-- Separator between built-in and user commands -->
                                        <Border Width="1" Background="#444444" Margin="0,2,8,2"
                                                Visibility="{Binding DataContext.QuickCommands.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibilityConverter}}"/>

                                        <!-- User Quick Commands -->
                                        <ItemsControl ItemsSource="{Binding DataContext.QuickCommands, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding DisplayText}"
                                                            ToolTip="{Binding Tooltip}"
                                                            Style="{StaticResource TerminalSwitchButton}"
                                                            Command="{Binding DataContext.ExecuteQuickCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,4,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Terminal Content Area - Grid with dynamic column widths (3 columns when run terminal visible) -->
                            <Grid Grid.Row="1" Background="#1E1E1E">
                                <Grid.ColumnDefinitions>
                                    <!-- Custom terminal column -->
                                    <ColumnDefinition Width="{Binding CustomColumnWidth}"/>
                                    <!-- Splitter column -->
                                    <ColumnDefinition Width="4"/>
                                    <!-- Shell terminal column -->
                                    <ColumnDefinition Width="{Binding ShellColumnWidth}"/>
                                    <!-- Run splitter column (hidden when run terminal not visible) -->
                                    <ColumnDefinition Width="{Binding RunSplitterWidth}"/>
                                    <!-- Run terminal column (hidden when not visible) -->
                                    <ColumnDefinition Width="{Binding RunColumnWidth}"/>
                                </Grid.ColumnDefinitions>

                                <!-- Custom Terminal (Column 0) -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#333333" Padding="4,2">
                                        <TextBlock Foreground="#AAAAAA" FontSize="10">
                                            <Run Text="{Binding CustomIcon, Mode=OneWay}"/>
                                            <Run Text=" Claude Code"/>
                                        </TextBlock>
                                    </Border>
                                    <ContentPresenter Grid.Row="1" Content="{Binding CustomTerminalContent}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>

                                <!-- Splitter (Column 1) -->
                                <GridSplitter x:Name="TerminalSplitter" Grid.Column="1" Width="4" Background="#333333" HorizontalAlignment="Stretch"
                                              DragCompleted="GridSplitter_DragCompleted"/>

                                <!-- Shell Terminal (Column 2) -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#333333" Padding="4,2">
                                        <TextBlock Foreground="#AAAAAA" FontSize="10">
                                            <Run Text="{Binding ShellIcon, Mode=OneWay}"/>
                                            <Run Text=" Shell"/>
                                        </TextBlock>
                                    </Border>
                                    <ContentPresenter Grid.Row="1" Content="{Binding ShellTerminalContent}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>

                                <!-- Run Splitter (Column 3) - only visible when run terminal is visible -->
                                <GridSplitter x:Name="RunTerminalSplitter" Grid.Column="3" Width="4" Background="#333333" HorizontalAlignment="Stretch"
                                              Visibility="{Binding IsRunTerminalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                              DragCompleted="RunSplitter_DragCompleted"/>

                                <!-- Run Terminal (Column 4) - only visible when run terminal is visible -->
                                <Grid Grid.Column="4" Visibility="{Binding IsRunTerminalVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#333333" Padding="4,2">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="×"
                                                    Style="{StaticResource TabCloseButton}"
                                                    Command="{Binding ToggleRunTerminalCommand}"
                                                    AutomationProperties.Name="Hide Run Terminal"
                                                    ToolTip="Hide Run Terminal"/>
                                            <TextBlock Foreground="#AAAAAA" FontSize="10" VerticalAlignment="Center">
                                                <Run Text="▶ Run"/>
                                                <Run Text=" - " Foreground="#666666"/>
                                                <Run Text="{Binding ActiveRunConfiguration.Name, FallbackValue='Not configured'}" Foreground="#4EC9B0"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>
                                    <ContentPresenter Grid.Row="1" Content="{Binding RunTerminalContent}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>

                    <!-- Settings Tab Content -->
                    <DataTemplate DataType="{x:Type vm:SettingsTabViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>

                    <!-- Profiles Tab Content -->
                    <DataTemplate DataType="{x:Type vm:ProfilesTabViewModel}">
                        <views:ProfilesView/>
                    </DataTemplate>

                    <!-- Statistics Tab Content -->
                    <DataTemplate DataType="{x:Type vm:StatisticsTabViewModel}">
                        <views:StatisticsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- Empty State - Show a test terminal directly -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                    <TextBlock Text="Test terminal below - " Foreground="#666666" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="+ Open Project"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding OpenNewProjectCommand}"
                            Padding="16,8"/>
                </StackPanel>

                <!-- Direct XAML terminal test -->
                <term:EasyTerminalControl x:Name="TestTerminal"
                                          Grid.Row="1"
                                          StartupCommandLine="cmd.exe"
                                          Focusable="True"
                                          IsTabStop="True"
                                          Margin="10"
                                          GotFocus="TestTerminal_GotFocus"
                                          MouseDown="TestTerminal_MouseDown"/>
            </Grid>
        </Grid>

        <!-- Tab Dropdown Popup -->
        <Popup x:Name="TabDropdownPopup"
               PlacementTarget="{Binding ElementName=TabDropdownButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#2D2D2D"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4"
                    MaxHeight="400"
                    MinWidth="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox x:Name="DropdownSearchBox"
                             Grid.Row="0"
                             Background="#1E1E1E"
                             Foreground="#CCCCCC"
                             BorderBrush="#444444"
                             BorderThickness="1"
                             Padding="6,4"
                             Margin="0,0,0,4"
                             Text=""
                             TextChanged="DropdownSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="#1E1E1E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Tab List -->
                    <ListBox x:Name="DropdownTabList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="350"
                             SelectionChanged="DropdownTabList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding TabIcon}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#CCCCCC"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3E3E3E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0078D4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>

        <!-- Tab Switcher Popup (Ctrl+Shift+T) -->
        <Popup x:Name="TabSwitcherPopup"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#2D2D2D"
                    BorderBrush="#0078D4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    MinWidth="400"
                    MaxWidth="600"
                    MaxHeight="500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox x:Name="SwitcherSearchBox"
                             Grid.Row="0"
                             Background="#1E1E1E"
                             Foreground="#CCCCCC"
                             BorderBrush="#444444"
                             BorderThickness="1"
                             Padding="8,6"
                             Margin="0,0,0,8"
                             FontSize="14"
                             Text=""
                             TextChanged="SwitcherSearch_TextChanged"
                             PreviewKeyDown="SwitcherSearchBox_PreviewKeyDown"/>

                    <!-- Tab List -->
                    <ListBox x:Name="SwitcherTabList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="400"
                             MouseDoubleClick="SwitcherTabList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                               Text="{Binding TabIcon}"
                                               FontSize="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding Title}"
                                               Foreground="#FFFFFF"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding WorkingDirectory}"
                                               Foreground="#808080"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E3E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>

        <!-- File Preview Popup (Ctrl+Click on file paths) -->
        <Popup x:Name="FilePreviewPopup"
               Placement="Absolute"
               StaysOpen="True"
               AllowsTransparency="True">
            <Border x:Name="FilePreviewBorder" Background="#1E1E1E"
                    BorderBrush="#0078D4"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinWidth="400"
                    MinHeight="300"
                    Width="900"
                    Height="600">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header (draggable) -->
                    <Border x:Name="FilePreviewHeader" Grid.Row="0" Background="#2D2D2D" Padding="12,8" CornerRadius="6,6,0,0"
                            MouseLeftButtonDown="FilePreviewHeader_MouseLeftButtonDown"
                            MouseMove="FilePreviewHeader_MouseMove"
                            MouseLeftButtonUp="FilePreviewHeader_MouseLeftButtonUp"
                            Cursor="SizeAll">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="×"
                                    AutomationProperties.Name="Close Preview"
                                    Style="{StaticResource TabCloseButton}"
                                    Click="FilePreviewClose_Click"
                                    FontSize="16"
                                    Padding="8,2"/>
                            <Button DockPanel.Dock="Right"
                                    Content="✏️ Edit"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Click="FilePreviewOpenInEditor_Click"
                                    ToolTip="Open in built-in editor"
                                    Margin="0,0,8,0"/>
                            <TextBlock x:Name="FilePreviewTitle"
                                       Foreground="#CCCCCC"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="#1E1E1E">
                        <RichTextBox x:Name="FilePreviewContent"
                                     Background="#1E1E1E"
                                     Foreground="#CCCCCC"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     FontFamily="Cascadia Code NF, Consolas, Courier New"
                                     FontSize="13"
                                     Padding="0"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#2D2D2D" Padding="12,6" CornerRadius="0,0,6,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="#808080"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,0"
                                       Text="Press Escape to close"/>
                            <TextBlock x:Name="FilePreviewInfo"
                                       Foreground="#808080"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Resize grip (bottom-right corner, spans all rows, on top of everything) -->
                    <Thumb x:Name="FilePreviewResizeGrip" Grid.Row="2"
                           Width="16" Height="16"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,2,2"
                           Cursor="SizeNWSE"
                           DragDelta="FilePreviewResizeGrip_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Grid Background="Transparent">
                                    <Path Data="M 0,16 L 16,0 M 5,16 L 16,5 M 10,16 L 16,10"
                                          Stroke="#888888" StrokeThickness="1.5"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Border>
        </Popup>

        <!-- File Edit Popup (Ctrl+Shift+E) -->
        <!-- File Edit View -->
        <popups:FileEditView x:Name="FileEditViewControl" />

        <!-- Help Popup (F1) -->
        <Popup x:Name="HelpPopup"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#252525"
                    BorderBrush="#0078D4"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0"
                    MinWidth="700"
                    MaxWidth="900"
                    MaxHeight="850">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#2D2D2D" Padding="16,12" CornerRadius="8,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="×"
                                    AutomationProperties.Name="Close Help"
                                    Style="{StaticResource TabCloseButton}"
                                    Click="HelpClose_Click"
                                    FontSize="18"
                                    Padding="8,2"/>
                            <TextBlock Text="TerminalHost Help"
                                       Foreground="#FFFFFF"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                        <StackPanel>
                            <!-- Keyboard Shortcuts Section -->
                            <TextBlock Text="Keyboard Shortcuts" Foreground="#4EC9B0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                            <!-- Tab Navigation -->
                            <TextBlock Text="Tab Navigation" Foreground="#9CDCFE" FontSize="12" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+PageDown" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Next tab" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+PageUp" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Previous tab" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+1-9" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Jump to tab 1-9" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+T" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Open tab switcher (search tabs)" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+W" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Close current tab" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Middle-click tab" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Close tab" Foreground="#CCCCCC" Margin="0,2"/>
                            </Grid>

                            <!-- Terminal -->
                            <TextBlock Text="Terminal" Foreground="#9CDCFE" FontSize="12" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+`" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Switch between Custom/Shell terminal" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Links button" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Click to view detected URLs and file paths" Foreground="#CCCCCC" Margin="0,2"/>
                            </Grid>

                            <!-- File Operations -->
                            <TextBlock Text="File Operations" Foreground="#9CDCFE" FontSize="12" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+N" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Open new project (folder picker)" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+E" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Open current folder in Explorer" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+O" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Open file preview dialog" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+E" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Open file editor" Foreground="#CCCCCC" Margin="0,2"/>
                            </Grid>

                            <!-- Application -->
                            <TextBlock Text="Application" Foreground="#9CDCFE" FontSize="12" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+," Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Open settings editor" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+P" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Open profile management" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+P" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Open command palette" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+Shift+N" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Open scratch pad (notes)" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl+G" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Open git changes panel" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl+B" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Open git branch switcher" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="F1" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Show this help window" Foreground="#CCCCCC" Margin="0,2"/>
                            </Grid>

                            <!-- Quick Commands Section -->
                            <TextBlock Text="Default Quick Commands" Foreground="#4EC9B0" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,12"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl+Shift+C" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Send 'commit' to Claude Code" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+Shift+D" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Run 'git pull --rebase' in Shell" Foreground="#CCCCCC" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+Shift+U" Foreground="#CE9178" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Run 'git push' in Shell" Foreground="#CCCCCC" Margin="0,2"/>
                            </Grid>

                            <!-- Tips Section -->
                            <TextBlock Text="Tips" Foreground="#4EC9B0" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,12"/>
                            <TextBlock Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="• " Foreground="#569CD6"/><Run Text="Drag tabs to reorder them"/>
                            </TextBlock>
                            <TextBlock Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="• " Foreground="#569CD6"/><Run Text="Use the splitter between terminals to adjust the split ratio (saved per directory)"/>
                            </TextBlock>
                            <TextBlock Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="• " Foreground="#569CD6"/><Run Text="File preview supports syntax highlighting for: JSON, C#, JavaScript/TypeScript, Python, XML, Markdown, CSV/TSV"/>
                            </TextBlock>
                            <TextBlock Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run Text="• " Foreground="#569CD6"/><Run Text="Configure custom link patterns in Settings to make ticket IDs clickable"/>
                            </TextBlock>

                            <!-- Command Line Section -->
                            <TextBlock Text="Command Line Usage" Foreground="#4EC9B0" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,12"/>
                            <Border Background="#1E1E1E" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock FontFamily="Cascadia Code NF, Consolas" Foreground="#CCCCCC" Margin="0,2">
                                        <Run Text="host" Foreground="#4EC9B0"/>
                                        <Run Text="                  # Open/focus app"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Cascadia Code NF, Consolas" Foreground="#CCCCCC" Margin="0,2">
                                        <Run Text="host ." Foreground="#4EC9B0"/>
                                        <Run Text="                # Open project from current directory"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Cascadia Code NF, Consolas" Foreground="#CCCCCC" Margin="0,2">
                                        <Run Text="host P:\MyProject" Foreground="#4EC9B0"/>
                                        <Run Text="   # Open specific project"/>
                                    </TextBlock>
                                    <TextBlock FontFamily="Cascadia Code NF, Consolas" Foreground="#CCCCCC" Margin="0,2">
                                        <Run Text="host -w P:\Path" Foreground="#4EC9B0"/>
                                        <Run Text="     # Using named argument"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Paths Section -->
                            <TextBlock Text="Important Paths" Foreground="#4EC9B0" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Config file:" Foreground="#9CDCFE" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="%APPDATA%\TerminalHost\config.json" Foreground="#CE9178" FontFamily="Cascadia Code NF, Consolas" FontSize="12" Margin="0,2"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#2D2D2D" Padding="16,10" CornerRadius="0,0,8,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Foreground="#808080"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Text="Press Escape or F1 to close"/>
                            <TextBlock Foreground="#808080"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Text="TerminalHost v1.0"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>

        <!-- Command Palette Popup (Ctrl+Shift+P) -->
        <Popup x:Name="CommandPalettePopup"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#252525"
                    BorderBrush="#0078D4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="0"
                    Width="500"
                    MaxHeight="450">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Row="0" Background="#1E1E1E" Padding="12,10" CornerRadius="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text=">"
                                       Foreground="#0078D4"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="PaletteSearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     Foreground="#CCCCCC"
                                     CaretBrush="#CCCCCC"
                                     BorderThickness="0"
                                     FontSize="14"
                                     VerticalAlignment="Center"
                                     TextChanged="PaletteSearch_TextChanged"
                                     PreviewKeyDown="PaletteSearchBox_PreviewKeyDown"/>
                        </Grid>
                    </Border>

                    <!-- Command List -->
                    <ListBox x:Name="PaletteCommandList"
                             Grid.Row="1"
                             Background="#252525"
                             BorderThickness="0"
                             MaxHeight="380"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="PaletteCommandList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="#CCCCCC"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#808080"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   Visibility="{Binding Description, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#3C3C3C"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            Visibility="{Binding Shortcut, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding DisplayShortcut}"
                                                   Foreground="#808080"
                                                   FontSize="11"
                                                   FontFamily="Cascadia Code NF, Consolas"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="4,0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E3E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>

        <!-- Scratch Pad View (Ctrl+Shift+N) -->
        <views:ScratchPadView x:Name="ScratchPadViewControl" />

        <!-- Git Files View (Ctrl+G) -->
        <popups:GitFilesView x:Name="GitFilesViewControl" />

        <!-- Git Branch View (Ctrl+B) -->
        <popups:GitBranchView x:Name="GitBranchViewControl" />

        <!-- Detected Links View -->
        <popups:DetectedLinksView x:Name="DetectedLinksViewControl" />

        <!-- Command Palette Popup (Ctrl+Shift+P) -->
    </Grid>
</Window>
