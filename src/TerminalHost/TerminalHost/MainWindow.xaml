<Window x:Class="TerminalHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TerminalHost"
        xmlns:vm="clr-namespace:TerminalHost.ViewModels"
        xmlns:views="clr-namespace:TerminalHost.Views"
        xmlns:domain="clr-namespace:TerminalHost.Domain"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="Resources/app.ico"
        Height="700"
        Width="1100"
        Background="#1E1E1E"
        FontFamily="Cascadia Code NF, Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Tab Close Button Style -->
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E3E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Terminal Switch Button Style -->
        <Style x:Key="TerminalSwitchButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E3E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActiveTerminalButton" TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084D8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Settings Toolbar Button Style -->
        <Style x:Key="SettingsToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E4E4E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <!-- Activity spinner animation using rotation -->
        <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Bar -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="4">
            <DockPanel>
                <!-- New Project Button -->
                <Button DockPanel.Dock="Right"
                        Content="+ New Project"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding OpenNewProjectCommand}"
                        Margin="8,0,4,0"/>

                <!-- Settings Button -->
                <Button DockPanel.Dock="Right"
                        Content="Settings"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Settings (Ctrl+,)"
                        Margin="0,0,4,0"/>

                <!-- Profiles Button -->
                <Button DockPanel.Dock="Right"
                        Content="Profiles"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding OpenProfilesCommand}"
                        ToolTip="Manage Profiles (Ctrl+P)"
                        Margin="0,0,4,0"/>

                <!-- Tab Dropdown Button -->
                <Button x:Name="TabDropdownButton"
                        DockPanel.Dock="Right"
                        Content="▼"
                        Style="{StaticResource TerminalSwitchButton}"
                        Click="TabDropdown_Click"
                        ToolTip="All tabs (Ctrl+Shift+T)"
                        Visibility="Collapsed"
                        Margin="0,0,4,0"/>

                <!-- Scroll Right Button -->
                <Button x:Name="ScrollRightButton"
                        DockPanel.Dock="Right"
                        Content="›"
                        Style="{StaticResource TerminalSwitchButton}"
                        Click="ScrollRight_Click"
                        ToolTip="Scroll right"
                        Visibility="Collapsed"
                        Padding="6,4"
                        Margin="0,0,2,0"/>

                <!-- Scroll Left Button -->
                <Button x:Name="ScrollLeftButton"
                        DockPanel.Dock="Right"
                        Content="‹"
                        Style="{StaticResource TerminalSwitchButton}"
                        Click="ScrollLeft_Click"
                        ToolTip="Scroll left"
                        Visibility="Collapsed"
                        Padding="6,4"
                        Margin="0,0,2,0"/>

                <!-- Tab List -->
                <ListBox x:Name="TabList"
                         ItemsSource="{Binding Tabs}"
                         SelectedItem="{Binding SelectedTab}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SizeChanged="TabList_SizeChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Resources>
                        <!-- Terminal Tab Template -->
                        <DataTemplate DataType="{x:Type vm:TerminalPairTabViewModel}">
                            <Border x:Name="TabBorder"
                                    Background="#3C3C3C"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4"
                                    Margin="0,0,2,0"
                                    MinWidth="120"
                                    AllowDrop="True"
                                    MouseDown="Tab_MouseDown"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tab_PreviewMouseMove"
                                    DragOver="Tab_DragOver"
                                    DragLeave="Tab_DragLeave"
                                    Drop="Tab_Drop">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="×"
                                            Style="{StaticResource TabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <!-- Activity spinner - rotates when terminal is active -->
                                    <TextBlock x:Name="ActivitySpinner"
                                               DockPanel.Dock="Right"
                                               Text="◌"
                                               Foreground="#4EC9B0"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               RenderTransformOrigin="0.5,0.5"
                                               Visibility="Collapsed">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               Text="{Binding TitleWithGit, Mode=OneWay}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                </DataTrigger>
                                <!-- Show and animate spinner when any terminal is active -->
                                <DataTrigger Binding="{Binding IsAnyTerminalActive}" Value="True">
                                    <Setter TargetName="ActivitySpinner" Property="Visibility" Value="Visible"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinnerStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="ActivitySpinner"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinnerStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- Settings Tab Template -->
                        <DataTemplate DataType="{x:Type vm:SettingsTabViewModel}">
                            <Border x:Name="TabBorder"
                                    Background="#3C3C3C"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4"
                                    Margin="0,0,2,0"
                                    MinWidth="100"
                                    AllowDrop="True"
                                    MouseDown="Tab_MouseDown"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tab_PreviewMouseMove"
                                    DragOver="Tab_DragOver"
                                    DragLeave="Tab_DragLeave"
                                    Drop="Tab_Drop">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="×"
                                            Style="{StaticResource TabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>

                        <!-- Profiles Tab Template -->
                        <DataTemplate DataType="{x:Type vm:ProfilesTabViewModel}">
                            <Border x:Name="TabBorder"
                                    Background="#3C3C3C"
                                    CornerRadius="4,4,0,0"
                                    Padding="8,4"
                                    Margin="0,0,2,0"
                                    MinWidth="100"
                                    AllowDrop="True"
                                    MouseDown="Tab_MouseDown"
                                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="Tab_PreviewMouseMove"
                                    DragOver="Tab_DragOver"
                                    DragLeave="Tab_DragLeave"
                                    Drop="Tab_Drop">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="×"
                                            Style="{StaticResource TabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Foreground="#CCCCCC"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Tab Content Area -->
        <Grid Grid.Row="1">
            <!-- Show when there's a selected tab -->
            <ContentControl Content="{Binding SelectedTab}"
                            Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl.Resources>
                    <!-- Terminal Tab Content -->
                    <DataTemplate DataType="{x:Type vm:TerminalPairTabViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Terminal Switcher Bar -->
                            <Border Grid.Row="0" Background="#252525" Padding="8,4">
                                <DockPanel>
                                    <!-- Terminal Type Buttons -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding CustomIcon, StringFormat='{}{0} Claude Code'}"
                                                Command="{Binding ShowCustomTerminalCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTerminal}" Value="{x:Static domain:ActiveTerminal.Custom}">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{Binding ShellIcon, StringFormat='{}{0} Shell'}"
                                                Command="{Binding ShowShellTerminalCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ActiveTerminal}" Value="{x:Static domain:ActiveTerminal.Shell}">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <TextBlock Foreground="#666666" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Text="{Binding Pair.WorkingDirectory}"/>

                                        <!-- Git Status Display -->
                                        <TextBlock Foreground="#4EC9B0" VerticalAlignment="Center" Margin="16,0,0,0"
                                                   Text="{Binding GitStatusDisplay}"/>

                                        <!-- Quick Commands Separator -->
                                        <Border Width="1" Background="#444444" Margin="16,2,8,2"/>

                                        <!-- Quick Commands -->
                                        <ItemsControl ItemsSource="{Binding DataContext.QuickCommands, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding DisplayText}"
                                                            ToolTip="{Binding Tooltip}"
                                                            Style="{StaticResource TerminalSwitchButton}"
                                                            Command="{Binding DataContext.ExecuteQuickCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,4,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Terminal Content Area - Single grid with dynamic column widths -->
                            <Grid Grid.Row="1" Background="#1E1E1E">
                                <Grid.ColumnDefinitions>
                                    <!-- Custom terminal column -->
                                    <ColumnDefinition Width="{Binding CustomColumnWidth}"/>
                                    <!-- Splitter column -->
                                    <ColumnDefinition Width="4"/>
                                    <!-- Shell terminal column -->
                                    <ColumnDefinition Width="{Binding ShellColumnWidth}"/>
                                </Grid.ColumnDefinitions>

                                <!-- Custom Terminal (Left) -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#333333" Padding="4,2">
                                        <TextBlock Foreground="#AAAAAA" FontSize="10">
                                            <Run Text="{Binding CustomIcon, Mode=OneWay}"/>
                                            <Run Text=" Claude Code"/>
                                        </TextBlock>
                                    </Border>
                                    <ContentPresenter Grid.Row="1" Content="{Binding CustomTerminalContent}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>

                                <!-- Splitter -->
                                <GridSplitter x:Name="TerminalSplitter" Grid.Column="1" Width="4" Background="#333333" HorizontalAlignment="Stretch"
                                              DragCompleted="GridSplitter_DragCompleted"/>

                                <!-- Shell Terminal (Right) -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#333333" Padding="4,2">
                                        <TextBlock Foreground="#AAAAAA" FontSize="10">
                                            <Run Text="{Binding ShellIcon, Mode=OneWay}"/>
                                            <Run Text=" Shell"/>
                                        </TextBlock>
                                    </Border>
                                    <ContentPresenter Grid.Row="1" Content="{Binding ShellTerminalContent}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>

                    <!-- Settings Tab Content -->
                    <DataTemplate DataType="{x:Type vm:SettingsTabViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>

                    <!-- Profiles Tab Content -->
                    <DataTemplate DataType="{x:Type vm:ProfilesTabViewModel}">
                        <views:ProfilesView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>

            <!-- Empty State - Show a test terminal directly -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                    <TextBlock Text="Test terminal below - " Foreground="#666666" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="+ Open Project"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding OpenNewProjectCommand}"
                            Padding="16,8"/>
                </StackPanel>

                <!-- Direct XAML terminal test -->
                <term:EasyTerminalControl x:Name="TestTerminal"
                                          Grid.Row="1"
                                          StartupCommandLine="cmd.exe"
                                          Focusable="True"
                                          IsTabStop="True"
                                          Margin="10"
                                          GotFocus="TestTerminal_GotFocus"
                                          MouseDown="TestTerminal_MouseDown"/>
            </Grid>
        </Grid>

        <!-- Tab Dropdown Popup -->
        <Popup x:Name="TabDropdownPopup"
               PlacementTarget="{Binding ElementName=TabDropdownButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#2D2D2D"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4"
                    MaxHeight="400"
                    MinWidth="200">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox x:Name="DropdownSearchBox"
                             Grid.Row="0"
                             Background="#1E1E1E"
                             Foreground="#CCCCCC"
                             BorderBrush="#444444"
                             BorderThickness="1"
                             Padding="6,4"
                             Margin="0,0,0,4"
                             Text=""
                             TextChanged="DropdownSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="#1E1E1E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Tab List -->
                    <ListBox x:Name="DropdownTabList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="350"
                             SelectionChanged="DropdownTabList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <TextBlock Text="{Binding TabIcon}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#CCCCCC"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3E3E3E"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0078D4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>

        <!-- Tab Switcher Popup (Ctrl+Shift+T) -->
        <Popup x:Name="TabSwitcherPopup"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="#2D2D2D"
                    BorderBrush="#0078D4"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    MinWidth="400"
                    MaxWidth="600"
                    MaxHeight="500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox x:Name="SwitcherSearchBox"
                             Grid.Row="0"
                             Background="#1E1E1E"
                             Foreground="#CCCCCC"
                             BorderBrush="#444444"
                             BorderThickness="1"
                             Padding="8,6"
                             Margin="0,0,0,8"
                             FontSize="14"
                             Text=""
                             TextChanged="SwitcherSearch_TextChanged"
                             PreviewKeyDown="SwitcherSearchBox_PreviewKeyDown"/>

                    <!-- Tab List -->
                    <ListBox x:Name="SwitcherTabList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="400"
                             MouseDoubleClick="SwitcherTabList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                               Text="{Binding TabIcon}"
                                               FontSize="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>

                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding Title}"
                                               Foreground="#FFFFFF"
                                               FontSize="13"/>

                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding WorkingDirectory}"
                                               Foreground="#808080"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E3E"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
