  <!--
    Note: .axaml files (MainWindow.axaml, App.axaml, Styles/*.axaml, Resources/*.axaml)
    are automatically included by the Avalonia SDK as AvaloniaResource.
    Converters\*.cs files are automatically included by the SDK as Compile.
  -->

  <!--
    Note: Converters\*.cs files are automatically included by the SDK
    since we only excluded the root Converters.cs, not the Converters folder
  -->

  <!-- Remove PDB files after publish -->
  <Target Name="RemovePdbFiles" AfterTargets="Publish">
    <ItemGroup>
      <PdbFilesToDelete Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PdbFilesToDelete)" />
  </Target>

</Project>
