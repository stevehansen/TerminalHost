<UserControl x:Class="TerminalHost.Views.MemoryBrowserContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:MemoryBrowserViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Memory list item style -->
        <Style x:Key="MemoryListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#334155">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="#334155"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar button style -->
        <Style x:Key="MemoryToolbarButton" TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stats badge style -->
        <Style x:Key="StatsBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Layer stack item style -->
        <Style x:Key="LayerBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header + stats -->
            <RowDefinition Height="Auto"/>  <!-- Search + filters -->
            <RowDefinition Height="*"/>     <!-- Content (list + detail) -->
        </Grid.RowDefinitions>

        <!-- Header Row: Title, Stats, Actions -->
        <Border Grid.Row="0" Background="#1E293B" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#334155">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title + connection status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border CornerRadius="3" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#334155"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                        <Setter Property="Background" Value="#065F46"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Stats badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatsBadge}" Background="#1A1E2E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ObservationCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatsBadge}" Background="#1A1E2E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding InsightCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatsBadge}" Background="#1A1E2E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ProcedureCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatsBadge}" Background="#1A1E2E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding HeuristicCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding TotalCount, StringFormat='({0} total)'}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MemoryToolbarButton}" Content="🔄" ToolTip="Refresh" Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource MemoryToolbarButton}" Content="📥" ToolTip="Run Intake" Command="{Binding RunIntakeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search + Filters Row -->
        <Border Grid.Row="1" Background="#1E293B" Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="#334155">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                         Style="{StaticResource FormTextBox}"
                         Padding="8,6"
                         FontSize="13"/>

                <!-- Type filter -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding TypeFilters}"
                          SelectedItem="{Binding SelectedTypeFilter}"
                          Style="{StaticResource DarkComboBox}"
                          Width="120"
                          Margin="8,0,0,0"/>

                <!-- Source filter -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding SourceFilters}"
                          SelectedItem="{Binding SelectedSourceFilter}"
                          Style="{StaticResource DarkComboBox}"
                          Width="130"
                          Margin="8,0,0,0"/>

                <!-- Show expired toggle -->
                <CheckBox Grid.Column="3"
                          IsChecked="{Binding ShowExpired}"
                          Content="Expired"
                          Foreground="{StaticResource TextSecondaryBrush}"
                          FontSize="12"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Content Area: Memory list + Detail pane + Layer stack -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Memory List -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Memories}"
                     SelectedItem="{Binding SelectedItem}"
                     ItemContainerStyle="{StaticResource MemoryListBoxItemStyle}"
                     Background="Transparent"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Type icon -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                       Text="{Binding TypeIcon}"
                                       FontSize="20"
                                       VerticalAlignment="Top"
                                       Margin="0,2,10,0"/>

                            <!-- Content preview -->
                            <TextBlock Grid.Column="1" Grid.Row="0"
                                       Text="{Binding DisplayContent}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       MaxHeight="60"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Tags row -->
                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="{Binding TagsDisplay}"
                                       Foreground="#64748B"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding TagsDisplay, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>

                            <!-- Source + Age -->
                            <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Source}" Foreground="#475569" FontSize="10"/>
                                <TextBlock Text=" · " Foreground="#475569" FontSize="10"/>
                                <TextBlock Text="{Binding AgeDisplay}" Foreground="#475569" FontSize="10"/>
                            </StackPanel>

                            <!-- Importance -->
                            <TextBlock Grid.Column="2" Grid.Row="0"
                                       Text="{Binding ImportanceDisplay}"
                                       Foreground="#94A3B8"
                                       FontSize="11"
                                       VerticalAlignment="Top"
                                       Margin="8,2,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" Background="#334155" HorizontalAlignment="Stretch"/>

            <!-- Right Pane: Detail + Layer Stack -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Detail View -->
                <Border Grid.Row="0" Background="#0F172A" Padding="12">
                    <Grid>
                        <TextBlock Text="Select a memory to view details"
                                   Foreground="#475569"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibleConverter}}"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding SelectedItem, Converter={StaticResource NullToCollapsedConverter}}">
                            <StackPanel DataContext="{Binding SelectedItem}">
                                <!-- Type + ID header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding TypeIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- ID -->
                                <TextBlock Text="{Binding Id}" Foreground="#475569" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <!-- Full content -->
                                <TextBlock Text="Content" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Border Background="#1E293B" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Content}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Tags -->
                                <TextBlock Text="Tags" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="{Binding TagsDisplay, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding TagsDisplay}" Foreground="#60A5FA" FontSize="12" Margin="0,0,0,12"
                                           Visibility="{Binding TagsDisplay, Converter={StaticResource NonEmptyStringToVisibilityConverter}}"/>

                                <!-- Entities -->
                                <TextBlock Text="Entities" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="{Binding HasEntities, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding EntitiesDisplay}" Foreground="#A78BFA" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                                           Visibility="{Binding HasEntities, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Foresight Hint -->
                                <TextBlock Text="Foresight" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="{Binding HasForesight, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border Background="#1A2332" CornerRadius="4" Padding="8" Margin="0,0,0,12"
                                        Visibility="{Binding HasForesight, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ForesightHint}" Foreground="#34D399" FontSize="11" TextWrapping="Wrap" FontStyle="Italic"/>
                                </Border>

                                <!-- Metadata -->
                                <TextBlock Text="Metadata" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Importance:" Foreground="#64748B" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ImportanceDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Confidence:" Foreground="#64748B" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfidenceDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Provenance:" Foreground="#64748B" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProvenanceDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Access Count:" Foreground="#64748B" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AccessCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,2"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Created:" Foreground="#64748B" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,2"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Source:" Foreground="#64748B" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Source}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,2"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Last Accessed:" Foreground="#64748B" FontSize="11" Margin="0,2"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastAccessedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}', TargetNullValue='Never'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,2"/>
                                </Grid>

                                <!-- Forget button -->
                                <Button Content="🗑 Forget Memory"
                                        Command="{Binding DataContext.ForgetMemoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource MemoryToolbarButton}"
                                        HorizontalAlignment="Left"
                                        Foreground="#EF4444"
                                        FontSize="12"
                                        Padding="8,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Layer Stack (bottom) -->
                <Border Grid.Row="1" Background="#1E293B" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="#334155"
                        MaxHeight="200">
                    <StackPanel>
                        <TextBlock Text="LAYER STACK" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource LayerBorder}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#0F172A"/>
                                        </Border.Background>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding EntryCount}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="3" Foreground="#475569" FontSize="10" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReadOnly}" Value="True">
                                                                <Setter Property="Text" Value="🔒"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loading overlay -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Loading..."
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
