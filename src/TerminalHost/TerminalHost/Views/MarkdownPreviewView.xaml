<UserControl x:Class="TerminalHost.Views.MarkdownPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1E1E1E"
             d:DataContext="{d:DesignInstance Type=vm:MarkdownPreviewViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header/Toolbar -->
        <Border Grid.Row="0" Background="#252526" Padding="8,6">
            <DockPanel>
                <!-- Right side buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="8,4"
                            Margin="0,0,4,0"
                            Background="#3C3C3C"
                            Foreground="#CCCCCC"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Refresh (F5)"/>
                    <ToggleButton x:Name="AutoReloadToggle"
                                  Content="Auto"
                                  IsChecked="{Binding AutoReload}"
                                  Padding="8,4"
                                  Margin="0,0,4,0"
                                  Cursor="Hand"
                                  ToolTip="Auto-reload on file change">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#2EA043"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4C4C4C"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>

                <!-- File path info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MD"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#569CD6"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding FileName}"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FilePath}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- WebView2 Content -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"
                          DefaultBackgroundColor="#FF1E1E1E"/>

            <!-- Loading overlay -->
            <Border Background="#CC1E1E1E"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Loading..."
                           FontSize="14"
                           Foreground="#808080"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#252526" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="#808080"/>
        </Border>
    </Grid>
</UserControl>
