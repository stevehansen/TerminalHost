<UserControl x:Class="TerminalHost.Views.MarkdownPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1E1E1E"
             d:DataContext="{d:DesignInstance Type=vm:MarkdownPreviewViewModel}">

    <Grid>
        <!-- Use MarkdownViewer control for consistent link handling and error toasts -->
        <controls:MarkdownViewer x:Name="MarkdownViewer"
                                 HtmlContent="{Binding RenderedHtml}"
                                 BasePath="{Binding MarkdownBasePath}"
                                 MarkdownLinkClicked="OnMarkdownLinkClicked"/>

        <!-- Loading overlay -->
        <Border Background="#CC1E1E1E"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading..."
                       FontSize="14"
                       Foreground="#808080"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
