<UserControl x:Class="TerminalHost.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1E1E1E">
    <UserControl.Resources>
        <!-- Button Style -->
        <Style x:Key="ProfileButton" TargetType="Button">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4E4E4E"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ProfileButton}">
            <Setter Property="Background" Value="#5A2D2D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8B3A3A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ProfileButton}">
            <Setter Property="Background" Value="#0E639C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1177BB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#3C3C3C"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Cascadia Code NF, Segoe UI"/>
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="FormCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Profile List -->
        <Grid Grid.Column="0" Background="#252525">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- List Header -->
            <Border Grid.Row="0" Background="#2D2D2D" Padding="12,8">
                <DockPanel>
                    <Button Content="+ Add"
                            DockPanel.Dock="Right"
                            Command="{Binding AddNewCommand}"
                            Style="{StaticResource ProfileButton}"/>
                    <TextBlock Text="Custom Profiles"
                               Foreground="#CCCCCC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Profile List -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Profiles}"
                     SelectedItem="{Binding SelectedProfile}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" Margin="4,2">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="#CCCCCC"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding DisplayInfo}"
                                           Foreground="#808080"
                                           FontSize="11"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#0E639C"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3C3C3C"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Border" Property="Background" Value="#1177BB"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Empty State -->
            <TextBlock Grid.Row="1"
                       Text="No custom profiles yet.&#x0a;Click + Add to create one."
                       Foreground="#666666"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Visibility="{Binding Profiles.Count, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
        </Grid>

        <!-- Right Panel: Edit Form or Details -->
        <Grid Grid.Column="1">
            <!-- Edit Form (when editing) -->
            <ScrollViewer Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="{Binding SelectedProfile, TargetNullValue='New Profile', StringFormat='Edit: {0}'}"
                               Foreground="#CCCCCC"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,24"/>

                    <!-- Name -->
                    <TextBlock Text="Name" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             Margin="0,0,0,16"/>

                    <!-- Command -->
                    <TextBlock Text="Command" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditCommand, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             Margin="0,0,0,16"/>

                    <!-- Icon -->
                    <TextBlock Text="Icon (emoji or symbol)" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditIcon, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             Width="100"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,16"/>

                    <!-- Shortcut -->
                    <TextBlock Text="Keyboard Shortcut (e.g., Ctrl+Shift+P)" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditShortcut, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBox}"
                             Width="200"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,16"/>

                    <!-- Auto-start -->
                    <CheckBox Content="Auto-start on application launch"
                              IsChecked="{Binding EditAutoStart}"
                              Style="{StaticResource FormCheckBox}"
                              Margin="0,0,0,24"/>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#F48771"
                               FontSize="12"
                               Margin="0,0,0,16"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="80"/>
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource ProfileButton}"
                                Width="80"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="80"
                                Visibility="{Binding SelectedProfile, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="24,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Details View (when not editing) -->
            <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <!-- Profile Selected -->
                <StackPanel Margin="24"
                            Visibility="{Binding SelectedProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedProfile.DisplayName}"
                               Foreground="#CCCCCC"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Command" Foreground="#808080" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedProfile.Command}"
                               Foreground="#CCCCCC"
                               FontSize="14"
                               FontFamily="Cascadia Code NF, Consolas"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Shortcut" Foreground="#808080" FontSize="12" Margin="0,0,0,4"
                               Visibility="{Binding SelectedProfile.Shortcut, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding SelectedProfile.Shortcut}"
                               Foreground="#CCCCCC"
                               FontSize="14"
                               Margin="0,0,0,16"
                               Visibility="{Binding SelectedProfile.Shortcut, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock Text="Auto-start enabled"
                               Foreground="#4EC9B0"
                               FontSize="12"
                               Margin="0,0,0,24"
                               Visibility="{Binding SelectedProfile.AutoStart, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶ Launch"
                                ToolTip="Launch profile (use profile's working directory)"
                                Command="{Binding LaunchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100"/>
                        <Button Content="📁 In Folder..."
                                ToolTip="Launch with folder picker"
                                Command="{Binding LaunchWithFolderCommand}"
                                Style="{StaticResource ProfileButton}"
                                Width="120"/>
                        <Button Content="Edit"
                                Command="{Binding StartEditCommand}"
                                Style="{StaticResource ProfileButton}"
                                Width="80"
                                Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- No Selection -->
                <TextBlock Text="Select a profile to view details&#x0a;or click + Add to create a new one."
                           Foreground="#666666"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="{Binding SelectedProfile, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
