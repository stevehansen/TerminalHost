<UserControl x:Class="TerminalHost.Views.VoiceBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="600"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">

    <Border x:Name="BarBorder"
            Background="#E8202020"
            BorderBrush="{StaticResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="80,6,80,0"
            Padding="10,6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Icon -->
                <ColumnDefinition Width="Auto"/>
                <!-- Transcript text -->
                <ColumnDefinition Width="*"/>
                <!-- Arrow + matched command -->
                <ColumnDefinition Width="Auto"/>
                <!-- Countdown / actions -->
                <ColumnDefinition Width="Auto"/>
                <!-- Close button -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Icon (mic, hourglass, arrow, etc.) -->
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusIcon}"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <!-- Pulse animation when listening -->
                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseMic">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.4" Duration="0:0:0.6"
                                                             AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseMic"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Transcript Text -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Transcript}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,8,0"/>

            <!-- Matched Command (Preview state) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="→"
                           Foreground="{StaticResource TextDimmedBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBlock Text="{Binding MatchedCommandName}"
                           Foreground="{StaticResource AccentOrangeBrush}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MatchedCommandShortcut}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"
                           Visibility="{Binding MatchedCommandShortcut, Converter={StaticResource NullToCollapsedConverter}}"/>
            </StackPanel>

            <!-- Executed confirmation -->
            <TextBlock Grid.Column="2"
                       Text="{Binding MatchedCommandName}"
                       Foreground="{StaticResource AccentGreenBrush}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Visibility="{Binding IsExecuted, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Alternatives (NoMatch state) -->
            <ItemsControl Grid.Column="2"
                          ItemsSource="{Binding Alternatives}"
                          Visibility="{Binding IsNoMatch, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Command.DisplayName}"
                                Command="{Binding DataContext.SelectAlternativeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                FontSize="11"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Background="{StaticResource BackgroundLightBrush}"
                                BorderThickness="0"
                                Padding="6,2"
                                Margin="2,0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Actions area -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">

                <!-- Countdown display (Preview state) -->
                <Grid Visibility="{Binding ShowCountdown, Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="0,0,6,0"
                      Width="60" Height="20">
                    <!-- Background track -->
                    <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="3"/>
                    <!-- Shrinking progress bar (ScaleX 1.0→0.0 as countdown expires) -->
                    <Border CornerRadius="3" HorizontalAlignment="Stretch"
                            RenderTransformOrigin="0,0.5">
                        <Border.Background>
                            <SolidColorBrush Color="#0078D4" Opacity="0.6"/>
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding CountdownProgress}" ScaleY="1"/>
                        </Border.RenderTransform>
                    </Border>
                    <!-- Countdown number -->
                    <TextBlock Text="{Binding CountdownRemaining, StringFormat={}{0}s}"
                               Foreground="{StaticResource TextBrightBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Execute Now button (Preview state — skip countdown) -->
                <Button Content="✓"
                        Command="{Binding ExecuteNowCommand}"
                        ToolTip="Execute now"
                        Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibilityConverter}}"
                        Foreground="{StaticResource AccentGreenBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Padding="4,0"
                        Margin="0,0,2,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Send to AI button (NoMatch state) -->
                <Button Content="Send to AI"
                        Command="{Binding SendToAiCommand}"
                        ToolTip="Send transcript to AI terminal"
                        Visibility="{Binding ShowSendToAi, Converter={StaticResource BoolToVisibilityConverter}}"
                        Foreground="{StaticResource TextBrightBrush}"
                        Background="{StaticResource AccentPrimaryBrush}"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand"
                        Padding="8,3"
                        Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Close / Cancel button -->
                <Button Content="✕"
                        Command="{Binding CancelCommand}"
                        ToolTip="Cancel (Escape)"
                        Foreground="{StaticResource TextMutedBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        Cursor="Hand"
                        Padding="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
