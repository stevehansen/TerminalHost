<UserControl x:Class="TerminalHost.Views.BranchComparisonContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             d:DataContext="{d:DesignInstance viewModels:BranchComparisonViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Branch Selection -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Base:"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableBranches}"
                          SelectedItem="{Binding BaseBranch}"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          FontSize="{StaticResource FontSizeCode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ShortName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Column="2"
                           Text="vs"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center"
                           Margin="12,0"/>

                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding AvailableBranches}"
                          SelectedItem="{Binding CompareBranch}"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          FontSize="{StaticResource FontSizeCode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ShortName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="4"
                        Content="Swap"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding SwapBranchesCommand}"
                        ToolTip="Swap base and compare branches"
                        Margin="8,0,0,0"/>

                <Button Grid.Column="5"
                        Content="Compare"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding CompareCommand}"
                        Margin="4,0,0,0"
                        Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Status/Summary -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8"
                Visibility="{Binding ComparisonResult, Converter={StaticResource NullToCollapsedConverter}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Fast-Forward"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding FastForwardBaseToCompareCommand}"
                            Visibility="{Binding ComparisonResult.CanFastForwardBaseToCompare, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                            ToolTip="Fast-forward base branch to match compare branch"
                            Margin="0,0,4,0"/>
                    <Button Content="Reset"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding ResetBaseToCompareCommand}"
                            ToolTip="Reset base branch to match compare branch (destructive)"
                            Foreground="{StaticResource AccentOrangeBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- View Mode Toggle -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,4"
                Visibility="{Binding ComparisonResult, Converter={StaticResource NullToCollapsedConverter}}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Commits" GroupName="CompareViewMode"
                             IsChecked="{Binding IsCommitsView, Mode=OneWay}"
                             Command="{Binding SetViewModeCommand}" CommandParameter="Commits"
                             Style="{StaticResource PopupModeTabButton}"
                             Margin="0,0,4,0"/>
                <RadioButton GroupName="CompareViewMode"
                             IsChecked="{Binding IsFilesView, Mode=OneWay}"
                             Command="{Binding SetViewModeCommand}" CommandParameter="Files"
                             Style="{StaticResource PopupModeTabButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Files"/>
                        <TextBlock Text="{Binding ChangedFiles.Count, StringFormat=' ({0})'}"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Comparison Content -->
        <Grid Grid.Row="3" Margin="0">

            <!-- Commits View (two-column commit lists) -->
            <Grid Visibility="{Binding IsCommitsView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Commits only in Base -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Commits only in "
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"/>
                            <TextBlock Text="{Binding BaseBranch.ShortName, FallbackValue='base'}"
                                       Foreground="{StaticResource SyntaxGreenBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text=" ("
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"/>
                            <TextBlock Text="{Binding CommitsInBase.Count}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"/>
                            <TextBlock Text=")"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding CommitsInBase}"
                             SelectedItem="{Binding SelectedCommit}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ShortHash}"
                                               Foreground="{StaticResource SyntaxYellowBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Subject}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RelativeDate}"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               Text="No unique commits"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding CommitsInBase.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Commits only in Compare -->
            <Border Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Commits only in "
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"/>
                            <TextBlock Text="{Binding CompareBranch.ShortName, FallbackValue='compare'}"
                                       Foreground="{StaticResource SyntaxCyanBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text=" ("
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"/>
                            <TextBlock Text="{Binding CommitsInCompare.Count}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"/>
                            <TextBlock Text=")"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding CommitsInCompare}"
                             SelectedItem="{Binding SelectedCommit}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ShortHash}"
                                               Foreground="{StaticResource SyntaxYellowBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               FontFamily="Consolas"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Subject}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RelativeDate}"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               Text="No unique commits"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding CommitsInCompare.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Loading overlay -->
            <Border Grid.ColumnSpan="2"
                    Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Comparing branches..."
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeNormal}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            </Grid>
            <!-- End of Commits View -->

            <!-- Files View (file list + diff) -->
            <Grid Visibility="{Binding IsFilesView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="200"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- File List -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                            <TextBlock Foreground="{StaticResource TextDimmedBrush}" FontSize="{StaticResource FontSizeTiny}">
                                <Run Text="{Binding ChangedFiles.Count, Mode=OneWay}"/>
                                <Run Text="files changed"/>
                            </TextBlock>
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ChangedFiles}"
                                 SelectedItem="{Binding SelectedFile}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                                   Text="{Binding StatusIcon}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding StatusDescription}"/>

                                        <TextBlock Grid.Column="1" Grid.Row="0"
                                                   Text="{Binding FileName}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="1" Grid.Row="1"
                                                   Text="{Binding Directory}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeMicro}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Directory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Padding="{TemplateBinding Padding}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                    <Setter Property="Background" Value="#333333"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Empty state -->
                        <TextBlock Grid.Row="1"
                                   Text="No file changes"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ChangedFiles.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

                <!-- Diff Area -->
                <Border Grid.Column="2" Background="{StaticResource BackgroundDarkestBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                            <TextBlock Text="{Binding SelectedFile.FilePath, StringFormat='Diff: {0}', FallbackValue='Select a file to view diff'}"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <controls:DiffViewer Grid.Row="1" DiffText="{Binding DiffText}"/>
                    </Grid>
                </Border>
            </Grid>
            <!-- End of Files View -->

            <!-- No comparison yet -->
            <TextBlock Text="Select two branches and click Compare"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding ComparisonResult, Converter={StaticResource NullToVisibleConverter}}"/>

            <!-- Loading overlay -->
            <Border Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Comparing branches..."
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeNormal}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
