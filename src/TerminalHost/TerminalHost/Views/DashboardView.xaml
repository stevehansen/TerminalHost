<UserControl x:Class="TerminalHost.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:DashboardTabViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkestBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="12,12,12,8">
                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   FontSize="{StaticResource FontSizeLarge}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding StatusMessage}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Section Buttons -->
                <StackPanel Grid.Row="1" Margin="8,0">
                    <!-- Review Requests -->
                    <Border CornerRadius="4" Margin="0,2"
                            Background="{Binding IsReviewSelected, Converter={StaticResource BoolToBackgroundConverter}}">
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="Review"
                                Style="{StaticResource TerminalSwitchButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,8">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Review" Width="100"
                                               FontWeight="{Binding IsReviewSelected, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                    <Border Background="{StaticResource SyntaxBlueBrush}" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{Binding ReviewRequestsCount}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Border>

                    <!-- My PRs -->
                    <Border CornerRadius="4" Margin="0,2"
                            Background="{Binding IsMyPRsSelected, Converter={StaticResource BoolToBackgroundConverter}}">
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="MyPRs"
                                Style="{StaticResource TerminalSwitchButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,8">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="My PRs" Width="100"
                                               FontWeight="{Binding IsMyPRsSelected, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                    <Border Background="{StaticResource SyntaxGreenBrush}" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{Binding MyPullRequestsCount}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Border>

                    <!-- CI Failed -->
                    <Border CornerRadius="4" Margin="0,2"
                            Background="{Binding IsCIFailedSelected, Converter={StaticResource BoolToBackgroundConverter}}"
                            Visibility="{Binding FailedRunsCount, Converter={StaticResource CountToVisibilityConverter}}">
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="CIFailed"
                                Style="{StaticResource TerminalSwitchButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,8">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CI Failed" Width="100"
                                               FontWeight="{Binding IsCIFailedSelected, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                    <Border Background="{StaticResource SyntaxRedBrush}" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{Binding FailedRunsCount}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Border>

                    <!-- Issues -->
                    <Border CornerRadius="4" Margin="0,2"
                            Background="{Binding IsIssuesSelected, Converter={StaticResource BoolToBackgroundConverter}}">
                        <Button Command="{Binding SelectSectionCommand}" CommandParameter="Issues"
                                Style="{StaticResource TerminalSwitchButton}"
                                HorizontalContentAlignment="Left"
                                Padding="12,8">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Issues" Width="100"
                                               FontWeight="{Binding IsIssuesSelected, Converter={StaticResource BoolToFontWeightConverter}}"/>
                                    <Border Background="{StaticResource SyntaxYellowBrush}" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{Binding MyIssuesCount}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="Black"/>
                                    </Border>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Border>

                    <Separator Margin="0,16,0,8" Background="{StaticResource BorderSubtleBrush}"/>

                    <!-- Recent Repos -->
                    <TextBlock Text="Recent Repos"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDimmedBrush}"
                               Margin="12,4"/>

                    <ItemsControl ItemsSource="{Binding RecentRepos}" Margin="4,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenRepositoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,1" Padding="8,4">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Footer - Refresh button -->
                <Border Grid.Row="2" Padding="8">
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource TerminalSwitchButton}"
                            HorizontalAlignment="Stretch"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <!-- GitHub CLI not available message (Z-order: bottom) -->
            <Border Background="{StaticResource BackgroundDarkestBrush}"
                    Visibility="{Binding IsGitHubCliAvailable, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="GitHub CLI Not Available"
                               FontSize="{StaticResource FontSizeLarge}"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Install and authenticate the gh CLI to use the Dashboard."
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextDimmedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="Run: gh auth login"
                               FontSize="{StaticResource FontSizeCode}"
                               Foreground="{StaticResource SyntaxCyanBrush}"
                               FontFamily="Consolas"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <Button Content="Retry Detection"
                            Command="{Binding RetryGitHubCliCommand}"
                            Style="{StaticResource TerminalSwitchButton}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Padding="16,8"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="{StaticResource FontSizeTiny}"
                               Foreground="{StaticResource TextDimmedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               MaxWidth="400"/>
                </StackPanel>
            </Border>

            <!-- Content when CLI is available -->
            <Grid Visibility="{Binding IsGitHubCliAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- AI Action Bar (above list) -->
                <StackPanel Grid.Row="0" Margin="8,8,8,0">
                    <!-- Feature 9: PR Prioritization (Review section) -->
                    <StackPanel Visibility="{Binding IsReviewSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Style="{StaticResource InlineActionButton}" Command="{Binding PrioritizePrsCommand}"
                                ToolTip="Suggest review priority order (AI)" FontSize="13" Padding="5,2" Margin="0,0,0,4"
                                HorizontalAlignment="Left">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2728; Prioritize"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGeneratingPrPriority}" Value="True">
                                                    <Setter Property="Text" Value="&#x00B7;&#x00B7;&#x00B7;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <Border Background="#1A2D4A" CornerRadius="3" Margin="0,0,0,4"
                                BorderBrush="#3A6DAA" BorderThickness="3,0,0,0"
                                Visibility="{Binding HasPrPriorityAdvice, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="8,7,6,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PrPriorityAdvice}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource FontSizeTiny}" LineHeight="18" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource InlineActionButton}"
                                        Command="{Binding DismissPrPriorityAdviceCommand}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Feature 8: CI Failure Analysis (CIFailed section) -->
                    <StackPanel Visibility="{Binding IsCIFailedSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Style="{StaticResource InlineActionButton}" Command="{Binding AnalyzeCiFailureCommand}"
                                ToolTip="Analyze selected CI failure (AI)" FontSize="13" Padding="5,2" Margin="0,0,0,4"
                                HorizontalAlignment="Left">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#x2728; Analyze"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnalyzingCiFailure}" Value="True">
                                                    <Setter Property="Text" Value="&#x00B7;&#x00B7;&#x00B7;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <Border Background="#1A2D4A" CornerRadius="3" Margin="0,0,0,4"
                                BorderBrush="#3A6DAA" BorderThickness="3,0,0,0"
                                Visibility="{Binding HasCiFailureAnalysis, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="8,7,6,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CiFailureAnalysis}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource FontSizeTiny}" LineHeight="18" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource InlineActionButton}"
                                        Command="{Binding DismissCiFailureAnalysisCommand}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Content List -->
                <ListBox x:Name="ContentList" Grid.Row="1"
                         ItemsSource="{Binding CurrentSectionItems}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="8"
                         Grid.IsSharedSizeScope="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,6" Margin="0,2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="TitleColumn"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Size badge (left, fixed width column for alignment) -->
                                    <Border Grid.Column="0" Grid.RowSpan="2"
                                            CornerRadius="4" Padding="6,4" Margin="0,0,10,0"
                                            HorizontalAlignment="Left"
                                            Background="{Binding SizeColor, Converter={StaticResource HexToBrushConverter}}"
                                            Visibility="{Binding SizeDisplay, Converter={StaticResource NullToCollapsedConverter}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   MinWidth="20"/>
                                    </Border>

                                    <!-- Title and meta (center) -->
                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding Title}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               MaxWidth="600"/>

                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Repository}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="{StaticResource SyntaxBlueBrush}"/>
                                        <TextBlock Text=" · "
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="{StaticResource TextDimmedBrush}"/>
                                        <TextBlock Text="{Binding Author}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="{StaticResource TextDimmedBrush}"/>
                                        <TextBlock Text=" · "
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="{StaticResource TextDimmedBrush}"/>
                                        <TextBlock Text="{Binding TimeSinceUpdate}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   ToolTip="{Binding UpdatedAt, StringFormat='Last updated: {0:yyyy-MM-dd HH:mm}'}"/>
                                    </StackPanel>

                                    <!-- Action buttons (right) -->
                                    <StackPanel Grid.Column="2" Grid.RowSpan="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <Button Content="Open"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,4,0"
                                                Padding="8,4"/>
                                        <Button Content="Review"
                                                Command="{Binding DataContext.OpenReviewModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,4,0"
                                                Padding="8,4"
                                                ToolTip="Open PR Review Mode">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Checkout"
                                                Command="{Binding DataContext.CheckoutPullRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                ToolTip="Clone/checkout and open project">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Loading indicator -->
                <Border Grid.Row="1" Background="#CC1E1E1E"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Loading..."
                               FontSize="{StaticResource FontSizeNormal}"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding CurrentSectionItems.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <TextBlock Text="No items"
                               FontSize="{StaticResource FontSizeNormal}"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Nothing to show in this section"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextDimmedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
