<UserControl x:Class="TerminalHost.Views.Tabs.TerminalPairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
             xmlns:views="clr-namespace:TerminalHost.Views"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1024">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Terminal Switcher Bar -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}" Padding="8,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- Terminal layout controls (hidden when center panel is active) -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsTerminalsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Custom Full Mode -->
                        <ToggleButton IsChecked="{Binding IsCustomFullMode, Mode=OneWay}"
                                      Command="{Binding SetCustomFullLayoutCommand}"
                                      ToolTip="Custom terminal only (full view)"
                                      AutomationProperties.AutomationId="CustomFullLayoutButton"
                                      Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="3,0,0,3"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Text="▣" FontSize="14" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Horizontal Split Mode -->
                        <ToggleButton IsChecked="{Binding IsHorizontalSplitMode, Mode=OneWay}"
                                      Command="{Binding SetHorizontalSplitLayoutCommand}"
                                      ToolTip="Horizontal split (side by side)"
                                      AutomationProperties.AutomationId="HorizontalSplitLayoutButton"
                                      Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Text="▥" FontSize="14" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- Vertical Split Mode -->
                        <ToggleButton IsChecked="{Binding IsVerticalSplitMode, Mode=OneWay}"
                                      Command="{Binding SetVerticalSplitLayoutCommand}"
                                      ToolTip="Vertical split (stacked)"
                                      AutomationProperties.AutomationId="VerticalSplitLayoutButton"
                                      Margin="0,0,8,0"
                                      Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="0,3,3,0"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Text="▤" FontSize="14" VerticalAlignment="Center"/>
                        </ToggleButton>

                        <!-- AI Assistant Selector (visible only when multiple assistants enabled) -->
                        <ComboBox ItemsSource="{Binding AvailableAiAssistants}"
                                  SelectedItem="{Binding SelectedAiAssistant, Mode=TwoWay}"
                                  Visibility="{Binding HasMultipleAiAssistants, Converter={StaticResource BoolToVisibilityConverter}}"
                                  AutomationProperties.AutomationId="AiAssistantSelector"
                                  ToolTip="Switch AI Assistant"
                                  Margin="8,0,0,0"
                                  MinWidth="100"
                                  Style="{StaticResource DarkComboBox}"
                                  DisplayMemberPath="DisplayLabel"/>
                    </StackPanel>

                    <TextBlock Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Text="{Binding Pair.WorkingDirectory}"/>

                    <!-- Git Status Display (click to open Git Changes) -->
                    <Button Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding DataContext.OpenGitPanelFromToolbarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Open Git Changes (Alt+G)"
                            Padding="6,2"
                            Margin="8,0,0,0"
                            Visibility="{Binding GitStatus.IsGitRepository, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Foreground="{StaticResource SyntaxCyanBrush}"
                                   Text="{Binding GitStatusDisplay}"/>
                    </Button>

                    <!-- Git Pull/Push Buttons -->
                    <Button Content="{Binding GitPullButtonText}" ToolTip="Git Pull (Ctrl+Shift+D)" AutomationProperties.Name="Git Pull"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding GitPullCommand}"
                            Visibility="{Binding GitStatus.IsGitRepository, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="6,2" Margin="8,0,2,0"/>
                    <Button Content="{Binding GitPushButtonText}" ToolTip="Git Push (Ctrl+Shift+U)" AutomationProperties.Name="Git Push"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding GitPushCommand}"
                            Visibility="{Binding GitStatus.IsGitRepository, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="6,2" Margin="0,0,4,0"/>

                    <!-- Quick Commands Separator -->
                    <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="16,2,8,2"/>

                    <!-- Built-in Quick Commands -->
                    <Button x:Name="DetectedLinksButton"
                            ToolTip="Detected Links - Click to view"
                            AutomationProperties.Name="Detected Links"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding DataContext.OpenDetectedLinksCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding HasDetectedLinks, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔗" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DetectedLinks.Count}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{StaticResource SyntaxCyanBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="📁"
                            ToolTip="Open in Explorer (Ctrl+E)"
                            AutomationProperties.Name="Open in Explorer"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                            Margin="0,0,4,0"/>
                    <Button Content="📝"
                            ToolTip="Scratch Pad (Ctrl+Shift+N)"
                            AutomationProperties.Name="Scratch Pad"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding DataContext.OpenScratchPadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                            Margin="0,0,4,0"
                            Visibility="Collapsed"/>
                    <Button Content="📋"
                            ToolTip="Git Panel (Alt+G)"
                            AutomationProperties.Name="Git Panel"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding DataContext.OpenGitPanelFromToolbarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                            Margin="0,0,4,0"/>
                    <Button Content="❓"
                            ToolTip="Help &amp; Shortcuts (F1)"
                            AutomationProperties.Name="Help"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                            Margin="0,0,4,0"/>

                    <!-- Run Controls Separator -->
                    <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2,8,2"
                            Visibility="{Binding HasAnyRunConfiguration, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Run State Indicator (colored dot) -->
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding RunState, Converter={StaticResource RunStateToColorConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0"
                             Visibility="{Binding HasAnyRunConfiguration, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Run/Stop Button -->
                    <Button Content="{Binding RunState, Converter={StaticResource RunStateToIconConverter}}"
                            ToolTip="{Binding RunState, Converter={StaticResource RunStateToTooltipConverter}}"
                            AutomationProperties.Name="Toggle Project Run"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding ToggleRunCommand}"
                            Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                            Margin="0,0,4,0"
                            Visibility="{Binding HasAnyRunConfiguration, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Run Configuration Dropdown (only if multiple configs) -->
                    <ComboBox ItemsSource="{Binding RunConfigurations}"
                              SelectedItem="{Binding ActiveRunConfiguration}"
                              MinWidth="80"
                              Visibility="{Binding HasMultipleRunConfigs, Converter={StaticResource BoolToVisibilityConverter}}"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Margin="0,0,4,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Detected Run URL Button -->
                    <Button ToolTip="{Binding DetectedRunUrl}"
                            AutomationProperties.Name="Open Detected URL"
                            Style="{StaticResource TerminalSwitchButton}"
                            Click="OpenDetectedRunUrl_Click"
                            Visibility="{Binding DetectedRunUrl, Converter={StaticResource NullToCollapsedConverter}}"
                            Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DetectedRunUrl}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{StaticResource SyntaxCyanBrush}"
                                       MaxWidth="150"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Toggle Run Terminal Visibility -->
                    <ToggleButton IsChecked="{Binding IsRunTerminalVisible}"
                                  Content="▶"
                                  ToolTip="Show/Hide Run Terminal"
                                  AutomationProperties.Name="Toggle Run Terminal Visibility"
                                  Margin="0,0,4,0"
                                  Visibility="{Binding HasAnyRunConfiguration, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Toggle Sessions Panel (global) -->
                    <ToggleButton IsChecked="{Binding DataContext.ShowSessionsPanel, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                  Content="⚡"
                                  ToolTip="Sessions Panel (Ctrl+Shift+A)"
                                  AutomationProperties.Name="Toggle Sessions Panel"
                                  Margin="0,0,8,0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Toggle Explorer Visibility -->
                    <ToggleButton IsChecked="{Binding IsExplorerVisible}"
                                  Content="📂"
                                  ToolTip="File Explorer (Ctrl+Shift+F)"
                                  AutomationProperties.Name="Toggle File Explorer"
                                  Margin="0,0,8,0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Separator between built-in and user commands -->
                    <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,2,8,2"
                            Visibility="{Binding DataContext.QuickCommands.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <!-- User Quick Commands -->
                    <ItemsControl ItemsSource="{Binding DataContext.QuickCommands, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayText}"
                                        ToolTip="{Binding Tooltip}"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding DataContext.ExecuteQuickCommandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,4,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Terminal Content Area - Outer grid for Explorer only -->
        <Grid Grid.Row="1" Background="{StaticResource BackgroundDarkestBrush}">
            <Grid.ColumnDefinitions>
                <!-- Main content area (terminals + run OR center panel) -->
                <ColumnDefinition Width="{Binding MainContentColumnWidth}"/>
                <!-- Explorer splitter column (hidden when explorer not visible) -->
                <ColumnDefinition Width="{Binding ExplorerSplitterWidth}"/>
                <!-- Explorer column (hidden when not visible) -->
                <ColumnDefinition Width="{Binding ExplorerColumnWidth}"/>
            </Grid.ColumnDefinitions>

            <!-- Center Content Switcher (Column 0) -->
            <Grid Grid.Column="0">

                <!-- Terminal Pair (visible when no center panel) -->
                <Grid x:Name="MainContentGrid"
                      Visibility="{Binding IsTerminalsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <!-- Main terminals area -->
                    <ColumnDefinition Width="{Binding MainTerminalsColumnWidth}"/>
                    <!-- Run splitter column (hidden when run terminal not visible) -->
                    <ColumnDefinition Width="{Binding RunSplitterWidth}"/>
                    <!-- Run terminal column (hidden when not visible) -->
                    <ColumnDefinition Width="{Binding RunColumnWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Main Terminals Grid - supports both horizontal and vertical layouts -->
                <Grid x:Name="MainTerminalsGrid" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <!-- Custom terminal column (for horizontal split) -->
                    <ColumnDefinition Width="{Binding CustomColumnWidth}"/>
                    <!-- Horizontal splitter column -->
                    <ColumnDefinition Width="{Binding MainSplitterWidth}"/>
                    <!-- Shell terminal column (for horizontal split) -->
                    <ColumnDefinition Width="{Binding ShellColumnWidth}"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- Custom terminal row (for vertical split) -->
                    <RowDefinition Height="{Binding CustomRowHeight}"/>
                    <!-- Vertical splitter row -->
                    <RowDefinition Height="{Binding VerticalSplitterHeight}"/>
                    <!-- Shell terminal row (for vertical split) -->
                    <RowDefinition Height="{Binding ShellRowHeight}"/>
                </Grid.RowDefinitions>

                <!-- Custom Terminal (Column 0, Row 0) - always visible, spans all rows/columns in full mode -->
                <Grid x:Name="CustomTerminalGrid" Grid.Column="0" Grid.Row="0"
                      Grid.RowSpan="{Binding ShouldCustomSpanAllRows, Converter={StaticResource BoolToRowSpanConverter}}"
                      Grid.ColumnSpan="{Binding ShouldCustomSpanAllColumns, Converter={StaticResource BoolToColumnSpanConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
                        <TextBlock FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CustomIcon, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text=" Claude Code" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text="{Binding CustomTerminalTitleDisplay, Mode=OneWay}"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{Binding CustomTerminalContent}"
                                      AutomationProperties.AutomationId="CustomTerminalContent"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>

                <!-- Horizontal Splitter (Column 1, Row 0) - visible in horizontal split mode -->
                <GridSplitter x:Name="TerminalSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                              Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"
                              Visibility="{Binding IsHorizontalSplitMode, Converter={StaticResource BoolToVisibilityConverter}}"
                              DragCompleted="GridSplitter_DragCompleted"/>

                <!-- Vertical Splitter (Column 0, Row 1) - visible in vertical split mode -->
                <GridSplitter x:Name="VerticalTerminalSplitter" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                              Height="4" Background="{StaticResource BackgroundMediumBrush}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows"
                              Visibility="{Binding IsVerticalSplitMode, Converter={StaticResource BoolToVisibilityConverter}}"
                              DragCompleted="VerticalSplitter_DragCompleted"/>

                <!-- Shell Terminal - Position depends on layout mode -->
                <!-- In Horizontal mode: Column 2, Row 0, spans all rows -->
                <!-- In Vertical mode: Column 0, Row 2, spans all columns -->
                <Grid x:Name="ShellTerminalGrid"
                      Grid.Column="{Binding IsVerticalSplitMode, Converter={StaticResource BoolToShellColumnConverter}}"
                      Grid.Row="{Binding IsVerticalSplitMode, Converter={StaticResource BoolToShellRowConverter}}"
                      Grid.RowSpan="{Binding IsHorizontalSplitMode, Converter={StaticResource BoolToRowSpanConverter}}"
                      Grid.ColumnSpan="{Binding IsVerticalSplitMode, Converter={StaticResource BoolToColumnSpanConverter}}"
                      Visibility="{Binding IsShellVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
                        <TextBlock FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding ShellIcon, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text=" Shell" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text="{Binding ShellTerminalTitleDisplay, Mode=OneWay}"
                                 Foreground="{StaticResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{Binding ShellTerminalContent}"
                                      AutomationProperties.AutomationId="ShellTerminalContent"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>
                </Grid>
                <!-- End of MainTerminalsGrid -->

                <!-- Run Splitter (Column 1 of MainContentGrid) - only visible when run terminal is visible -->
                <GridSplitter x:Name="RunTerminalSplitter" Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"
                              Visibility="{Binding IsRunTerminalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                              DragCompleted="RunSplitter_DragCompleted"/>

                <!-- Run Terminal (Column 2 of MainContentGrid) - only visible when run terminal is visible -->
                <Grid Grid.Column="2" Visibility="{Binding IsRunTerminalVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="×"
                                    Style="{StaticResource TabCloseButton}"
                                    Command="{Binding ToggleRunTerminalCommand}"
                                    AutomationProperties.Name="Hide Run Terminal"
                                    ToolTip="Hide Run Terminal"/>
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center">
                                <Run Text="▶ Run"/>
                                <Run Text=" - " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Run Text="{Binding ActiveRunConfiguration.Name, FallbackValue='Not configured'}" Foreground="{StaticResource SyntaxCyanBrush}"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{Binding RunTerminalContent}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>
            </Grid>
            <!-- End of MainContentGrid (terminals) -->

                <!-- Center Panel (visible when a center panel is active) -->
                <Grid Visibility="{Binding ActiveCenterPanel, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Center Panel Header Bar -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="×"
                                    Style="{StaticResource TabCloseButton}"
                                    Command="{Binding CloseCenterPanelCommand}"
                                    ToolTip="Back to Terminals (Escape)"/>
                            <Button DockPanel.Dock="Right" Content="&#x29C9;"
                                    Style="{StaticResource TabCloseButton}"
                                    Click="PopOutCenterPanel_Click"
                                    ToolTip="Pop out to window"
                                    FontSize="12"
                                    Margin="0,0,4,0"/>
                            <Button DockPanel.Dock="Left"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding CloseCenterPanelCommand}"
                                    ToolTip="Back to Terminals (Escape)"
                                    Padding="8,4">
                                <TextBlock Text="← Terminals" FontSize="{StaticResource FontSizeSmall}"/>
                            </Button>
                            <TextBlock Text="{Binding ActiveCenterPanel.PanelIcon}" Margin="8,0,4,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ActiveCenterPanel.PanelTitle}"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeNormal}"/>
                        </DockPanel>
                    </Border>

                    <!-- Center Panel Content (uses DataTemplate from PanelContentTemplates.xaml) -->
                    <ContentControl Grid.Row="1" Content="{Binding ActiveCenterPanel}"/>
                </Grid>

            </Grid>
            <!-- End of Center Content Switcher -->

            <!-- Explorer Splitter (Column 1 of outer grid) - only visible when explorer is visible -->
            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"
                          Visibility="{Binding IsExplorerVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                          DragCompleted="ExplorerSplitter_DragCompleted"/>

            <!-- Right Panel Host (Column 2 of outer grid) - contains Explorer + other docked panels -->
            <controls:PanelHost x:Name="RightPanelHost"
                                Grid.Column="2"
                                Panels="{Binding RightPanels}"
                                ActivePanel="{Binding ActiveRightPanel, Mode=TwoWay}"
                                Side="Right"
                                Visibility="{Binding IsExplorerVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

    </Grid>
</UserControl>
