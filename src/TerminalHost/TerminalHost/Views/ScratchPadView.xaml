<UserControl x:Class="TerminalHost.Views.ScratchPadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:ScratchPadViewModel}"
             mc:Ignorable="d">
    
    <Popup x:Name="ScratchPadPopup"
           Placement="Center"
           PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
           StaysOpen="True"
           AllowsTransparency="True"
           IsOpen="{Binding IsOpen, Mode=TwoWay}">
        <Border x:Name="ScratchPadBorder" Background="{StaticResource BackgroundDarkestBrush}"
                BorderBrush="{StaticResource SyntaxBlueBrush}"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="400"
                MinHeight="300"
                Width="{Binding Width, Mode=TwoWay}"
                Height="{Binding Height, Mode=TwoWay}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (draggable) -->
                <Border x:Name="ScratchPadHeader" Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="ScratchPadHeader_MouseLeftButtonDown"
                        MouseMove="ScratchPadHeader_MouseMove"
                        MouseLeftButtonUp="ScratchPadHeader_MouseLeftButtonUp"
                        Cursor="SizeAll">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Style="{StaticResource TabCloseButton}"
                                Command="{Binding CloseCommand}"
                                FontSize="{StaticResource FontSizeLarge}"
                                Padding="8,2"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,8,0">
                            <!-- Project Scope Radio -->
                            <RadioButton Content="Project"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         GroupName="ScratchPadScope"
                                         IsChecked="{Binding IsGlobalScope, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                                         IsEnabled="{Binding IsProjectScopeEnabled}"
                                         Command="{Binding ToggleScopeCommand}"
                                         Margin="0,0,8,0"
                                         Style="{StaticResource ScopeRadioButton}">
                                <!-- Note: Since we are binding IsChecked OneWay with a command to toggle, 
                                     we rely on the command to flip the ViewModel state. 
                                     Alternatively, we can bind IsGlobalScope with a converter for TwoWay binding.
                                     For simplicity here, let's use the explicit IsGlobalScope binding. -->
                            </RadioButton>
                            
                            <!-- Global Scope Radio -->
                            <RadioButton Content="Global"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         GroupName="ScratchPadScope"
                                         IsChecked="{Binding IsGlobalScope, Mode=TwoWay}"
                                         Style="{StaticResource ScopeRadioButton}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding WindowTitle}"
                                   Foreground="{StaticResource TextBrightBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Content -->
                <TextBox Grid.Row="1"
                         x:Name="ScratchPadTextBox"
                         Text="{Binding ContentText, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         Foreground="{StaticResource TextLightBrush}"
                         BorderThickness="0"
                         Padding="12"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         FontSize="{StaticResource FontSizeNormal}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="12,6" CornerRadius="0,0,6,6">
                    <Grid>
                        <TextBlock Text="{Binding InfoText}"
                                   Foreground="{StaticResource ResizeGripBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                        <Thumb HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Cursor="SizeNWSE"
                               Width="16" Height="16"
                               Template="{StaticResource ResizeGripTemplate}"
                               DragDelta="ScratchPadResizeGrip_DragDelta"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Popup>
    
</UserControl>
