<UserControl x:Class="TerminalHost.Views.ClaudeTasksContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             d:DataContext="{d:DesignInstance viewModels:ClaudeTasksPanelViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Task item style -->
        <Style x:Key="TaskListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#334155">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="#334155"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Task action button style -->
        <Style x:Key="TaskActionButton" TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active task item template -->
        <DataTemplate x:Key="ActiveTaskItemTemplate" DataType="{x:Type domain:FocusTask}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="#E2E8F0"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ActiveForm}"
                               Foreground="#60A5FA"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontStyle="Italic"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ActiveForm, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Foreground="#94A3B8" FontSize="{StaticResource FontSizeMicro}">
                        <Run Text="Started "/>
                        <Run Text="{Binding StartedAt, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TaskActionButton}"
                            Content="&#x2713;"
                            ToolTip="Complete"
                            Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource TaskActionButton}"
                            Content="&#x1F5D1;"
                            ToolTip="Delete"
                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Pending task item template -->
        <DataTemplate x:Key="PendingTaskItemTemplate" DataType="{x:Type domain:FocusTask}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="☐"
                           Foreground="#64748B"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="#CBD5E1"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Description}"
                               Foreground="#64748B"
                               FontSize="{StaticResource FontSizeMicro}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300"
                               Visibility="{Binding Description, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource TaskActionButton}"
                        Content="&#x1F5D1;"
                        ToolTip="Delete"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>

        <!-- Completed task item template -->
        <DataTemplate x:Key="CompletedTaskItemTemplate" DataType="{x:Type domain:FocusTask}">
            <StackPanel VerticalAlignment="Center" Opacity="0.7">
                <TextBlock Text="{Binding Title}"
                           Foreground="#E2E8F0"
                           FontWeight="SemiBold"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Foreground="#94A3B8" FontSize="{StaticResource FontSizeMicro}" Opacity="0.6">
                    <Run Text="&#x2713; Completed "/>
                    <Run Text="{Binding CompletedAt, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Notes}"
                           Foreground="#10B981"
                           FontSize="{StaticResource FontSizeMicro}"
                           Visibility="{Binding Notes, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Workspace Filter Toggle -->
        <Border Grid.Row="0"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding FilterModeText}"
                           Foreground="#94A3B8"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Command="{Binding ToggleFilterModeCommand}"
                        ToolTip="Toggle between current workspace and all workspaces"
                        Padding="6,3"
                        Background="Transparent"
                        BorderThickness="1"
                        BorderBrush="#475569"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#334155"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="🔄" FontSize="11"/>
                </Button>
            </Grid>
        </Border>

        <!-- Current Task Section (Hero Card) -->
        <Border Grid.Row="1"
                Background="#1E3A8A"
                BorderBrush="#3B82F6"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="8,8,8,4"
                Visibility="{Binding HasCurrentTask, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#x1F916;"
                               FontSize="24"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTask.Title}"
                                   Foreground="#E2E8F0"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentTaskProgress}"
                                   Foreground="#60A5FA"
                                   FontSize="13"
                                   FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding CurrentTask.ActiveForm, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="{Binding CurrentTaskElapsed}"
                               Foreground="#94A3B8"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Progress indicator -->
                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Foreground="#3B82F6"
                             Background="#1E293B"
                             BorderThickness="0"
                             Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,4,8,8">

                <!-- Collab Topics Section -->
                <StackPanel Visibility="{Binding HasCollabTopics, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="COLLAB TOPICS"
                               Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,8,0,4"/>
                    <ItemsControl ItemsSource="{Binding CollabTopics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:CollabTopic}">
                                <Border Background="#0A0E1A"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#E2E8F0"
                                                           FontWeight="SemiBold"
                                                           FontSize="{StaticResource FontSizeSmall}"/>
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#64748B"
                                                           FontSize="{StaticResource FontSizeMicro}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Description, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Foreground="#94A3B8"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding MessageCount, Mode=OneWay}"/>
                                                <Run Text="msgs"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Subscriber badges -->
                                        <ItemsControl ItemsSource="{Binding Subscribers}" Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1E293B"
                                                            CornerRadius="3"
                                                            Padding="6,2"
                                                            Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="#60A5FA"
                                                                   FontSize="10"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Collab Messages Section (bubble-up feed) -->
                <StackPanel Visibility="{Binding HasCollabMessages, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="MESSAGES"
                               Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,8,0,4"/>
                    <ItemsControl ItemsSource="{Binding RecentCollabMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:CollabMessage}">
                                <Border CornerRadius="6"
                                        Padding="8,6"
                                        Margin="0,0,0,4"
                                        MaxWidth="320"
                                        RenderTransformOrigin="0.5,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A1E293B"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TransformGroup>
                                                        <TranslateTransform Y="0"/>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </TransformGroup>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <!-- Bubble-up entrance animation for new messages -->
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <!-- Slide up from below -->
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="RenderTransform.Children[0].Y"
                                                                    From="20" To="0"
                                                                    Duration="0:0:0.35"
                                                                    DecelerationRatio="0.6"/>
                                                                <!-- Fade in -->
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0" To="1"
                                                                    Duration="0:0:0.3"/>
                                                                <!-- Subtle scale pop -->
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="RenderTransform.Children[1].ScaleX"
                                                                    From="0.95" To="1"
                                                                    Duration="0:0:0.3"
                                                                    DecelerationRatio="0.5"/>
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="RenderTransform.Children[1].ScaleY"
                                                                    From="0.95" To="1"
                                                                    Duration="0:0:0.3"
                                                                    DecelerationRatio="0.5"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Sender + timestamp row -->
                                        <DockPanel Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Sender}"
                                                       Foreground="#60A5FA"
                                                       FontWeight="SemiBold"
                                                       FontSize="10"
                                                       DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}"
                                                       Foreground="#475569"
                                                       FontSize="9"
                                                       HorizontalAlignment="Right"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <!-- Message content -->
                                        <TextBlock Text="{Binding Content}"
                                                   Foreground="#CBD5E1"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <!-- Topic badge -->
                                        <Border Background="#0F172A"
                                                CornerRadius="2"
                                                Padding="4,1"
                                                Margin="0,3,0,0"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Topic}"
                                                       Foreground="#64748B"
                                                       FontSize="9"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,40,0,0">
                    <TextBlock Text="&#x1F916;"
                               FontSize="32"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="No Claude tasks detected"
                               FontSize="16"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    <TextBlock Text="Tasks will appear here when Claude Code is working"
                               FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="300"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                    <Button Content="Create Manual Task"
                            Command="{Binding CreateManualTaskCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Padding="12,6"
                            Foreground="White"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3B82F6"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Manual Task Creation Form -->
                <Border Background="#0A0E1A"
                        BorderBrush="#2563EB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,8"
                        Visibility="{Binding IsCreateFormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Create Manual Task"
                                   Foreground="#CBD5E1"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding ManualTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BackgroundDarkestBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="#444"
                                 Padding="8"
                                 FontSize="{StaticResource FontSizeSmall}"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">
                            <Button Content="Create"
                                    Command="{Binding SubmitManualTaskCommand}"
                                    Padding="12,6"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource AccentBlueBrush}"
                                    Foreground="White"
                                    BorderThickness="0"/>
                            <Button Content="Cancel"
                                    Command="{Binding CancelManualTaskCommand}"
                                    Padding="12,6"
                                    Background="#475569"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Active Tasks Section -->
                <StackPanel Visibility="{Binding ActiveTasks.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <TextBlock Text="ACTIVE TASKS"
                               Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,8,0,4"/>
                    <Border Background="#0A0E1A"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ListBox ItemsSource="{Binding ActiveTasks}"
                                 SelectedItem="{Binding SelectedTask}"
                                 ItemTemplate="{StaticResource ActiveTaskItemTemplate}"
                                 ItemContainerStyle="{StaticResource TaskListBoxItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                    </Border>
                </StackPanel>

                <!-- Pending Tasks Section -->
                <StackPanel Visibility="{Binding PendingTasks.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            Margin="0,12,0,0">
                    <TextBlock Text="PENDING TASKS"
                               Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,8,0,4"/>
                    <Border Background="#0A0E1A"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ListBox ItemsSource="{Binding PendingTasks}"
                                 SelectedItem="{Binding SelectedTask}"
                                 ItemTemplate="{StaticResource PendingTaskItemTemplate}"
                                 ItemContainerStyle="{StaticResource TaskListBoxItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                    </Border>
                </StackPanel>

                <!-- Completed Tasks Section -->
                <StackPanel Visibility="{Binding CompletedTasks.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            Margin="0,12,0,0">
                    <TextBlock Text="COMPLETED"
                               Foreground="#CBD5E1"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,8,0,4"/>
                    <Border Background="#0A0E1A"
                            BorderBrush="#2563EB"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ListBox ItemsSource="{Binding CompletedTasks}"
                                 SelectedItem="{Binding SelectedTask}"
                                 ItemTemplate="{StaticResource CompletedTaskItemTemplate}"
                                 ItemContainerStyle="{StaticResource TaskListBoxItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
