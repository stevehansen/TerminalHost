<UserControl x:Class="TerminalHost.Views.FileExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Domain"
             d:DataContext="{d:DesignInstance viewModels:FileExplorerViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Expand/Collapse Toggle Style - must be defined before FileTreeViewItem -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2">
                            <Path x:Name="ExpandPath"
                                  Data="M 0 2 L 4 6 L 0 10 Z"
                                  Fill="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data" Value="M 0 0 L 8 0 L 4 5 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeView Item Style -->
        <Style x:Key="FileTreeViewItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyMonospace}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ExpandCollapseToggleStyle}"/>

                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Margin="16,0,0,0"
                                            Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context Menu - uses Opened event to set DataContext since context menus aren't in visual tree -->
        <ContextMenu x:Key="FileContextMenu" Style="{StaticResource DarkContextMenu}" Opened="ContextMenu_Opened">
            <MenuItem Header="Open" Command="{Binding OpenInViewerCommand}"
                      InputGestureText="Enter">
                <MenuItem.Icon>
                    <TextBlock Text="📄" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Edit" Command="{Binding EditInViewerCommand}"
                      InputGestureText="F4">
                <MenuItem.Icon>
                    <TextBlock Text="✏️" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open in New Window" Command="{Binding PopOutViewerCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="⧉" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Open with Default App" Command="{Binding OpenExternalCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="🚀" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in Explorer" Command="{Binding ExploreInExplorerCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="📂" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="View History" Command="{Binding ViewHistoryCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="📜" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="View Blame" Command="{Binding ViewBlameCommand}"
                      InputGestureText="Ctrl+Shift+B">
                <MenuItem.Icon>
                    <TextBlock Text="👤" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}"
                      InputGestureText="Ctrl+C">
                <MenuItem.Icon>
                    <TextBlock Text="📋" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="CD to Folder" Command="{Binding CdToFolderCommand}">
                <MenuItem.Icon>
                    <TextBlock Text="💻" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Rename" Command="{Binding RenameCommand}"
                      InputGestureText="F2">
                <MenuItem.Icon>
                    <TextBlock Text="✏️" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete" Command="{Binding DeleteCommand}"
                      InputGestureText="Del">
                <MenuItem.Icon>
                    <TextBlock Text="🗑️" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
            <DockPanel>
                <!-- Right buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding ShowHiddenFiles}"
                                  Content="👁"
                                  ToolTip="Show hidden files"
                                  AutomationProperties.Name="Show hidden files"
                                  Margin="0,0,4,0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowIgnoredFiles}"
                                  Content="◌"
                                  ToolTip="Show git-ignored files"
                                  AutomationProperties.Name="Show git-ignored files"
                                  Margin="0,0,4,0">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button Content="📄+"
                            Command="{Binding NewFileCommand}"
                            Style="{StaticResource TerminalSwitchButton}"
                            ToolTip="New File"
                            AutomationProperties.Name="New File"
                            Padding="6,2"
                            Margin="0,0,4,0"/>
                    <Button Content="📁+"
                            Command="{Binding NewFolderCommand}"
                            Style="{StaticResource TerminalSwitchButton}"
                            ToolTip="New Folder"
                            AutomationProperties.Name="New Folder"
                            Padding="6,2"
                            Margin="0,0,4,0"/>
                    <Grid>
                        <Button Content="⟳"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource TerminalSwitchButton}"
                                ToolTip="Refresh"
                                AutomationProperties.Name="Refresh"
                                Padding="6,2"/>
                        <!-- Pending changes indicator dot (yellow dot when files changed) -->
                        <Ellipse Width="6" Height="6"
                                 Fill="{StaticResource SyntaxYellowBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-2,-2,0"
                                 Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                 ToolTip="{Binding LastChangedFile, StringFormat='Changed: {0}'}"
                                 IsHitTestVisible="True"/>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- TreeView -->
        <TreeView x:Name="FileTree"
                  Grid.Row="1"
                  ItemsSource="{Binding RootNode.Children}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="4"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ItemContainerStyle="{StaticResource FileTreeViewItem}"
                  SelectedItemChanged="FileTree_SelectedItemChanged"
                  MouseDoubleClick="FileTree_MouseDoubleClick"
                  KeyDown="FileTree_KeyDown"
                  PreviewMouseRightButtonDown="FileTree_PreviewMouseRightButtonDown">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type domain:FileSystemNode}"
                                          ItemsSource="{Binding Children}">
                    <Grid ContextMenu="{StaticResource FileContextMenu}"
                          Background="{Binding RowBackground}"
                          Margin="-2,0,0,0"
                          ToolTip="{Binding FullPath}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <!-- Dim ignored files to 50% opacity -->
                                    <DataTrigger Binding="{Binding IsGitIgnored}" Value="True">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Orientation="Horizontal">
                            <!-- Loading indicator -->
                            <TextBlock Text="⏳"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       Margin="0,0,4,0"/>

                            <!-- File/folder icon -->
                            <TextBlock Text="{Binding Icon}"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityInvertedConverter}}"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>

                            <!-- File name -->
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>

                            <!-- Git ignored indicator -->
                            <TextBlock Text="(ignored)"
                                       Visibility="{Binding IsGitIgnored, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>

                            <!-- Git status badge (only shown when not ignored) -->
                            <Border Visibility="{Binding GitStatus, Converter={StaticResource NullToVisibilityConverter}}"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    Padding="4,0"
                                    Margin="6,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <!-- Hide git status badge for ignored files -->
                                            <DataTrigger Binding="{Binding IsGitIgnored}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding GitStatusIcon}"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="{Binding GitStatusColor, Converter={StaticResource StringToColorConverter}}"/>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Loading overlay -->
        <Border Grid.Row="1"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading..."
                       Foreground="{StaticResource TextDimmedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeNormal}"/>
        </Border>

        <!-- Empty state -->
        <Border Grid.Row="1"
                Visibility="{Binding RootNode.Children.Count, Converter={StaticResource ZeroToVisibilityConverter}}"
                Background="Transparent">
            <TextBlock Text="No files to display"
                       Foreground="{StaticResource TextDimmedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="{StaticResource FontSizeSmall}"/>
        </Border>
    </Grid>
</UserControl>
