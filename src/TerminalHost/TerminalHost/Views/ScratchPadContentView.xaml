<UserControl x:Class="TerminalHost.Views.ScratchPadContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:ScratchPadViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkestBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Scope selector header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <!-- Project Scope Radio -->
                <RadioButton Content="Project"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             GroupName="ScratchPadScope"
                             IsChecked="{Binding IsGlobalScope, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                             IsEnabled="{Binding IsProjectScopeEnabled}"
                             Command="{Binding ToggleScopeCommand}"
                             Margin="0,0,8,0"
                             Style="{StaticResource ScopeRadioButton}"/>

                <!-- Global Scope Radio -->
                <RadioButton Content="Global"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             GroupName="ScratchPadScope"
                             IsChecked="{Binding IsGlobalScope, Mode=TwoWay}"
                             Style="{StaticResource ScopeRadioButton}"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <TextBox Grid.Row="1"
                 x:Name="ScratchPadTextBox"
                 Text="{Binding ContentText, UpdateSourceTrigger=PropertyChanged}"
                 Background="Transparent"
                 Foreground="{StaticResource TextLightBrush}"
                 BorderThickness="0"
                 Padding="12"
                 FontFamily="{StaticResource FontFamilyMonospace}"
                 FontSize="{StaticResource FontSizeNormal}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
    </Grid>
</UserControl>
