<UserControl x:Class="TerminalHost.Views.WorkspaceSidebarView"
             x:Name="SidebarRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:WorkspaceSidebarViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <!-- Expand/Collapse Toggle Style -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2">
                            <Path x:Name="ExpandPath"
                                  Data="M 0 2 L 4 6 L 0 10 Z"
                                  Fill="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="Data" Value="M 0 0 L 8 0 L 4 5 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Workspace Item Template -->
        <DataTemplate x:Key="WorkspaceItemTemplate" DataType="{x:Type viewModels:WorkspaceEntryViewModel}">
            <Border Padding="4,2" Cursor="Hand"
                    Background="Transparent"
                    MouseLeftButtonDown="Workspace_MouseLeftButtonDown"
                    MouseLeftButtonUp="Workspace_MouseLeftButtonUp">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem Header="Open"
                                  Command="{Binding OpenCommand}"/>
                        <MenuItem Header="Duplicate Tab"
                                  Command="{Binding DataContext.DuplicateWorkspaceCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Move Up"
                                  Command="{Binding DataContext.MoveWorkspaceUpCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Move Down"
                                  Command="{Binding DataContext.MoveWorkspaceDownCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Move to Top"
                                  Command="{Binding DataContext.MoveWorkspaceToTopCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Move to Bottom"
                                  Command="{Binding DataContext.MoveWorkspaceToBottomCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Create Worktree..."
                                  Command="{Binding DataContext.CreateWorktreeCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="{Binding MoveToSectionHeader}"
                                  Command="{Binding DataContext.MoveWorkspaceToOtherSectionCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Git Fetch"
                                  Command="{Binding DataContext.GitFetchCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Git Pull (Rebase)"
                                  Command="{Binding DataContext.GitPullRebaseCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <MenuItem Header="Git Push"
                                  Command="{Binding DataContext.GitPushCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding CanPush}"/>
                        <Separator/>
                        <MenuItem Header="Open in Explorer"
                                  Command="{Binding DataContext.OpenInExplorerCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Close"
                                  Command="{Binding DataContext.CloseWorkspaceCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Expand/Collapse Toggle -->
                    <ToggleButton Grid.Column="0"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  Style="{StaticResource ExpandCollapseToggleStyle}"
                                  Visibility="{Binding Worktrees.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <!-- Icon and Name -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                        <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Branch Info -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0"
                                ToolTip="{Binding CurrentBranch}">
                        <TextBlock Text="{Binding BranchNameShort}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AheadBehindDisplay}"
                                   Foreground="{StaticResource AccentOrangeBrush}"
                                   FontSize="10"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding AheadBehindDisplay, Converter={StaticResource NullToCollapsedConverter}}"/>
                    </StackPanel>

                    <!-- Activity Indicators -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <!-- Spinning indicator when terminal is active -->
                        <TextBlock x:Name="ActivitySpinner"
                                   Text="◐"
                                   Foreground="{StaticResource SyntaxYellowBrush}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   RenderTransformOrigin="0.5,0.5"
                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="SpinStoryboard">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.8"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Completed indicator (green dot) when activity finished but not viewed -->
                        <TextBlock Text="●"
                                   Foreground="{StaticResource SyntaxGreenBrush}"
                                   FontSize="8"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"
                                   Visibility="{Binding HasUnreadActivity, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Worktree Item Template -->
        <DataTemplate x:Key="WorktreeItemTemplate" DataType="{x:Type viewModels:WorktreeEntryViewModel}">
            <Border Padding="20,2,4,2" Cursor="Hand"
                    Background="Transparent"
                    MouseLeftButtonDown="Worktree_MouseLeftButtonDown">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem Header="Open"
                                  Click="OpenWorktree_Click"/>
                        <Separator/>
                        <MenuItem Header="Remove Worktree..."
                                  Command="{Binding DataContext.RemoveWorktreeCommand, Source={x:Reference SidebarRoot}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Icon}"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>

                    <!-- Branch Name -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayName}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource FontFamilyMonospace}"
                               FontSize="11"
                               VerticalAlignment="Center"/>

                    <!-- Activity Indicator -->
                    <Ellipse Grid.Column="2"
                             Width="5" Height="5"
                             Fill="{StaticResource AccentGreenBrush}"
                             Margin="4,0"
                             Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundDarkestBrush}"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="WORKSPACES"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+"
                            Style="{StaticResource TerminalSwitchButton}"
                            Padding="6,2"
                            FontSize="14"
                            ToolTip="Add Workspaces (multi-select)"
                            Click="AddWorkspace_Click"/>
                    <Button Content="{Binding SortToggleIcon}"
                            Padding="6,2"
                            FontSize="12"
                            ToolTip="{Binding SortToggleToolTip}"
                            Command="{Binding ToggleAutoSortCommand}"
                            Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAutoSortEnabled}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#8635;"
                            Style="{StaticResource TerminalSwitchButton}"
                            Padding="6,2"
                            FontSize="12"
                            ToolTip="Refresh"
                            Command="{Binding RefreshCommand}"
                            Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspaces List -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Main Workspaces -->
                <ItemsControl ItemsSource="{Binding Workspaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:WorkspaceEntryViewModel}">
                            <StackPanel>
                                <!-- Workspace Header -->
                                <ContentControl Content="{Binding}"
                                                ContentTemplate="{StaticResource WorkspaceItemTemplate}"/>

                                <!-- Worktrees (when expanded) -->
                                <ItemsControl ItemsSource="{Binding Worktrees}"
                                              ItemTemplate="{StaticResource WorktreeItemTemplate}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Playground Section Header -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundDarkestBrush}"
                Padding="8,6"
                Visibility="{Binding Playgrounds.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <TextBlock Text="PLAYGROUND"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Playgrounds List -->
        <ScrollViewer Grid.Row="3"
                      MaxHeight="150"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Playgrounds.Count, Converter={StaticResource CountToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Playgrounds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:WorkspaceEntryViewModel}">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource WorkspaceItemTemplate}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Open Tabs Section Header (non-project tabs like Settings, Statistics, Dashboard) -->
        <Border Grid.Row="4"
                Background="{StaticResource BackgroundDarkestBrush}"
                Padding="8,6"
                Visibility="{Binding DataContext.HasNonProjectTabs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="OPEN TABS"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Open Tabs List -->
        <ItemsControl Grid.Row="5"
                      ItemsSource="{Binding DataContext.NonProjectTabs, RelativeSource={RelativeSource AncestorType=Window}}"
                      Visibility="{Binding DataContext.HasNonProjectTabs, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,4" Cursor="Hand"
                            Background="Transparent"
                            MouseLeftButtonDown="OpenTab_MouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TabIcon}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>

                            <!-- Title -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Close Button -->
                            <Button Grid.Column="2"
                                    Content="×"
                                    Style="{StaticResource TabCloseButton}"
                                    FontSize="14"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    Click="CloseTab_Click"
                                    Tag="{Binding}"
                                    Visibility="{Binding IsCloseable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Loading Indicator -->
        <Border Grid.Row="1" Grid.RowSpan="5"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Loading..."
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
