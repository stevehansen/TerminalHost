                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Profiles Section -->
                    <Grid Margin="24"
                          Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Profiles}">
