                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠" Foreground="#F9A825" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding ProfileShortcutConflictMessage}"
                                                           Foreground="#F9A825"
                                                           FontSize="{StaticResource FontSizeTiny}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <CheckBox Content="Auto-start on application launch"
                                                  IsChecked="{Binding EditProfileAutoStart}"
                                                  Style="{StaticResource FormCheckBox}"/>
