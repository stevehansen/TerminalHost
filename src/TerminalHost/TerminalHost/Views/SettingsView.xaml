                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Profile List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddProfileCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    ToolTip="Add a new profile"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveProfileUpCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move up"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveProfileDownCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Profile List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Profiles}"
                                             SelectedItem="{Binding SelectedProfile}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                               FontSize="{StaticResource FontSizeNormal}"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                                        <TextBlock Text="{Binding Command}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Background="{StaticResource StatusSuccessBrush}"
                                                            CornerRadius="2"
                                                            Padding="4,1"
                                                            Margin="4,0,0,0"
                                                            Visibility="{Binding AutoStart, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Auto"
                                                                   Foreground="{StaticResource TextBrightBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Panel -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="16"
                                    Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Edit Profile"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"/>
                                        <TextBlock Text="Display name for the profile."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Command" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditProfileCommand, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="The command to execute (e.g., pwsh.exe, cmd.exe)."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Icon" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditProfileIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 Width="60"
                                                 HorizontalAlignment="Left"
                                                 FontSize="{StaticResource FontSizeLarge}"/>
                                        <TextBlock Text="Single emoji character shown in menus."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Keyboard Shortcut" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditProfileShortcut, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 Width="200"
                                                 HorizontalAlignment="Left"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="e.g., Ctrl+Shift+P"
                                                   Style="{StaticResource HelpText}"/>
                                        <!-- Shortcut Conflict Warning -->
                                        <Border Background="#442d1b"
                                                BorderBrush="#F9A825"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,4,0,0"
