                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddLinkPatternCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    ToolTip="Add a new link pattern"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveLinkPatternUpCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move up (higher priority)"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveLinkPatternDownCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pattern List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding LinkPatterns}"
                                             SelectedItem="{Binding SelectedLinkPattern}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                                        <TextBlock Text="{Binding Pattern}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1"
                                                              IsChecked="{Binding Enabled}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Enabled"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                                </MultiTrigger>
