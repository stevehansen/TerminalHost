<UserControl x:Class="TerminalHost.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Domain"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             AutomationProperties.AutomationId="SettingsView"
             Background="{StaticResource BackgroundDarkestBrush}">
    <UserControl.Resources>
        <!-- Settings Toolbar Button Style -->
        <Style x:Key="SettingsToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mode Toggle Button Style (RadioButton look) -->
        <Style x:Key="ModeToggleButton" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Item Button Style -->
        <Style x:Key="SidebarItemButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form TextBox Style -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCode}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- Form CheckBox Style -->
        <Style x:Key="FormCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Section Description Style -->
        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimmedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>

        <!-- Field Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Help Text Style -->
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeTiny}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,16"/>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeCode}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"/>
                                                <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Fill="{StaticResource TextSecondaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Stroke="{StaticResource TextSecondaryBrush}"
                                                      StrokeThickness="1"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,6,28,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource BackgroundMediumBrush}"
                                            BorderBrush="{StaticResource BorderDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bool to Visibility Converter -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- View Mode to Visibility Converters -->
        <local:ViewModeToVisibilityConverter x:Key="RichModeVisibility" TargetMode="Rich"/>
        <local:ViewModeToVisibilityConverter x:Key="RawModeVisibility" TargetMode="Raw"/>

        <!-- Section to Visibility Converter -->
        <local:SectionToVisibilityConverter x:Key="SectionVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
            <DockPanel>
                <!-- Mode Toggle (Left) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton Content="Rich"
                                 GroupName="ViewMode"
                                 Style="{StaticResource ModeToggleButton}"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeConverter}, ConverterParameter=Rich}"
                                 Margin="0,0,2,0"/>
                    <RadioButton Content="Raw"
                                 GroupName="ViewMode"
                                 Style="{StaticResource ModeToggleButton}"
                                 IsChecked="{Binding ViewMode, Converter={StaticResource ViewModeConverter}, ConverterParameter=Raw}"
                                 Margin="0,0,12,0"/>

                    <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,2,12,2"/>

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            AutomationProperties.AutomationId="SaveButton"
                            Style="{StaticResource SettingsToolbarButton}"
                            Margin="0,0,4,0"/>
                    <Button Content="Reload"
                            Command="{Binding ReloadCommand}"
                            Style="{StaticResource SettingsToolbarButton}"
                            Margin="0,0,4,0"/>
                </StackPanel>

                <TextBlock Text="config.json"
                           Foreground="{StaticResource TextDimmedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeSmall}"/>
            </DockPanel>
        </Border>

        <!-- Rich Mode Content -->
        <Grid Grid.Row="1" Visibility="{Binding ViewMode, Converter={StaticResource RichModeVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                <StackPanel Margin="0,8,0,0">
                    <RadioButton Content="General"
                                 GroupName="SettingsSection"
                                 Style="{StaticResource SidebarItemButton}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=General}"/>
                    <RadioButton Content="Terminals"
                                 GroupName="SettingsSection"
                                 Style="{StaticResource SidebarItemButton}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=Terminals}"/>
                    <RadioButton Content="Profiles"
                                 GroupName="SettingsSection"
                                 Style="{StaticResource SidebarItemButton}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=Profiles}"/>
                    <RadioButton Content="Quick Commands"
                                 GroupName="SettingsSection"
                                 Style="{StaticResource SidebarItemButton}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=QuickCommands}"/>
                    <RadioButton Content="Link Patterns"
                                 GroupName="SettingsSection"
                                 Style="{StaticResource SidebarItemButton}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=LinkPatterns}"/>
                    <RadioButton Content="Project Types"
                                 GroupName="SettingsSection"
                                 Style="{StaticResource SidebarItemButton}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=ProjectTypes}"/>
                    <RadioButton Content="Claude Commands"
                                 GroupName="SettingsSection"
                                 Style="{StaticResource SidebarItemButton}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=ClaudeCommands}"/>
                    <RadioButton Content="Directory Settings"
                                 GroupName="SettingsSection"
                                 Style="{StaticResource SidebarItemButton}"
                                 IsChecked="{Binding SelectedSection, Converter={StaticResource SectionConverter}, ConverterParameter=DirectorySettings}"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- General Settings Section -->
                    <StackPanel Margin="24"
                                Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=General}">
                        <TextBlock Text="General Settings" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Application behavior and appearance settings." Style="{StaticResource SectionDescription}"/>

                        <CheckBox Content="Confirm before closing window"
                                  IsChecked="{Binding ConfirmOnClose}"
                                  Style="{StaticResource FormCheckBox}"
                                  ToolTip="When enabled, shows a confirmation dialog before closing the application."/>
                        <TextBlock Text="Shows a confirmation dialog when closing the application with active terminals."
                                   Style="{StaticResource HelpText}"/>

                        <CheckBox Content="Show icon in system tray"
                                  IsChecked="{Binding ShowInSystemTray}"
                                  Style="{StaticResource FormCheckBox}"
                                  ToolTip="Minimizes to system tray instead of taskbar."/>
                        <TextBlock Text="When enabled, the application minimizes to the system tray instead of the taskbar."
                                   Style="{StaticResource HelpText}"/>
                    </StackPanel>

                    <!-- Terminal Settings Section -->
                    <StackPanel Margin="24"
                                Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Terminals}">
                        <TextBlock Text="Terminal Settings" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Configure the custom terminal and shell terminal commands." Style="{StaticResource SectionDescription}"/>

                        <!-- Custom Terminal -->
                        <TextBlock Text="CUSTOM TERMINAL"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Command" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     FontFamily="{StaticResource FontFamilyMonospace}"/>
                            <Button Grid.Column="1" Content="Browse..."
                                    Style="{StaticResource SettingsToolbarButton}"
                                    Margin="8,0,0,0"
                                    Click="BrowseCustomCommand_Click"/>
                        </Grid>
                        <TextBlock Text="Path to the custom terminal executable. Environment variables like %USERPROFILE% are supported."
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="Display Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CustomCommandName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Width="300"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Text="The name shown in tabs and UI elements."
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="Icon" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding CustomCommandIcon, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Width="60"
                                 HorizontalAlignment="Left"
                                 FontSize="{StaticResource FontSizeLarge}"/>
                        <TextBlock Text="Single emoji character displayed in the tab."
                                   Style="{StaticResource HelpText}"/>

                        <!-- Separator -->
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,24"/>

                        <!-- Shell Terminal -->
                        <TextBlock Text="SHELL TERMINAL"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Command" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ShellCommand, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBox}"
                                     FontFamily="{StaticResource FontFamilyMonospace}"/>
                            <Button Grid.Column="1" Content="Browse..."
                                    Style="{StaticResource SettingsToolbarButton}"
                                    Margin="8,0,0,0"
                                    Click="BrowseShellCommand_Click"/>
                        </Grid>
                        <TextBlock Text="Path to the shell executable (e.g., pwsh.exe, cmd.exe)."
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="Display Name" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ShellCommandName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Width="300"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Text="The name shown in tabs and UI elements."
                                   Style="{StaticResource HelpText}"/>

                        <TextBlock Text="Icon" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ShellCommandIcon, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBox}"
                                 Width="60"
                                 HorizontalAlignment="Left"
                                 FontSize="{StaticResource FontSizeLarge}"/>
                        <TextBlock Text="Single emoji character displayed in the tab."
                                   Style="{StaticResource HelpText}"/>
                    </StackPanel>

                    <!-- Profiles Section -->
                    <Grid Margin="24"
                          Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=Profiles}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Profiles" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Grid.Row="1" Text="Terminal profiles that can be launched from the + menu. Profiles with auto-start enabled will launch automatically when the application starts." Style="{StaticResource SectionDescription}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Profile List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddProfileCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    ToolTip="Add a new profile"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveProfileUpCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move up"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveProfileDownCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Profile List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Profiles}"
                                             SelectedItem="{Binding SelectedProfile}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                               FontSize="{StaticResource FontSizeNormal}"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                                        <TextBlock Text="{Binding Command}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Background="{StaticResource StatusSuccessBrush}"
                                                            CornerRadius="2"
                                                            Padding="4,1"
                                                            Margin="4,0,0,0"
                                                            Visibility="{Binding AutoStart, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="Auto"
                                                                   Foreground="{StaticResource TextBrightBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Panel -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="16"
                                    Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Edit Profile"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"/>
                                        <TextBlock Text="Display name for the profile."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Command" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditProfileCommand, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="The command to execute (e.g., pwsh.exe, cmd.exe)."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Icon" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditProfileIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 Width="60"
                                                 HorizontalAlignment="Left"
                                                 FontSize="{StaticResource FontSizeLarge}"/>
                                        <TextBlock Text="Single emoji character shown in menus."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Keyboard Shortcut" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditProfileShortcut, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 Width="200"
                                                 HorizontalAlignment="Left"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="e.g., Ctrl+Shift+P"
                                                   Style="{StaticResource HelpText}"/>

                                        <CheckBox Content="Auto-start on application launch"
                                                  IsChecked="{Binding EditProfileAutoStart}"
                                                  Style="{StaticResource FormCheckBox}"/>
                                        <TextBlock Text="Automatically launch this profile when the app starts."
                                                   Style="{StaticResource HelpText}"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyProfileCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="80"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteProfileCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- No Selection State -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Visibility="{Binding SelectedProfile, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="Select a profile to edit"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Quick Commands Section -->
                    <Grid Margin="24"
                          Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=QuickCommands}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Quick Commands" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Grid.Row="1" Text="Keyboard shortcuts to send commands to terminals." Style="{StaticResource SectionDescription}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Command List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddQuickCommandCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    ToolTip="Add a new quick command"/>
                                            <Button Content="Reset"
                                                    Command="{Binding ResetQuickCommandsCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    ToolTip="Reset to default quick commands"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveQuickCommandUpCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move up"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveQuickCommandDownCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Command List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding QuickCommands}"
                                             SelectedItem="{Binding SelectedQuickCommand}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                               FontSize="{StaticResource FontSizeNormal}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,0,0"/>
                                                    <Border Grid.Column="2"
                                                            Background="{StaticResource BackgroundLightBrush}"
                                                            CornerRadius="2"
                                                            Padding="4,1"
                                                            Margin="4,0,0,0"
                                                            Visibility="{Binding Shortcut, Converter={StaticResource NullToCollapsedConverter}}">
                                                        <TextBlock Text="{Binding Shortcut}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Panel -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="16"
                                    Visibility="{Binding SelectedQuickCommand, Converter={StaticResource NullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Edit Command"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="Label" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditQcLabel, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"/>
                                        <TextBlock Text="Display name for the command button."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Icon" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditQcIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 Width="60"
                                                 HorizontalAlignment="Left"
                                                 FontSize="{StaticResource FontSizeLarge}"/>
                                        <TextBlock Text="Single emoji or character shown on the button."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Command Text" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditQcText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="60"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="The text sent to the terminal when executed."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Target Terminal" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedValue="{Binding EditQcTarget}"
                                                  SelectedValuePath="Tag"
                                                  Style="{StaticResource DarkComboBox}"
                                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                                  Width="200"
                                                  HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Custom (Claude Code)" Tag="{x:Static domain:QuickCommandTarget.Custom}"/>
                                            <ComboBoxItem Content="Shell (PowerShell)" Tag="{x:Static domain:QuickCommandTarget.Shell}"/>
                                        </ComboBox>
                                        <TextBlock Text="Which terminal receives the command."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Keyboard Shortcut" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditQcShortcut, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 Width="200"
                                                 HorizontalAlignment="Left"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="e.g., Ctrl+Shift+C or Ctrl+Alt+P"
                                                   Style="{StaticResource HelpText}"/>

                                        <CheckBox Content="Append newline after command"
                                                  IsChecked="{Binding EditQcAppendNewline}"
                                                  Style="{StaticResource FormCheckBox}"/>
                                        <TextBlock Text="Automatically sends Enter after the command text."
                                                   Style="{StaticResource HelpText}"/>

                                        <CheckBox Content="Use user input mode"
                                                  IsChecked="{Binding EditQcUseUserInput}"
                                                  Style="{StaticResource FormCheckBox}"/>
                                        <TextBlock Text="For apps like Claude Code that need key event handling."
                                                   Style="{StaticResource HelpText}"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyQuickCommandCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="80"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteQuickCommandCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- No Selection State -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Visibility="{Binding SelectedQuickCommand, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="Select a command to edit"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Link Patterns Section (Placeholder) -->
                    <StackPanel Margin="24"
                                Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=LinkPatterns}">
                        <TextBlock Text="Link Patterns" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Custom patterns to detect and linkify text in terminal output." Style="{StaticResource SectionDescription}"/>

                        <TextBlock Text="Link patterns editor coming soon. Use Raw mode to edit."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Project Types Section (Placeholder) -->
                    <StackPanel Margin="24"
                                Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=ProjectTypes}">
                        <TextBlock Text="Project Types" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Auto-detection rules for project run configurations." Style="{StaticResource SectionDescription}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="+ Add Project Type"
                                    Style="{StaticResource SettingsToolbarButton}"/>
                            <Button Content="Reset to Defaults"
                                    Command="{Binding ResetProjectTypesCommand}"
                                    Style="{StaticResource SettingsToolbarButton}"
                                    ToolTip="Reset project types to factory defaults"/>
                        </StackPanel>

                        <TextBlock Text="Project types editor coming soon. Use Raw mode to edit."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Claude Commands Section (Placeholder) -->
                    <StackPanel Margin="24"
                                Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=ClaudeCommands}">
                        <TextBlock Text="Claude Commands" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Keyboard shortcuts for Claude Code slash commands. Commands are auto-detected from .claude/commands/ folders." Style="{StaticResource SectionDescription}"/>

                        <TextBlock Text="Claude commands shortcuts editor coming soon. Use Raw mode to edit."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Directory Settings Section (Placeholder) -->
                    <StackPanel Margin="24"
                                Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=DirectorySettings}">
                        <TextBlock Text="Directory Settings" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Per-project configuration for layout, run configs, and file explorer." Style="{StaticResource SectionDescription}"/>

                        <TextBlock Text="Directory settings editor coming soon. Use Raw mode to edit."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Raw Mode Content (JSON Editor) -->
        <Grid Grid.Row="1" Visibility="{Binding ViewMode, Converter={StaticResource RawModeVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Raw Mode Toolbar -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Format"
                            Command="{Binding FormatCommand}"
                            Style="{StaticResource SettingsToolbarButton}"/>
                    <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="8,2"/>
                    <Button Content="Reset Quick Commands"
                            Command="{Binding ResetQuickCommandsCommand}"
                            Style="{StaticResource SettingsToolbarButton}"
                            ToolTip="Reset quick commands to defaults (preserves other settings)"/>
                </StackPanel>
            </Border>

            <!-- JSON Editor -->
            <RichTextBox x:Name="JsonEditor"
                         Grid.Row="1"
                         AutomationProperties.AutomationId="JsonEditor"
                         Background="{StaticResource BackgroundDarkestBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         FontSize="{StaticResource FontSizeCode}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="8"
                         TextChanged="JsonEditor_TextChanged"
                         Loaded="JsonEditor_Loaded">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Grid>

        <!-- Error Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource DangerBackgroundBrush}"
                Padding="8,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource StatusErrorBrush}"
                       FontFamily="{StaticResource FontFamilyMonospace}"
                       FontSize="{StaticResource FontSizeSmall}"/>
        </Border>
    </Grid>
</UserControl>
