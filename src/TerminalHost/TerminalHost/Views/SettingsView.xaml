                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="80"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteProfileCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- No Selection State -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Visibility="{Binding SelectedProfile, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="Select a profile to edit"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Quick Commands Section -->
                    <Grid Margin="24"
                          Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=QuickCommands}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Quick Commands" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Grid.Row="1" Text="Keyboard shortcuts to send commands to terminals." Style="{StaticResource SectionDescription}"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280" MinWidth="200"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Command List -->
                            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}" CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- List Header -->
                                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="4,4,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="+ Add"
                                                    Command="{Binding AddQuickCommandCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    ToolTip="Add a new quick command"/>
                                            <Button Content="Reset"
                                                    Command="{Binding ResetQuickCommandsCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    ToolTip="Reset to default quick commands"/>
                                            <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="4,2"/>
                                            <Button Content="↑"
                                                    Command="{Binding MoveQuickCommandUpCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move up"/>
                                            <Button Content="↓"
                                                    Command="{Binding MoveQuickCommandDownCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Width="28"
                                                    ToolTip="Move down"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Command List -->
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding QuickCommands}"
                                             SelectedItem="{Binding SelectedQuickCommand}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                               FontSize="{StaticResource FontSizeNormal}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,0,0"/>
                                                    <Border Grid.Column="2"
                                                            Background="{StaticResource BackgroundLightBrush}"
                                                            CornerRadius="2"
                                                            Padding="4,1"
                                                            Margin="4,0,0,0"
                                                            Visibility="{Binding Shortcut, Converter={StaticResource NullToCollapsedConverter}}">
                                                        <TextBlock Text="{Binding Shortcut}"
                                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                                   FontSize="{StaticResource FontSizeTiny}"
                                                                   FontFamily="{StaticResource FontFamilyMonospace}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Border"
                                                                    Background="{TemplateBinding Background}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsSelected" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="Border" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Right: Edit Panel -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Padding="16"
                                    Visibility="{Binding SelectedQuickCommand, Converter={StaticResource NullToVisibilityConverter}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Edit Command"
                                                   Foreground="{StaticResource TextBrightBrush}"
                                                   FontSize="{StaticResource FontSizeLarge}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,16"/>

                                        <TextBlock Text="Label" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditQcLabel, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"/>
                                        <TextBlock Text="Display name for the command button."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Icon" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditQcIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 Width="60"
                                                 HorizontalAlignment="Left"
                                                 FontSize="{StaticResource FontSizeLarge}"/>
                                        <TextBlock Text="Single emoji or character shown on the button."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Command Text" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditQcText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Height="60"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="The text sent to the terminal when executed."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Target Terminal" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox SelectedValue="{Binding EditQcTarget}"
                                                  SelectedValuePath="Tag"
                                                  Style="{StaticResource DarkComboBox}"
                                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                                  Width="200"
                                                  HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Custom (Claude Code)" Tag="{x:Static domain:QuickCommandTarget.Custom}"/>
                                            <ComboBoxItem Content="Shell (PowerShell)" Tag="{x:Static domain:QuickCommandTarget.Shell}"/>
                                        </ComboBox>
                                        <TextBlock Text="Which terminal receives the command."
                                                   Style="{StaticResource HelpText}"/>

                                        <TextBlock Text="Keyboard Shortcut" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding EditQcShortcut, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 Width="200"
                                                 HorizontalAlignment="Left"
                                                 FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        <TextBlock Text="e.g., Ctrl+Shift+C or Ctrl+Alt+P"
                                                   Style="{StaticResource HelpText}"/>
                                        <!-- Shortcut Conflict Warning -->
                                        <Border Background="#442d1b"
                                                BorderBrush="#F9A825"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                Margin="0,4,0,0"
                                                Visibility="{Binding HasQcShortcutConflict, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚠" Foreground="#F9A825" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding QcShortcutConflictMessage}"
                                                           Foreground="#F9A825"
                                                           FontSize="{StaticResource FontSizeTiny}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <CheckBox Content="Append newline after command"
                                                  IsChecked="{Binding EditQcAppendNewline}"
                                                  Style="{StaticResource FormCheckBox}"/>
                                        <TextBlock Text="Automatically sends Enter after the command text."
                                                   Style="{StaticResource HelpText}"/>

                                        <CheckBox Content="Use user input mode"
                                                  IsChecked="{Binding EditQcUseUserInput}"
                                                  Style="{StaticResource FormCheckBox}"/>
                                        <TextBlock Text="For apps like Claude Code that need key event handling."
                                                   Style="{StaticResource HelpText}"/>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyQuickCommandCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Background="{StaticResource AccentDarkBrush}"
                                                    Width="80"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteQuickCommandCommand}"
                                                    Style="{StaticResource SettingsToolbarButton}"
                                                    Background="{StaticResource DangerBackgroundBrush}"
                                                    Width="80"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- No Selection State -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundDarkBrush}"
                                    CornerRadius="4"
                                    Visibility="{Binding SelectedQuickCommand, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="Select a command to edit"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Link Patterns Section -->
                    <Grid Margin="24"
                          Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisibility}, ConverterParameter=LinkPatterns}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Link Patterns" Style="{StaticResource SectionHeader}"/>
