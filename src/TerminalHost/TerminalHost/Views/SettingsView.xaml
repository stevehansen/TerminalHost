<UserControl x:Class="TerminalHost.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{StaticResource BackgroundDarkestBrush}">
    <UserControl.Resources>
        <!-- Settings Toolbar Button Style -->
        <Style x:Key="SettingsToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bool to Visibility Converter -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SettingsToolbarButton}"
                            Margin="0,0,4,0"/>
                    <Button Content="Reload"
                            Command="{Binding ReloadCommand}"
                            Style="{StaticResource SettingsToolbarButton}"
                            Margin="0,0,4,0"/>
                    <Button Content="Format"
                            Command="{Binding FormatCommand}"
                            Style="{StaticResource SettingsToolbarButton}"
                            Margin="0,0,12,0"/>
                    <Border Width="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,2,12,2"/>
                    <Button Content="↻ Reset Quick Commands"
                            Command="{Binding ResetQuickCommandsCommand}"
                            Style="{StaticResource SettingsToolbarButton}"
                            ToolTip="Reset quick commands to defaults (preserves other settings)"/>
                </StackPanel>
                <TextBlock Text="config.json"
                           Foreground="{StaticResource TextDimmedBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontFamily="Cascadia Code NF, Segoe UI"
                           FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- JSON Editor -->
        <RichTextBox x:Name="JsonEditor"
                     Grid.Row="1"
                     Background="{StaticResource BackgroundDarkestBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderThickness="0"
                     FontFamily="Cascadia Code NF, Consolas, Courier New"
                     FontSize="13"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="8"
                     TextChanged="JsonEditor_TextChanged"
                     Loaded="JsonEditor_Loaded">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <!-- Error Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource DangerBackgroundBrush}"
                Padding="8,6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource StatusErrorBrush}"
                       FontFamily="Cascadia Code NF, Segoe UI"
                       FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
