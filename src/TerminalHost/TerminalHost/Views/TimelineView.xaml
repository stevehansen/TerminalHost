<UserControl x:Class="TerminalHost.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost.Views"
             xmlns:viewmodels="clr-namespace:TerminalHost.Core.ViewModels;assembly=TerminalHost.Core"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:TimelineTabViewModel}"
             d:DesignHeight="600" d:DesignWidth="1200"
             Background="{StaticResource BackgroundDarkestBrush}" Foreground="{StaticResource TextBrightBrush}">

    <UserControl.Resources>
        <!-- Time Scale Button Style -->
        <Style x:Key="TimeScaleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Icon Button Style -->
        <Style x:Key="TimelineIconButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button Style -->
        <Style x:Key="TimelinePrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Date -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Timeline Mode" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentDateDisplay}" FontSize="12" Foreground="{StaticResource TextDimmedBrush}"/>
                </StackPanel>

                <!-- Focus Time -->
                <StackPanel Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FocusTimeDisplay}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBlueBrush}"/>
                        <Button Content="{Binding IsFocusing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='⏸|▶'}"
                                Command="{Binding ToggleFocusCommand}"
                                Style="{StaticResource TimelineIconButton}"
                                Margin="8,0,0,0" FontSize="12"
                                ToolTip="Toggle focus timer"/>
                        <Button Content="↺" Command="{Binding ResetFocusTimeCommand}"
                                Style="{StaticResource TimelineIconButton}"
                                Margin="4,0,0,0" FontSize="12"
                                ToolTip="Reset focus time"/>
                    </StackPanel>
                    <TextBlock Text="Focus Time" FontSize="11" Foreground="{StaticResource TextDimmedBrush}"/>
                </StackPanel>

                <!-- Current Time -->
                <StackPanel Grid.Column="2" Margin="40,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeDisplay}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Current" FontSize="11" Foreground="{StaticResource TextDimmedBrush}"/>
                </StackPanel>

                <!-- Time Scale Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Minutes"
                            Command="{Binding SetTimeScaleCommand}"
                            CommandParameter="{x:Static domain:TimeScale.Minutes}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TimeScaleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTimeScale}" Value="{x:Static domain:TimeScale.Minutes}">
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Hours"
                            Command="{Binding SetTimeScaleCommand}"
                            CommandParameter="{x:Static domain:TimeScale.Hours}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TimeScaleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTimeScale}" Value="{x:Static domain:TimeScale.Hours}">
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Days"
                            Command="{Binding SetTimeScaleCommand}"
                            CommandParameter="{x:Static domain:TimeScale.Days}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TimeScaleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTimeScale}" Value="{x:Static domain:TimeScale.Days}">
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- New Intent Button -->
                <Button Grid.Column="5" Content="+ New Intent"
                        Command="{Binding CreateNewIntentCommand}"
                        Style="{StaticResource TimelinePrimaryButton}"
                        Margin="20,0,0,0"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Intent List (Left Panel) -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Intents}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:IntentRowViewModel}">
                                <Border Background="{StaticResource BackgroundMediumBrush}"
                                        Margin="0,0,0,8" Padding="12,10" CornerRadius="4"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Expand/Collapse Toggle -->
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding IsExpanded, Converter={StaticResource BoolToStringConverter}, ConverterParameter='▼|▶'}"
                                                   FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Cursor="Hand">
                                            <TextBlock.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleExpandedCommand}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>

                                        <!-- Intent Name -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}"
                                                   FontWeight="Bold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <!-- Running Indicator -->
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="●" FontSize="12"
                                                   Foreground="{StaticResource AccentBlueBrush}"
                                                   Visibility="{Binding HasRunningSession, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   ToolTip="Claude Code running"/>

                                        <!-- Branch Name -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding ShortBranchName}"
                                                   FontSize="12" Foreground="{StaticResource TextDimmedBrush}"
                                                   ToolTip="{Binding BranchName}"/>

                                        <!-- Status -->
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                    Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding StatusIcon}" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:IntentStatus.Active}">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                                <Setter Property="Text" Value="Active"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:IntentStatus.Paused}">
                                                                <Setter Property="Foreground" Value="{StaticResource SyntaxYellowBrush}"/>
                                                                <Setter Property="Text" Value="Paused"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:IntentStatus.Completed}">
                                                                <Setter Property="Foreground" Value="{StaticResource SyntaxGreenBrush}"/>
                                                                <Setter Property="Text" Value="Completed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:IntentStatus.Abandoned}">
                                                                <Setter Property="Foreground" Value="{StaticResource TextDimmedBrush}"/>
                                                                <Setter Property="Text" Value="Abandoned"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Context Indicator -->
                                            <TextBlock Text="📝" FontSize="11" Margin="8,0,0,0"
                                                       Visibility="{Binding HasContext, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       ToolTip="Has context file"/>

                                            <!-- Start Session Button -->
                                            <Button Content="+ Start" Command="{Binding StartNewSessionCommand}"
                                                    Style="{StaticResource TimelineIconButton}"
                                                    FontSize="10" Margin="8,0,0,0"
                                                    ToolTip="Start new Claude Code session"/>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Context Menu -->
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Start Session" Command="{Binding StartNewSessionCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Mark Active" Command="{Binding MarkActiveCommand}"/>
                                            <MenuItem Header="Mark Paused" Command="{Binding MarkPausedCommand}"/>
                                            <MenuItem Header="Mark Complete" Command="{Binding MarkCompleteCommand}"/>
                                            <MenuItem Header="Abandon" Command="{Binding AbandonCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete Intent" Command="{Binding DeleteCommand}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BackgroundLightBrush}"/>

            <!-- Timeline Area (Right Panel) -->
            <Border Grid.Column="2" Background="{StaticResource BackgroundDarkestBrush}">
                <Grid>
                    <!-- Empty State -->
                    <TextBlock Text="Create an intent to start tracking Claude Code sessions"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="16" Foreground="{StaticResource TextDimmedBrush}"
                               Visibility="{Binding Intents.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                    <!-- Timeline Content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Intents}" Margin="16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewmodels:IntentRowViewModel}">
                                    <Border Margin="0,0,0,8" Padding="8"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Intent Header in Timeline -->
                                            <TextBlock Grid.Row="0" Text="{Binding Name}"
                                                       FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource TextDimmedBrush}"
                                                       Margin="0,0,0,4"/>

                                            <!-- Sessions Row -->
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Sessions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewmodels:SessionBlockViewModel}">
                                                        <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="4"
                                                                Cursor="Hand" MinWidth="100">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:ClaudeSessionStatus.Success}">
                                                                            <Setter Property="Background" Value="#2D3E2D"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource SyntaxGreenBrush}"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:ClaudeSessionStatus.Failed}">
                                                                            <Setter Property="Background" Value="#3E2D2D"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource SyntaxRedBrush}"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:ClaudeSessionStatus.Running}">
                                                                            <Setter Property="Background" Value="#2D3E4E"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                                                            <Setter Property="BorderThickness" Value="1"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static domain:ClaudeSessionStatus.Abandoned}">
                                                                            <Setter Property="Opacity" Value="0.5"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="0.9"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}"/>
                                                            </Border.InputBindings>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding StatusIcon}" FontSize="14" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="CC" FontWeight="Bold" FontSize="12"/>
                                                                    <TextBlock Text="{Binding DurationDisplay}"
                                                                               FontSize="12" Margin="6,0,0,0"
                                                                               Foreground="{StaticResource TextDimmedBrush}"/>
                                                                </StackPanel>
                                                                <!-- Fork Indicator -->
                                                                <TextBlock Text="↳ fork" FontSize="10"
                                                                           Foreground="{StaticResource TextDimmedBrush}"
                                                                           Visibility="{Binding IsFork, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Session Detail Popup -->
                    <Border Background="{StaticResource BackgroundDarkBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Width="400" Height="Auto" MaxHeight="500"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="20"
                            Visibility="{Binding IsSessionDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid DataContext="{Binding SelectedSession}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}"
                                    Padding="16,12" CornerRadius="8,8,0,0">
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding TimeRangeDisplay}"
                                                       Margin="12,0,0,0"
                                                       Foreground="{StaticResource TextDimmedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{StaticResource TimelineIconButton}"
                                            FontSize="12"
                                            Command="{Binding DataContext.CloseSessionDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </Border>

                            <!-- Commit Info -->
                            <Border Grid.Row="1" Padding="16,12"
                                    Visibility="{Binding HasCommit, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ShortCommitHash}" FontFamily="Consolas"
                                               FontSize="12" Foreground="{StaticResource SyntaxYellowBrush}"/>
                                    <TextBlock Text="{Binding CommitMessage}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Files Changed -->
                            <Border Grid.Row="2" Padding="16,12"
                                    Visibility="{Binding HasFilesChanged, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="FILES CHANGED" FontWeight="Bold" FontSize="11"
                                               Foreground="{StaticResource TextDimmedBrush}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding FilesChanged}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Additions, StringFormat='+{0}'}"
                                                                   Foreground="{StaticResource SyntaxGreenBrush}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Deletions, StringFormat=' -{0}'}"
                                                                   Foreground="{StaticResource SyntaxRedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Commands -->
                            <Border Grid.Row="3" Padding="16,12"
                                    Visibility="{Binding HasCommands, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="COMMANDS" FontWeight="Bold" FontSize="11"
                                               Foreground="{StaticResource TextDimmedBrush}" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Commands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,2">
                                                    <Run Text="$" Foreground="{StaticResource SyntaxYellowBrush}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Agent Notes -->
                            <Border Grid.Row="4" Padding="16,12"
                                    Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="AGENT NOTES" FontWeight="Bold" FontSize="11"
                                               Foreground="{StaticResource TextDimmedBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding AgentNotes}" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Actions -->
                            <Border Grid.Row="5" Padding="16,12" Background="{StaticResource BackgroundMediumBrush}"
                                    CornerRadius="0,0,8,8">
                                <StackPanel>
                                    <!-- Running session actions -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="Mark Success" Command="{Binding MarkSuccessCommand}"
                                                Style="{StaticResource TimelineIconButton}"
                                                Background="#2D5A2D"
                                                Padding="12,6" Margin="0,0,8,0"/>
                                        <Button Content="Mark Failed" Command="{Binding MarkFailedCommand}"
                                                Style="{StaticResource TimelineIconButton}"
                                                Background="#5A2D2D"
                                                Padding="12,6" Margin="0,0,8,0"/>
                                        <Button Content="Abandon" Command="{Binding MarkAbandonedCommand}"
                                                Style="{StaticResource TimelineIconButton}"
                                                Padding="12,6"/>
                                    </StackPanel>
                                    <!-- Completed session actions -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="Fork from here" Command="{Binding ForkCommand}"
                                                Style="{StaticResource TimelineIconButton}"
                                                Padding="12,6" Margin="0,0,8,0"/>
                                        <Button Content="Cherry-pick" Command="{Binding CherryPickCommand}"
                                                Style="{StaticResource TimelineIconButton}"
                                                Padding="12,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Hook Status Indicator -->
                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                ToolTip="{Binding HookStatusMessage}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource SyntaxYellowBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HooksInstalled}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SyntaxGreenBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RunningSessionsCount}" Value="0">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                                                        Duration="0:0:0"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding HookStatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text=" · " Foreground="{StaticResource TextDimmedBrush}"/>
                        <TextBlock>
                            <Run Text="{Binding TotalIntentsCount}"/>
                            <Run Text=" intents"/>
                        </TextBlock>
                        <TextBlock Text=" · " Foreground="{StaticResource TextDimmedBrush}"/>
                        <TextBlock>
                            <Run Text="{Binding ActiveForksCount}"/>
                            <Run Text=" forks"/>
                        </TextBlock>
                        <TextBlock Text=" · " Foreground="{StaticResource TextDimmedBrush}"/>
                        <TextBlock>
                            <Run Text="{Binding RunningSessionsCount}"/>
                            <Run Text=" running"/>
                        </TextBlock>
                        <TextBlock Text=" · " Foreground="{StaticResource TextDimmedBrush}"/>
                        <TextBlock>
                            <Run Text="{Binding TotalCommitsCount}"/>
                            <Run Text=" commits"/>
                        </TextBlock>
                        <!-- Unassigned sessions warning -->
                        <TextBlock Text=" · " Foreground="{StaticResource TextDimmedBrush}"
                                   Visibility="{Binding UnassignedSessionsCount, Converter={StaticResource IntToVisibilityConverter}}"/>
                        <TextBlock Foreground="{StaticResource SyntaxYellowBrush}" FontSize="11"
                                   Visibility="{Binding UnassignedSessionsCount, Converter={StaticResource IntToVisibilityConverter}}">
                            <Run Text="{Binding UnassignedSessionsCount}"/>
                            <Run Text=" unassigned"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Legend + Troubleshoot button -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Background="{StaticResource SyntaxGreenBrush}" Width="12" Height="12" CornerRadius="2" Margin="0,0,4,0"/>
                        <TextBlock Text="Success" FontSize="11" Margin="0,0,12,0"/>
                        <Border Background="{StaticResource SyntaxRedBrush}" Width="12" Height="12" CornerRadius="2" Margin="0,0,4,0"/>
                        <TextBlock Text="Failed" FontSize="11" Margin="0,0,12,0"/>
                        <Border Background="{StaticResource AccentBlueBrush}" Width="12" Height="12" CornerRadius="6" Margin="0,0,4,0"/>
                        <TextBlock Text="Running" FontSize="11" Margin="0,0,12,0"/>
                        <Button Content="?" Command="{Binding ToggleTroubleshootingCommand}"
                                Style="{StaticResource TimelineIconButton}"
                                ToolTip="Toggle troubleshooting info"
                                FontSize="11" Padding="6,2" MinWidth="24"/>
                    </StackPanel>
                </Grid>

                <!-- Expandable Troubleshooting Section -->
                <Border Grid.Row="1" Margin="0,8,0,0" Padding="12,8" Background="{StaticResource BackgroundDarkBrush}"
                        CornerRadius="4" Visibility="{Binding ShowTroubleshooting, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Troubleshooting" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hooks installed:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,12,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" Margin="0,0,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="No - Run: claude /install-plugin plugins\terminalhost-session-tracker"/>
                                        <Setter Property="Foreground" Value="{StaticResource SyntaxYellowBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HooksInstalled}" Value="True">
                                                <Setter Property="Text" Value="Yes"/>
                                                <Setter Property="Foreground" Value="{StaticResource SyntaxGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Intents configured:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,12,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Margin="0,0,0,4">
                                <Run Text="{Binding TotalIntentsCount, Mode=OneWay}"/>
                                <Run Text=" - Sessions are matched to intents by working directory"/>
                            </TextBlock>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="How it works:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Create an intent → Start Claude Code in that folder → Sessions appear on timeline"
                                       FontSize="11" Foreground="{StaticResource TextDimmedBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
