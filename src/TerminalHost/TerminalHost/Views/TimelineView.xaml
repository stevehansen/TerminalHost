<UserControl x:Class="TerminalHost.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TerminalHost.Core.ViewModels;assembly=TerminalHost.Core"
             d:DataContext="{d:DesignInstance Type=vm:TimelineTabViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}"
             Focusable="True">

    <UserControl.Resources>
        <Style x:Key="FilterTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#3A3A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TimelineButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A3A"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="BorderBrush" Value="#3A3A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A4A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource TimelineButton}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header Bar -->
        <Border Grid.Row="0" Background="#1A1A2A" BorderBrush="#2A2A3A" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏱️ Timeline" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentDateDisplay}" Foreground="#808080" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Focus:" Foreground="#808080" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FocusTimeDisplay}" Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="13"
                               Margin="6,0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource TimelineButton}" Content="{Binding IsFocusing, Converter={StaticResource BoolToStringConverter}, ConverterParameter='⏸|▶'}"
                            Command="{Binding ToggleFocusCommand}" Padding="6,3" FontSize="10"/>
                    <Button Style="{StaticResource TimelineButton}" Content="↺" ToolTip="Reset focus time"
                            Command="{Binding ResetFocusTimeCommand}" Padding="6,3" FontSize="10" Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TimelineButton}" Content="⧉" ToolTip="Pop out to window"
                            Command="{Binding PopOutCommand}" Padding="6,3" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CurrentTimeDisplay}" Foreground="#808080" FontSize="11"
                               VerticalAlignment="Center" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Filter Bar -->
        <Border Grid.Row="1" Background="#1E1E2E" BorderBrush="#2A2A3A" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" MaxWidth="400" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Style="{StaticResource FilterTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Search sessions..." Foreground="#505060" FontSize="12" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <CheckBox Grid.Column="1" Content="Live only" Foreground="#B0B0B0" FontSize="11"
                          IsChecked="{Binding ShowLiveOnly}" VerticalAlignment="Center" Margin="12,0"/>

                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="+ New Intent"
                        Command="{Binding CreateNewIntentCommand}" Margin="4,0"/>
            </Grid>
        </Border>

        <!-- Row 2: Session List + Detail Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Empty state -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Sessions.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                <TextBlock Text="⏱️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="No sessions yet" FontSize="16" Foreground="#808080" HorizontalAlignment="Center"/>
                <TextBlock Text="Start a Claude Code session to begin tracking" FontSize="12" Foreground="#606060"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Install Tracking Hooks" Margin="0,16,0,0"
                        Command="{Binding InstallHooksCommand}" HorizontalAlignment="Center"
                        Visibility="{Binding HooksInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Session cards list -->
            <ListBox x:Name="SessionList" Grid.Column="0"
                     ItemsSource="{Binding Sessions}"
                     SelectedItem="{Binding SelectedSession}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SessionCardViewModel}">
                        <Border Margin="8,3" CornerRadius="6" Padding="12,10" Cursor="Hand"
                                Background="#1E1E2E" BorderThickness="1" BorderBrush="#2A2A3A"
                                Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding SelectCommand}"/>
                            </Border.InputBindings>
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenu}">
                                    <MenuItem Header="Open Project Folder"
                                              Command="{Binding PlacementTarget.Tag.OpenSessionFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Open Transcript Folder"
                                              Command="{Binding PlacementTarget.Tag.OpenSessionTranscriptCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Copy Session ID"
                                              Command="{Binding PlacementTarget.Tag.CopySessionIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Background" Value="#1A2A3A"/>
                                            <Setter Property="BorderBrush" Value="#2E5580"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#252535"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status indicator -->
                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <!-- Content -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold"
                                                   Foreground="White" FontSize="13"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Bold"
                                                   Foreground="#4FC3F7" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Foreground="#607880" FontSize="11" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Text="{Binding GitBranch}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GitBranch}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Summary}" Foreground="#A0A0A0" FontSize="11"
                                               TextTrimming="CharacterEllipsis" MaxWidth="600"
                                               HorizontalAlignment="Left" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Summary}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding ActivitySummary}" Foreground="#6090B0" FontSize="10"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding HasActivityData, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <TextBlock Foreground="#4FC3F7" FontSize="10" FontStyle="Italic" Margin="0,2,0,0"
                                               Text="{Binding CurrentToolDescription}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Duration + time -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="{Binding DurationDisplay}" Foreground="#B0B0B0" FontSize="12"
                                               FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding TimeRangeDisplay}" Foreground="#606060" FontSize="10"
                                               HorizontalAlignment="Right" FontFamily="Consolas"/>
                                    <TextBlock Foreground="#506060" FontSize="10" HorizontalAlignment="Right"
                                               Margin="0,2,0,0" Text="{Binding MessageCount, StringFormat='{}{0} messages'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MessageCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail Panel (right side) -->
            <Border Grid.Column="1" Width="340" Background="#1A1A2A" BorderBrush="#2A2A3A" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Detail header -->
                    <Border Grid.Row="0" Background="#1E1E2E" Padding="12,10" BorderBrush="#2A2A3A" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedSession.StatusIcon}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedSession.ProjectName}" FontWeight="SemiBold" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="#4FC3F7" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding SelectedSession.IsLive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource TimelineButton}" Content="✕" FontSize="12"
                                    Command="{Binding CloseDetailCommand}" Padding="6,2" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Detail content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
                        <StackPanel>
                            <!-- Summary / First Prompt -->
                            <TextBlock Text="{Binding SelectedSession.Summary}" Foreground="#C0C0C0" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSession.Summary}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- First Prompt (if different from summary) -->
                            <TextBlock Foreground="#909090" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       FontStyle="Italic" Text="{Binding SelectedSession.FirstPrompt}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSession.FirstPrompt}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Info rows -->
                            <Border Background="#222233" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <!-- Duration -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Duration" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.DurationDisplay}" Foreground="#C0C0C0" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>

                                    <!-- Time Range -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Time" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.TimeRangeDisplay}" Foreground="#C0C0C0" FontSize="11" FontFamily="Consolas"/>
                                    </Grid>

                                    <!-- Git Branch -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSession.GitBranch}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Branch" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.GitBranch}" Foreground="#80B0D0" FontSize="11"/>
                                    </Grid>

                                    <!-- Messages -->
                                    <Grid Margin="0,0,0,6" Visibility="{Binding SelectedSession.MessageCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Messages" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.MessageCount}" Foreground="#C0C0C0" FontSize="11"/>
                                    </Grid>

                                    <!-- Model -->
                                    <Grid Visibility="{Binding SelectedSession.Model, Converter={StaticResource NullToCollapsedConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Model" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.Model}" Foreground="#A0A0B0" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Activity section (live sessions) -->
                            <Border Background="#222233" CornerRadius="4" Padding="10,8" Margin="0,0,0,8"
                                    Visibility="{Binding SelectedSession.HasActivityData, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Activity" Foreground="#808090" FontSize="10" FontWeight="SemiBold"
                                               Margin="0,0,0,6" TextDecorations="Underline"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Total Tools" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.ToolCount}" Foreground="#C0C0C0" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4" Visibility="{Binding SelectedSession.FileReads, Converter={StaticResource IntToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File Reads" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.FileReads}" Foreground="#80C080" FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4" Visibility="{Binding SelectedSession.FileWrites, Converter={StaticResource IntToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File Writes" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.FileWrites}" Foreground="#E0A060" FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4" Visibility="{Binding SelectedSession.ShellCommands, Converter={StaticResource IntToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Shell" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.ShellCommands}" Foreground="#C080C0" FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4" Visibility="{Binding SelectedSession.Searches, Converter={StaticResource IntToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Searches" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.Searches}" Foreground="#80B0E0" FontSize="11"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,4" Visibility="{Binding SelectedSession.SubagentCount, Converter={StaticResource IntToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Subagents" Foreground="#707080" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSession.SubagentCount}" Foreground="#E0C060" FontSize="11"/>
                                    </Grid>

                                    <!-- Current tool -->
                                    <TextBlock Foreground="#4FC3F7" FontSize="10" FontStyle="Italic" Margin="0,6,0,0"
                                               TextWrapping="Wrap" Text="{Binding SelectedSession.CurrentToolDescription}"
                                               Visibility="{Binding SelectedSession.CurrentToolDescription, Converter={StaticResource NullToCollapsedConverter}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Path info -->
                            <Border Background="#222233" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Project Path" Foreground="#707080" FontSize="10" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding SelectedSession.ProjectPath}" Foreground="#909090" FontSize="10"
                                               TextWrapping="Wrap" FontFamily="Consolas"/>

                                    <TextBlock Text="Session ID" Foreground="#707080" FontSize="10" Margin="0,8,0,2"/>
                                    <TextBlock Text="{Binding SelectedSession.SessionId}" Foreground="#707070" FontSize="9"
                                               TextWrapping="Wrap" FontFamily="Consolas"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Detail actions -->
                    <Border Grid.Row="2" Background="#1E1E2E" Padding="10,8" BorderBrush="#2A2A3A" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource TimelineButton}" Content="📁 Open Folder" Margin="0,0,6,0"
                                    Command="{Binding OpenSessionFolderCommand}"
                                    CommandParameter="{Binding SelectedSession}"/>
                            <Button Style="{StaticResource TimelineButton}" Content="📄 Transcript" Margin="0,0,6,0"
                                    Command="{Binding OpenSessionTranscriptCommand}"
                                    CommandParameter="{Binding SelectedSession}"/>
                            <Button Style="{StaticResource TimelineButton}" Content="📋 Copy ID"
                                    Command="{Binding CopySessionIdCommand}"
                                    CommandParameter="{Binding SelectedSession}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 3: Status Bar -->
        <Border Grid.Row="3" Background="#1A1A2A" BorderBrush="#2A2A3A" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#4CAF50"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HooksInstalled}" Value="False">
                                        <Setter Property="Fill" Value="#FFC107"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HostOnPath}" Value="False">
                                        <Setter Property="Fill" Value="#FFC107"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding HookStatusMessage}" Foreground="#808080" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>

                    <TextBlock Foreground="#607080" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="{Binding TotalSessionCount, Mode=OneWay}"/>
                        <Run Text=" sessions"/>
                    </TextBlock>

                    <TextBlock Foreground="#4FC3F7" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding LiveSessionCount, Converter={StaticResource IntToVisibilityConverter}}">
                        <Run Text="{Binding LiveSessionCount, Mode=OneWay}"/>
                        <Run Text=" live"/>
                    </TextBlock>

                    <TextBlock Foreground="#607080" FontSize="10" VerticalAlignment="Center">
                        <Run Text="{Binding TotalIntentsCount, Mode=OneWay}"/>
                        <Run Text=" intents"/>
                    </TextBlock>

                    <Button Style="{StaticResource TimelineButton}" Content="?" ToolTip="Troubleshoot"
                            Command="{Binding ToggleTroubleshootingCommand}" Padding="6,2" FontSize="10"
                            Margin="20,0,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,6,0,0" Padding="8" Background="#1E1E2E" CornerRadius="4"
                        Visibility="{Binding ShowTroubleshooting, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Hooks:" Foreground="#808080" FontSize="11" Width="80"/>
                            <TextBlock Foreground="#B0B0B0" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Installed ✓"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HooksInstalled}" Value="False">
                                                <Setter Property="Text" Value="Not installed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource PrimaryButton}" Content="Install" Margin="8,0,0,0"
                                    Command="{Binding InstallHooksCommand}" Padding="8,2" FontSize="10"
                                    Visibility="{Binding HooksInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <Button Style="{StaticResource TimelineButton}" Content="Uninstall" Margin="8,0,0,0"
                                    Command="{Binding UninstallHooksCommand}" Padding="8,2" FontSize="10"
                                    Visibility="{Binding HooksInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                    Visibility="{Binding HostOnPath, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="PATH:" Foreground="#808080" FontSize="11" Width="80"/>
                            <TextBlock Text="⚠ host.exe not found on PATH" Foreground="#FFC107" FontSize="11"/>
                        </StackPanel>

                        <TextBlock Text="Sessions are auto-tracked when Claude Code hooks fire. Historical sessions are read from ~/.claude/projects/."
                                   Foreground="#606060" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
