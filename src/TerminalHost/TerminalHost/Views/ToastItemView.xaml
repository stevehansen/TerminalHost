<UserControl x:Class="TerminalHost.Views.ToastItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TerminalHost.Core.ViewModels;assembly=TerminalHost.Core"
             xmlns:services="clr-namespace:TerminalHost.Services"
             xmlns:core="clr-namespace:TerminalHost.Core.Interfaces;assembly=TerminalHost.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ToastViewModel}">
    <Border Background="#E0202020"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="6"
            MinWidth="250"
            MaxWidth="400"
            Padding="12"
            Margin="0,0,0,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock Grid.Column="0"
                       Text="{Binding Icon}"
                       FontSize="{StaticResource FontSizeLarge}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SyntaxBlueBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static core:ToastType.Success}">
                                <Setter Property="Foreground" Value="{StaticResource SyntaxGreenBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static core:ToastType.Warning}">
                                <Setter Property="Foreground" Value="{StaticResource SyntaxYellowBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static core:ToastType.Error}">
                                <Setter Property="Foreground" Value="{StaticResource SyntaxRedBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="{x:Static core:ToastType.Progress}">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Message -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="{StaticResource FontSizeNormal}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <!-- Close Button -->
            <Button Grid.Column="2"
                    Command="{Binding CloseCommand}"
                    Visibility="{Binding IsCloseable, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Padding="6,2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Foreground" Value="{StaticResource TextDimmedBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <TextBlock Text="&#x2715;" FontSize="{StaticResource FontSizeSmall}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
