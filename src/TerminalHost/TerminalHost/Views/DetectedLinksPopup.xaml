<UserControl x:Class="TerminalHost.Views.DetectedLinksPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Border Background="#252525"
            BorderBrush="#0078D4"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0"
            MinWidth="300"
            MaxWidth="500"
            MaxHeight="400">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2D2D2D" Padding="12,8" CornerRadius="6,6,0,0">
                <DockPanel>
                    <Button x:Name="RefreshButton"
                            DockPanel.Dock="Right"
                            Content="↻"
                            Style="{StaticResource TabCloseButton}"
                            Click="RefreshButton_Click"
                            ToolTip="Refresh links"
                            FontSize="14"
                            Padding="6,2"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔗" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Detected Links"
                                   Foreground="#CCCCCC"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Links List -->
            <ListBox x:Name="LinksList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="320"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="LinksList_MouseDoubleClick"
                     SelectionChanged="LinksList_SelectionChanged"
                     PreviewKeyDown="LinksList_PreviewKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Icon}"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayText}"
                                           Foreground="#CCCCCC"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Url}"
                                           Foreground="#666666"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Url}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PopupListBoxItem}"/>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyState"
                       Grid.Row="1"
                       Text="No links detected"
                       Foreground="#666666"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Padding="20"
                       Visibility="Collapsed"/>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#2D2D2D" Padding="12,6" CornerRadius="0,0,6,6">
                <TextBlock Foreground="#808080"
                           FontSize="10"
                           Text="Click to open, double-click or Enter to open"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
