<Window x:Class="TerminalHost.Views.SparkCanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:TerminalHost.Views"
        xmlns:vm="clr-namespace:TerminalHost.ViewModels"
        mc:Ignorable="d"
        Title="Spark — TerminalHost"
        Width="1200"
        Height="800"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF050510"
        d:DataContext="{d:DesignInstance Type=vm:SparkCanvasViewModel}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <views:SparkCanvasView DataContext="{Binding}"/>
</Window>
