<Window x:Class="TerminalHost.Views.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:TerminalHost.Views"
        xmlns:vm="clr-namespace:TerminalHost.Core.ViewModels;assembly=TerminalHost.Core"
        mc:Ignorable="d"
        Title="Timeline — TerminalHost"
        Width="1000"
        Height="700"
        MinWidth="500"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2A"
        d:DataContext="{d:DesignInstance Type=vm:TimelineTabViewModel}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <views:TimelineView DataContext="{Binding}"/>
</Window>
