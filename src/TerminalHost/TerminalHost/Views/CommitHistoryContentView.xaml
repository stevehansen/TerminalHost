<UserControl x:Class="TerminalHost.Views.CommitHistoryContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             d:DataContext="{d:DesignInstance viewModels:CommitHistoryViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <!-- Commit item template -->
        <DataTemplate x:Key="CommitItemTemplate">
            <Grid Margin="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.RowSpan="2"
                           Text="{Binding ShortHash}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           ToolTip="{Binding Hash}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#569CD6"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWipEntry}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Subject}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="250">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWipEntry}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SyntaxYellowBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ParsedDecorations}"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ParsedDecorations.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="3" Padding="5,1" Margin="2,0"
                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}">
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="White"
                                               FontSize="{StaticResource FontSizeMicro}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Grid.Column="1" Grid.Row="1"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}">
                    <Run Text="{Binding AuthorName, Mode=OneWay}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding RelativeDate, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Compact commit item template (single-row table view) -->
        <DataTemplate x:Key="CompactCommitItemTemplate">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ShortHash}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeMicro}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#569CD6"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWipEntry}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentOrangeBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <TextBlock Text="{Binding Subject}"
                               FontSize="{StaticResource FontSizeMicro}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWipEntry}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SyntaxYellowBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ParsedDecorations}"
                                  Margin="4,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding ParsedDecorations.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="2" Padding="3,0" Margin="1,0"
                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}">
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="White"
                                               FontSize="9"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding AuthorName}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="{Binding RelativeDate}"
                           Foreground="{StaticResource TextDimmedBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- File item template -->
        <DataTemplate x:Key="FileItemTemplate">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusIcon}"
                           Foreground="{Binding StatusColor}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeMicro}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding FilePath}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatsDisplay}"
                           Foreground="{StaticResource TextDimmedBrush}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeMicro}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- ListBoxItem style with fixed height to match graph -->
        <Style x:Key="CommitListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="{Binding DataContext.CommitItemHeight,
                RelativeSource={RelativeSource AncestorType=ListBox}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*" MinWidth="200"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Commit List -->
        <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Loading overlay -->
                <Border Grid.RowSpan="4"
                        Background="#80000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        Panel.ZIndex="100">
                    <TextBlock Text="Loading..."
                               Foreground="{StaticResource TextDimmedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="🔍"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding ToggleFilterExpandedCommand}"
                                    ToolTip="Toggle filters"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Padding="6,2"
                                    Margin="0,0,4,0"/>
                            <Button Content="≡"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding ToggleCompactViewCommand}"
                                    ToolTip="Toggle compact view"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Padding="6,2"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Commits.Count, StringFormat='{}{0} commits'}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Filter panel (expandable) -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}" Padding="8,4"
                        Visibility="{Binding IsFilterExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Search message -->
                        <Grid Margin="0,0,0,4">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource BackgroundDarkestBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="#444" Padding="6,4"
                                     FontSize="{StaticResource FontSizeMicro}"/>
                            <TextBlock Text="Search message..."
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeMicro}"
                                       Margin="8,5,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding SearchText, Converter={StaticResource NullOrEmptyToVisibleConverter}}"/>
                        </Grid>
                        <!-- Author + File path -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding AuthorFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BackgroundDarkestBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="#444" Padding="6,4"
                                         FontSize="{StaticResource FontSizeMicro}"/>
                                <TextBlock Text="Author..."
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           Margin="8,5,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding AuthorFilter, Converter={StaticResource NullOrEmptyToVisibleConverter}}"/>
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBox Text="{Binding FilePathFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BackgroundDarkestBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="#444" Padding="6,4"
                                         FontSize="{StaticResource FontSizeMicro}"/>
                                <TextBlock Text="File path..."
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           Margin="8,5,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding FilePathFilter, Converter={StaticResource NullOrEmptyToVisibleConverter}}"/>
                            </Grid>
                        </Grid>
                        <!-- Dates + Apply/Clear -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding AfterDateText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BackgroundDarkestBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="#444" Padding="6,4"
                                         FontSize="{StaticResource FontSizeMicro}"/>
                                <TextBlock Text="After (yyyy-MM-dd)"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           Margin="8,5,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding AfterDateText, Converter={StaticResource NullOrEmptyToVisibleConverter}}"/>
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBox Text="{Binding BeforeDateText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BackgroundDarkestBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="#444" Padding="6,4"
                                         FontSize="{StaticResource FontSizeMicro}"/>
                                <TextBlock Text="Before (yyyy-MM-dd)"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeMicro}"
                                           Margin="8,5,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding BeforeDateText, Converter={StaticResource NullOrEmptyToVisibleConverter}}"/>
                            </Grid>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0">
                                <Button Content="Apply"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding ApplyFiltersCommand}"
                                        Padding="8,4" FontSize="{StaticResource FontSizeMicro}"
                                        Margin="0,0,4,0"/>
                                <Button Content="Clear"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding ClearFiltersCommand}"
                                        Padding="8,4" FontSize="{StaticResource FontSizeMicro}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Commit list with graph -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Graph column -->
                    <ScrollViewer Grid.Column="0" x:Name="GraphScrollViewer"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Width="{Binding GraphWidth}"
                                  MinWidth="40">
                        <controls:CommitGraphControl
                            ItemsSource="{Binding GraphNodes}"
                            ItemHeight="{Binding CommitItemHeight}"
                            VerticalAlignment="Top"/>
                    </ScrollViewer>

                    <!-- Commit list -->
                    <ListBox Grid.Column="1"
                         x:Name="CommitListBox"
                         ItemsSource="{Binding Commits}"
                         SelectedItem="{Binding SelectedCommit}"
                         ItemContainerStyle="{StaticResource CommitListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Loaded="OnCommitListBoxLoaded">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="ItemTemplate" Value="{StaticResource CommitItemTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactView}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource CompactCommitItemTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                </ListBox>

                </Grid>

                <!-- Load more button -->
                <Border Grid.Row="3" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4"
                        Visibility="{Binding HasMoreCommits, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Content="Load More..."
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding LoadMoreCommitsCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="0,4"/>
                </Border>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

        <!-- Right Panel: Details + Diff -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="250"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Commit Details -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <Grid Visibility="{Binding HasSelectedCommit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Hash and Author -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding SelectedCommit.ShortHash}"
                                       Foreground="#569CD6"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontSize="{StaticResource FontSizeMicro}"/>
                            <TextBlock Text=" - " Foreground="{StaticResource TextDimmedBrush}" FontSize="{StaticResource FontSizeMicro}"/>
                            <TextBlock Text="{Binding CommitDetails.AuthorName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeMicro}"/>
                            <TextBlock Text="{Binding SelectedCommit.RelativeDate, StringFormat=' ({0})'}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeMicro}"/>
                        </StackPanel>

                        <!-- Subject and Actions -->
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Button Content="Copy"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding CopyHashCommand}"
                                        FontSize="{StaticResource FontSizeTiny}"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        ToolTip="Copy full commit hash"/>
                                <Button Content="Cherry-pick"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding CherryPickCommand}"
                                        FontSize="{StaticResource FontSizeTiny}"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        ToolTip="Cherry-pick this commit to current branch"/>
                                <Button Content="Revert"
                                        FontSize="{StaticResource FontSizeTiny}"
                                        Padding="6,2"
                                        ToolTip="Create a revert commit"
                                        Command="{Binding RevertCommitCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
                                            <Setter Property="Foreground" Value="#F14C4C"/>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Style="{StaticResource InlineActionButton}" Command="{Binding ExplainCommitCommand}"
                                        ToolTip="Explain this commit (AI)" FontSize="13" Padding="5,2" Margin="2,0,0,0">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#x2728; Explain"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExplainingCommit}" Value="True">
                                                            <Setter Property="Text" Value="&#xB7;&#xB7;&#xB7;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedCommit.Subject}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </DockPanel>

                        <!-- AI Explanation callout -->
                        <Border Grid.Row="2" Background="#1A2D4A" CornerRadius="3" Margin="0,0,0,6"
                                BorderBrush="#3A6DAA" BorderThickness="3,0,0,0"
                                Visibility="{Binding HasCommitExplanation, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid Margin="8,7,6,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CommitAiExplanation}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource FontSizeTiny}" LineHeight="18" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="&#x1F4CB;" Style="{StaticResource InlineActionButton}"
                                        Command="{Binding CopyCommitExplanationCommand}" VerticalAlignment="Top" Margin="6,0,0,0"
                                        ToolTip="Copy to clipboard"/>
                                <Button Grid.Column="2" Content="&#x2715;" Style="{StaticResource InlineActionButton}"
                                        Command="{Binding DismissCommitExplanationCommand}" VerticalAlignment="Top" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Files header -->
                        <TextBlock Grid.Row="3" Margin="0,0,0,4"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeMicro}">
                            <Run Text="Files: "/>
                            <Run Text="{Binding CommitDetails.Files.Count, Mode=OneWay}"/>
                            <Run Text=" (+"/>
                            <Run Text="{Binding CommitDetails.TotalInsertions, Mode=OneWay}" Foreground="#4EC9B0"/>
                            <Run Text=" -"/>
                            <Run Text="{Binding CommitDetails.TotalDeletions, Mode=OneWay}" Foreground="#F14C4C"/>
                            <Run Text=")"/>
                        </TextBlock>

                        <!-- Files list -->
                        <ListBox Grid.Row="4"
                                 ItemsSource="{Binding CommitDetails.Files}"
                                 SelectedItem="{Binding SelectedFile}"
                                 ItemTemplate="{StaticResource FileItemTemplate}"
                                 ItemContainerStyle="{StaticResource CommitListBoxItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="100"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

            <!-- Diff viewer -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundDarkestBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                        <TextBlock Text="{Binding SelectedFile.FilePath, StringFormat='Diff: {0}', FallbackValue='Select a file to view diff'}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <controls:DiffViewer Grid.Row="1" DiffText="{Binding DiffText}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
