<UserControl x:Class="TerminalHost.Views.SessionsTreeContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:SessionsTreePanelViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkestBrush}">

    <UserControl.Resources>

        <!-- Visibility + spin animation for the spinner glyph.
             The RotateTransform itself is set inline on each TextBlock instance
             (in the row template below) — putting it in a Style Setter freezes
             it and breaks the animation with "Cannot animate on immutable object". -->
        <Style x:Key="RowSpinnerStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="SpinStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowStateIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact progress bar style for the context-token usage meter. -->
        <Style x:Key="UsageProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Title style: sessions read as primary headings, subagents as muted sub-rows.
             This is the main per-row cue distinguishing the two kinds. -->
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSession}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row content for both session and subagent rows. Subtitle and usage each get
             their own row so the status icon (and the chevron, see the item template) can
             center on the title line rather than the whole multi-line block. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type viewModels:SessionTreeNode}">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource RowSpinnerStyle}"
                               Text="◐"
                               FontSize="14"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Style="{StaticResource RowStateIconStyle}" Text="{Binding StateIcon}"/>
                </Grid>

                <Grid Grid.Row="0" Grid.Column="1" Margin="6,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               Style="{StaticResource RowTitleStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Activity}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="1"
                           Margin="6,1,0,0"
                           Text="{Binding Subtitle}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibilityConverter}}"/>

                <Grid Grid.Row="2" Grid.Column="1"
                      Margin="6,4,8,0"
                      Visibility="{Binding UsageText, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0"
                                 Style="{StaticResource UsageProgressStyle}"
                                 Value="{Binding UsagePercent, Mode=OneWay}"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding UsageText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeMicro}"
                               Margin="0,2,0,0"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Hierarchical template: same row content for both levels. -->
        <HierarchicalDataTemplate DataType="{x:Type viewModels:SessionTreeNode}"
                                  ItemsSource="{Binding Children}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowTemplate}"/>
        </HierarchicalDataTemplate>

        <Style x:Key="SessionsTreeViewItem" TargetType="TreeViewItem">
            <!-- Neutralise the WPF default selection chrome — informational rows don't need a visible "selected" state. -->
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#CCCCCC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CCCCCC"/>
            </Style.Resources>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyStandard}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <!-- Tag carries the panel ViewModel so the ContextMenu (separate visual tree)
                 can reach OpenWorkspaceCommand via PlacementTarget.Tag. -->
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem Header="Open / Focus Workspace"
                                  Command="{Binding PlacementTarget.Tag.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnTreeViewItemDoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <!-- Collapses to 0 for childless rows (see HasItems trigger) so
                                     only sessions with subagents reserve disclosure space. -->
                                <ColumnDefinition x:Name="ExpanderColumn" Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Expander toggle in column 0, top-aligned to sit on the title line
                                 rather than centered over the full (title + subtitle + usage) header. -->
                            <ToggleButton x:Name="Expander"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          VerticalAlignment="Top"
                                          Margin="0,9,0,0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{StaticResource TextMutedBrush}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="2">
                                                        <TextBlock x:Name="Arrow"
                                                                   Text="▶"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderTransformOrigin="0.5,0.5"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <!-- Header content in a stretch column. Card chrome (background +
                                 border + spacing) is applied per-kind via the IsSession triggers
                                 below, giving each session a distinct, separated block. -->
                            <Border x:Name="Bd"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Stretch"/>
                            </Border>

                            <!-- Children -->
                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- No subagents: drop the disclosure entirely (and reclaim its column)
                                 so childless rows don't look expandable. -->
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ExpanderColumn" Property="Width" Value="0"/>
                            </Trigger>
                            <!-- Session rows render as separated cards: a soft fill (no border) so
                                 they read as light blocks, inset from the panel edges. -->
                            <DataTrigger Binding="{Binding IsSession}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
                                <Setter TargetName="Bd" Property="Padding" Value="8,5"/>
                                <Setter TargetName="Bd" Property="Margin" Value="2,3,2,3"/>
                            </DataTrigger>
                            <!-- Subagent rows hang under their session with a subordinate left rule. -->
                            <DataTrigger Binding="{Binding IsSession}" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2,0,0,0"/>
                                <Setter TargetName="Bd" Property="Padding" Value="8,1,0,1"/>
                                <Setter TargetName="Bd" Property="Margin" Value="2,0,2,2"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Empty state -->
        <Border Grid.Row="0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⚡"
                           FontSize="40"
                           Opacity="0.5"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="No active sessions"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Start a Claude Code session to see it here."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeTiny}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TreeView Grid.Row="0"
                  ItemsSource="{Binding Sessions}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,6"
                  ItemContainerStyle="{StaticResource SessionsTreeViewItem}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>
