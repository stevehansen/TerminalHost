<UserControl x:Class="TerminalHost.Views.SessionsTreeContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:SessionsTreePanelViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkestBrush}">

    <UserControl.Resources>

        <!-- Visibility + spin animation for the spinner arc (matches the status overlay).
             The RotateTransform itself is set inline on the Path instance (in the row
             template below) — putting it in a Style Setter freezes it and breaks the
             animation with "Cannot animate on immutable object". -->
        <Style x:Key="RowSpinnerStyle" TargetType="Path">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="SpinStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowStateIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Compact progress bar style for the context-token usage meter. -->
        <Style x:Key="UsageProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Title style: sessions read as primary headings, subagents as muted sub-rows.
             This is the main per-row cue distinguishing the two kinds. -->
        <Style x:Key="RowTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSession}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Row content for both session and subagent rows. The chevron and spinner both live
             on the title line (row 0) so they stay vertically centered with the title; subtitle
             and usage sit on their own rows below. The chevron's column is fixed-width for
             sessions (so toggling it never shifts the row) and collapses to 0 for subagents. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type viewModels:SessionTreeNode}">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChevronColumn" Width="20"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Expand/collapse chevron — shown only when the row has subagents. Bound to the
                     ancestor TreeViewItem so it can live here on the title line, centered with the
                     spinner, rather than in the item template's outer frame. -->
                <ToggleButton Grid.Row="0" Grid.Column="0"
                              ClickMode="Press"
                              Focusable="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Background="Transparent"
                              BorderThickness="0"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Mode=TwoWay}"
                              Visibility="{Binding HasItems, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="2">
                                            <!-- Always the same glyph; collapsed state just rotates it
                                                 to point right, so both states render identically. -->
                                            <TextBlock x:Name="Arrow"
                                                       Text="▼"
                                                       FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="-90"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                    <Path Style="{StaticResource RowSpinnerStyle}"
                          Data="M12,2 A10,10 0 1,1 2,12"
                          Stroke="#4FC3F7"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          Width="11"
                          Height="11"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Style="{StaticResource RowStateIconStyle}" Text="{Binding StateIcon}"/>
                </Grid>

                <Grid Grid.Row="0" Grid.Column="2" Margin="6,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               Style="{StaticResource RowTitleStyle}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Activity}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="2"
                           Margin="6,1,0,0"
                           Text="{Binding Subtitle}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Subtitle, Converter={StaticResource NullToVisibilityConverter}}"/>

                <Grid Grid.Row="2" Grid.Column="2"
                      Margin="6,4,8,0"
                      Visibility="{Binding UsageText, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0"
                                 Style="{StaticResource UsageProgressStyle}"
                                 Value="{Binding UsagePercent, Mode=OneWay}"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding UsageText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeMicro}"
                               Margin="0,2,0,0"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Subagents never expand: reclaim the chevron column so the spinner sits close
                     to the indent instead of leaving a wide empty gap. -->
                <DataTrigger Binding="{Binding IsSession}" Value="False">
                    <Setter TargetName="ChevronColumn" Property="Width" Value="0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Hierarchical template: same row content for both levels. -->
        <HierarchicalDataTemplate DataType="{x:Type viewModels:SessionTreeNode}"
                                  ItemsSource="{Binding Children}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowTemplate}"/>
        </HierarchicalDataTemplate>

        <Style x:Key="SessionsTreeViewItem" TargetType="TreeViewItem">
            <!-- Neutralise the WPF default selection chrome — informational rows don't need a visible "selected" state. -->
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#CCCCCC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CCCCCC"/>
            </Style.Resources>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontFamily" Value="{StaticResource FontFamilyStandard}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <!-- Tag carries the panel ViewModel so the ContextMenu (separate visual tree)
                 can reach OpenWorkspaceCommand via PlacementTarget.Tag. -->
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem Header="Open / Focus Workspace"
                                  Command="{Binding PlacementTarget.Tag.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseDoubleClick" Handler="OnTreeViewItemDoubleClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <!-- The card border wraps BOTH the header and the children, so subagents
                             render inside the session's card rather than as separate rows below it.
                             The chevron lives in the header row template (not here), so this frame
                             is just the card + the nested items. -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <ContentPresenter x:Name="PART_Header"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Stretch"/>
                                <!-- Subagents, rendered inside the session card. -->
                                <ItemsPresenter x:Name="ItemsHost"
                                                Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Session rows render as separated cards: a soft fill (no border) so
                                 they read as light blocks, inset from the panel edges. -->
                            <DataTrigger Binding="{Binding IsSession}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
                                <Setter TargetName="Bd" Property="Padding" Value="8,5"/>
                                <Setter TargetName="Bd" Property="Margin" Value="2,3,2,3"/>
                            </DataTrigger>
                            <!-- Subagent rows sit inside the card, indented so their spinner aligns
                                 with the parent's text/usage-meter column (chevron 20 + status 16). -->
                            <DataTrigger Binding="{Binding IsSession}" Value="False">
                                <Setter TargetName="Bd" Property="Padding" Value="4,2,0,2"/>
                                <Setter TargetName="Bd" Property="Margin" Value="36,2,0,2"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Empty state -->
        <Border Grid.Row="0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⚡"
                           FontSize="40"
                           Opacity="0.5"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="No active sessions"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Start a Claude Code session to see it here."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeTiny}"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TreeView Grid.Row="0"
                  ItemsSource="{Binding Sessions}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="8,6"
                  ItemContainerStyle="{StaticResource SessionsTreeViewItem}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>
