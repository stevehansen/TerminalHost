<UserControl x:Class="TerminalHost.Views.FileHistoryContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             d:DataContext="{d:DesignInstance viewModels:FileHistoryViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <!-- Commit item template -->
        <DataTemplate x:Key="CommitItemTemplate">
            <Grid Margin="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Short hash -->
                <TextBlock Grid.Column="0" Grid.RowSpan="2"
                           Text="{Binding ShortHash}"
                           Foreground="#569CD6"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           ToolTip="{Binding Hash}"/>

                <!-- Subject -->
                <TextBlock Grid.Column="1" Grid.Row="0"
                           Text="{Binding Subject}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="350"/>

                <!-- Author and date -->
                <TextBlock Grid.Column="1" Grid.Row="1"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}">
                    <Run Text="{Binding AuthorName, Mode=OneWay}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding RelativeDate, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ListBoxItem style -->
        <Style x:Key="CommitListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- File path header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource InlineActionButton}"
                            Command="{Binding SummarizeFileHistoryCommand}"
                            ToolTip="Summarize file evolution (AI)" FontSize="13" Padding="5,2" Margin="0,0,8,0">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#x2728; Summarize"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSummarizingHistory}" Value="True">
                                                <Setter Property="Text" Value="&#xB7;&#xB7;&#xB7;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button Content="Refresh"
                            Style="{StaticResource TerminalSwitchButton}"
                            Command="{Binding RefreshCommitsCommand}"
                            ToolTip="Refresh file history"/>
                </StackPanel>
                <TextBlock Foreground="{StaticResource TextDimmedBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding FilePath, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Commit List -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Loading overlay -->
                    <Border Grid.RowSpan="4"
                            Background="#80000000"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            Panel.ZIndex="100">
                        <TextBlock Text="Loading..."
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                        <TextBlock Text="{Binding Commits.Count, StringFormat='{}{0} commits'}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"/>
                    </Border>

                    <!-- AI Summary callout -->
                    <Border Grid.Row="1" Background="#1A2D4A" CornerRadius="3" Margin="6,6,6,0"
                            BorderBrush="#3A6DAA" BorderThickness="3,0,0,0"
                            Visibility="{Binding HasFileHistorySummary, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="8,7,6,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FileHistorySummary}" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeTiny}" LineHeight="18" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="&#x2715;" Style="{StaticResource InlineActionButton}"
                                    Command="{Binding DismissFileHistorySummaryCommand}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Commit list -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Commits}"
                             SelectedItem="{Binding SelectedCommit}"
                             ItemTemplate="{StaticResource CommitItemTemplate}"
                             ItemContainerStyle="{StaticResource CommitListBoxItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                    <!-- Load more button -->
                    <Border Grid.Row="3" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4"
                            Visibility="{Binding HasCommits, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Content="Load More..."
                                Style="{StaticResource TerminalSwitchButton}"
                                Command="{Binding LoadMoreCommitsCommand}"
                                HorizontalAlignment="Stretch"
                                Padding="0,4"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

            <!-- Right Panel: Commit Details + Diff -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Commit info header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copy Hash"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding CopyHashCommand}"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Margin="0,0,8,0"/>
                            <Button Content="View File"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding ViewFileAtCommitCommand}"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    ToolTip="View file content at this commit"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasSelectedCommit, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="{Binding SelectedCommit.ShortHash, Mode=OneWay}" Foreground="#569CD6" FontFamily="{StaticResource FontFamilyMonospace}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding SelectedCommit.AuthorName, Mode=OneWay}"/>
                            <Run Text=" ("/>
                            <Run Text="{Binding SelectedCommit.RelativeDate, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Diff / File content viewer -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundDarkestBrush}">
                    <Grid>
                        <!-- Tab header for switching view modes -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Diff"
                                             IsChecked="{Binding ShowFileContent, Converter={StaticResource InverseBoolConverter}}"
                                             Style="{StaticResource ScopeRadioButton}"
                                             Margin="0,0,4,0"/>
                                <RadioButton Content="File Content"
                                             IsChecked="{Binding ShowFileContent}"
                                             Style="{StaticResource ScopeRadioButton}"
                                             Command="{Binding ViewFileAtCommitCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Diff view -->
                        <controls:DiffViewer Grid.Row="1"
                                             DiffText="{Binding DiffText}"
                                             Visibility="{Binding ShowFileContent, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <!-- File content view -->
                        <ScrollViewer Grid.Row="1"
                                      Visibility="{Binding ShowFileContent, Converter={StaticResource BoolToVisibilityConverter}}"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding FileContentAtCommit, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="{StaticResource FontFamilyMonospace}"
                                     FontSize="{StaticResource FontSizeSmall}"
                                     BorderThickness="0"
                                     Padding="8"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"/>
                        </ScrollViewer>

                        <!-- Loading overlay -->
                        <Border Grid.RowSpan="2"
                                Background="#80000000"
                                Visibility="{Binding IsLoadingDiff, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Loading..."
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
