<UserControl x:Class="TerminalHost.Views.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Converters (needed for visibility bindings) -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>
    <Border Background="#2D2D2D" Padding="4">
        <DockPanel>
            <!-- New Project Button -->
            <Button DockPanel.Dock="Right"
                    Content="+ New Project"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenNewProjectCommand}"
                    Margin="8,0,4,0"/>

            <!-- Settings Button -->
            <Button DockPanel.Dock="Right"
                    Content="Settings"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="Settings (Ctrl+,)"
                    Margin="0,0,4,0"/>

            <!-- Profiles Button -->
            <Button DockPanel.Dock="Right"
                    Content="Profiles"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenProfilesCommand}"
                    ToolTip="Manage Profiles (Ctrl+P)"
                    Margin="0,0,4,0"/>

            <!-- Statistics Button -->
            <Button DockPanel.Dock="Right"
                    Content="Statistics"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenStatisticsCommand}"
                    ToolTip="View Usage Statistics"
                    Margin="0,0,4,0"/>



            <!-- Scroll Right Button -->
            <Button x:Name="ScrollRightButton"
                    DockPanel.Dock="Right"
                    Content="›"
                    AutomationProperties.Name="Scroll tabs right"
                    Style="{StaticResource TerminalSwitchButton}"
                    Click="ScrollRight_Click"
                    ToolTip="Scroll right"
                    Visibility="Collapsed"
                    Padding="6,4"
                    Margin="0,0,2,0"/>

            <!-- Scroll Left Button -->
            <Button x:Name="ScrollLeftButton"
                    DockPanel.Dock="Right"
                    Content="‹"
                    AutomationProperties.Name="Scroll tabs left"
                    Style="{StaticResource TerminalSwitchButton}"
                    Click="ScrollLeft_Click"
                    ToolTip="Scroll left"
                    Visibility="Collapsed"
                    Padding="6,4"
                    Margin="0,0,2,0"/>

            <!-- Tab List -->
            <ListBox x:Name="TabList"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SizeChanged="TabList_SizeChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
