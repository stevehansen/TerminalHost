<UserControl x:Class="TerminalHost.Views.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Converters (needed for visibility bindings) -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <!-- Tab Header Templates (local scope to override App-level content templates) -->

        <!-- Terminal Tab Header Template -->
        <DataTemplate DataType="{x:Type vm:TerminalPairTabViewModel}">
            <Border x:Name="TabBorder"
                    Background="#3C3C3C"
                    CornerRadius="4,4,0,0"
                    Padding="8,4"
                    Margin="0,0,2,0"
                    MinWidth="120"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tab_PreviewMouseMove"
                    MouseDown="Tab_MouseDown"
                    DragOver="Tab_DragOver"
                    DragLeave="Tab_DragLeave"
                    Drop="Tab_Drop">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="×"
                            AutomationProperties.Name="Close tab"
                            Style="{StaticResource TabCloseButton}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <!-- Activity spinner - rotates when terminal is active (hidden for selected tab) -->
                    <TextBlock x:Name="ActivitySpinner"
                               DockPanel.Dock="Right"
                               Text="◐"
                               Foreground="#FFD700"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               RenderTransformOrigin="0.5,0.5"
                               Visibility="Collapsed">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Text="{Binding TitleWithGit, Mode=OneWay}"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                </DataTrigger>
                <!-- Show and animate spinner when terminal is active AND tab is NOT selected -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAnyTerminalActive}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ActivitySpinner" Property="Visibility" Value="Visible"/>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinnerStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="ActivitySpinner"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinnerStoryboard"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Settings Tab Header Template -->
        <DataTemplate DataType="{x:Type vm:SettingsTabViewModel}">
            <Border x:Name="TabBorder"
                    Background="#3C3C3C"
                    CornerRadius="4,4,0,0"
                    Padding="8,4"
                    Margin="0,0,2,0"
                    MinWidth="100"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tab_PreviewMouseMove"
                    MouseDown="Tab_MouseDown"
                    DragOver="Tab_DragOver"
                    DragLeave="Tab_DragLeave"
                    Drop="Tab_Drop">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="×"
                            Style="{StaticResource TabCloseButton}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Text="{Binding Title}"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Profiles Tab Header Template -->
        <DataTemplate DataType="{x:Type vm:ProfilesTabViewModel}">
            <Border x:Name="TabBorder"
                    Background="#3C3C3C"
                    CornerRadius="4,4,0,0"
                    Padding="8,4"
                    Margin="0,0,2,0"
                    MinWidth="100"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tab_PreviewMouseMove"
                    MouseDown="Tab_MouseDown"
                    DragOver="Tab_DragOver"
                    DragLeave="Tab_DragLeave"
                    Drop="Tab_Drop">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="×"
                            Style="{StaticResource TabCloseButton}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Text="{Binding Title}"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Statistics Tab Header Template -->
        <DataTemplate DataType="{x:Type vm:StatisticsTabViewModel}">
            <Border x:Name="TabBorder"
                    Background="#3C3C3C"
                    CornerRadius="4,4,0,0"
                    Padding="8,4"
                    Margin="0,0,2,0"
                    MinWidth="100"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tab_PreviewMouseMove"
                    MouseDown="Tab_MouseDown"
                    DragOver="Tab_DragOver"
                    DragLeave="Tab_DragLeave"
                    Drop="Tab_Drop">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="×"
                            Style="{StaticResource TabCloseButton}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <TextBlock Foreground="#CCCCCC"
                               VerticalAlignment="Center"
                               Text="{Binding Title}"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="#2D2D2D" Padding="4">
        <DockPanel>
            <!-- New Project Button -->
            <Button DockPanel.Dock="Right"
                    Content="+ New Project"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenNewProjectCommand}"
                    Margin="8,0,4,0"/>

            <!-- Settings Button -->
            <Button DockPanel.Dock="Right"
                    Content="Settings"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="Settings (Ctrl+,)"
                    Margin="0,0,4,0"/>

            <!-- Profiles Button -->
            <Button DockPanel.Dock="Right"
                    Content="Profiles"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenProfilesCommand}"
                    ToolTip="Manage Profiles (Ctrl+P)"
                    Margin="0,0,4,0"/>

            <!-- Statistics Button -->
            <Button DockPanel.Dock="Right"
                    Content="Statistics"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenStatisticsCommand}"
                    ToolTip="View Usage Statistics"
                    Margin="0,0,4,0"/>



            <!-- Scroll Right Button -->
            <Button x:Name="ScrollRightButton"
                    DockPanel.Dock="Right"
                    Content="›"
                    AutomationProperties.Name="Scroll tabs right"
                    Style="{StaticResource TerminalSwitchButton}"
                    Click="ScrollRight_Click"
                    ToolTip="Scroll right"
                    Visibility="Collapsed"
                    Padding="6,4"
                    Margin="0,0,2,0"/>

            <!-- Scroll Left Button -->
            <Button x:Name="ScrollLeftButton"
                    DockPanel.Dock="Right"
                    Content="‹"
                    AutomationProperties.Name="Scroll tabs left"
                    Style="{StaticResource TerminalSwitchButton}"
                    Click="ScrollLeft_Click"
                    ToolTip="Scroll left"
                    Visibility="Collapsed"
                    Padding="6,4"
                    Margin="0,0,2,0"/>

            <!-- Tab Dropdown Button (shows all tabs when there's overflow) -->
            <Button x:Name="TabDropdownButton"
                    DockPanel.Dock="Right"
                    Content="▼"
                    AutomationProperties.Name="Show all tabs"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding DataContext.OpenTabDropdownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="All tabs (Ctrl+Shift+T)"
                    Visibility="Collapsed"
                    Padding="6,4"
                    Margin="0,0,2,0"/>

            <!-- Tab List -->
            <ListBox x:Name="TabList"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     Background="Transparent"
                     BorderThickness="0"
                     SizeChanged="TabList_SizeChanged">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="ScrollViewer"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
