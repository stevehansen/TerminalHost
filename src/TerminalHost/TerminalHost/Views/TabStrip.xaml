<UserControl x:Class="TerminalHost.Views.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Converters (needed for visibility bindings) -->
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <!-- Shared Tab Header Template - used by all tab types via ITabViewModel interface -->
        <DataTemplate x:Key="TabHeaderTemplate">
            <Border x:Name="TabBorder"
                    Background="{StaticResource BackgroundLightBrush}"
                    CornerRadius="4,4,0,0"
                    Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                    Margin="0,0,2,0"
                    MinWidth="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToDoubleConverter}, ConverterParameter='100|140'}"
                    ToolTip="{Binding ContainerTooltip}"
                    AllowDrop="True"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tab_PreviewMouseMove"
                    MouseDown="Tab_MouseDown"
                    DragOver="Tab_DragOver"
                    DragLeave="Tab_DragLeave"
                    Drop="Tab_Drop">
                <Border.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenu}">
                        <MenuItem Header="Duplicate Tab"
                                  Command="{Binding PlacementTarget.Tag.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.CanDuplicate, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Separator Visibility="{Binding PlacementTarget.DataContext.CanDuplicate, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <MenuItem Header="Move to Front"
                                  Command="{Binding PlacementTarget.Tag.MoveTabToFrontCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Move to End"
                                  Command="{Binding PlacementTarget.Tag.MoveTabToEndCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Close Other Tabs"
                                  Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Close Tabs to the Right"
                                  Command="{Binding PlacementTarget.Tag.CloseTabsToRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Close Tab"
                                  Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="×"
                            AutomationProperties.Name="Close tab"
                            AutomationProperties.AutomationId="CloseTabButton"
                            Style="{StaticResource TabCloseButton}"
                            Padding="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='4,0|10,4'}"
                            FontSize="{Binding DataContext.TouchMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TouchModeToDoubleConverter}, ConverterParameter='12|16'}"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <!-- Activity spinner - rotates when terminal is active (hidden for selected tab) -->
                    <TextBlock x:Name="ActivitySpinner"
                               DockPanel.Dock="Right"
                               Text="◐"
                               AutomationProperties.HelpText="Terminal is active"
                               Foreground="{StaticResource SyntaxYellowBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               RenderTransformOrigin="0.5,0.5"
                               Visibility="Collapsed">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <!-- Completed indicator - solid green dot when activity finished but tab not yet focused -->
                    <TextBlock x:Name="CompletedIndicator"
                               DockPanel.Dock="Right"
                               Text="●"
                               AutomationProperties.HelpText="Terminal activity completed"
                               Foreground="#22C55E"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="4,0,6,0"
                               Visibility="Collapsed"/>
                    <!-- Waiting for input indicator - pulsing orange dot when terminal is waiting for user input -->
                    <TextBlock x:Name="WaitingIndicator"
                               DockPanel.Dock="Right"
                               Text="●"
                               AutomationProperties.HelpText="Waiting for user input"
                               Foreground="#F59E0B"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="4,0,6,0"
                               Visibility="Collapsed"/>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding DisplayTitle, Mode=OneWay}"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BackgroundDarkestBrush}"/>
                </DataTrigger>
                <!-- Show and animate spinner when terminal is active AND tab is NOT selected -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAnyTerminalActive}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="ActivitySpinner" Property="Visibility" Value="Visible"/>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="SpinnerStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="ActivitySpinner"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpinnerStoryboard"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <!-- Show green indicator when activity completed (not active) AND has unread activity AND tab is NOT selected AND not waiting for input -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasUnreadActivity}" Value="True"/>
                        <Condition Binding="{Binding IsAnyTerminalActive}" Value="False"/>
                        <Condition Binding="{Binding IsWaitingForInput}" Value="False"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="CompletedIndicator" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <!-- Show pulsing blue indicator when waiting for input AND tab is NOT selected -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsWaitingForInput}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="WaitingIndicator" Property="Visibility" Value="Visible"/>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="WaitingIndicator"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.3" Duration="0:0:0.8"
                                                 AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{StaticResource BackgroundMediumBrush}" Padding="4">
        <DockPanel>
            <!-- New Project Button -->
            <Button DockPanel.Dock="Right"
                    AutomationProperties.AutomationId="NewProjectButton"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenNewProjectCommand}"
                    ToolTip="New Project (Ctrl+N)"
                    Padding="{Binding TouchMode, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                    FontSize="{Binding TouchMode, Converter={StaticResource TouchModeToDoubleConverter}, ConverterParameter='11|14'}"
                    Margin="8,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" New Project" VerticalAlignment="Center"
                               Visibility="{Binding TouchMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
            </Button>

            <!-- Settings Button -->
            <Button DockPanel.Dock="Right"
                    AutomationProperties.AutomationId="SettingsButton"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="Settings (Ctrl+,)"
                    Padding="{Binding TouchMode, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                    FontSize="{Binding TouchMode, Converter={StaticResource TouchModeToDoubleConverter}, ConverterParameter='11|14'}"
                    Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" Settings" VerticalAlignment="Center"
                               Visibility="{Binding TouchMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
            </Button>

            <!-- Statistics Button -->
            <Button DockPanel.Dock="Right"
                    AutomationProperties.AutomationId="StatisticsButton"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding OpenStatisticsCommand}"
                    ToolTip="View Usage Statistics"
                    Padding="{Binding TouchMode, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='8,4|14,8'}"
                    FontSize="{Binding TouchMode, Converter={StaticResource TouchModeToDoubleConverter}, ConverterParameter='11|14'}"
                    Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text=" Statistics" VerticalAlignment="Center"
                               Visibility="{Binding TouchMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
            </Button>



            <!-- Scroll Right Button -->
            <Button x:Name="ScrollRightButton"
                    DockPanel.Dock="Right"
                    Content="›"
                    AutomationProperties.Name="Scroll tabs right"
                    Style="{StaticResource TerminalSwitchButton}"
                    Click="ScrollRight_Click"
                    ToolTip="Scroll right"
                    Visibility="Collapsed"
                    Padding="{Binding TouchMode, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='6,4|12,8'}"
                    Margin="0,0,2,0"/>

            <!-- Scroll Left Button -->
            <Button x:Name="ScrollLeftButton"
                    DockPanel.Dock="Right"
                    Content="‹"
                    AutomationProperties.Name="Scroll tabs left"
                    Style="{StaticResource TerminalSwitchButton}"
                    Click="ScrollLeft_Click"
                    ToolTip="Scroll left"
                    Visibility="Collapsed"
                    Padding="{Binding TouchMode, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='6,4|12,8'}"
                    Margin="0,0,2,0"/>

            <!-- Tab Dropdown Button (shows all tabs when there's overflow) -->
            <Button x:Name="TabDropdownButton"
                    DockPanel.Dock="Right"
                    Content="▼"
                    AutomationProperties.Name="Show all tabs"
                    Style="{StaticResource TerminalSwitchButton}"
                    Command="{Binding DataContext.OpenTabDropdownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="All tabs (Ctrl+Shift+T)"
                    Visibility="Collapsed"
                    Padding="{Binding TouchMode, Converter={StaticResource TouchModeToPaddingConverter}, ConverterParameter='6,4|12,8'}"
                    Margin="0,0,2,0"/>

            <!-- Tab List -->
            <ListBox x:Name="TabList"
                     ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab}"
                     AutomationProperties.AutomationId="TabList"
                     ItemTemplate="{StaticResource TabHeaderTemplate}"
                     Background="Transparent"
                     BorderThickness="0"
                     SizeChanged="TabList_SizeChanged">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="ScrollViewer"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Visibility" Value="{Binding IsVisibleInFocusMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
