<UserControl x:Class="TerminalHost.Views.CommandPalettePopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Border Background="#252525"
            BorderBrush="#0078D4"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0"
            Width="500"
            MaxHeight="450">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <Border Grid.Row="0" Background="#1E1E1E" Padding="12,10" CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text=">"
                               Foreground="#0078D4"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             Foreground="#CCCCCC"
                             CaretBrush="#CCCCCC"
                             BorderThickness="0"
                             FontSize="{StaticResource FontSizeNormal}"
                             VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- Command List -->
            <ListBox x:Name="CommandList"
                     Grid.Row="1"
                     Background="#252525"
                     BorderThickness="0"
                     MaxHeight="380"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="CommandList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="#CCCCCC"
                                           FontSize="{StaticResource FontSizeCode}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#808080"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Visibility="{Binding Description, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="#3C3C3C"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Visibility="{Binding Shortcut, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding DisplayShortcut}"
                                           Foreground="#808080"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E3E"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
