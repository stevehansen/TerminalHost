<UserControl x:Class="TerminalHost.Views.GitFilesContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             d:DataContext="{d:DesignInstance viewModels:GitFilesViewModel}"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundDarkBrush}">

    <UserControl.Resources>
        <!-- Shared file row style for ListBoxItem (used in both staged and unstaged lists) -->
        <Style x:Key="FileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Conventional commit prefix button style -->
        <Style x:Key="PrefixChipButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimmedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,3,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Staged file item template (with unstage button on hover) -->
        <DataTemplate x:Key="StagedFileTemplate">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.RowSpan="2"
                           Text="{Binding StatusIcon}"
                           Foreground="{Binding StatusColor}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           ToolTip="{Binding StatusDescription}"/>

                <TextBlock Grid.Column="1" Grid.Row="0"
                           Text="{Binding FileName}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1" Grid.Row="1"
                           Text="{Binding Directory}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Directory, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Unstage button (visible on hover) -->
                <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="−" ToolTip="Unstage file"
                            Style="{StaticResource InlineActionButton}"
                            Command="{Binding DataContext.UnstageItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Unstaged file item template (with stage + discard buttons on hover) -->
        <DataTemplate x:Key="UnstagedFileTemplate">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.RowSpan="2"
                           Text="{Binding StatusIcon}"
                           Foreground="{Binding StatusColor}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           ToolTip="{Binding StatusDescription}"/>

                <TextBlock Grid.Column="1" Grid.Row="0"
                           Text="{Binding FileName}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1" Grid.Row="1"
                           Text="{Binding Directory}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Directory, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Stage + Discard buttons (visible on hover) -->
                <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="+" ToolTip="Stage file"
                            Style="{StaticResource InlineActionButton}"
                            Command="{Binding DataContext.StageItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="↩" ToolTip="Discard changes"
                            Style="{StaticResource InlineActionButton}"
                            Command="{Binding DataContext.DiscardItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Foreground="#C74E4E"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Mode Toggle -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Working" GroupName="ChangesViewMode"
                             IsChecked="{Binding IsWorkingView, Mode=OneWay}"
                             Command="{Binding SetChangesViewModeCommand}" CommandParameter="Working"
                             Style="{StaticResource PopupModeTabButton}"
                             Margin="0,0,4,0"/>
                <RadioButton GroupName="ChangesViewMode"
                             IsChecked="{Binding IsBranchView, Mode=OneWay}"
                             Command="{Binding SetChangesViewModeCommand}" CommandParameter="Branch"
                             Style="{StaticResource PopupModeTabButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Branch"/>
                        <TextBlock Text="{Binding BaseBranchName, StringFormat=' vs {0}'}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding BaseBranchName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Working Changes View -->
        <Grid Grid.Row="1" Visibility="{Binding IsWorkingView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- File List + Commit Form -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- File list header -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding ToggleTreeViewCommand}"
                                    ToolTip="Toggle tree/list view"
                                    FontSize="12" Padding="4,2">
                                <Button.Content>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#x1f332;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTreeView}" Value="True">
                                                        <Setter Property="Text" Value="&#x2630;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>
                            <TextBlock Text="{Binding FileChangeSummary}"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Merge conflict banner -->
                    <Border Grid.Row="0" Margin="0,28,0,0"
                            Background="#33F14C4C" Padding="8,4"
                            Visibility="{Binding IsMergeInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Resolve"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding OpenMergeConflictResolverCommand}"
                                    Foreground="#F14C4C" Padding="6,2"/>
                            <TextBlock Foreground="#F14C4C" FontSize="{StaticResource FontSizeMicro}" VerticalAlignment="Center">
                                <Run Text="Merge in progress —"/>
                                <Run Text="{Binding ConflictCount, Mode=OneWay}"/>
                                <Run Text="conflicts"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- File lists (flat view) -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsTreeView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- STAGED section header -->
                            <Border Background="#1A3A1A3A" Padding="8,5"
                                    Visibility="{Binding StagedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="−"
                                            Style="{StaticResource InlineActionButton}"
                                            Command="{Binding UnstageAllCommand}"
                                            ToolTip="Unstage all files"
                                            FontWeight="Bold" Padding="6,2"/>
                                    <TextBlock Foreground="{StaticResource SyntaxGreenBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <Run Text="Staged Changes ("/>
                                        <Run Text="{Binding StagedFiles.Count, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <!-- Staged files list -->
                            <ListBox x:Name="StagedList"
                                     ItemsSource="{Binding StagedFiles}"
                                     ItemTemplate="{StaticResource StagedFileTemplate}"
                                     ItemContainerStyle="{StaticResource FileListBoxItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="StagedList_SelectionChanged"
                                     Visibility="{Binding StagedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>

                            <!-- UNSTAGED section header -->
                            <Border Background="#1A3A1A3A" Padding="8,5"
                                    Visibility="{Binding UnstagedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="+"
                                                Style="{StaticResource InlineActionButton}"
                                                Command="{Binding StageAllCommand}"
                                                ToolTip="Stage all files"
                                                FontWeight="Bold" Padding="6,2"/>
                                    </StackPanel>
                                    <TextBlock Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <Run Text="Changes ("/>
                                        <Run Text="{Binding UnstagedFiles.Count, Mode=OneWay}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </DockPanel>
                            </Border>

                            <!-- Unstaged files list -->
                            <ListBox x:Name="UnstagedList"
                                     ItemsSource="{Binding UnstagedFiles}"
                                     ItemTemplate="{StaticResource UnstagedFileTemplate}"
                                     ItemContainerStyle="{StaticResource FileListBoxItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="UnstagedList_SelectionChanged"
                                     Visibility="{Binding UnstagedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <ItemsPresenter/>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- File tree (tree view) -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsTreeView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <!-- Staged tree section -->
                            <Border Background="#1A3A1A3A" Padding="8,5"
                                    Visibility="{Binding StagedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Foreground="{StaticResource SyntaxGreenBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold">
                                    <Run Text="Staged Changes ("/>
                                    <Run Text="{Binding StagedFiles.Count, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Border>
                            <TreeView ItemsSource="{Binding StagedTree}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectedItemChanged="TreeView_SelectedItemChanged"
                                      Visibility="{Binding StagedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type domain:FileTreeNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2" Cursor="Hand">
                                            <TextBlock Text="{Binding DisplayIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CountDisplay}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>

                            <!-- Unstaged tree section -->
                            <Border Background="#1A3A1A3A" Padding="8,5"
                                    Visibility="{Binding UnstagedFiles.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <TextBlock Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontWeight="SemiBold">
                                    <Run Text="Changes ("/>
                                    <Run Text="{Binding UnstagedFiles.Count, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Border>
                            <TreeView ItemsSource="{Binding UnstagedTree}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectedItemChanged="TreeView_SelectedItemChanged">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type domain:FileTreeNode}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2" Cursor="Hand">
                                            <TextBlock Text="{Binding DisplayIcon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CountDisplay}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="{StaticResource FontSizeMicro}"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               Text="No changes"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeCode}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- COMMIT FORM -->
                    <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}"
                            Padding="8,6" BorderBrush="#3F3F3F" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- AI explanation callout (shown when HasExplanation is true) -->
                            <Border Background="#1A2D4A" CornerRadius="3" Margin="0,0,0,6"
                                    BorderBrush="#3A6DAA" BorderThickness="3,0,0,0"
                                    Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="8,7,6,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DiffExplanation}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               LineHeight="18"
                                               TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" Content="✕"
                                            Style="{StaticResource InlineActionButton}"
                                            Command="{Binding DismissExplanationCommand}"
                                            VerticalAlignment="Top" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Conventional commit prefix chips -->
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="feat" Style="{StaticResource PrefixChipButton}"
                                        Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="feat"/>
                                <Button Content="fix" Style="{StaticResource PrefixChipButton}"
                                        Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="fix"/>
                                <Button Content="refactor" Style="{StaticResource PrefixChipButton}"
                                        Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="refactor"/>
                                <Button Content="docs" Style="{StaticResource PrefixChipButton}"
                                        Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="docs"/>
                                <Button Content="chore" Style="{StaticResource PrefixChipButton}"
                                        Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="chore"/>
                                <Button Content="test" Style="{StaticResource PrefixChipButton}"
                                        Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="test"/>
                                <Button Content="style" Style="{StaticResource PrefixChipButton}"
                                        Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="style"/>
                                <Button Content="perf" Style="{StaticResource PrefixChipButton}"
                                        Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="perf"/>
                            </WrapPanel>

                            <!-- Commit message input -->
                            <Grid>
                                <TextBox x:Name="CommitMessageBox"
                                         Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="48"
                                         MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#1E1E1E"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="#3F3F3F"
                                         BorderThickness="1"
                                         Padding="6,4"
                                         FontSize="{StaticResource FontSizeTiny}"
                                         FontFamily="{StaticResource FontFamilyMonospace}"
                                         KeyDown="CommitMessageBox_KeyDown"/>
                                <!-- Placeholder text -->
                                <TextBlock Text="Commit message (Ctrl+Enter to commit)"
                                           IsHitTestVisible="False"
                                           Foreground="#555555"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"
                                           Margin="8,6,0,0"
                                           VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommitMessage}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Subject length + Amend + Actions row -->
                            <DockPanel Margin="0,5,0,0">
                                <!-- Commit button (rightmost) -->
                                <Button DockPanel.Dock="Right"
                                        Content="Commit"
                                        Command="{Binding CreateCommitCommand}"
                                        Padding="10,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Margin="4,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2D5230"/>
                                            <Setter Property="Foreground" Value="#6CCB5F"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                Padding="{TemplateBinding Padding}"
                                                                CornerRadius="3">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#3D6240"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="#252525"/>
                                                                <Setter Property="Foreground" Value="#555555"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Undo last commit button -->
                                <Button DockPanel.Dock="Right"
                                        Content="↩"
                                        Style="{StaticResource InlineActionButton}"
                                        Command="{Binding UndoLastCommitCommand}"
                                        ToolTip="Undo last commit (soft reset)"
                                        FontSize="14" Padding="5,2"
                                        Margin="2,0,0,0"/>

                                <!-- Explain staged changes button -->
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource InlineActionButton}"
                                        Command="{Binding ExplainChangesCommand}"
                                        ToolTip="Explain staged changes in plain English (AI)"
                                        FontSize="13" Padding="5,2"
                                        Margin="2,0,0,0">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="💡"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExplainingDiff}" Value="True">
                                                            <Setter Property="Text" Value="···"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>

                                <!-- Generate commit message button -->
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource InlineActionButton}"
                                        Command="{Binding GenerateCommitMessageCommand}"
                                        ToolTip="Generate commit message (AI-powered if Claude available)"
                                        FontSize="13" Padding="5,2"
                                        Margin="2,0,0,0">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✦"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGeneratingMessage}" Value="True">
                                                            <Setter Property="Text" Value="···"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>

                                <!-- Subject length indicator -->
                                <TextBlock DockPanel.Dock="Left"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeMicro}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSubjectTooLong}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding SubjectLength, Mode=OneWay}"/><Run Text="/72"/>
                                </TextBlock>

                                <!-- Amend checkbox -->
                                <CheckBox Content="Amend"
                                          IsChecked="{Binding AmendCommit}"
                                          Foreground="{StaticResource TextDimmedBrush}"
                                          FontSize="{StaticResource FontSizeMicro}"
                                          VerticalAlignment="Center"
                                          Margin="8,0,0,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

            <!-- Diff/Preview Area -->
            <Border Grid.Column="2" Background="{StaticResource BackgroundDarkestBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Diff header with actions -->
                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <!-- Explain this file's diff (works for staged and unstaged) -->
                                <Button Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding ExplainFileDiffCommand}"
                                        ToolTip="Explain this file's changes (AI)"
                                        Margin="0,0,4,0">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="💡 Explain"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExplainingFileDiff}" Value="True">
                                                            <Setter Property="Text" Value="···"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button Content="&#x1f441; Preview"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding PreviewFileCommand}"
                                        ToolTip="Open file preview"
                                        Margin="0,0,4,0"/>
                                <Button Content="&#x270f;&#xfe0f; Edit"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding EditFileCommand}"
                                        ToolTip="Open file in editor"
                                        Margin="0,0,4,0"/>
                                <Button Content="&#x1f4c2; Explorer"
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding ExploreFileCommand}"
                                        ToolTip="Open containing folder"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedGitFile.FilePath, StringFormat='Diff: {0}', FallbackValue='Select a file to view diff'}"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <!-- Per-file AI explanation callout -->
                    <Border Grid.Row="1" Background="#1A2D4A" BorderBrush="#3A6DAA" BorderThickness="0,0,0,0"
                            Padding="0"
                            Visibility="{Binding HasFileDiffExplanation, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="12,7,6,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding FileDiffExplanation}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       LineHeight="18"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Content="✕"
                                    Style="{StaticResource InlineActionButton}"
                                    Command="{Binding DismissFileDiffExplanationCommand}"
                                    VerticalAlignment="Top" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Diff content with hunk staging -->
                    <controls:HunkStagingDiffViewer Grid.Row="2"
                        x:Name="HunkDiffViewer"
                        DiffText="{Binding DiffText}"
                        IsStaged="{Binding SelectedGitFile.IsStaged}"/>
                </Grid>
            </Border>
        </Grid>
        <!-- End Working Changes View -->

        <!-- Branch Changes View -->
        <Grid Grid.Row="1" Visibility="{Binding IsBranchView, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Branch file list -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                        <TextBlock Foreground="{StaticResource TextDimmedBrush}" FontSize="{StaticResource FontSizeTiny}">
                            <Run Text="{Binding BranchChangedFiles.Count, Mode=OneWay}"/>
                            <Run Text="files changed vs"/>
                            <Run Text="{Binding BaseBranchName, Mode=OneWay}" Foreground="{StaticResource SyntaxGreenBrush}"/>
                        </TextBlock>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding BranchChangedFiles}"
                             SelectedItem="{Binding SelectedBranchFile}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                               Text="{Binding StatusIcon}"
                                               Foreground="{Binding StatusColor}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding StatusDescription}"/>

                                    <TextBlock Grid.Column="1" Grid.Row="0"
                                               Text="{Binding FileName}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Text="{Binding Directory}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="{StaticResource FontSizeMicro}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding Directory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Padding="{TemplateBinding Padding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                <Setter Property="Background" Value="#333333"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1"
                               Text="No file changes"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="{StaticResource FontSizeCode}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding BranchChangedFiles.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

            <!-- Branch diff area (read-only, no hunk staging) -->
            <Border Grid.Column="2" Background="{StaticResource BackgroundDarkestBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                        <TextBlock Text="{Binding SelectedBranchFile.FilePath, StringFormat='Diff: {0}', FallbackValue='Select a file to view diff'}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <controls:DiffViewer Grid.Row="1" DiffText="{Binding BranchDiffText}"/>
                </Grid>
            </Border>
        </Grid>
        <!-- End Branch Changes View -->
    </Grid>
</UserControl>
