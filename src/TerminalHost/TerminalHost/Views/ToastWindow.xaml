<Window x:Class="TerminalHost.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TerminalHost.Views"
        Title="Toasts"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        ResizeMode="NoResize"
        Width="420"
        Height="400">
    <!-- Toast container positioned at bottom-right -->
    <Grid VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,16,16">
        <views:ToastContainerView x:Name="ToastContainer"/>
    </Grid>
</Window>
