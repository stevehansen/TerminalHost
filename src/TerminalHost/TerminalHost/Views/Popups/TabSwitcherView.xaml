<UserControl x:Class="TerminalHost.Views.Popups.TabSwitcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="500" d:DesignWidth="400">
    <Border Background="#2D2D2D"
            BorderBrush="#0078D4"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8"
            MinWidth="400"
            MaxWidth="600"
            MaxHeight="500">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <TextBox x:Name="SwitcherSearchBox"
                     Grid.Row="0"
                     Background="#1E1E1E"
                     Foreground="#CCCCCC"
                     BorderBrush="#444444"
                     BorderThickness="1"
                     Padding="8,6"
                     Margin="0,0,0,8"
                     FontSize="14"
                     Text="{Binding SwitcherSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="SwitcherSearchBox_PreviewKeyDown"/>

            <!-- Tab List -->
            <ListBox x:Name="SwitcherTabList"
                     Grid.Row="1"
                     ItemsSource="{Binding FilteredSwitcherTabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="400"
                     MouseDoubleClick="SwitcherTabList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                       Text="{Binding TabIcon}"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <TextBlock Grid.Column="1" Grid.Row="0"
                                       Text="{Binding Title}"
                                       Foreground="#FFFFFF"
                                       FontSize="13"/>

                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="{Binding WorkingDirectory}"
                                       Foreground="#808080"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#3E3E3E"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#0078D4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
