<UserControl x:Class="TerminalHost.Views.Popups.GitFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Domain"
             xmlns:local="clr-namespace:TerminalHost"
             d:DataContext="{d:DesignInstance viewModels:GitFilesViewModel}"
             mc:Ignorable="d">
    <Popup x:Name="GitFilesPop"
               Placement="Absolute"
               StaysOpen="True"
               AllowsTransparency="True"
           IsOpen="{Binding IsOpen, Mode=TwoWay}"
           HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
           VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}">
        <Border x:Name="GitFilesBorder" Background="{StaticResource BackgroundDarkestBrush}"
                    BorderBrush="{StaticResource SyntaxCyanBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinWidth="500"
                    MinHeight="400"
                    Width="{Binding Width, Mode=TwoWay}"
                    Height="{Binding Height, Mode=TwoWay}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (draggable) -->
                <Border x:Name="GitFilesHeader" Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0"
                            MouseLeftButtonDown="GitFilesHeader_MouseLeftButtonDown"
                            MouseMove="GitFilesHeader_MouseMove"
                            MouseLeftButtonUp="GitFilesHeader_MouseLeftButtonUp"
                            Cursor="SizeAll">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                    Content="×"
                                    Style="{StaticResource TabCloseButton}"
                                    Command="{Binding CloseCommand}"
                                    FontSize="16"
                                    Padding="8,2"/>
                        <Button DockPanel.Dock="Right"
                                    Content="↻ Refresh"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding RefreshGitFilesCommand}"
                                    ToolTip="Refresh file list"
                                    Margin="0,0,8,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📋"
                                           Foreground="{StaticResource SyntaxCyanBrush}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                            <TextBlock x:Name="GitFilesTitle"
                                           Text="{Binding Title}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content - Split view: File list on left, diff/preview on right -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="200"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- File List -->
                    <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- File list header -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                                <TextBlock x:Name="GitFilesCount"
                                               Text="{Binding GitFiles.Count, StringFormat='{}{0} files changed'}"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="11"/>
                            </Border>

                            <!-- File list -->
                            <ListBox x:Name="GitFilesList"
                                         Grid.Row="1"
                                         ItemsSource="{Binding GitFiles}"
                                         SelectedItem="{Binding SelectedGitFile}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Status icon -->
                                            <TextBlock Grid.Column="0" Grid.RowSpan="2"
                                                           Text="{Binding StatusIcon}"
                                                           Foreground="{Binding StatusColor}"
                                                           FontFamily="Cascadia Code NF, Consolas"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding StatusDescription}"/>

                                            <!-- File name -->
                                            <TextBlock Grid.Column="1" Grid.Row="0"
                                                           Text="{Binding FileName}"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>

                                            <!-- Directory path -->
                                            <TextBlock Grid.Column="1" Grid.Row="1"
                                                           Text="{Binding Directory}"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Directory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#333333"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Empty state -->
                            <TextBlock x:Name="GitFilesEmptyState"
                                           Grid.Row="1"
                                           Text="No changes"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

                    <!-- Diff/Preview Area -->
                    <Border Grid.Column="2" Background="{StaticResource BackgroundDarkestBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Diff header with actions -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="GitFilePreviewButton"
                                                    Content="👁 Preview"
                                                    Style="{StaticResource TerminalSwitchButton}"
                                                    Command="{Binding PreviewFileCommand}"
                                                    ToolTip="Open file preview"
                                                    Margin="0,0,4,0"/>
                                        <Button x:Name="GitFileEditButton"
                                                    Content="✏️ Edit"
                                                    Style="{StaticResource TerminalSwitchButton}"
                                                    Command="{Binding EditFileCommand}"
                                                    ToolTip="Open file in editor"
                                                    Margin="0,0,4,0"/>
                                        <Button x:Name="GitFileExplorerButton"
                                                    Content="📂 Explorer"
                                                    Style="{StaticResource TerminalSwitchButton}"
                                                    Command="{Binding ExploreFileCommand}"
                                                    ToolTip="Open containing folder"/>
                                    </StackPanel>
                                    <TextBlock x:Name="GitDiffTitle"
                                                   Text="{Binding SelectedGitFile.FilePath, StringFormat='Diff: {0}', FallbackValue='Select a file to view diff'}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                                                        <!-- Diff content -->
                                                        <FlowDocumentScrollViewer Grid.Row="1"
                                                                                  Document="{Binding DiffDocument}"
                                                                                  VerticalScrollBarVisibility="Auto"
                                                                                  HorizontalScrollBarVisibility="Auto"
                                                                                  Background="{StaticResource BackgroundDarkestBrush}"
                                                                                  BorderThickness="0" />                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="12,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,0"
                                       Text="Press Escape to close"/>
                        <TextBlock x:Name="GitFilesInfo"
                                       Text="{Binding Info}"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Resize grip -->
                <Thumb x:Name="GitFilesResizeGrip" Grid.Row="2"
                           Width="16" Height="16"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,2,2"
                           Cursor="SizeNWSE"
                           DragDelta="GitFilesResizeGrip_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Grid Background="Transparent">
                                <Path Data="M 0,16 L 16,0 M 5,16 L 16,5 M 10,16 L 16,10"
                                      Stroke="{StaticResource ResizeGripBrush}" StrokeThickness="1.5"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Popup>
</UserControl>