<UserControl x:Class="TerminalHost.Views.Popups.GitFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             d:DataContext="{d:DesignInstance viewModels:GitFilesViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- File item template used in both staged and unstaged lists -->
        <DataTemplate x:Key="GitFileItemTemplate">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status icon -->
                <TextBlock Grid.Column="0" Grid.RowSpan="2"
                           Text="{Binding StatusIcon}"
                           Foreground="{Binding StatusColor}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeSmall}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           ToolTip="{Binding StatusDescription}"/>

                <!-- File name -->
                <TextBlock Grid.Column="1" Grid.Row="0"
                           Text="{Binding FileName}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Directory path -->
                <TextBlock Grid.Column="1" Grid.Row="1"
                           Text="{Binding Directory}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding Directory, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </DataTemplate>

        <!-- ListBoxItem style for git files -->
        <Style x:Key="GitFileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeaderButton" TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </UserControl.Resources>

    <controls:DraggablePopup
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        PopupWidth="{Binding Width, Mode=TwoWay}"
        PopupHeight="{Binding Height, Mode=TwoWay}"
        HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
        VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}"
        Title="{Binding Title}"
        CloseCommand="{Binding CloseCommand}">

        <controls:DraggablePopup.HeaderRightContent>
            <StackPanel Orientation="Horizontal">
                <Button Content="📦 Stash"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding QuickStashCommand}"
                        ToolTip="Stash current changes (Ctrl+Shift+S for stash manager)"
                        Margin="0,0,4,0"/>
                <Button Content="↻ Refresh"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding RefreshGitFilesCommand}"
                        ToolTip="Refresh file list"
                        Margin="0,0,8,0"/>
            </StackPanel>
        </controls:DraggablePopup.HeaderRightContent>

        <controls:DraggablePopup.PopupContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Content - Split view: File list on left, diff/preview on right -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="250"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel: Staged + Unstaged Files + Commit -->
                    <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Loading overlay -->
                            <Border Grid.RowSpan="3"
                                    Background="#80000000"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Panel.ZIndex="100">
                                <TextBlock Text="Loading..."
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Summary header -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                                <TextBlock Text="{Binding FileChangeSummary}"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"/>
                            </Border>

                            <!-- Files area with staged and unstaged sections -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Staged Changes Section -->
                                    <Border Background="{StaticResource BackgroundDarkBrush}"
                                            Visibility="{Binding StagedFiles.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Staged header -->
                                            <Border Grid.Row="0" Background="#1A4EC9B0" Padding="8,4">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Unstage All"
                                                                Style="{StaticResource SectionHeaderButton}"
                                                                Command="{Binding UnstageAllCommand}"
                                                                ToolTip="Unstage all files"/>
                                                    </StackPanel>
                                                    <TextBlock VerticalAlignment="Center">
                                                        <Run Text="Staged Changes" FontWeight="SemiBold" Foreground="#4EC9B0"/>
                                                        <Run Text=" (" Foreground="{StaticResource TextDimmedBrush}"/>
                                                        <Run Text="{Binding StagedFiles.Count, Mode=OneWay}" Foreground="{StaticResource TextDimmedBrush}"/>
                                                        <Run Text=")" Foreground="{StaticResource TextDimmedBrush}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Border>

                                            <!-- Staged file list -->
                                            <ListBox Grid.Row="1"
                                                     ItemsSource="{Binding StagedFiles}"
                                                     SelectedItem="{Binding SelectedGitFile}"
                                                     ItemTemplate="{StaticResource GitFileItemTemplate}"
                                                     ItemContainerStyle="{StaticResource GitFileListBoxItemStyle}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     MaxHeight="200"/>
                                        </Grid>
                                    </Border>

                                    <!-- Unstaged Changes Section -->
                                    <Border Background="{StaticResource BackgroundDarkBrush}"
                                            Visibility="{Binding UnstagedFiles.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Unstaged header -->
                                            <Border Grid.Row="0" Background="#1AE2C08D" Padding="8,4">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Stage All"
                                                                Style="{StaticResource SectionHeaderButton}"
                                                                Command="{Binding StageAllCommand}"
                                                                ToolTip="Stage all files"/>
                                                    </StackPanel>
                                                    <TextBlock VerticalAlignment="Center">
                                                        <Run Text="Unstaged Changes" FontWeight="SemiBold" Foreground="#E2C08D"/>
                                                        <Run Text=" (" Foreground="{StaticResource TextDimmedBrush}"/>
                                                        <Run Text="{Binding UnstagedFiles.Count, Mode=OneWay}" Foreground="{StaticResource TextDimmedBrush}"/>
                                                        <Run Text=")" Foreground="{StaticResource TextDimmedBrush}"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </Border>

                                            <!-- Unstaged file list -->
                                            <ListBox Grid.Row="1"
                                                     ItemsSource="{Binding UnstagedFiles}"
                                                     SelectedItem="{Binding SelectedGitFile}"
                                                     ItemTemplate="{StaticResource GitFileItemTemplate}"
                                                     ItemContainerStyle="{StaticResource GitFileListBoxItemStyle}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                        </Grid>
                                    </Border>

                                    <!-- Empty state -->
                                    <TextBlock Text="No changes"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="{StaticResource FontSizeCode}"
                                               HorizontalAlignment="Center"
                                               Margin="0,40"
                                               Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Commit Section -->
                            <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="8" BorderThickness="0,1,0,0" BorderBrush="#333">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Commit header with conventional commit buttons -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="Commit Message"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="feat" Style="{StaticResource SectionHeaderButton}"
                                                    Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="feat"
                                                    ToolTip="New feature"/>
                                            <Button Content="fix" Style="{StaticResource SectionHeaderButton}"
                                                    Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="fix"
                                                    ToolTip="Bug fix"/>
                                            <Button Content="docs" Style="{StaticResource SectionHeaderButton}"
                                                    Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="docs"
                                                    ToolTip="Documentation"/>
                                            <Button Content="refactor" Style="{StaticResource SectionHeaderButton}"
                                                    Command="{Binding InsertConventionalPrefixCommand}" CommandParameter="refactor"
                                                    ToolTip="Code refactoring"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Commit message input -->
                                    <TextBox Grid.Row="1"
                                             Text="{Binding CommitMessage, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BackgroundDarkestBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="#444"
                                             FontFamily="{StaticResource FontFamilyMonospace}"
                                             FontSize="{StaticResource FontSizeSmall}"
                                             Padding="6"
                                             Height="60"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"/>

                                    <!-- Character count and amend checkbox -->
                                    <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontSize="{StaticResource FontSizeMicro}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimmedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSubjectTooLong}" Value="True">
                                                            <Setter Property="Foreground" Value="#E2C08D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding SubjectLength, Mode=OneWay}"/>
                                            <Run Text="/72"/>
                                        </TextBlock>
                                        <CheckBox Content="Amend"
                                                  IsChecked="{Binding AmendCommit}"
                                                  Foreground="{StaticResource TextDimmedBrush}"
                                                  FontSize="{StaticResource FontSizeMicro}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Amend the last commit"/>
                                    </DockPanel>

                                    <!-- Commit button -->
                                    <Button Grid.Row="3"
                                            Margin="0,8,0,0"
                                            Command="{Binding CreateCommitCommand}"
                                            HorizontalAlignment="Stretch"
                                            Padding="8,6"
                                            Background="{StaticResource AccentBlueBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#4A90D9"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Commit"/>
                                            <TextBlock Text=" (" Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding StagedFiles.Count}" Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text=")" Visibility="{Binding HasStagedFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

                    <!-- Diff/Preview Area -->
                    <Border Grid.Column="2" Background="{StaticResource BackgroundDarkestBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Diff header with actions -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <!-- Staging buttons for selected file -->
                                        <Button Content="+ Stage"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding StageFileCommand}"
                                                ToolTip="Stage this file"
                                                Foreground="#4EC9B0"
                                                Margin="0,0,4,0"/>
                                        <Button Content="- Unstage"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding UnstageFileCommand}"
                                                ToolTip="Unstage this file"
                                                Foreground="#E2C08D"
                                                Margin="0,0,4,0"/>
                                        <Button Content="✕ Discard"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DiscardChangesCommand}"
                                                ToolTip="Discard changes (cannot be undone)"
                                                Foreground="#F14C4C"
                                                Margin="0,0,8,0"/>
                                        <Border Width="1" Background="#444" Margin="0,2,8,2"/>
                                        <Button Content="👁"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding PreviewFileCommand}"
                                                ToolTip="Open file preview"
                                                Margin="0,0,4,0"/>
                                        <Button Content="✏"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding EditFileCommand}"
                                                ToolTip="Open file in editor"
                                                Margin="0,0,4,0"/>
                                        <Button Content="📂"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding ExploreFileCommand}"
                                                ToolTip="Open containing folder"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedGitFile.FilePath, StringFormat='Diff: {0}', FallbackValue='Select a file to view diff'}"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                            <!-- Diff content -->
                            <controls:DiffViewer Grid.Row="1" DiffText="{Binding DiffText}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" Padding="12,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"
                                   Text="Press Escape to close"/>
                        <TextBlock Text="{Binding Info}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </controls:DraggablePopup.PopupContent>
    </controls:DraggablePopup>
</UserControl>
