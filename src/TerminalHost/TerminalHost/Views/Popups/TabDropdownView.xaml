<UserControl x:Class="TerminalHost.Views.Popups.TabDropdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="300" d:DesignWidth="200">
    
    <Border Background="#2D2D2D"
            BorderBrush="#444444"
            BorderThickness="1"
            CornerRadius="4"
            Padding="4"
            MaxHeight="400"
            MinWidth="200">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <TextBox x:Name="DropdownSearchBox"
                     Grid.Row="0"
                     Background="#1E1E1E"
                     Foreground="#CCCCCC"
                     BorderBrush="#444444"
                     BorderThickness="1"
                     Padding="6,4"
                     Margin="0,0,0,4"
                     Text="{Binding DropdownSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="DropdownSearchBox_PreviewKeyDown">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="#1E1E1E"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Tab List -->
            <ListBox x:Name="DropdownTabList"
                     Grid.Row="1"
                     ItemsSource="{Binding FilteredDropdownTabs}"
                     SelectedItem="{Binding SelectedTab, Mode=OneWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="350"
                     MouseUp="DropdownTabList_MouseUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="{Binding TabIcon}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E3E3E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0078D4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>