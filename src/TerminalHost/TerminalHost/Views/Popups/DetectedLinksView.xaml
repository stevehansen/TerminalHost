<UserControl x:Class="TerminalHost.Views.Popups.DetectedLinksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:local="clr-namespace:TerminalHost"
             d:DataContext="{d:DesignInstance viewModels:DetectedLinksViewModel}"
             mc:Ignorable="d">
    <Popup x:Name="DetectedLinksPop"
           Placement="Center"
           PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
           StaysOpen="True"
           AllowsTransparency="True"
           IsOpen="{Binding IsOpen, Mode=TwoWay}"
           Width="{Binding Width, Mode=TwoWay}"
           Height="{Binding Height, Mode=TwoWay}">
        <Border Background="{StaticResource BackgroundDarkBrush}"
                BorderBrush="{StaticResource AccentPrimaryBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                MinWidth="300"
                MaxWidth="500"
                MaxHeight="400">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="↻"
                                Style="{StaticResource TabCloseButton}"
                                Command="{Binding RefreshLinksCommand}"
                                ToolTip="Refresh links"
                                FontSize="14"
                                Padding="6,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔗" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Detected Links"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Links List -->
                <ListBox x:Name="LinksList"
                         Grid.Row="1"
                         ItemsSource="{Binding Links}"
                         SelectedItem="{Binding SelectedLink}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="320"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="LinksList_MouseDoubleClick"
                         PreviewKeyDown="LinksList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayText}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Url}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PopupListBoxItem}"/>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyState"
                           Grid.Row="1"
                           Text="No links detected"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="20"
                           Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="12,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="👁️ Preview"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding PreviewSelectedLinkCommand}"
                                    ToolTip="Preview file"
                                    Margin="0,0,4,0"/>
                            <Button Content="🌐 Open"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding OpenSelectedLinkCommand}"
                                    ToolTip="Open link"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="10"
                                   Text="Double-click or Enter to open, Esc to close"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Popup>
</UserControl>
