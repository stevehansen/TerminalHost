<UserControl x:Class="TerminalHost.Views.Popups.ReflogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:ReflogViewModel}"
             mc:Ignorable="d"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <Popup x:Name="ReflogPopup"
           Placement="Center"
           PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
           StaysOpen="True"
           AllowsTransparency="True"
           IsOpen="{Binding IsOpen, Mode=TwoWay}">
        <Border Background="{StaticResource BackgroundDarkBrush}"
                BorderBrush="{StaticResource SyntaxOrangeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                Width="{Binding Width, Mode=TwoWay}"
                Height="{Binding Height, Mode=TwoWay}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="x"
                                Style="{StaticResource TabCloseButton}"
                                Command="{Binding CloseCommand}"
                                FontSize="{StaticResource FontSizeLarge}"
                                Padding="8,2"/>
                        <Button DockPanel.Dock="Right"
                                Content="Refresh"
                                Style="{StaticResource TerminalSwitchButton}"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Refresh reflog"
                                Margin="0,0,8,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="R"
                                       Foreground="{StaticResource SyntaxOrangeBrush}"
                                       FontSize="{StaticResource FontSizeNormal}"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Create Branch Section -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8"
                        Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Create branch:"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 Padding="8,6"
                                 FontSize="{StaticResource FontSizeCode}"
                                 ToolTip="Branch name to create from selected entry"/>

                        <Button Grid.Column="2"
                                Content="Create"
                                Style="{StaticResource TerminalSwitchButton}"
                                Command="{Binding CreateBranchCommand}"
                                ToolTip="Create branch from selected reflog entry"
                                Margin="8,0,0,0"
                                Padding="12,6"/>
                    </Grid>
                </Border>

                <!-- Reflog List -->
                <ListBox x:Name="ReflogList"
                         Grid.Row="2"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Selector and Action -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Background="{StaticResource BackgroundMediumBrush}"
                                            CornerRadius="3"
                                            Padding="4,2"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ActionIcon}"
                                                   Foreground="{StaticResource SyntaxCyanBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="Bold"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Selector}"
                                               Foreground="{StaticResource SyntaxOrangeBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" "
                                               FontSize="{StaticResource FontSizeSmall}"/>
                                    <TextBlock Text="{Binding ShortHash}"
                                               Foreground="{StaticResource SyntaxYellowBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding DisplayText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>

                                <!-- Time and Actions -->
                                <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding RelativeTime}"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Checkout"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DataContext.CheckoutCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                FontSize="{StaticResource FontSizeTiny}"
                                                Padding="6,2"
                                                Margin="0,0,4,0"
                                                ToolTip="Checkout this commit (detached HEAD)"/>
                                        <Button Content="Copy"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding DataContext.CopyHashCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                FontSize="{StaticResource FontSizeTiny}"
                                                Padding="6,2"
                                                ToolTip="Copy full commit hash"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Empty state -->
                <TextBlock Grid.Row="2"
                           Text="No reflog entries"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="20"
                           Visibility="{Binding Entries.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                <!-- Loading overlay -->
                <Border Grid.Row="2"
                        Background="#80000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Loading..."
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeNormal}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Footer with hints -->
                <Border Grid.Row="3" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}">
                            <Run Text="Escape"/>
                            <Run Text=" to close"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Info}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Popup>
</UserControl>
