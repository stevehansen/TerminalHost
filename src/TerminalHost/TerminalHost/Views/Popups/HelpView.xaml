<UserControl x:Class="TerminalHost.Views.Popups.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:HelpViewModel}"
             d:DesignHeight="500" d:DesignWidth="700"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Border Background="{StaticResource BackgroundDarkBrush}"
        BorderBrush="{StaticResource AccentPrimaryBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Margin="10"
        MinWidth="700"
        MaxWidth="900"
        MaxHeight="850">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="8,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                        Content="x"
                        AutomationProperties.Name="Close Help"
                        Style="{StaticResource TabCloseButton}"
                        Command="{Binding CloseCommand}"
                        FontSize="{StaticResource FontSizeHeader}"
                        Padding="8,2"/>
                    <TextBlock Text="TerminalHost Help"
                           Foreground="{StaticResource TextBrightBrush}"
                           FontSize="{StaticResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel Margin="10">
                    <!-- Keyboard Shortcuts Header -->
                    <TextBlock Text="Keyboard Shortcuts"
                               Foreground="{StaticResource SyntaxCyanBrush}"
                               FontSize="{StaticResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <!-- Shortcut Sections -->
                    <ItemsControl ItemsSource="{Binding ShortcutSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <!-- Section Header -->
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource SyntaxLightBlueBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Margin="0,0,0,6"/>
                                    <!-- Shortcut Items -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Shortcut}"
                                                               Foreground="{StaticResource SyntaxOrangeBrush}"
                                                               Margin="0,2"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Description}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="0,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quick Commands Section -->
                    <ItemsControl ItemsSource="{Binding QuickCommandSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,16">
                                    <!-- Section Header -->
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource SyntaxCyanBrush}"
                                               FontSize="{StaticResource FontSizeNormal}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12"/>
                                    <!-- Shortcut Items -->
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Shortcut}"
                                                               Foreground="{StaticResource SyntaxOrangeBrush}"
                                                               Margin="0,2"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Description}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="0,2"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tips Section -->
                    <TextBlock Text="Tips"
                               Foreground="{StaticResource SyntaxCyanBrush}"
                               FontSize="{StaticResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               Margin="0,8,0,12"/>
                    <ItemsControl ItemsSource="{Binding Tips}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run Text="* " Foreground="{StaticResource SyntaxBlueBrush}"/><Run Text="{Binding Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Command Line Section -->
                    <TextBlock Text="Command Line Usage"
                               Foreground="{StaticResource SyntaxCyanBrush}"
                               FontSize="{StaticResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               Margin="0,8,0,12"/>
                    <Border Background="{StaticResource BackgroundDarkestBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding CommandLineExamples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{StaticResource FontFamilyMonospace}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,2">
                                        <Run Text="{Binding Command, Mode=OneWay}" Foreground="{StaticResource SyntaxCyanBrush}"/>
                                        <Run Text="  # "/>
                                        <Run Text="{Binding Description, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Paths Section -->
                    <TextBlock Text="Important Paths"
                               Foreground="{StaticResource SyntaxCyanBrush}"
                               FontSize="{StaticResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               Margin="0,8,0,12"/>
                    <ItemsControl ItemsSource="{Binding ImportantPaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               Foreground="{StaticResource SyntaxLightBlueBrush}"
                                               Margin="0,2"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Path}"
                                               Foreground="{StaticResource SyntaxOrangeBrush}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Margin="0,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="16,10" CornerRadius="0,0,8,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                           Foreground="{StaticResource TextDimmedBrush}"
                           FontSize="{StaticResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Text="Press Escape or F1 to close"/>
                    <TextBlock Foreground="{StaticResource TextDimmedBrush}"
                           FontSize="{StaticResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Text="{Binding VersionString}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
