<UserControl x:Class="TerminalHost.Views.Popups.TaskPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TaskPanelViewModel}"
             d:DesignHeight="600" d:DesignWidth="550"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Width="550"
            MaxHeight="600">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,10" CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="📋"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock Grid.Column="1"
                               Text="Tasks"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- Focus Mode Toggle -->
                    <Button Grid.Column="2"
                            Command="{Binding ToggleFocusModeCommand}"
                            ToolTip="{Binding FocusModeButtonText}"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BorderDimBrush}"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocusModeEnabled}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FocusModeIcon}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding FocusModeButtonText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeSmall}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Content="×"
                            Click="CloseButton_Click"
                            Style="{StaticResource TabCloseButton}"
                            Padding="8,2"/>
                </Grid>
            </Border>

            <!-- Current Task Section -->
            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundLightBrush}"
                    Padding="12,10"
                    Visibility="{Binding HasCurrentTask, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Current Task Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="● CURRENT"
                                   Foreground="{StaticResource AccentYellowBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentTaskElapsed}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Task Title -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding CurrentTaskTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,6,0,4"/>

                    <!-- Projects -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding CurrentTaskProjects}"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Margin="0,0,0,4"/>

                    <!-- PR Link (if any) -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding CurrentTaskPrDisplay}"
                               Foreground="{StaticResource AccentBlueBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Visibility="{Binding CurrentTaskHasPrLink, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,0,0,8"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="✓ Complete"
                                Command="{Binding CompleteCurrentTaskCommand}"
                                Style="{StaticResource SmallButton}"
                                Background="{StaticResource AccentGreenBrush}"
                                Margin="0,0,8,0"/>
                        <Button Content="⏸ Pause"
                                Command="{Binding PauseCurrentTaskCommand}"
                                Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="+ Subtask"
                                Command="{Binding AddSubtaskCommand}"
                                Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="🔄 PR"
                                ToolTip="Refresh PR/Branch info"
                                Command="{Binding RefreshPrInfoCommand}"
                                Style="{StaticResource SmallButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content (Scrollable) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,8">

                    <!-- Add Task Section -->
                    <Border Background="{StaticResource BackgroundDarkestBrush}"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,12"
                            Visibility="{Binding IsAddingTask, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="NewTaskTextBox"
                                     Grid.Row="0"
                                     Text="{Binding NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource BackgroundLightBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderDimBrush}"
                                     Padding="8,6"
                                     FontSize="{StaticResource FontSizeNormal}"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Cancel"
                                        Command="{Binding CancelAddTaskCommand}"
                                        Style="{StaticResource SmallButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Add"
                                        Command="{Binding CreateTaskCommand}"
                                        Style="{StaticResource SmallButton}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Add &amp; Start"
                                        Command="{Binding CreateAndStartTaskCommand}"
                                        Style="{StaticResource SmallButton}"
                                        Background="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Backlog Section -->
                    <TextBlock Text="○ BACKLOG"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding BacklogTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundDarkestBrush}"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="TaskItem_MouseLeftButtonDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusIcon}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="{StaticResource FontSizeCode}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ProjectPaths.Count, StringFormat='{}{0} project(s)'}"
                                                       Foreground="{StaticResource TextDimmedBrush}"
                                                       FontSize="{StaticResource FontSizeTiny}"
                                                       Visibility="{Binding ProjectPaths.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Border Background="{StaticResource BackgroundLightBrush}"
                                                    CornerRadius="3"
                                                    Padding="4,2"
                                                    Margin="4,0"
                                                    Visibility="{Binding Priority, Converter={StaticResource CountToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Priority, StringFormat='P:{0}'}"
                                                           Foreground="{StaticResource TextDimmedBrush}"
                                                           FontSize="{StaticResource FontSizeTiny}"/>
                                            </Border>
                                            <Button Content="▶"
                                                    ToolTip="Start Task"
                                                    Command="{Binding DataContext.StartTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    Padding="6,2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty Backlog Message -->
                    <TextBlock Text="No tasks in backlog. Click + to add one."
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontStyle="Italic"
                               Margin="0,4,0,12"
                               Visibility="{Binding BacklogTasks.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>

                    <!-- Quick Notes Section -->
                    <TextBlock Text="📝 QUICK NOTES"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontWeight="Bold"
                               Margin="0,12,0,8"
                               Visibility="{Binding QuickNotes.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding QuickNotes}"
                                  Visibility="{Binding QuickNotes.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundDarkestBrush}"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Preview}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="→ Task"
                                                    ToolTip="Convert to Task"
                                                    Command="{Binding DataContext.ConvertNoteToTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SmallButton}"
                                                    Padding="6,2"
                                                    Margin="4,0"/>
                                            <Button Content="×"
                                                    ToolTip="Delete Note"
                                                    Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TabCloseButton}"
                                                    Padding="4,2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Completed Today Section -->
                    <TextBlock Text="✓ COMPLETED TODAY"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontWeight="Bold"
                               Margin="0,12,0,8"
                               Visibility="{Binding CompletedTodayTasks.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding CompletedTodayTasks}"
                                  Visibility="{Binding CompletedTodayTasks.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundDarkestBrush}"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,4"
                                        Opacity="0.7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="✅"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeCode}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextDecorations="Strikethrough"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ElapsedTimeDisplay}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8" CornerRadius="0,0,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="+ New Task"
                                Command="{Binding ShowAddTaskCommand}"
                                Style="{StaticResource SmallButton}"
                                Margin="0,0,8,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Ctrl+T to toggle • Esc to close"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
