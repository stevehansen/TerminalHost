<UserControl x:Class="TerminalHost.Views.Popups.FilePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:local="clr-namespace:TerminalHost"
             d:DataContext="{d:DesignInstance viewModels:FilePreviewViewModel}"
             mc:Ignorable="d">
    <Popup x:Name="FilePreviewPop"
           Placement="Absolute"
           StaysOpen="True"
           AllowsTransparency="True"
           IsOpen="{Binding IsOpen, Mode=TwoWay}"
           HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
           VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}">
        <Border x:Name="FilePreviewBorder" Background="{StaticResource BackgroundDarkestBrush}"
                BorderBrush="{StaticResource AccentPrimaryBrush}"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="500"
                MinHeight="400"
                Width="{Binding Width, Mode=TwoWay}"
                Height="{Binding Height, Mode=TwoWay}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (draggable) -->
                <Border x:Name="FilePreviewHeader" Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="FilePreviewHeader_MouseLeftButtonDown"
                        MouseMove="FilePreviewHeader_MouseMove"
                        MouseLeftButtonUp="FilePreviewHeader_MouseLeftButtonUp"
                        Cursor="SizeAll">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Style="{StaticResource TabCloseButton}"
                                Command="{Binding CloseCommand}"
                                FontSize="{StaticResource FontSizeLarge}"
                                Padding="8,2"/>
                        <Button DockPanel.Dock="Right"
                                Content="✏️ Edit"
                                Style="{StaticResource TerminalSwitchButton}"
                                Command="{Binding OpenInEditorCommand}"
                                ToolTip="Open file in editor"
                                Margin="0,0,8,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👁"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeNormal}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="FilePreviewTitle"
                                       Text="{Binding Title}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content -->
                <FlowDocumentScrollViewer x:Name="FilePreviewContent"
                                          Grid.Row="1"
                                          Document="{Binding Content}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Background="{StaticResource BackgroundDarkestBrush}"
                                          BorderThickness="0" />

                <!-- Footer -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="12,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"
                                   Text="Press Escape to close"/>
                        <TextBlock x:Name="FilePreviewInfo"
                                   Text="{Binding Info}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Resize grip -->
                <Thumb x:Name="FilePreviewResizeGrip" Grid.Row="2"
                       Width="16" Height="16"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,2,2"
                       Cursor="SizeNWSE"
                       DragDelta="FilePreviewResizeGrip_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Grid Background="Transparent">
                                <Path Data="M 0,16 L 16,0 M 5,16 L 16,5 M 10,16 L 16,10"
                                      Stroke="{StaticResource ResizeGripBrush}" StrokeThickness="1.5"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Popup>
</UserControl>