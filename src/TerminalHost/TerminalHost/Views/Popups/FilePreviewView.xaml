<UserControl x:Class="TerminalHost.Views.Popups.FilePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             d:DataContext="{d:DesignInstance viewModels:FilePreviewViewModel}"
             mc:Ignorable="d">
    
    <controls:DraggablePopup
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        PopupWidth="{Binding Width, Mode=TwoWay}"
        PopupHeight="{Binding Height, Mode=TwoWay}"
        HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
        VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}"
        Title="{Binding Title}"
        CloseCommand="{Binding CloseCommand}">
        
        <controls:DraggablePopup.HeaderRightContent>
             <Button Content="✏️ Edit"
                     Style="{StaticResource TerminalSwitchButton}"
                     Command="{Binding OpenInEditorCommand}"
                     ToolTip="Open file in editor"
                     Margin="0,0,8,0"/>
        </controls:DraggablePopup.HeaderRightContent>

        <controls:DraggablePopup.PopupContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Content Area -->
                <Grid Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}">
                    <!-- Text/Code Mode -->
                    <FlowDocumentScrollViewer Document="{Binding Content}"
                                              Visibility="{Binding IsText, Converter={StaticResource BoolToVisibilityConverter}}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              Background="{StaticResource BackgroundDarkestBrush}"
                                              BorderThickness="0" />

                    <!-- Markdown Mode -->
                    <controls:MarkdownViewer HtmlContent="{Binding RenderedHtml}"
                                             BasePath="{Binding MarkdownBasePath}"
                                             MarkdownLinkClicked="MarkdownViewer_LinkClicked"
                                             Visibility="{Binding IsMarkdown, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Image Mode -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Image Source="{Binding ImageSource}" 
                               Stretch="None" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Margin="16"/>
                    </ScrollViewer>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" Padding="12,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"
                                   Text="Press Escape to close"/>
                        <TextBlock Text="{Binding Info}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </controls:DraggablePopup.PopupContent>
    </controls:DraggablePopup>
</UserControl>