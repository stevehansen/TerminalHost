<UserControl x:Class="TerminalHost.Views.Popups.FileBlameView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Domain"
             d:DataContext="{d:DesignInstance viewModels:FileBlameViewModel}"
             mc:Ignorable="d"
             IsVisible="{Binding IsOpen}">

    <!-- Overlay panel centered in parent -->
    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{StaticResource BackgroundDarkBrush}"
                BorderBrush="{StaticResource SyntaxPurpleBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                Width="1100"
                Height="750"
                BoxShadow="0 5 20 0 #80000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="x"
                                Classes="TabCloseButton"
                                Command="{Binding CloseCommand}"
                                FontSize="{StaticResource FontSizeLarge}"
                                Padding="8,2"/>
                        <Button DockPanel.Dock="Right"
                                Content="Refresh"
                                Classes="TerminalSwitchButton"
                                Command="{Binding RefreshCommand}"
                                ToolTip.Tip="Refresh blame"
                                Margin="0,0,8,0"/>
                        <ToggleButton DockPanel.Dock="Right"
                                      Content="Colors"
                                      Classes="TerminalSwitchButton"
                                      IsChecked="{Binding ColorByAuthor}"
                                      ToolTip.Tip="Color by author"
                                      Margin="0,0,8,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="{StaticResource FontSizeNormal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="File Blame - "
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FileName}"
                                       Foreground="{StaticResource SyntaxPurpleBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content: Split view with blame lines and commit details -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Blame lines -->
                    <ListBox x:Name="BlameList"
                             Grid.Column="0"
                             ItemsSource="{Binding BlameLines}"
                             SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                             Background="{StaticResource BackgroundDarkestBrush}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="domain:GitBlameLine">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Short hash -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ShortHash}"
                                               Foreground="{StaticResource SyntaxCyanBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Padding="4,2"
                                               VerticalAlignment="Center"/>

                                    <!-- Author -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Author}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="4,2"
                                               VerticalAlignment="Center"/>

                                    <!-- Relative date -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RelativeDate}"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               Padding="4,2"
                                               VerticalAlignment="Center"/>

                                    <!-- Line number -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding LineNumber}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               TextAlignment="Right"
                                               Padding="4,2"
                                               VerticalAlignment="Center"/>

                                    <!-- Content -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Content}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontFamily="{StaticResource FontFamilyMonospace}"
                                               Padding="8,2"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="MinHeight" Value="20"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BorderSubtleBrush}"/>

                    <!-- Commit details -->
                    <Border Grid.Column="2" Background="{StaticResource BackgroundMediumBrush}">
                        <Grid>
                            <!-- Commit details when selected -->
                            <ScrollViewer IsVisible="{Binding SelectedCommitDetails, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Padding="12">
                                <StackPanel Spacing="12" DataContext="{Binding SelectedCommitDetails}">
                                    <TextBlock Text="Commit Details"
                                               Foreground="{StaticResource TextBrightBrush}"
                                               FontSize="{StaticResource FontSizeNormal}"
                                               FontWeight="SemiBold"/>

                                    <!-- Hash -->
                                    <StackPanel>
                                        <TextBlock Text="Hash"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"/>
                                        <TextBlock Text="{Binding ShortHash}"
                                                   Foreground="{StaticResource SyntaxCyanBrush}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>

                                    <!-- Author -->
                                    <StackPanel>
                                        <TextBlock Text="Author"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"/>
                                        <TextBlock Text="{Binding Author}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                        <TextBlock Text="{Binding AuthorEmail}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"/>
                                    </StackPanel>

                                    <!-- Date -->
                                    <StackPanel>
                                        <TextBlock Text="Date"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"/>
                                        <TextBlock Text="{Binding Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"/>
                                    </StackPanel>

                                    <!-- Subject -->
                                    <StackPanel>
                                        <TextBlock Text="Message"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"/>
                                        <TextBlock Text="{Binding Subject}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Body}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"
                                                   IsVisible="{Binding Body, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- No selection message -->
                            <TextBlock Text="Select a line to view commit details"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding SelectedCommitDetails, Converter={x:Static ObjectConverters.IsNull}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copy Hash"
                                    Classes="TerminalSwitchButton"
                                    Command="{Binding CopyHashCommand}"
                                    ToolTip.Tip="Copy commit hash to clipboard"/>
                        </StackPanel>
                        <TextBlock Text="{Binding BlameLines.Count, StringFormat='{}{0} lines'}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>
