<UserControl x:Class="TerminalHost.Views.Popups.QuickNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="450"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource SyntaxYellowBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Width="450"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="📝"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock Grid.Column="1"
                               Text="Quick Note"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="×"
                            Click="CloseButton_Click"
                            Style="{StaticResource TabCloseButton}"
                            Padding="8,2"/>
                </Grid>
            </Border>

            <!-- Input -->
            <Border Grid.Row="1" Padding="12,10">
                <TextBox x:Name="NoteTextBox"
                         Text="{Binding QuickNoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource BackgroundLightBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         CaretBrush="{StaticResource TextPrimaryBrush}"
                         BorderThickness="1"
                         BorderBrush="{StaticResource BorderSubtleBrush}"
                         Padding="10,8"
                         FontSize="{StaticResource FontSizeNormal}"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         MaxHeight="60"/>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8" CornerRadius="0,0,6,6">
                <TextBlock Text="Enter to save • Esc to cancel"
                           Foreground="{StaticResource TextDimmedBrush}"
                           FontSize="{StaticResource FontSizeTiny}"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
