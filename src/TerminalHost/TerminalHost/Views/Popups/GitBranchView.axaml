<UserControl x:Class="TerminalHost.Views.Popups.GitBranchView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:GitBranchViewModel}"
             mc:Ignorable="d"
             IsVisible="{Binding IsOpen}">

    <!-- Overlay panel centered in parent -->
    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="{StaticResource BackgroundDarkBrush}"
                BorderBrush="{StaticResource SyntaxCyanBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                MinWidth="400"
                MaxWidth="550"
                MaxHeight="500"
                Width="{Binding Width, Mode=TwoWay}"
                Height="{Binding Height, Mode=TwoWay}"
                BoxShadow="0 5 20 0 #80000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Classes="TabCloseButton"
                                Command="{Binding CloseCommand}"
                                FontSize="{StaticResource FontSizeLarge}"
                                Padding="8,2"/>
                        <Button DockPanel.Dock="Right"
                                Content="⟳ Pull"
                                Classes="TerminalSwitchButton"
                                Command="{Binding PullCommand}"
                                ToolTip.Tip="Pull current branch"
                                Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right"
                                Content="↓ Fetch"
                                Classes="TerminalSwitchButton"
                                Command="{Binding FetchAllCommand}"
                                ToolTip.Tip="Fetch all remotes"
                                Margin="0,0,4,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌿" FontSize="{StaticResource FontSizeNormal}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Search Box -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8">
                    <TextBox x:Name="GitBranchSearchBox"
                             Text="{Binding SearchText}"
                             Background="{StaticResource BackgroundMediumBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="{StaticResource FontSizeCode}"/>
                </Border>

                <!-- Branch List -->
                <ListBox x:Name="GitBranchList"
                         Grid.Row="2"
                         ItemsSource="{Binding Branches}"
                         SelectedItem="{Binding SelectedBranch}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="350"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="viewModels:GitBranchViewModel">
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Current branch indicator -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           Foreground="{Binding StatusColor}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <!-- Branch name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Foreground="{Binding StatusColor}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Issue number (for branches like issues/#123) -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding IssueNumber}"
                                           Foreground="{StaticResource SyntaxBlueBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           IsVisible="{Binding IssueNumber, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Ahead/Behind status -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding StatusDisplay}"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           IsVisible="{Binding StatusDisplay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>

                <!-- Empty state -->
                <TextBlock x:Name="GitBranchEmptyState"
                           Grid.Row="2"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="20"
                           IsVisible="{Binding Branches.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                <!-- Footer with action buttons -->
                <Border Grid.Row="3" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="🗑 Delete"
                                    Classes="TerminalSwitchButton"
                                    Command="{Binding DeleteBranchCommand}"
                                    ToolTip.Tip="Delete selected branch"
                                    Margin="0,0,4,0"/>
                            <Button Content="✓ Switch"
                                    Classes="TerminalSwitchButton"
                                    Command="{Binding CheckoutBranchCommand}"
                                    ToolTip.Tip="Switch to selected branch"/>
                        </StackPanel>
                        <Button Content="+ New Branch"
                                Classes="TerminalSwitchButton"
                                Command="{Binding CreateBranchCommand}"
                                ToolTip.Tip="Create new branch from current HEAD"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</UserControl>
