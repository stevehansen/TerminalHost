<UserControl x:Class="TerminalHost.Views.Popups.CommitHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             d:DataContext="{d:DesignInstance viewModels:CommitHistoryViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Commit item template -->
        <DataTemplate x:Key="CommitItemTemplate">
            <Grid Margin="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Short hash -->
                <TextBlock Grid.Column="0" Grid.RowSpan="2"
                           Text="{Binding ShortHash}"
                           Foreground="#569CD6"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           ToolTip="{Binding Hash}"/>

                <!-- Subject with decorations -->
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding Subject}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280"/>
                    <TextBlock Text="{Binding Decorations}"
                               Foreground="#4EC9B0"
                               FontSize="{StaticResource FontSizeMicro}"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding Decorations, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Author and date -->
                <TextBlock Grid.Column="1" Grid.Row="1"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeMicro}">
                    <Run Text="{Binding AuthorName, Mode=OneWay}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding RelativeDate, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- File item template -->
        <DataTemplate x:Key="FileItemTemplate">
            <Grid Margin="2,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusIcon}"
                           Foreground="{Binding StatusColor}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeMicro}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding FilePath}"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeMicro}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding StatsDisplay}"
                           Foreground="{StaticResource TextDimmedBrush}"
                           FontFamily="{StaticResource FontFamilyMonospace}"
                           FontSize="{StaticResource FontSizeMicro}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- ListBoxItem style -->
        <Style x:Key="CommitListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <controls:DraggablePopup
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        PopupWidth="{Binding Width, Mode=TwoWay}"
        PopupHeight="{Binding Height, Mode=TwoWay}"
        HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
        VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}"
        Title="{Binding Title}"
        CloseCommand="{Binding CloseCommand}">

        <controls:DraggablePopup.HeaderRightContent>
            <StackPanel Orientation="Horizontal">
                <Button Content="↻ Refresh"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding RefreshCommitsCommand}"
                        ToolTip="Refresh commit history"
                        Margin="0,0,8,0"/>
            </StackPanel>
        </controls:DraggablePopup.HeaderRightContent>

        <controls:DraggablePopup.PopupContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Main content -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350" MinWidth="250"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*" MinWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel: Commit List -->
                    <Border Grid.Column="0" Background="{StaticResource BackgroundDarkBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Loading overlay -->
                            <Border Grid.RowSpan="4"
                                    Background="#80000000"
                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Panel.ZIndex="100">
                                <TextBlock Text="Loading..."
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                                <TextBlock Text="{Binding Commits.Count, StringFormat='{}{0} commits'}"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"/>
                            </Border>

                            <!-- Filter bar -->
                            <Border Grid.Row="1" Background="{StaticResource BackgroundDarkBrush}" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding AuthorFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Background="{StaticResource BackgroundDarkestBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="#444"
                                             Padding="6,4"
                                             FontSize="{StaticResource FontSizeMicro}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Tag" Value="Filter by author..."/>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button Grid.Column="1"
                                            Content="Filter"
                                            Style="{StaticResource TerminalSwitchButton}"
                                            Command="{Binding ApplyAuthorFilterCommand}"
                                            Margin="4,0,0,0"
                                            Padding="8,4"
                                            FontSize="{StaticResource FontSizeMicro}"/>
                                </Grid>
                            </Border>

                            <!-- Commit list -->
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding Commits}"
                                     SelectedItem="{Binding SelectedCommit}"
                                     ItemTemplate="{StaticResource CommitItemTemplate}"
                                     ItemContainerStyle="{StaticResource CommitListBoxItemStyle}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            <!-- Load more button -->
                            <Border Grid.Row="3" Background="{StaticResource BackgroundMediumBrush}" Padding="8,4"
                                    Visibility="{Binding HasCommits, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="Load More..."
                                        Style="{StaticResource TerminalSwitchButton}"
                                        Command="{Binding LoadMoreCommitsCommand}"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,4"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

                    <!-- Right Panel: Commit Details + Diff -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MaxHeight="300"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Commit Details -->
                        <Border Grid.Row="0" Background="{StaticResource BackgroundDarkBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Details header -->
                                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Content="Copy Hash"
                                                Style="{StaticResource TerminalSwitchButton}"
                                                Command="{Binding CopyHashCommand}"
                                                FontSize="{StaticResource FontSizeMicro}"/>
                                        <TextBlock Text="Commit Details"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <!-- Details content -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                                    <Grid Visibility="{Binding HasSelectedCommit, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Hash -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Commit: "
                                                       Foreground="{StaticResource TextDimmedBrush}"
                                                       FontSize="{StaticResource FontSizeMicro}"/>
                                            <TextBlock Text="{Binding SelectedCommit.Hash}"
                                                       Foreground="#569CD6"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontSize="{StaticResource FontSizeMicro}"/>
                                        </StackPanel>

                                        <!-- Author -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Author: "
                                                       Foreground="{StaticResource TextDimmedBrush}"
                                                       FontSize="{StaticResource FontSizeMicro}"/>
                                            <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="{StaticResource FontSizeMicro}">
                                                <Run Text="{Binding CommitDetails.AuthorName, Mode=OneWay}"/>
                                                <Run Text=" &lt;"/>
                                                <Run Text="{Binding CommitDetails.AuthorEmail, Mode=OneWay}"/>
                                                <Run Text="&gt;"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Date -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Date: "
                                                       Foreground="{StaticResource TextDimmedBrush}"
                                                       FontSize="{StaticResource FontSizeMicro}"/>
                                            <TextBlock Text="{Binding SelectedCommit.CommitDate, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="{StaticResource FontSizeMicro}"/>
                                            <TextBlock Text="{Binding SelectedCommit.RelativeDate, StringFormat=' ({0})'}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="{StaticResource FontSizeMicro}"/>
                                        </StackPanel>

                                        <!-- Message -->
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding SelectedCommit.Subject}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>

                                        <!-- Files changed -->
                                        <Border Grid.Row="4" Margin="0,4,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Margin="0,0,0,4"
                                                           Foreground="{StaticResource TextDimmedBrush}"
                                                           FontSize="{StaticResource FontSizeMicro}">
                                                    <Run Text="Files changed: "/>
                                                    <Run Text="{Binding CommitDetails.Files.Count, Mode=OneWay}"/>
                                                    <Run Text=" (+"/>
                                                    <Run Text="{Binding CommitDetails.TotalInsertions, Mode=OneWay}" Foreground="#4EC9B0"/>
                                                    <Run Text=" -"/>
                                                    <Run Text="{Binding CommitDetails.TotalDeletions, Mode=OneWay}" Foreground="#F14C4C"/>
                                                    <Run Text=")"/>
                                                </TextBlock>

                                                <ListBox Grid.Row="1"
                                                         ItemsSource="{Binding CommitDetails.Files}"
                                                         SelectedItem="{Binding SelectedFile}"
                                                         ItemTemplate="{StaticResource FileItemTemplate}"
                                                         ItemContainerStyle="{StaticResource CommitListBoxItemStyle}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         MaxHeight="120"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Splitter -->
                        <GridSplitter Grid.Row="1" Height="4" Background="{StaticResource BackgroundMediumBrush}" HorizontalAlignment="Stretch"/>

                        <!-- Diff viewer -->
                        <Border Grid.Row="2" Background="{StaticResource BackgroundDarkestBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Diff header -->
                                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6">
                                    <TextBlock Text="{Binding SelectedFile.FilePath, StringFormat='Diff: {0}', FallbackValue='Select a file to view diff'}"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <!-- Diff content -->
                                <controls:DiffViewer Grid.Row="1" DiffText="{Binding DiffText}" />

                                <!-- Loading overlay for details -->
                                <Border Grid.RowSpan="2"
                                        Background="#80000000"
                                        Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Loading..."
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundMediumBrush}" Padding="12,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"
                                   Text="Press Escape to close"/>
                        <TextBlock Text="{Binding Info}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </controls:DraggablePopup.PopupContent>
    </controls:DraggablePopup>
</UserControl>
