<UserControl x:Class="TerminalHost.Views.Popups.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="450" d:DesignWidth="500">
    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0"
            Width="500"
            MaxHeight="450">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,10" CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text=">"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBox x:Name="PaletteSearchBox"
                             Grid.Column="1"
                             AutomationProperties.Name="Command Search"
                             AutomationProperties.HelpText="Type to filter commands"
                             ToolTip="Search commands"
                             Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0"
                             FontSize="14"
                             VerticalAlignment="Center"
                             Text="{Binding PaletteSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="PaletteSearchBox_PreviewKeyDown"/>
                </Grid>
            </Border>

            <!-- Command List -->
            <ListBox x:Name="PaletteCommandList"
                     Grid.Row="1"
                     ItemsSource="{Binding FilteredPaletteCommands}"
                     SelectedItem="{Binding SelectedPaletteCommand, Mode=TwoWay}"
                     Background="{StaticResource BackgroundDarkBrush}"
                     BorderThickness="0"
                     MaxHeight="380"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="PaletteCommandList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Visibility="{Binding Description, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource BackgroundLightBrush}"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Visibility="{Binding Shortcut, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding DisplayShortcut}"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="11"
                                           FontFamily="Cascadia Code NF, Consolas"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
