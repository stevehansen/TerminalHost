<UserControl x:Class="TerminalHost.Views.Popups.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="450" d:DesignWidth="500"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0"
            Width="500"
            MaxHeight="450">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Box -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,10" CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text=">"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Grid Grid.Column="1">
                        <!-- Placeholder text -->
                        <TextBlock Text="Type to search commands..."
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeNormal}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding PaletteSearchText, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}"/>
                        <TextBox x:Name="PaletteSearchBox"
                                 AutomationProperties.Name="Command Search"
                                 AutomationProperties.HelpText="Type to filter commands"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0"
                                 FontSize="{StaticResource FontSizeNormal}"
                                 VerticalAlignment="Center"
                                 Text="{Binding PaletteSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Button Grid.Column="2"
                            Content="×"
                            Click="CloseButton_Click"
                            Style="{StaticResource TabCloseButton}"
                            Padding="8,2"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Command List -->
            <ListBox x:Name="PaletteCommandList"
                     Grid.Row="1"
                     ItemsSource="{Binding FilteredPaletteCommands}"
                     SelectedItem="{Binding SelectedPaletteCommand, Mode=TwoWay}"
                     Background="{StaticResource BackgroundDarkBrush}"
                     BorderThickness="0"
                     MaxHeight="380"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="PaletteCommandList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/><!-- Fixed width for icon alignment -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icon column with fixed width -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Icon}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <!-- Name and description -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource FontSizeCode}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="250"
                                           Visibility="{Binding Description, Converter={StaticResource NullToCollapsedConverter}}"/>
                            </StackPanel>
                            <!-- Shortcut badge -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource BackgroundLightBrush}"
                                    CornerRadius="3"
                                    Padding="6,2"
                                    Visibility="{Binding Shortcut, Converter={StaticResource NullToCollapsedConverter}}">
                                <TextBlock Text="{Binding DisplayShortcut}"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="{StaticResource FontSizeTiny}"
                                           FontFamily="{StaticResource FontFamilyMonospace}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="4,0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
