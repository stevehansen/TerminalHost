<UserControl x:Class="TerminalHost.Views.Popups.TaskPanelView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Domain"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TaskPanelViewModel}"
             d:DesignHeight="600" d:DesignWidth="550">
    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Width="550"
            MaxHeight="600">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" OffsetY="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,10" CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="📋"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock Grid.Column="1"
                               Text="Tasks"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeLarge}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- Focus Mode Toggle -->
                    <Button Grid.Column="2"
                            Command="{Binding ToggleFocusModeCommand}"
                            ToolTip.Tip="{Binding FocusModeTooltip}"
                            IsEnabled="{Binding CanToggleFocusMode}"
                            Margin="0,0,8,0"
                            Classes="TerminalSwitchButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FocusModeIcon}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding FocusModeButtonText}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Content="×"
                            Click="CloseButton_Click"
                            Classes="TabCloseButton"
                            Padding="8,2"/>
                </Grid>
            </Border>

            <!-- Current Task Section -->
            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundLightBrush}"
                    Padding="12,10"
                    IsVisible="{Binding HasCurrentTask}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Current Task Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="● CURRENT"
                                   Foreground="{StaticResource SyntaxYellowBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentTaskElapsed}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Task Title -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding CurrentTaskTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,6,0,4"/>

                    <!-- Projects -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding CurrentTaskProjects}"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Margin="0,0,0,4"/>

                    <!-- PR Link (if any) -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding CurrentTaskPrDisplay}"
                               Foreground="{StaticResource AccentBlueBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               IsVisible="{Binding CurrentTaskHasPrLink}"
                               Margin="0,0,0,8"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="✓ Complete"
                                Command="{Binding CompleteCurrentTaskCommand}"
                                Classes="SmallButton"
                                Margin="0,0,8,0"/>
                        <Button Content="⏸ Pause"
                                Command="{Binding PauseCurrentTaskCommand}"
                                Classes="SmallButton"
                                Margin="0,0,8,0"/>
                        <Button Content="+ Subtask"
                                Command="{Binding AddSubtaskCommand}"
                                Classes="SmallButton"
                                Margin="0,0,8,0"/>
                        <Button Content="🔄 PR"
                                ToolTip.Tip="Refresh PR/Branch info"
                                Command="{Binding RefreshPrInfoCommand}"
                                Classes="SmallButton"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content (Scrollable) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,8">

                    <!-- Add Task Section -->
                    <Border Background="{StaticResource BackgroundDarkestBrush}"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,12"
                            IsVisible="{Binding IsAddingTask}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="NewTaskTextBox"
                                     Grid.Row="0"
                                     Text="{Binding NewTaskTitle, Mode=TwoWay}"
                                     Background="{StaticResource BackgroundLightBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Padding="8,6"
                                     FontSize="{StaticResource FontSizeNormal}"/>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Cancel"
                                        Command="{Binding CancelAddTaskCommand}"
                                        Classes="SmallButton"
                                        Margin="0,0,8,0"/>
                                <Button Content="Add"
                                        Command="{Binding CreateTaskCommand}"
                                        Classes="SmallButton"
                                        Margin="0,0,8,0"/>
                                <Button Content="Add &amp; Start"
                                        Command="{Binding CreateAndStartTaskCommand}"
                                        Classes="SmallButton"
                                        Background="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Backlog Section -->
                    <TextBlock Text="○ BACKLOG"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding BacklogTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="domain:FocusTask">
                                <Border Background="{StaticResource BackgroundDarkestBrush}"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,4"
                                        Cursor="Hand"
                                        PointerPressed="TaskItem_PointerPressed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding StatusIcon}"
                                                   Foreground="{Binding StatusColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="{StaticResource FontSizeCode}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ProjectPaths.Count, StringFormat='{}{0} project(s)'}"
                                                       Foreground="{StaticResource TextDimmedBrush}"
                                                       FontSize="{StaticResource FontSizeTiny}"
                                                       IsVisible="{Binding ProjectPaths.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Border Background="{StaticResource BackgroundLightBrush}"
                                                    CornerRadius="3"
                                                    Padding="4,2"
                                                    Margin="4,0"
                                                    IsVisible="{Binding Priority, Converter={StaticResource CountToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Priority, StringFormat='P:{0}'}"
                                                           Foreground="{StaticResource TextDimmedBrush}"
                                                           FontSize="{StaticResource FontSizeTiny}"/>
                                            </Border>
                                            <Button Content="▶"
                                                    ToolTip.Tip="Start Task"
                                                    Command="{Binding $parent[UserControl].((vm:TaskPanelViewModel)DataContext).StartTaskCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="IconButton"
                                                    Padding="6,2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty Backlog Message -->
                    <TextBlock Text="No tasks in backlog. Click + to add one."
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontStyle="Italic"
                               Margin="0,4,0,12"
                               IsVisible="{Binding BacklogTasks.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

                    <!-- Edit Task Panel -->
                    <Border Background="{StaticResource BackgroundLightBrush}"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,8,0,12"
                            IsVisible="{Binding HasSelectedTask}">
                        <StackPanel>
                            <TextBlock Text="✏️ EDIT TASK"
                                       Foreground="{StaticResource SyntaxYellowBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>

                            <!-- Title -->
                            <TextBlock Text="Title"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditTitle, Mode=TwoWay}"
                                     Background="{StaticResource BackgroundDarkestBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Padding="8,6"
                                     FontSize="{StaticResource FontSizeNormal}"
                                     Margin="0,0,0,10"/>

                            <!-- Description -->
                            <TextBlock Text="Description (optional)"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditDescription, Mode=TwoWay}"
                                     Background="{StaticResource BackgroundDarkestBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Padding="8,6"
                                     FontSize="{StaticResource FontSizeSmall}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="50"
                                     Margin="0,0,0,10"/>

                            <!-- Priority and Issue/PR in a row -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Priority -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Priority"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditPriority, Mode=TwoWay}"
                                             Background="{StaticResource BackgroundDarkestBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Padding="8,6"
                                             Width="60"
                                             HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Issue/PR -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Issue/PR # or branch"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               FontSize="{StaticResource FontSizeTiny}"
                                               Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditLinkedIssue, Mode=TwoWay}"
                                             Background="{StaticResource BackgroundDarkestBrush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             Padding="8,6"
                                             ToolTip.Tip="Enter #123 for issue/PR, or branch name"/>
                                </StackPanel>
                            </Grid>

                            <!-- Projects -->
                            <TextBlock Text="Linked Projects"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       Margin="0,0,0,4"/>
                            <Border Background="{StaticResource BackgroundDarkestBrush}"
                                    CornerRadius="3"
                                    Padding="6"
                                    Margin="0,0,0,6"
                                    MinHeight="30">
                                <ItemsControl ItemsSource="{Binding SelectedTaskProjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BackgroundLightBrush}"
                                                    CornerRadius="3"
                                                    Padding="6,3"
                                                    Margin="0,0,4,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Converter={StaticResource PathToFolderNameConverter}}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeTiny}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="×"
                                                            Command="{Binding $parent[UserControl].((vm:TaskPanelViewModel)DataContext).RemoveProjectFromSelectedTaskCommand}"
                                                            CommandParameter="{Binding}"
                                                            Classes="TabCloseButton"
                                                            Padding="4,0"
                                                            Margin="4,0,0,0"
                                                            FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Button Content="+ Add Current Project"
                                    Command="{Binding AddProjectToSelectedTaskCommand}"
                                    Classes="SmallButton"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"/>

                            <!-- Notes -->
                            <TextBlock Text="Notes (scratch pad for this task)"
                                       Foreground="{StaticResource TextDimmedBrush}"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditNotes, Mode=TwoWay}"
                                     Background="{StaticResource BackgroundDarkestBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"
                                     Padding="8,6"
                                     FontSize="{StaticResource FontSizeSmall}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="60"
                                     Margin="0,0,0,12"/>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Command="{Binding CancelEditCommand}"
                                        Classes="SmallButton"
                                        Margin="0,0,8,0"/>
                                <Button Content="Save"
                                        Command="{Binding SaveEditedTaskCommand}"
                                        Classes="SmallButton"
                                        Background="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quick Notes Section -->
                    <TextBlock Text="📝 QUICK NOTES"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontWeight="Bold"
                               Margin="0,12,0,8"
                               IsVisible="{Binding QuickNotes.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding QuickNotes}"
                                  IsVisible="{Binding QuickNotes.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundDarkestBrush}"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Preview}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="→ Task"
                                                    ToolTip.Tip="Convert to Task"
                                                    Command="{Binding $parent[UserControl].((vm:TaskPanelViewModel)DataContext).ConvertNoteToTaskCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="SmallButton"
                                                    Padding="6,2"
                                                    Margin="4,0"/>
                                            <Button Content="×"
                                                    ToolTip.Tip="Delete Note"
                                                    Command="{Binding $parent[UserControl].((vm:TaskPanelViewModel)DataContext).DeleteNoteCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="TabCloseButton"
                                                    Padding="4,2"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Completed Today Section -->
                    <TextBlock Text="✓ COMPLETED TODAY"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontWeight="Bold"
                               Margin="0,12,0,8"
                               IsVisible="{Binding CompletedTodayTasks.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                    <ItemsControl ItemsSource="{Binding CompletedTodayTasks}"
                                  IsVisible="{Binding CompletedTodayTasks.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundDarkestBrush}"
                                        CornerRadius="4"
                                        Padding="10"
                                        Margin="0,0,0,4"
                                        Opacity="0.7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="✅"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="{StaticResource FontSizeCode}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextDecorations="Strikethrough"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ElapsedTimeDisplay}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   FontSize="{StaticResource FontSizeTiny}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="3" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8" CornerRadius="0,0,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="+ New Task"
                                Command="{Binding ShowAddTaskCommand}"
                                Classes="SmallButton"
                                Margin="0,0,8,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="Ctrl+T to toggle • Esc to close"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
