<UserControl x:Class="TerminalHost.Views.Popups.GitBranchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TerminalHost"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:GitBranchViewModel}"
             mc:Ignorable="d">
    
    <Popup x:Name="GitBranchPopup"
           Placement="Center"
           PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
           StaysOpen="True"
           AllowsTransparency="True"
           IsOpen="{Binding IsOpen, Mode=TwoWay}">
        <Border Background="{StaticResource BackgroundDarkBrush}"
                BorderBrush="{StaticResource SyntaxCyanBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0"
                MinWidth="400"
                MaxWidth="550"
                MaxHeight="500"
                Width="{Binding Width, Mode=TwoWay}"
                Height="{Binding Height, Mode=TwoWay}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="12,8" CornerRadius="6,6,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Style="{StaticResource TabCloseButton}"
                                Command="{Binding CloseCommand}"
                                FontSize="16"
                                Padding="8,2"/>
                        <Button DockPanel.Dock="Right"
                                Content="⟳ Pull"
                                Style="{StaticResource TerminalSwitchButton}"
                                Command="{Binding PullCommand}"
                                ToolTip="Pull current branch"
                                Margin="0,0,8,0"/>
                        <Button DockPanel.Dock="Right"
                                Content="↓ Fetch"
                                Style="{StaticResource TerminalSwitchButton}"
                                Command="{Binding FetchAllCommand}"
                                ToolTip="Fetch all remotes"
                                Margin="0,0,4,0"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌿" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Search Box -->
                <Border Grid.Row="1" Background="{StaticResource BackgroundDarkestBrush}" Padding="12,8">
                    <TextBox x:Name="GitBranchSearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource BackgroundMediumBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="13"
                             PreviewKeyDown="GitBranchSearchBox_PreviewKeyDown"/>
                </Border>

                <!-- Branch List -->
                <ListBox x:Name="GitBranchList"
                         Grid.Row="2"
                         ItemsSource="{Binding Branches}"
                         SelectedItem="{Binding SelectedBranch}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="350"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="GitBranchList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Current branch indicator -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           Foreground="{Binding StatusColor}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                                <!-- Branch name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Foreground="{Binding StatusColor}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Issue number (for branches like issues/#123) -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding IssueNumber}"
                                           Foreground="{StaticResource SyntaxBlueBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding IssueNumber, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Ahead/Behind status -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding StatusDisplay}"
                                           Foreground="{StaticResource TextDimmedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Visibility="{Binding StatusDisplay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource SyntaxBlueBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="8,8,8,4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BackgroundHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Empty state -->
                <TextBlock x:Name="GitBranchEmptyState"
                           Grid.Row="2"
                           Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="20"
                           Visibility="{Binding Branches.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverse}"/>

                <!-- Footer with action buttons -->
                <Border Grid.Row="3" Background="{StaticResource BackgroundMediumBrush}" Padding="8,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="🗑 Delete"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding DeleteBranchCommand}"
                                    ToolTip="Delete selected branch"
                                    Margin="0,0,4,0"/>
                            <Button Content="✓ Switch"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding CheckoutBranchCommand}"
                                    ToolTip="Switch to selected branch"/>
                        </StackPanel>
                        <Button Content="+ New Branch"
                                Style="{StaticResource TerminalSwitchButton}"
                                Command="{Binding CreateBranchCommand}"
                                ToolTip="Create new branch from current HEAD"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Popup>
</UserControl>