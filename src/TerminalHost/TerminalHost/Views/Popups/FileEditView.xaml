<UserControl x:Class="TerminalHost.Views.Popups.FileEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:local="clr-namespace:TerminalHost"
             d:DataContext="{d:DesignInstance viewModels:FileEditViewModel}"
             mc:Ignorable="d">
    <Popup x:Name="FileEditPop"
           Placement="Absolute"
           StaysOpen="True"
           AllowsTransparency="True"
           IsOpen="{Binding IsOpen, Mode=TwoWay}"
           HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
           VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}">
        <Border x:Name="FileEditBorder" Background="#1E1E1E"
                BorderBrush="#0078D4"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="500"
                MinHeight="400"
                Width="{Binding Width, Mode=TwoWay}"
                Height="{Binding Height, Mode=TwoWay}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (draggable) -->
                <Border x:Name="FileEditHeader" Grid.Row="0" Background="#2D2D2D" Padding="12,8" CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="FileEditHeader_MouseLeftButtonDown"
                        MouseMove="FileEditHeader_MouseMove"
                        MouseLeftButtonUp="FileEditHeader_MouseLeftButtonUp"
                        Cursor="SizeAll">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Style="{StaticResource TabCloseButton}"
                                Command="{Binding CloseCommand}"
                                FontSize="16"
                                Padding="8,2"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,12,0">
                            <Button x:Name="FileEditSaveButton"
                                    Content="💾 Save"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding SaveCommand}"
                                    IsEnabled="{Binding CanSave}"
                                    ToolTip="Save changes (Ctrl+S)"
                                    Margin="0,0,8,0"/>
                            <Button Content="↻ Reload"
                                    Style="{StaticResource TerminalSwitchButton}"
                                    Command="{Binding ReloadCommand}"
                                    ToolTip="Reload from disk"
                                    Margin="0,0,8,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📝"
                                       Foreground="#0078D4"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="FileEditTitle"
                                       Text="{Binding Title}"
                                       Foreground="#CCCCCC"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="FileEditModifiedIndicator"
                                       Text="*"
                                       Foreground="#E0E0E0"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding IsFileModified, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Line Numbers -->
                    <ScrollViewer x:Name="LineNumberScroller"
                                  Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="#252525"
                                  Padding="4,4,8,4">
                        <TextBlock x:Name="FileEditLineNumbers"
                                   Text="{Binding LineNumbers}"
                                   FontFamily="Cascadia Code NF, Consolas, Courier New"
                                   FontSize="13"
                                   Foreground="#606060"
                                   TextAlignment="Right"/>
                    </ScrollViewer>

                    <!-- Text Editor -->
                    <TextBox x:Name="FileEditTextBox"
                             Grid.Column="1"
                             Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1E1E1E"
                             Foreground="#D4D4D4"
                             CaretBrush="#D4D4D4"
                             BorderThickness="0"
                             FontFamily="Cascadia Code NF, Consolas, Courier New"
                             FontSize="13"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Padding="4"
                             ScrollViewer.ScrollChanged="FileEditTextBox_ScrollChanged"
                             PreviewKeyDown="FileEditTextBox_PreviewKeyDown"
                             SelectionChanged="FileEditTextBox_SelectionChanged"/>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#2D2D2D" Padding="12,6" CornerRadius="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="#808080"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"
                                   Text="Ctrl+S to save, Escape to close"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FileEditInfo"
                                       Text="{Binding Info}"
                                       Foreground="#808080"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="FileEditCursorInfo"
                                       Text="{Binding CursorInfo}"
                                       Foreground="#808080"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Resize grip -->
                <Thumb x:Name="FileEditResizeGrip" Grid.Row="2"
                       Width="16" Height="16"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,2,2"
                       Cursor="SizeNWSE"
                       DragDelta="FileEditResizeGrip_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Grid Background="Transparent">
                                <Path Data="M 0,16 L 16,0 M 5,16 L 16,5 M 10,16 L 16,10"
                                      Stroke="#888888" StrokeThickness="1.5"/>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Popup>
</UserControl>