<UserControl x:Class="TerminalHost.Views.Popups.ClaudeTasksPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             xmlns:domain="clr-namespace:TerminalHost.Core.Domain;assembly=TerminalHost.Core"
             d:DataContext="{d:DesignInstance viewModels:ClaudeTasksPanelViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Task item style -->
        <Style x:Key="TaskListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#334155">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="#334155"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Task action button style -->
        <Style x:Key="TaskActionButton" TargetType="Button" BasedOn="{StaticResource TerminalSwitchButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Active task item template -->
        <DataTemplate x:Key="ActiveTaskItemTemplate" DataType="{x:Type domain:FocusTask}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="#E2E8F0"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ActiveForm}"
                               Foreground="#60A5FA"
                               FontSize="{StaticResource FontSizeTiny}"
                               FontStyle="Italic"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ActiveForm, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Foreground="#94A3B8" FontSize="{StaticResource FontSizeMicro}">
                        <Run Text="Started "/>
                        <Run Text="{Binding StartedAt, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TaskActionButton}"
                            Content="&#x2713;"
                            ToolTip="Complete"
                            Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Style="{StaticResource TaskActionButton}"
                            Content="&#x1F5D1;"
                            ToolTip="Delete"
                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Completed task item template -->
        <DataTemplate x:Key="CompletedTaskItemTemplate" DataType="{x:Type domain:FocusTask}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Opacity="0.7">
                    <TextBlock Text="{Binding Title}"
                               Foreground="#E2E8F0"
                               FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="#94A3B8" FontSize="{StaticResource FontSizeMicro}" Opacity="0.6">
                        <Run Text="&#x2713; Completed "/>
                        <Run Text="{Binding CompletedAt, StringFormat='{}{0:HH:mm:ss}', Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Notes}"
                               Foreground="#10B981"
                               FontSize="{StaticResource FontSizeMicro}"
                               Visibility="{Binding Notes, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource TaskActionButton}"
                        Content="&#x1F5D1;"
                        ToolTip="Delete"
                        VerticalAlignment="Center"
                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <controls:DraggablePopup
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        PopupWidth="{Binding Width, Mode=TwoWay}"
        PopupHeight="{Binding Height, Mode=TwoWay}"
        HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
        VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}"
        Title="{Binding PanelTitle}"
        CloseCommand="{Binding CloseCommand}">

        <controls:DraggablePopup.HeaderRightContent>
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding FilterModeText}"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding ToggleFilterModeCommand}"
                        ToolTip="Toggle between current workspace and all workspaces"
                        Margin="0,0,4,0"/>
                <Button Content="+ Create"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding CreateManualTaskCommand}"
                        ToolTip="Create manual task"
                        Margin="0,0,4,0"/>
                <Button Content="&#x21BB; Refresh"
                        Style="{StaticResource TerminalSwitchButton}"
                        Command="{Binding RefreshTasksCommand}"
                        ToolTip="Refresh task list"
                        Margin="0,0,8,0"/>
            </StackPanel>
        </controls:DraggablePopup.HeaderRightContent>

        <controls:DraggablePopup.PopupContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Current Task Section (Hero Card) -->
                <Border Grid.Row="0"
                        Background="#1E3A8A"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        Margin="12,12,12,8"
                        Visibility="{Binding HasCurrentTask, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="&#x1F916;"
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTask.Title}"
                                           Foreground="#E2E8F0"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentTaskProgress}"
                                           Foreground="#60A5FA"
                                           FontSize="13"
                                           FontStyle="Italic"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding CurrentTask.ActiveForm, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding CurrentTaskElapsed}"
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Progress indicator -->
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Foreground="#3B82F6"
                                     Background="#1E293B"
                                     BorderThickness="0"
                                     Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Main Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0,12,12">

                        <!-- Empty State -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,40,0,0">
                            <TextBlock Text="&#x1F916;"
                                       FontSize="32"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="No Claude tasks detected"
                                       FontSize="16"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0"/>
                            <TextBlock Text="Tasks will appear here when Claude Code is working"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="300"
                                       TextAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <Button Content="Create Manual Task"
                                    Command="{Binding CreateManualTaskCommand}"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0"
                                    Padding="12,6"
                                    Background="{StaticResource AccentBlueBrush}"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </StackPanel>

                        <!-- Manual Task Creation Form -->
                        <Border Background="#0A0E1A"
                                BorderBrush="#2563EB"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,12"
                                Visibility="{Binding IsCreateFormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Create Manual Task"
                                           Foreground="#CBD5E1"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Margin="0,0,0,8"/>
                                <TextBox Text="{Binding ManualTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource BackgroundDarkestBrush}"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         BorderBrush="#444"
                                         Padding="8"
                                         FontSize="{StaticResource FontSizeSmall}"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,8,0,0">
                                    <Button Content="Create"
                                            Command="{Binding SubmitManualTaskCommand}"
                                            Padding="12,6"
                                            Margin="0,0,8,0"
                                            Background="{StaticResource AccentBlueBrush}"
                                            Foreground="White"
                                            BorderThickness="0"/>
                                    <Button Content="Cancel"
                                            Command="{Binding CancelManualTaskCommand}"
                                            Padding="12,6"
                                            Background="#475569"
                                            Foreground="White"
                                            BorderThickness="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Active Tasks Section -->
                        <StackPanel Visibility="{Binding ActiveTasks.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="ACTIVE TASKS"
                                       Foreground="#CBD5E1"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,8,0,4"/>
                            <Border Background="#0A0E1A"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ListBox ItemsSource="{Binding ActiveTasks}"
                                         SelectedItem="{Binding SelectedTask}"
                                         ItemTemplate="{StaticResource ActiveTaskItemTemplate}"
                                         ItemContainerStyle="{StaticResource TaskListBoxItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </Border>
                        </StackPanel>

                        <!-- Completed Tasks Section -->
                        <StackPanel Visibility="{Binding CompletedTasks.Count, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,16,0,0">
                            <TextBlock Text="COMPLETED TODAY"
                                       Foreground="#CBD5E1"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,8,0,4"/>
                            <Border Background="#0A0E1A"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ListBox ItemsSource="{Binding CompletedTasks}"
                                         SelectedItem="{Binding SelectedTask}"
                                         ItemTemplate="{StaticResource CompletedTaskItemTemplate}"
                                         ItemContainerStyle="{StaticResource TaskListBoxItemStyle}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2"
                        Background="{StaticResource BackgroundMediumBrush}"
                        Padding="12,6"
                        CornerRadius="0,0,6,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Text="Press Escape to close"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </controls:DraggablePopup.PopupContent>
    </controls:DraggablePopup>
</UserControl>
