<UserControl x:Class="TerminalHost.Views.Popups.FileViewerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             d:DataContext="{d:DesignInstance viewModels:FileViewerViewModel}"
             mc:Ignorable="d">

    <controls:DraggablePopup
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        PopupWidth="{Binding Width, Mode=TwoWay}"
        PopupHeight="{Binding Height, Mode=TwoWay}"
        HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
        VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}"
        CloseCommand="{Binding CloseCommand}">

        <controls:DraggablePopup.HeaderRightContent>
             <Button Content="⧉"
                     Style="{StaticResource TabCloseButton}"
                     Command="{Binding DetachCommand}"
                     ToolTip="Pop out to window"
                     FontSize="{StaticResource FontSizeNormal}"
                     Padding="8,4"
                     Margin="0,0,4,0"/>
        </controls:DraggablePopup.HeaderRightContent>

        <controls:DraggablePopup.HeaderLeftContent>
            <StackPanel Orientation="Horizontal">
                <!-- Mode tabs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="👁 Preview"
                                 Style="{StaticResource PopupModeTabButton}"
                                 IsChecked="{Binding IsPreviewModeSelected, Mode=OneWay}"
                                 Command="{Binding SwitchToPreviewCommand}"
                                 Margin="0,0,4,0"/>
                    <RadioButton Content="✏ Edit"
                                 Style="{StaticResource PopupModeTabButton}"
                                 IsChecked="{Binding IsEditModeSelected, Mode=OneWay}"
                                 Command="{Binding SwitchToEditCommand}"
                                 Margin="0,0,4,0"/>
                    <RadioButton Content="⫏ Side by Side"
                                 Style="{StaticResource PopupModeTabButton}"
                                 IsChecked="{Binding IsSideBySideModeSelected, Mode=OneWay}"
                                 Command="{Binding SwitchToSideBySideCommand}"
                                 Visibility="{Binding ShowSideBySideTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding FileName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeCode}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="400"/>
                    <TextBlock Text="*"
                               Foreground="{StaticResource TextLightBrush}"
                               FontSize="{StaticResource FontSizeCode}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </controls:DraggablePopup.HeaderLeftContent>

        <controls:DraggablePopup.PopupContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview mode: FlowDocumentScrollViewer (for non-markdown text files) -->
                <FlowDocumentScrollViewer
                    Grid.Row="0"
                    Document="{Binding PreviewDocument}"
                    Visibility="{Binding IsPreviewMode, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{StaticResource BackgroundDarkestBrush}"
                    Foreground="#CCCCCC"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    IsToolBarVisible="False"
                    IsSelectionEnabled="True"
                    Zoom="100"/>

                <!-- Markdown preview mode: WebView2-based rich rendering (only in Preview mode, not SideBySide) -->
                <controls:MarkdownViewer
                    Grid.Row="0"
                    HtmlContent="{Binding RenderedHtml}"
                    Visibility="{Binding IsMarkdownPreviewMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Edit mode: TextBox with line numbers -->
                <Grid Grid.Row="0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Line numbers -->
                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Hidden"
                                  Background="{StaticResource BackgroundDarkBrush}">
                        <TextBlock Text="{Binding LineNumbers}"
                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                   FontSize="{StaticResource FontSizeCode}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Background="{StaticResource BackgroundDarkBrush}"
                                   Padding="8,4,8,4"
                                   TextAlignment="Right"
                                   MinWidth="40"/>
                    </ScrollViewer>

                    <!-- Editor -->
                    <TextBox Grid.Column="1"
                             Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource FontFamilyMonospace}"
                             FontSize="{StaticResource FontSizeCode}"
                             Foreground="#CCCCCC"
                             Background="{StaticResource BackgroundDarkestBrush}"
                             CaretBrush="#AEAFAD"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="{Binding IsReadOnly}"
                             Padding="4"
                             Focusable="True"
                             IsTabStop="True"
                             ScrollViewer.ScrollChanged="EditTextBox_ScrollChanged"
                             SelectionChanged="EditTextBox_SelectionChanged"
                             PreviewKeyDown="EditTextBox_PreviewKeyDown"
                             GotFocus="EditTextBox_GotFocus"/>
                </Grid>

                <!-- Side-by-Side mode: Editor + Preview for markdown files -->
                <Grid Grid.Row="0" Visibility="{Binding IsSideBySideMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Editor with line numbers -->
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Line numbers -->
                        <ScrollViewer Grid.Column="0"
                                      Tag="SideBySideLineNumbers"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"
                                      Background="{StaticResource BackgroundDarkBrush}">
                            <TextBlock Text="{Binding LineNumbers}"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Background="{StaticResource BackgroundDarkBrush}"
                                       Padding="8,4,8,4"
                                       TextAlignment="Right"
                                       MinWidth="40"/>
                        </ScrollViewer>

                        <!-- Editor -->
                        <TextBox Tag="SideBySideEditor"
                                 Grid.Column="1"
                                 Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeCode}"
                                 Foreground="#CCCCCC"
                                 Background="{StaticResource BackgroundDarkestBrush}"
                                 CaretBrush="#AEAFAD"
                                 BorderThickness="0"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Padding="4"
                                 Focusable="True"
                                 IsTabStop="True"
                                 ScrollViewer.ScrollChanged="SideBySideEditTextBox_ScrollChanged"
                                 SelectionChanged="SideBySideEditTextBox_SelectionChanged"
                                 PreviewKeyDown="SideBySideEditTextBox_PreviewKeyDown"
                                 GotFocus="SideBySideEditTextBox_GotFocus"/>
                    </Grid>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  Background="{StaticResource BorderSubtleBrush}"
                                  HorizontalAlignment="Stretch"/>

                    <!-- Right: Markdown Preview -->
                    <controls:MarkdownViewer Grid.Column="2"
                                             HtmlContent="{Binding RenderedHtml}"/>
                </Grid>

                <!-- Image preview mode -->
                <Grid Grid.Row="0"
                      Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="{StaticResource BackgroundDarkestBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <Image Source="{Binding ImageSource}"
                               Stretch="None"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="16"/>
                    </ScrollViewer>
                    <TextBlock Text="{Binding ImageInfo}"
                               Foreground="{StaticResource TextDimmedBrush}"
                               FontSize="{StaticResource FontSizeTiny}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="8"
                               Padding="4,2"
                               Background="#80000000"/>
                </Grid>

                <!-- Status bar -->
                <Border Grid.Row="1" Background="{StaticResource AccentPrimaryBrush}" Padding="8,4,24,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Action buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="💾 Save"
                                    Style="{StaticResource StatusBarButton}"
                                    Command="{Binding SaveCommand}"
                                    ToolTip="Save (Ctrl+S)"
                                    Visibility="{Binding CanSave, Converter={StaticResource BoolToVisibilityConverter}}"
                                    IsEnabled="{Binding CanSave}"
                                    Margin="0,0,8,0"/>
                            <Button Content="↻ Reload"
                                    Style="{StaticResource StatusBarButton}"
                                    Command="{Binding ReloadCommand}"
                                    ToolTip="Reload from disk"/>
                        </StackPanel>

                        <!-- File info -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Info}"
                                   Foreground="White"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="16,0"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Cursor position (edit and side-by-side modes) -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CursorInfo}"
                                   Foreground="White"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSideBySideMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Shortcuts hint (different for edit/side-by-side vs preview mode) -->
                        <TextBlock Grid.Column="3"
                                   Foreground="#CCFFFFFF"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Escape close"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="Ctrl+S save · Escape close"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSideBySideMode}" Value="True">
                                            <Setter Property="Text" Value="Ctrl+S save · Escape close"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </controls:DraggablePopup.PopupContent>
    </controls:DraggablePopup>
</UserControl>