<UserControl x:Class="TerminalHost.Views.Popups.FileViewerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:views="clr-namespace:TerminalHost.Views"
             d:DataContext="{d:DesignInstance viewModels:FileViewerViewModel}"
             mc:Ignorable="d"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Popup x:Name="FileViewerPop"
           Placement="Absolute"
           StaysOpen="True"
           AllowsTransparency="True"
           IsOpen="{Binding IsOpen, Mode=TwoWay}"
           HorizontalOffset="{Binding HorizontalOffset, Mode=TwoWay}"
           VerticalOffset="{Binding VerticalOffset, Mode=TwoWay}">
        <Border x:Name="FileViewerBorder"
                Background="{StaticResource BackgroundDarkestBrush}"
                BorderBrush="{StaticResource AccentPrimaryBrush}"
                BorderThickness="1"
                CornerRadius="6"
                MinWidth="600"
                MinHeight="450"
                Width="{Binding Width, Mode=TwoWay}"
                Height="{Binding Height, Mode=TwoWay}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Draggable header -->
                <Border x:Name="DragHeader"
                        Grid.Row="0"
                        Background="{StaticResource BackgroundMediumBrush}"
                        Padding="12,8"
                        CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="DragHeader_MouseLeftButtonDown"
                        MouseMove="DragHeader_MouseMove"
                        MouseLeftButtonUp="DragHeader_MouseLeftButtonUp"
                        Cursor="SizeAll">
                    <DockPanel>
                        <!-- Close button -->
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Style="{StaticResource TabCloseButton}"
                                Command="{Binding CloseCommand}"
                                FontSize="{StaticResource FontSizeLarge}"
                                Padding="8,2"/>

                        <!-- Pop out button -->
                        <Button DockPanel.Dock="Right"
                                Content="⧉"
                                Style="{StaticResource TabCloseButton}"
                                Command="{Binding DetachCommand}"
                                ToolTip="Pop out to window"
                                FontSize="{StaticResource FontSizeNormal}"
                                Padding="8,4"
                                Margin="0,0,4,0"/>

                        <!-- Mode tabs -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="PreviewTab"
                                         Content="👁 Preview"
                                         Style="{StaticResource PopupModeTabButton}"
                                         IsChecked="{Binding IsPreviewMode, Mode=OneWay}"
                                         Command="{Binding SwitchToPreviewCommand}"
                                         Margin="0,0,4,0"/>
                            <RadioButton x:Name="EditTab"
                                         Content="✏ Edit"
                                         Style="{StaticResource PopupModeTabButton}"
                                         IsChecked="{Binding IsEditMode, Mode=OneWay}"
                                         Command="{Binding SwitchToEditCommand}"/>
                        </StackPanel>

                        <!-- Title -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="{Binding FileName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="400"/>
                            <TextBlock Text="*"
                                       Foreground="{StaticResource TextLightBrush}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Content area with embedded FileViewerView content (not the control itself to avoid nesting issues) -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Preview mode: FlowDocumentScrollViewer -->
                    <FlowDocumentScrollViewer
                        x:Name="PreviewViewer"
                        Grid.Row="0"
                        Document="{Binding PreviewDocument}"
                        Visibility="{Binding IsPreviewMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{StaticResource BackgroundDarkestBrush}"
                        Foreground="#CCCCCC"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        IsToolBarVisible="False"
                        IsSelectionEnabled="True"
                        Zoom="100"/>

                    <!-- Edit mode: TextBox with line numbers -->
                    <Grid Grid.Row="0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Line numbers -->
                        <ScrollViewer x:Name="LineNumbersScroll"
                                      Grid.Column="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"
                                      Background="{StaticResource BackgroundDarkBrush}">
                            <TextBlock x:Name="LineNumbers"
                                       Text="{Binding LineNumbers}"
                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                       FontSize="{StaticResource FontSizeCode}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Background="{StaticResource BackgroundDarkBrush}"
                                       Padding="8,4,8,4"
                                       TextAlignment="Right"
                                       MinWidth="40"/>
                        </ScrollViewer>

                        <!-- Editor -->
                        <TextBox x:Name="EditTextBox"
                                 Grid.Column="1"
                                 Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeCode}"
                                 Foreground="#CCCCCC"
                                 Background="{StaticResource BackgroundDarkestBrush}"
                                 CaretBrush="#AEAFAD"
                                 BorderThickness="0"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Padding="4"
                                 Focusable="True"
                                 IsTabStop="True"
                                 ScrollViewer.ScrollChanged="EditTextBox_ScrollChanged"
                                 SelectionChanged="EditTextBox_SelectionChanged"
                                 PreviewKeyDown="EditTextBox_PreviewKeyDown"
                                 GotFocus="EditTextBox_GotFocus"/>
                    </Grid>

                    <!-- Image preview mode -->
                    <Grid Grid.Row="0"
                          Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibilityConverter}}"
                          Background="{StaticResource BackgroundDarkestBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="Transparent">
                            <Image Source="{Binding ImageSource}"
                                   Stretch="None"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="16"/>
                        </ScrollViewer>
                        <TextBlock Text="{Binding ImageInfo}"
                                   Foreground="{StaticResource TextDimmedBrush}"
                                   FontSize="{StaticResource FontSizeTiny}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="8"
                                   Padding="4,2"
                                   Background="#80000000"/>
                    </Grid>

                    <!-- Status bar -->
                    <Border Grid.Row="1" Background="{StaticResource AccentPrimaryBrush}" Padding="8,4,24,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Action buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="💾 Save"
                                        Style="{StaticResource StatusBarButton}"
                                        Command="{Binding SaveCommand}"
                                        ToolTip="Save (Ctrl+S)"
                                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding CanSave}"
                                        Margin="0,0,8,0"/>
                                <Button Content="↻ Reload"
                                        Style="{StaticResource StatusBarButton}"
                                        Command="{Binding ReloadCommand}"
                                        ToolTip="Reload from disk"/>
                            </StackPanel>

                            <!-- File info -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Info}"
                                       Foreground="White"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       VerticalAlignment="Center"
                                       Margin="16,0"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Cursor position (edit mode) -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CursorInfo}"
                                       Foreground="White"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"
                                       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <!-- Shortcuts hint (different for edit vs preview mode) -->
                            <TextBlock Grid.Column="3"
                                       Foreground="#CCFFFFFF"
                                       FontSize="{StaticResource FontSizeTiny}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Escape close"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Text" Value="Ctrl+S save · Escape close"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Resize grip -->
                    <Thumb x:Name="ResizeGrip"
                           Grid.Row="1"
                           Width="16" Height="16"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,2,2"
                           Cursor="SizeNWSE"
                           DragDelta="ResizeGrip_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate>
                                <Grid Background="Transparent">
                                    <Path Data="M 0,16 L 16,0 M 5,16 L 16,5 M 10,16 L 16,10"
                                          Stroke="{StaticResource ResizeGripBrush}"
                                          StrokeThickness="1.5"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>
    </Popup>
</UserControl>
