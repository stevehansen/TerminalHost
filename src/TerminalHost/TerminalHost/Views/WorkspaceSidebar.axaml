<UserControl x:Class="TerminalHost.Views.WorkspaceSidebar"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:TerminalHost.ViewModels"
             xmlns:domain="clr-namespace:TerminalHost.Domain"
             d:DesignWidth="250" d:DesignHeight="600"
             mc:Ignorable="d"
             x:DataType="viewModels:WorkspaceSidebarViewModel">

    <Design.DataContext>
        <viewModels:WorkspaceSidebarViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <!-- Workspace Item Context Menu -->
        <ContextMenu x:Key="WorkspaceContextMenu">
            <MenuItem Header="Open" Command="{Binding OpenWorkspaceCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="📂" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Remove from Recent" Command="{Binding $parent[UserControl].((viewModels:WorkspaceSidebarViewModel)DataContext).RemoveFromRecentCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="🗑️" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Toggle Playground" Command="{Binding $parent[UserControl].((viewModels:WorkspaceSidebarViewModel)DataContext).TogglePlaygroundCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="🎮" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Worktree Item Context Menu -->
        <ContextMenu x:Key="WorktreeContextMenu">
            <MenuItem Header="Open" Command="{Binding $parent[UserControl].((viewModels:WorkspaceSidebarViewModel)DataContext).OpenWorktreeCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <TextBlock Text="📂" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Create Branch" Command="{Binding $parent[UserControl].((viewModels:WorkspaceSidebarViewModel)DataContext).CreateBranchFromWorktreeCommand}"
                      CommandParameter="{Binding}"
                      IsVisible="{Binding IsDetached}">
                <MenuItem.Icon>
                    <TextBlock Text="🌿" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Remove Worktree" Command="{Binding $parent[UserControl].((viewModels:WorkspaceSidebarViewModel)DataContext).RemoveWorktreeCommand}"
                      CommandParameter="{Binding}"
                      IsVisible="{Binding !IsMain}">
                <MenuItem.Icon>
                    <TextBlock Text="🗑️" FontSize="{StaticResource FontSizeSmall}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Expander header style -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Expander /template/ ToggleButton#PART_toggle">
            <Setter Property="Background" Value="{StaticResource BackgroundMediumBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- ListBox item style -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
        </Style>

        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="{StaticResource BackgroundDarkBrush}">
        <!-- Header with toggle button -->
        <Border Grid.Row="0" Padding="8" Background="{StaticResource BackgroundDarkestBrush}">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Title and toggle button -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0"
                               Text="WORKSPACES"
                               FontFamily="{StaticResource FontFamilyStandard}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{Binding MainViewModel.ToggleLayoutModeCommand}"
                            ToolTip.Tip="Switch to Tabs (Cmd+Shift+L)"
                            Background="Transparent"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Padding="4,2">
                        <TextBlock Text="☰" FontSize="{StaticResource FontSizeSmall}"/>
                    </Button>
                </Grid>
                <!-- Search/Filter Box -->
                <TextBox Grid.Row="1"
                         Text="{Binding FilterText}"
                         Watermark="Filter workspaces..."
                         FontFamily="{StaticResource FontFamilyStandard}"
                         FontSize="{StaticResource FontSizeSmall}"
                         Background="{StaticResource BackgroundMediumBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="1"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="8,6"/>
            </Grid>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0">

                <!-- Open Projects Section -->
                <Expander IsExpanded="{Binding IsOpenProjectsExpanded}" Margin="0,0,0,1">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📁" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="OPEN PROJECTS"
                                       FontFamily="{StaticResource FontFamilyStandard}"
                                       FontSize="{StaticResource FontSizeSmaller}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MainViewModel.Tabs.Count, StringFormat='({0})'}"
                                       FontFamily="{StaticResource FontFamilyStandard}"
                                       FontSize="{StaticResource FontSizeSmaller}"
                                       Foreground="{StaticResource TextDimmedBrush}"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListBox ItemsSource="{Binding MainViewModel.Tabs}"
                             SelectedItem="{Binding MainViewModel.SelectedTab}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ITabViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding TabIcon}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontFamily="{StaticResource FontFamilyStandard}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- Activity indicators -->
                                    <Panel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <!-- Spinning activity indicator (yellow) -->
                                        <TextBlock x:Name="ActivitySpinner" Text="●"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SyntaxYellowBrush}"
                                                   IsVisible="{Binding ShowActivitySpinner}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock#ActivitySpinner[IsVisible=True]">
                                                    <Style.Animations>
                                                        <Animation Duration="0:0:1" IterationCount="INFINITE">
                                                            <KeyFrame Cue="0%">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </KeyFrame>
                                                            <KeyFrame Cue="50%">
                                                                <Setter Property="Opacity" Value="0.3"/>
                                                            </KeyFrame>
                                                            <KeyFrame Cue="100%">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </KeyFrame>
                                                        </Animation>
                                                    </Style.Animations>
                                                </Style>
                                            </TextBlock.Styles>
                                        </TextBlock>
                                        <!-- Completed indicator (green) -->
                                        <TextBlock Text="●"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SyntaxGreenBrush}"
                                                   IsVisible="{Binding ShowCompletedIndicator}"/>
                                    </Panel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

                <!-- Git Worktrees Section -->
                <Expander IsExpanded="{Binding IsWorktreesExpanded}"
                          IsVisible="{Binding HasWorktrees}"
                          Margin="0,0,0,1">
                    <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🌿" FontSize="{StaticResource FontSizeSmall}"/>
                                <TextBlock Text="WORKTREES"
                                           FontFamily="{StaticResource FontFamilyStandard}"
                                           FontSize="{StaticResource FontSizeSmaller}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding CurrentRepositoryName, StringFormat='({0})'}"
                                           FontFamily="{StaticResource FontFamilyStandard}"
                                           FontSize="{StaticResource FontSizeSmaller}"
                                           Foreground="{StaticResource TextDimmedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+"
                                    Command="{Binding ShowCreateWorktreeDialogCommand}"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Padding="4,0"
                                    ToolTip.Tip="Create Worktree"/>
                        </Grid>
                    </Expander.Header>

                    <ListBox ItemsSource="{Binding Worktrees}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:WorktreeInfo">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,2"
                                      ContextMenu="{StaticResource WorktreeContextMenu}"
                                      DoubleTapped="Worktree_DoubleTapped">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding BranchDisplay}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ShortHash}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontSize="{StaticResource FontSizeSmaller}"
                                                       Foreground="{StaticResource TextDimmedBrush}"
                                                       IsVisible="{Binding !IsDetached}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontSize="{StaticResource FontSizeSmaller}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

                <!-- Recent Workspaces Section -->
                <Expander IsExpanded="{Binding IsRecentExpanded}" Margin="0,0,0,1">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🕐" FontSize="{StaticResource FontSizeSmall}"/>
                            <TextBlock Text="RECENT"
                                       FontFamily="{StaticResource FontFamilyStandard}"
                                       FontSize="{StaticResource FontSizeSmaller}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RecentWorkspaces.Count, StringFormat='({0})'}"
                                       FontFamily="{StaticResource FontFamilyStandard}"
                                       FontSize="{StaticResource FontSizeSmaller}"
                                       Foreground="{StaticResource TextDimmedBrush}"/>
                        </StackPanel>
                    </Expander.Header>

                    <ListBox ItemsSource="{Binding RecentWorkspaces}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Workspace">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2"
                                      ContextMenu="{StaticResource WorkspaceContextMenu}"
                                      DoubleTapped="Workspace_DoubleTapped">
                                    <Panel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="🎮" FontSize="{StaticResource FontSizeSmall}"
                                                   IsVisible="{Binding IsPlayground}"/>
                                        <TextBlock Text="📂" FontSize="{StaticResource FontSizeSmall}"
                                                   IsVisible="{Binding !IsPlayground}"/>
                                    </Panel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontFamily="{StaticResource FontFamilyStandard}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding GitBranch}"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"
                                                       FontSize="{StaticResource FontSizeSmaller}"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       IsVisible="{Binding GitBranch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                                   FontSize="{StaticResource FontSizeSmaller}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding RelativeLastOpened}"
                                               FontFamily="{StaticResource FontFamilyStandard}"
                                               FontSize="{StaticResource FontSizeSmaller}"
                                               Foreground="{StaticResource TextDimmedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Indicator -->
        <Border Grid.RowSpan="2"
                Background="#80000000"
                IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading..."
                           FontFamily="{StaticResource FontFamilyStandard}"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Create Worktree Dialog -->
        <Border Grid.RowSpan="2"
                Background="#C0000000"
                IsVisible="{Binding IsCreateWorktreeDialogOpen}">
            <Border Background="{StaticResource BackgroundDarkBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    MaxWidth="350"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="Create Worktree"
                               FontFamily="{StaticResource FontFamilyStandard}"
                               FontSize="{StaticResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Path"
                                   FontFamily="{StaticResource FontFamilyStandard}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding NewWorktreePath}"
                                 Watermark="/path/to/worktree"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeSmall}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Branch"
                                   FontFamily="{StaticResource FontFamilyStandard}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding AvailableBranches}"
                                  SelectedItem="{Binding NewWorktreeBranch}"
                                  IsVisible="{Binding !CreateNewBranch}"
                                  HorizontalAlignment="Stretch"
                                  FontFamily="{StaticResource FontFamilyMonospace}"
                                  FontSize="{StaticResource FontSizeSmall}"/>
                        <TextBox Text="{Binding NewWorktreeBranch}"
                                 IsVisible="{Binding CreateNewBranch}"
                                 Watermark="new-branch-name"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeSmall}"
                                 Background="{StaticResource BackgroundMediumBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding CreateNewBranch}"
                              Content="Create new branch"
                              FontFamily="{StaticResource FontFamilyStandard}"
                              FontSize="{StaticResource FontSizeSmall}"
                              Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CancelCreateWorktreeCommand}"
                                Background="{StaticResource BackgroundMediumBrush}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Padding="16,8"/>
                        <Button Content="Create"
                                Command="{Binding CreateWorktreeCommand}"
                                Background="{StaticResource AccentBlueBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
