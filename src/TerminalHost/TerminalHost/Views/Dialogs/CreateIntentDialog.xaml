<Window x:Class="TerminalHost.Views.Dialogs.CreateIntentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Intent"
        Width="550" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border Background="{DynamicResource BackgroundDarkBrush}"
            BorderBrush="{DynamicResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown"
                    Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="New Intent"
                                   FontSize="{StaticResource FontSizeNormal}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrightBrush}"
                                   FontFamily="{StaticResource FontFamilyStandard}"/>
                        <TextBlock x:Name="RepoPathDisplay"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    <Button Content="×"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click"
                            FontSize="16"
                            Padding="8,2"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundActiveBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20,16">

                <!-- Intent Name -->
                <TextBlock Text="Intent Name"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource FontFamilyStandard}"
                           FontSize="{StaticResource FontSizeCode}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="IntentNameTextBox"
                         Text="{Binding IntentName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource FontFamilyStandard}"
                         FontSize="{StaticResource FontSizeCode}"
                         Padding="8,6"
                         Background="{DynamicResource BackgroundMediumBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderMediumBrush}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         SelectionBrush="{DynamicResource AccentPrimaryBrush}"/>

                <TextBlock Text="A short description of what you want to achieve (e.g., 'Add user authentication')"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           FontStyle="Italic"
                           Margin="0,4,0,0"/>

                <!-- Intent Mode Selection -->
                <TextBlock Text="Working Directory"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource FontFamilyStandard}"
                           FontSize="{StaticResource FontSizeCode}"
                           FontWeight="SemiBold"
                           Margin="0,20,0,8"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="NewWorktreeRadio"
                                 Content="Create new worktree"
                                 IsChecked="{Binding CreateNewWorktree, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontFamily="{StaticResource FontFamilyStandard}"
                                 Margin="0,0,20,0"
                                 GroupName="IntentMode"/>
                    <RadioButton Content="Use existing folder"
                                 IsChecked="{Binding UseExistingFolder, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontFamily="{StaticResource FontFamilyStandard}"
                                 GroupName="IntentMode"/>
                </StackPanel>

                <!-- New Worktree Section -->
                <StackPanel x:Name="NewWorktreeSection"
                            Visibility="{Binding CreateNewWorktree, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Branch -->
                    <TextBlock Text="Branch"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource FontFamilyStandard}"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="BranchTextBox"
                             Text="{Binding BranchName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource FontFamilyMonospace}"
                             FontSize="{StaticResource FontSizeCode}"
                             Padding="8,6"
                             Background="{DynamicResource BackgroundMediumBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderMediumBrush}"
                             BorderThickness="1"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             SelectionBrush="{DynamicResource AccentPrimaryBrush}"
                             Margin="0,0,0,4"/>

                    <!-- Branch selection dropdown -->
                    <Border Background="{DynamicResource BackgroundMediumBrush}"
                            BorderBrush="{DynamicResource BorderMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            MaxHeight="120"
                            Margin="0,0,0,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BranchList" Padding="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                Padding="8,3"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="BranchItem_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" Foreground="{Binding StatusColor}" Width="14" FontSize="11"/>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BackgroundHoverBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="CreateNewBranchRadio"
                                     Content="Create new branch"
                                     IsChecked="{Binding CreateNewBranch, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontFamily="{StaticResource FontFamilyStandard}"
                                     FontSize="11"
                                     Margin="0,0,16,0"
                                     GroupName="BranchMode"/>
                        <RadioButton Content="Use existing branch"
                                     IsChecked="{Binding UseExistingBranch, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontFamily="{StaticResource FontFamilyStandard}"
                                     FontSize="11"
                                     GroupName="BranchMode"/>
                    </StackPanel>

                    <!-- Worktree Location -->
                    <TextBlock Text="Worktree Location"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource FontFamilyStandard}"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding WorktreePath, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeCode}"
                                 Padding="8,6"
                                 Background="{DynamicResource BackgroundMediumBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderMediumBrush}"
                                 BorderThickness="1"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 SelectionBrush="{DynamicResource AccentPrimaryBrush}"/>

                        <Button Grid.Column="1"
                                Content="Browse"
                                Click="BrowseWorktreeButton_Click"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Background="{DynamicResource BackgroundLightBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundActiveBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Existing Folder Section -->
                <StackPanel x:Name="ExistingFolderSection"
                            Visibility="{Binding UseExistingFolder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Text="Select Folder"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="{StaticResource FontFamilyStandard}"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <!-- Open folders list -->
                    <Border Background="{DynamicResource BackgroundMediumBrush}"
                            BorderBrush="{DynamicResource BorderMediumBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            MaxHeight="100"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasOpenFolders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="OpenFoldersList" Padding="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                Padding="8,4"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="FolderItem_Click">
                                            <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                                       FontFamily="{StaticResource FontFamilyMonospace}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BackgroundHoverBrush}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding ExistingFolderPath, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource FontFamilyMonospace}"
                                 FontSize="{StaticResource FontSizeCode}"
                                 Padding="8,6"
                                 Background="{DynamicResource BackgroundMediumBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderMediumBrush}"
                                 BorderThickness="1"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 SelectionBrush="{DynamicResource AccentPrimaryBrush}"/>

                        <Button Grid.Column="1"
                                Content="Browse"
                                Click="BrowseExistingButton_Click"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Background="{DynamicResource BackgroundLightBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundActiveBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <TextBlock Text="Select from open projects above, or browse to any folder"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               FontStyle="Italic"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Context (Optional) -->
                <TextBlock Text="Context for Claude Code (Optional)"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{StaticResource FontFamilyStandard}"
                           FontSize="{StaticResource FontSizeCode}"
                           FontWeight="SemiBold"
                           Margin="0,20,0,8"/>

                <TextBox x:Name="ContextTextBox"
                         Text="{Binding Context, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource FontFamilyStandard}"
                         FontSize="{StaticResource FontSizeCode}"
                         Padding="8,6"
                         Height="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BackgroundMediumBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderMediumBrush}"
                         BorderThickness="1"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         SelectionBrush="{DynamicResource AccentPrimaryBrush}"/>

                <TextBlock Text="This context will be loaded at the start of every Claude Code session in this intent"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           FontStyle="Italic"
                           Margin="0,4,0,0"/>

                <!-- Validation message -->
                <TextBlock x:Name="ValidationMessage"
                           Foreground="#F44336"
                           FontFamily="{StaticResource FontFamilyStandard}"
                           FontSize="{StaticResource FontSizeCode}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Footer with Buttons -->
            <Border Grid.Row="2" Background="{DynamicResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Click="CancelButton_Click"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{DynamicResource BackgroundLightBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundActiveBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CreateButton"
                            Content="Create Intent"
                            Click="CreateButton_Click"
                            Padding="16,6"
                            MinWidth="120"
                            Background="{DynamicResource AccentPrimaryBrush}"
                            Foreground="{DynamicResource TextBrightBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                                    <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
