<Window x:Class="TerminalHost.Views.Dialogs.NotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="350"
        MaxWidth="500">
    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <TextBlock x:Name="TitleText"
                           Foreground="{StaticResource TextBrightBrush}"
                           FontSize="{StaticResource FontSizeNormal}"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource FontFamilyStandard}"/>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <TextBlock x:Name="IconText"
                           Grid.Column="0"
                           FontSize="32"
                           VerticalAlignment="Top"
                           Margin="0,0,16,0"/>

                <!-- Message -->
                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeCode}"
                           FontFamily="{StaticResource FontFamilyStandard}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           MaxWidth="380"/>
            </Grid>

            <!-- Footer with Buttons -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Yes Button -->
                    <Button x:Name="YesButton"
                            Content="Yes"
                            Click="YesButton_Click"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextBrightBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- No Button -->
                    <Button x:Name="NoButton"
                            Content="No"
                            IsCancel="True"
                            Click="NoButton_Click"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{StaticResource BackgroundLightBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- OK Button -->
                    <Button x:Name="OKButton"
                            Content="OK"
                            Click="OKButton_Click"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{StaticResource AccentPrimaryBrush}"
                            Foreground="{StaticResource TextBrightBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            IsCancel="True"
                            Click="CancelButton_Click"
                            Visibility="Collapsed"
                            Padding="16,6"
                            MinWidth="80"
                            Background="{StaticResource BackgroundLightBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundActiveBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
