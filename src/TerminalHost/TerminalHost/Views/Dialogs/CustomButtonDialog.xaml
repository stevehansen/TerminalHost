<Window x:Class="TerminalHost.Views.Dialogs.CustomButtonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="350"
        MaxWidth="550">
    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource AccentPrimaryBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    Cursor="SizeAll">
                <TextBlock x:Name="TitleText"
                           Foreground="{StaticResource TextBrightBrush}"
                           FontSize="{StaticResource FontSizeNormal}"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource FontFamilyStandard}"/>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <TextBlock x:Name="IconText"
                           Grid.Column="0"
                           Text="&#x2139;"
                           FontSize="32"
                           VerticalAlignment="Top"
                           Margin="0,0,16,0"
                           Foreground="{StaticResource AccentPrimaryBrush}"/>

                <!-- Message -->
                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="{StaticResource FontSizeCode}"
                           FontFamily="{StaticResource FontFamilyStandard}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           MaxWidth="420"/>
            </Grid>

            <!-- Footer with Dynamic Buttons -->
            <Border Grid.Row="2" Background="{StaticResource BackgroundMediumBrush}" Padding="16,12" CornerRadius="0,0,6,6">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>
