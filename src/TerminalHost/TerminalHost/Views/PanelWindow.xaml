<Window x:Class="TerminalHost.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:interfaces="clr-namespace:TerminalHost.Core.Interfaces;assembly=TerminalHost.Core"
        mc:Ignorable="d"
        Title="{Binding PanelTitle}"
        Width="400"
        Height="600"
        MinWidth="250"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        d:DataContext="{d:DesignInstance Type=interfaces:IPanelableViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/PanelContentTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with dock button -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Custom header commands from panel -->
                    <ItemsControl ItemsSource="{Binding HeaderCommands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Icon}"
                                        ToolTip="{Binding Tooltip}"
                                        Command="{Binding Command}"
                                        Style="{StaticResource TabCloseButton}"
                                        FontSize="12"
                                        Padding="6,2"
                                        Margin="0,0,4,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Separator when custom commands exist -->
                    <Border Width="1"
                            Background="{StaticResource BorderSubtleBrush}"
                            Margin="0,4,8,4"
                            Visibility="{Binding HeaderCommands, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <!-- Dock button -->
                    <Button Content="&#x25E7;"
                            Style="{StaticResource TabCloseButton}"
                            Click="DockButton_Click"
                            ToolTip="Dock back to panel"
                            FontSize="14"
                            Padding="8,4"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PanelIcon}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding PanelTitle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Panel Content - uses DataTemplates from PanelContentTemplates.xaml -->
        <ContentPresenter Grid.Row="1" Content="{Binding}"/>

        <!-- Status bar (only shown when StatusText is not empty) -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsedConverter}}">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeMicro}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
