<UserControl x:Class="TerminalHost.Views.FileViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TerminalHost.ViewModels"
             xmlns:controls="clr-namespace:TerminalHost.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:FileViewerViewModel}">
    <UserControl.Resources>
        <Style x:Key="ModeTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="BorderBrush" Value="#569CD6"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D2D30"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewerToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeNormal}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#555555"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with mode tabs and actions -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mode tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton Content="Preview"
                                 Style="{StaticResource ModeTabButton}"
                                 IsChecked="{Binding IsPreviewModeSelected, Mode=OneWay}"
                                 Command="{Binding SwitchToPreviewCommand}"/>
                    <RadioButton Content="Edit"
                                 Style="{StaticResource ModeTabButton}"
                                 IsChecked="{Binding IsEditModeSelected, Mode=OneWay}"
                                 Command="{Binding SwitchToEditCommand}"/>
                    <!-- Side by Side tab - only visible for markdown files -->
                    <RadioButton Content="Side by Side"
                                 Style="{StaticResource ModeTabButton}"
                                 IsChecked="{Binding IsSideBySideModeSelected, Mode=OneWay}"
                                 Command="{Binding SwitchToSideBySideCommand}"
                                 Visibility="{Binding ShowSideBySideTab, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- File name with dirty indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="{Binding Title}"
                               Foreground="#CCCCCC"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text=" *"
                               Foreground="#CCCCCC"
                               Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="💾"
                            Style="{StaticResource ViewerToolbarButton}"
                            Command="{Binding SaveCommand}"
                            ToolTip="Save (Ctrl+S)"
                            Visibility="{Binding CanSave, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="⟳"
                            Style="{StaticResource ViewerToolbarButton}"
                            Command="{Binding ReloadCommand}"
                            ToolTip="Reload"/>
                    <Button Content="📜"
                            Style="{StaticResource ViewerToolbarButton}"
                            Command="{Binding ViewHistoryCommand}"
                            ToolTip="View History"
                            Visibility="{Binding CanViewHistory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="👤"
                            Style="{StaticResource ViewerToolbarButton}"
                            Command="{Binding ViewBlameCommand}"
                            ToolTip="View Blame (Ctrl+Shift+B)"
                            Visibility="{Binding CanViewBlame, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="⧉"
                            Style="{StaticResource ViewerToolbarButton}"
                            Command="{Binding DetachCommand}"
                            ToolTip="Pop Out"
                            Visibility="{Binding IsDetached, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <!-- Hide close button in detached window mode (window has its own close) -->
                    <Button Content="✕"
                            Style="{StaticResource ViewerToolbarButton}"
                            Command="{Binding CloseCommand}"
                            ToolTip="Close"
                            Visibility="{Binding IsDetached, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1">
            <!-- Preview mode: FlowDocumentScrollViewer (for non-markdown text files) -->
            <FlowDocumentScrollViewer
                x:Name="PreviewViewer"
                Document="{Binding PreviewDocument}"
                Visibility="{Binding IsPreviewMode, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#1E1E1E"
                Foreground="#CCCCCC"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto"
                IsToolBarVisible="False"
                IsSelectionEnabled="True"
                Zoom="100"/>

            <!-- Markdown preview mode: WebView2-based rich rendering (only in Preview mode, not SideBySide) -->
            <controls:MarkdownViewer
                HtmlContent="{Binding RenderedHtml}"
                Visibility="{Binding IsMarkdownPreviewMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Image preview mode -->
            <Grid Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="#1E1E1E">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Image Source="{Binding ImageSource}"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16"/>
                </ScrollViewer>
                <TextBlock Text="{Binding ImageInfo}"
                           Foreground="#666666"
                           FontSize="{StaticResource FontSizeTiny}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="8"
                           Padding="4,2"
                           Background="#80000000"/>
            </Grid>

            <!-- Edit mode: TextBox with line numbers -->
            <Grid Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Line numbers -->
                <ScrollViewer x:Name="LineNumbersScroll"
                              Grid.Column="0"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Hidden"
                              Background="#1E1E1E">
                    <TextBlock x:Name="LineNumbers"
                               Text="{Binding LineNumbers}"
                               FontFamily="{StaticResource FontFamilyMonospace}"
                               FontSize="{StaticResource FontSizeCode}"
                               Foreground="#5A5A5A"
                               Background="#1E1E1E"
                               Padding="8,4,8,4"
                               TextAlignment="Right"
                               MinWidth="4"/>
                </ScrollViewer>

                <!-- Editor -->
                <TextBox x:Name="EditTextBox"
                         Grid.Column="1"
                         Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource FontFamilyMonospace}"
                         FontSize="{StaticResource FontSizeCode}"
                         Foreground="#CCCCCC"
                         Background="#1E1E1E"
                         CaretBrush="#AEAFAD"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="{Binding IsReadOnly}"
                         Padding="4"
                         ScrollViewer.ScrollChanged="EditTextBox_ScrollChanged"
                         SelectionChanged="EditTextBox_SelectionChanged"/>
            </Grid>

            <!-- Side-by-Side mode: Editor + Preview for markdown files -->
            <Grid Visibility="{Binding IsSideBySideMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Editor with line numbers -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Line numbers -->
                    <ScrollViewer x:Name="SideBySideLineNumbersScroll"
                                  Grid.Column="0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Hidden"
                                  Background="#1E1E1E">
                        <TextBlock Text="{Binding LineNumbers}"
                                   FontFamily="{StaticResource FontFamilyMonospace}"
                                   FontSize="{StaticResource FontSizeCode}"
                                   Foreground="#5A5A5A"
                                   Background="#1E1E1E"
                                   Padding="8,4,8,4"
                                   TextAlignment="Right"
                                   MinWidth="40"/>
                    </ScrollViewer>

                    <!-- Editor -->
                    <TextBox x:Name="SideBySideEditTextBox"
                             Grid.Column="1"
                             Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource FontFamilyMonospace}"
                             FontSize="{StaticResource FontSizeCode}"
                             Foreground="#CCCCCC"
                             Background="#1E1E1E"
                             CaretBrush="#AEAFAD"
                             BorderThickness="0"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="{Binding IsReadOnly}"
                             Padding="4"
                             ScrollViewer.ScrollChanged="SideBySideEditTextBox_ScrollChanged"
                             SelectionChanged="SideBySideEditTextBox_SelectionChanged"/>
                </Grid>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              Background="#3F3F46"
                              HorizontalAlignment="Stretch"/>

                <!-- Right: Markdown Preview -->
                <controls:MarkdownViewer Grid.Column="2"
                                         HtmlContent="{Binding RenderedHtml}"/>
            </Grid>

            <!-- Empty state -->
            <TextBlock Text="Select a file to view"
                       Foreground="#808080"
                       FontSize="{StaticResource FontSizeNormal}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding FilePath, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=Invert}"/>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File info -->
                <TextBlock Grid.Column="0"
                           Text="{Binding Info}"
                           Foreground="White"
                           FontSize="{StaticResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Cursor position (edit and side-by-side modes) -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CursorInfo}"
                           Foreground="White"
                           FontSize="{StaticResource FontSizeTiny}"
                           VerticalAlignment="Center"
                           Margin="16,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSideBySideMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Modified indicator -->
                <TextBlock Grid.Column="2"
                           Text="Modified"
                           Foreground="White"
                           FontSize="{StaticResource FontSizeTiny}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
