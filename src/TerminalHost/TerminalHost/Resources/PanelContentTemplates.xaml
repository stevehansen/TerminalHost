<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TerminalHost.ViewModels"
                    xmlns:views="clr-namespace:TerminalHost.Views">

    <!-- DataTemplate for FileExplorerPanelViewModel - uses the inner ExplorerViewModel -->
    <DataTemplate DataType="{x:Type vm:FileExplorerPanelViewModel}">
        <views:FileExplorerView DataContext="{Binding ExplorerViewModel}"/>
    </DataTemplate>

    <!-- DataTemplate for MarkdownPreviewViewModel -->
    <DataTemplate DataType="{x:Type vm:MarkdownPreviewViewModel}">
        <views:MarkdownPreviewView/>
    </DataTemplate>

    <!-- DataTemplate for GitFilesViewModel (Git Changes panel) -->
    <DataTemplate DataType="{x:Type vm:GitFilesViewModel}">
        <views:GitFilesContentView/>
    </DataTemplate>

    <!-- DataTemplate for CommitHistoryViewModel (Commit History panel) -->
    <DataTemplate DataType="{x:Type vm:CommitHistoryViewModel}">
        <views:CommitHistoryContentView/>
    </DataTemplate>

    <!-- DataTemplate for ScratchPadViewModel -->
    <DataTemplate DataType="{x:Type vm:ScratchPadViewModel}">
        <views:ScratchPadContentView/>
    </DataTemplate>

    <!-- DataTemplate for SearchAcrossFilesViewModel (Search panel) -->
    <DataTemplate DataType="{x:Type vm:SearchAcrossFilesViewModel}">
        <views:SearchAcrossFilesContentView/>
    </DataTemplate>

    <!-- DataTemplate for FileHistoryViewModel -->
    <DataTemplate DataType="{x:Type vm:FileHistoryViewModel}">
        <views:FileHistoryContentView/>
    </DataTemplate>

    <!-- DataTemplate for FileBlameViewModel -->
    <DataTemplate DataType="{x:Type vm:FileBlameViewModel}">
        <views:FileBlameContentView/>
    </DataTemplate>

    <!-- DataTemplate for BranchComparisonViewModel -->
    <DataTemplate DataType="{x:Type vm:BranchComparisonViewModel}">
        <views:BranchComparisonContentView/>
    </DataTemplate>

    <!-- DataTemplate for ClaudeTasksPanelViewModel -->
    <DataTemplate DataType="{x:Type vm:ClaudeTasksPanelViewModel}">
        <views:ClaudeTasksContentView/>
    </DataTemplate>

    <!-- DataTemplate for UnifiedGitPanelViewModel (center panel) -->
    <DataTemplate DataType="{x:Type vm:UnifiedGitPanelViewModel}">
        <views:UnifiedGitPanelContentView/>
    </DataTemplate>

    <!-- DataTemplate for FileViewerViewModel (center panel) -->
    <DataTemplate DataType="{x:Type vm:FileViewerViewModel}">
        <views:FileViewerView/>
    </DataTemplate>

    <!-- DataTemplate for PrReviewViewModel (center panel) -->
    <DataTemplate DataType="{x:Type vm:PrReviewViewModel}">
        <views:PrReviewContentView/>
    </DataTemplate>

    <!-- DataTemplate for TestResultsViewModel (center panel) -->
    <DataTemplate DataType="{x:Type vm:TestResultsViewModel}">
        <views:TestResultsContentView/>
    </DataTemplate>

    <!-- DataTemplate for DetectedLinksViewModel (sidebar panel) -->
    <DataTemplate DataType="{x:Type vm:DetectedLinksViewModel}">
        <views:DetectedLinksContentView/>
    </DataTemplate>

    <!-- DataTemplate for RecentFeaturesViewModel (center panel / empty state) -->
    <DataTemplate DataType="{x:Type vm:RecentFeaturesViewModel}">
        <views:RecentFeaturesContentView/>
    </DataTemplate>

    <!-- DataTemplate for SparkCanvasViewModel (center panel) -->
    <DataTemplate DataType="{x:Type vm:SparkCanvasViewModel}">
        <views:SparkCanvasView/>
    </DataTemplate>

    <!-- DataTemplate for SessionsTreePanelViewModel (right sidebar) -->
    <DataTemplate DataType="{x:Type vm:SessionsTreePanelViewModel}">
        <views:SessionsTreeContentView/>
    </DataTemplate>

    <!-- DataTemplate for MemoryBrowserViewModel (center panel) -->
    <DataTemplate DataType="{x:Type vm:MemoryBrowserViewModel}">
        <views:MemoryBrowserContentView/>
    </DataTemplate>

    <!-- DataTemplate for DebugLogViewModel (center panel) -->
    <DataTemplate DataType="{x:Type vm:DebugLogViewModel}">
        <views:DebugLogContentView/>
    </DataTemplate>

</ResourceDictionary>
