<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TerminalHost.ViewModels"
        xmlns:views="using:TerminalHost.Views"
        xmlns:popups="using:TerminalHost.Views.Popups"
        mc:Ignorable="d"
        x:Class="TerminalHost.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        Background="{StaticResource BackgroundDarkestBrush}">

    <!-- Main Layout -->
    <Grid RowDefinitions="Auto,*">
        <!-- Row 0: Tab Strip -->
        <views:TabStrip Grid.Row="0" DataContext="{Binding}" />

        <!-- Row 1: Tab Content Area -->
        <Grid Grid.Row="1">
            <!-- Tab Content - rendered via DataTemplates -->
            <ContentControl Content="{Binding SelectedTab}">
                <!-- Placeholder when no tab selected -->
                <ContentControl.Styles>
                    <Style Selector="ContentControl:empty">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Background="{StaticResource TerminalBackgroundBrush}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Welcome to TerminalHost"
                                                   FontFamily="{StaticResource FontFamilyStandard}"
                                                   FontSize="{StaticResource FontSizeHeader}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Press Ctrl+N to open a project folder"
                                                   FontFamily="{StaticResource FontFamilyStandard}"
                                                   FontSize="{StaticResource FontSizeNormal}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                        <TextBlock Text="or click '+ New Project' in the tab bar"
                                                   FontFamily="{StaticResource FontFamilyStandard}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{StaticResource TextDimmedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                </ContentControl.Styles>
            </ContentControl>

            <!-- Popup Overlay Layer -->
            <Panel x:Name="PopupHost" IsHitTestVisible="False">
                <!-- Command Palette - Top Center -->
                <popups:CommandPaletteView
                    IsVisible="{Binding IsCommandPaletteOpen}"
                    IsHitTestVisible="{Binding IsCommandPaletteOpen}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,80,0,0" />

                <!-- Help View - Center -->
                <popups:HelpView
                    IsVisible="{Binding IsHelpOpen}"
                    IsHitTestVisible="{Binding IsHelpOpen}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <!-- Tab Switcher - Center -->
                <popups:TabSwitcherView
                    IsVisible="{Binding IsTabSwitcherOpen}"
                    IsHitTestVisible="{Binding IsTabSwitcherOpen}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <!-- Tab Dropdown - Top Left -->
                <popups:TabDropdownView
                    IsVisible="{Binding IsTabDropdownOpen}"
                    IsHitTestVisible="{Binding IsTabDropdownOpen}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="4,0,0,0" />

                <!-- Quick Task - Center -->
                <popups:QuickTaskView
                    IsVisible="{Binding IsQuickTaskOpen}"
                    IsHitTestVisible="{Binding IsQuickTaskOpen}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <!-- Quick Note - Center -->
                <popups:QuickNoteView
                    IsVisible="{Binding IsQuickNoteOpen}"
                    IsHitTestVisible="{Binding IsQuickNoteOpen}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Panel>
        </Grid>
    </Grid>
</Window>
