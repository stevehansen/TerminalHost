{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>stevehansen/renovate-config"
  ],
  "packageRules": [
    {
      "description": "global.json sdk.version is a floor (rollForward: latestFeature). The nix build uses the SDK nixpkgs pins, which lags; raising the floor breaks it.",
      "matchDatasources": [
        "dotnet-version"
      ],
      "matchDepNames": [
        "dotnet-sdk"
      ],
      "enabled": false
    },
    {
      "groupName": "LiveChartsCore",
      "matchPackageNames": [
        "/^LiveChartsCore\\./"
      ]
    },
    {
      "groupName": "Whisper.net",
      "matchPackageNames": [
        "/^Whisper\\.net/"
      ]
    },
    {
      "groupName": "FlaUI",
      "matchPackageNames": [
        "/^FlaUI\\./"
      ]
    },
    {
      "groupName": "WebView.Avalonia",
      "matchPackageNames": [
        "/^WebView\\.Avalonia/"
      ]
    },
    {
      "groupName": "xunit",
      "matchPackageNames": [
        "/^xunit/"
      ]
    }
  ]
}
