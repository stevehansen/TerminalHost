# Auto detect text files and perform LF normalization
* text=auto

# C# source files
*.cs text diff=csharp
*.csx text diff=csharp

# XAML files
*.xaml text

# Project files
*.csproj text
*.sln text
*.props text
*.targets text

# Config files
*.json text
*.xml text
*.config text

# Documentation
*.md text diff=markdown
*.txt text

# Scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
